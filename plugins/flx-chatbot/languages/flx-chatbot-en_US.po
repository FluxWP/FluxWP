msgid "Ayarlar"
msgstr "Settings"

msgid "Yapay zekâ sohbet penceresi, canlı destek ve müşteri hizmetleri"
msgstr "AI chat window, live chat and customer support"

msgid "Site sohbetleri"
msgstr "Site chats"

msgid "Açık"
msgstr "Open"

msgid "Tümü"
msgstr "All"

msgid "Asistanda"
msgstr "With assistant"

msgid "Kapalı"
msgstr "Closed"

msgid "Ad, e-posta, telefon ya da sayfa ara"
msgstr "Search name, email, phone or page"

msgid "Bu görünümde sohbet yok."
msgstr "No chats in this view."

msgid "Soldan bir sohbet seçin."
msgstr "Pick a chat on the left."

msgid "Yükleniyor…"
msgstr "Loading…"

msgid "Cevabınızı yazın… (Enter gönderir, Shift+Enter yeni satır)"
msgstr "Type your reply… (Enter sends, Shift+Enter for a new line)"

