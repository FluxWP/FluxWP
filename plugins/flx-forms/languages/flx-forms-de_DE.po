msgstr "Spalte"

msgid "Spreadsheet header"
msgstr "Tabellenkopfzeile"

msgid "Order / On"
msgstr "Bestellen / An"

msgid "Refresh fields from form"
msgstr "Felder aus Formular aktualisieren"

