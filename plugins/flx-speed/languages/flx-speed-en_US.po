msgid "Eski adreslere gelen ziyaretçi"
msgstr "Visitors to the old addresses"

msgid "404 sayfası göster (önerilen)"
msgstr "Show the 404 page (recommended)"

msgid "Ana sayfaya yönlendir"
msgstr "Redirect to the home page"

msgid "wp-login.php ve giriş yapmamış ziyaretçinin wp-admin istekleri için. admin-ajax.php, admin-post.php, REST API, wp-cron, WooCommerce hesabım girişi ve Flux App bağlantısı etkilenmez."
msgstr "Applies to wp-login.php and to wp-admin requests from logged-out visitors. admin-ajax.php, admin-post.php, the REST API, wp-cron, WooCommerce My Account login and the Flux App connection are not affected."

