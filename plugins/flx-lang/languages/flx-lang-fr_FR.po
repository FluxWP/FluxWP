msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: fr_FR\nPlural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Languages"
msgstr "Langues"

msgid "Shared page: the same in every language, interface in the visitor's language."
msgstr "Page partagée : la même dans toutes les langues, interface dans la langue du visiteur."

msgid "Shared"
msgstr "Partagé"

msgid "%1$s translation (%2$s)"
msgstr "%1$straduction (%2$s)"

msgid "Create %s translation"
msgstr "Créer une traduction%s"

msgid "You are not allowed to do this."
msgstr "Vous n'êtes pas autorisé à faire cela."

msgid "Filter by language"
msgstr "Filtrer par langue"

msgid "All languages"
msgstr "Toutes les langues"

msgid "Language"
msgstr "Langue"

msgid "Language of this content"
msgstr "Langue de ce contenu"

msgid "After saving you can create translations in other languages."
msgstr "Après avoir enregistré, vous pouvez créer des traductions dans d'autres langues."

msgid "Re-translate with AI"
msgstr "Retraduire avec l'IA"

msgid "Copy and translate"
msgstr "Copier et traduire"

msgid "Translate with AI"
msgstr "Traduire avec l'IA"

msgid "With Flux AI installed, translation is one click; AI agents connected over MCP can also translate with the flxl_save_translation tool."
msgstr "Avec Flux AI installé, la traduction se fait en un clic ; Les agents IA connectés via MCP peuvent également traduire avec l'outil flxl_save_translation."

msgid "Preparing translation…"
msgstr "Préparation de la traduction…"

msgid "AI is translating: %1$d / %2$d"
msgstr "L'IA traduit :%1$d/%2$d"

msgid "Translation ready, opening the editor…"
msgstr "Traduction prête, ouverture de l’éditeur…"

msgid "Some sections could not be translated and stayed in Turkish. Check them in the editor."
msgstr "Certaines sections n'ont pas pu être traduites et sont restées en turc. Vérifiez-les dans l'éditeur."

msgid "Translation stopped:"
msgstr "Traduction arrêtée :"

msgid "Replace the title, excerpt and body of the existing translation with an AI translation?"
msgstr "Remplacer le titre, l'extrait et le corps de la traduction existante par une traduction IA ?"

msgid "Translate with AI? If you choose No, a draft copy is created for you to translate yourself."
msgstr "Traduire avec l’IA ? Si vous choisissez Non, un brouillon est créé pour que vous puissiez le traduire vous-même."

msgid "Settings"
msgstr "Paramètres"

msgid "Saved."
msgstr "Enregistré."

msgid "The default language has no prefix in the address (example.org/hakkimizda/); other languages open with a prefix such as /en/. Each language version of a content is a separate page/post: create it from the language badge in the list or from the Language box in the editor. Theme and plugin interface texts use their own translations."
msgstr "La langue par défaut n'a pas de préfixe dans l'adresse (example.org/hakkimizda/) ; d'autres langues s'ouvrent avec un préfixe tel que /en/. Chaque version linguistique d'un contenu est une page/article distinct : créez-la à partir du badge de langue dans la liste ou à partir de la zone Langue de l'éditeur. Les textes de l'interface du thème et du plugin utilisent leurs propres traductions."

msgid "Active"
msgstr "Actif"

msgid "Code / address"
msgstr "Code/adresse"

msgid "Name"
msgstr "Nom"

msgid "Flag"
msgstr "Drapeau"

msgid "WordPress locale"
msgstr "Paramètres régionaux WordPress"

msgid "Default"
msgstr "Par défaut"

msgid "Remove"
msgstr "Supprimer"

msgid "Add language"
msgstr "Ajouter une langue"

msgid "— choose —"
msgstr "- choisir -"

msgid "A new language is added inactive: prepare its content, then activate it. Languages other than English also need the WordPress language pack (System check warns)."
msgstr "Une nouvelle langue est ajoutée inactive : préparez son contenu, puis activez-la. Les langues autres que l’anglais ont également besoin du pack de langue WordPress (avertissement de vérification du système)."

msgid "Content"
msgstr "Contenu"

msgid "Translated content types"
msgstr "Types de contenu traduit"

msgid "Cart, checkout and my account pages are shared by all languages. Categories are shared; their names are translated per language on the category edit screen. Language-specific alt text and replacement images are on the media edit screen."
msgstr "Les pages de panier, de paiement et de mon compte sont partagées dans toutes les langues. Les catégories sont partagées ; leurs noms sont traduits par langue sur l'écran d'édition de catégorie. Le texte alternatif spécifique à la langue et les images de remplacement se trouvent sur l'écran d'édition multimédia."

msgid "Content without a translation"
msgstr "Contenu sans traduction"

msgid "Show the Turkish version in other languages (menu and interface stay in that language; search engines get the Turkish canonical address)"
msgstr "Afficher la version turque dans d'autres langues (le menu et l'interface restent dans cette langue ; les moteurs de recherche obtiennent l'adresse canonique turque)"

msgid "When off, the English site lists only content that has an English version."
msgstr "Lorsqu'il est désactivé, le site anglais répertorie uniquement le contenu disposant d'une version anglaise."

msgid "Language switcher"
msgstr "Sélecteur de langue"

msgid "Elsewhere: the \"Flux Language Switcher\" block or the [flx_dil_secici] shortcode."
msgstr "Ailleurs : le bloc \"Flux Language Switcher\" ou le shortcode [flx_dil_secici]."

msgid "Switcher position"
msgstr "Position du commutateur"

msgid "Footer"
msgstr "Pied de page"

msgid "Header and mobile menu"
msgstr "En-tête et menu mobile"

msgid "Both"
msgstr "Les deux"

msgid "Language suggestion for visitors"
msgstr "Suggestion de langue pour les visiteurs"

msgid "Visitors from outside Türkiye"
msgstr "Visiteurs extérieurs à la Turquie"

msgid "Open directly in their language (recommended)"
msgstr "Ouvrir directement dans leur langue (recommandé)"

msgid "Show a suggestion bar at the top of the page"
msgstr "Afficher une barre de suggestions en haut de la page"

msgid "Off"
msgstr "Désactivé"

msgid "Visitors from outside Türkiye open the version in their language (English if none) before the page renders, and stay in it on later visits. A visitor who picks another language in the switcher stays in it. Search engine bots are never redirected. If the country or time zone is Türkiye, the visitor stays in Turkish. Not applied to logged-in users; use a private window to test."
msgstr "Les visiteurs extérieurs à la Turquie ouvrent la version dans leur langue (anglais s'il n'y en a pas) avant le rendu de la page et y restent lors de leurs visites ultérieures. Un visiteur qui choisit une autre langue dans le mélangeur y reste. Les robots des moteurs de recherche ne sont jamais redirigés. Si le pays ou le fuseau horaire est Türkiye, le visiteur reste en turc. Non appliqué aux utilisateurs connectés ; utilisez une fenêtre privée pour tester."

msgid "Suggested language"
msgstr "Langue suggérée"

msgid "If the browser language is one of the active languages (e.g. German once added), that one is suggested; otherwise this one."
msgstr "Si la langue du navigateur est l'une des langues actives (par exemple l'allemand une fois ajouté), celle-ci est suggérée ; sinon celui-ci."

msgid "Countries that see Turkish"
msgstr "Pays qui voient le turc"

msgid "Two-letter country codes (TR, CY…)."
msgstr "Codes pays à deux lettres (TR, CY…)."

msgid "Country information"
msgstr "Informations sur le pays"

msgid "Country in your request: %1$s (%2$s header). Country-based suggestion works."
msgstr "Pays dans votre demande :%1$s(en-tête%2$s). Les suggestions basées sur les pays fonctionnent."

msgid "The server sends no country information; the browser's time zone is used (Türkiye time = Turkish). For more accurate results, put the domain behind Cloudflare (free plan, the CF-IPCountry header is used automatically) or enable your host's GeoIP header."
msgstr "Le serveur n'envoie aucune information sur le pays ; le fuseau horaire du navigateur est utilisé (heure Türkiye = turc). Pour des résultats plus précis, placez le domaine derrière Cloudflare (forfait gratuit, l'en-tête CF-IPCountry est utilisé automatiquement) ou activez l'en-tête GeoIP de votre hébergeur."

msgid "Site texts per language"
msgstr "Textes du site par langue"

msgid "Empty fields are shown in Turkish."
msgstr "Les champs vides sont affichés en turc."

msgid "Save"
msgstr "Enregistrer"

msgid "Translation with AI"
msgstr "Traduction avec l'IA"

msgid "With Flux AI installed, a \"Translate with AI\" button appears in the list and the editor. AI agents connected over MCP (Claude etc.) and the Flux AI chat use these tools: flxl_languages, flxl_untranslated, flxl_translations, flxl_save_translation, flxl_set_language, flxl_image_language, flxl_term_translation, flxl_site_texts. Flux SEO tools (list_content, create_content, update_content) have a lang parameter."
msgstr "Une fois Flux AI installé, un bouton « Traduire avec AI » apparaît dans la liste et dans l'éditeur. Les agents IA connectés via MCP (Claude etc.) et le chat Flux AI utilisent ces outils : flxl_linguals, flxl_untranslated, flxl_translations, flxl_save_translation, flxl_set_lingual, flxl_image_langage, flxl_term_translation, flxl_site_texts. Les outils Flux SEO (list_content, create_content, update_content) ont un paramètre lang."

msgid "Source content not found or this type is not translated."
msgstr "Contenu source introuvable ou ce type n'est pas traduit."

msgid "Language is not active."
msgstr "La langue n'est pas active."

msgid "The content is already in this language."
msgstr "Le contenu est déjà dans cette langue."

msgid "Flux Language (translation)"
msgstr "Langage Flux (traduction)"

msgid "Flux Language"
msgstr "Langage des flux"

msgid "Flux AI & MCP is not installed or not ready."
msgstr "Flux AI & MCP n'est pas installé ou n'est pas prêt."

msgid "AI returned an empty answer."
msgstr "AI a renvoyé une réponse vide."

msgid "The AI answer was cut off."
msgstr "La réponse de l’IA a été coupée."

msgid "Translation job not found or expired."
msgstr "Travail de traduction introuvable ou expiré."

msgid "Alternative text (%s)"
msgstr "Texte alternatif (%s)"

msgid "Image (%s)"
msgstr "Image (%s)"

msgid "ID of the image shown instead of this one in this language (e.g. the translated version of a poster with text). Empty: same image."
msgstr "ID de l'image affichée à la place de celle-ci dans cette langue (par exemple la version traduite d'une affiche avec texte). Vide : même image."

msgid "This page is available in %s."
msgstr "Cette page est disponible dans%s."

msgid "Switch to %s"
msgstr "Passer à%s"

msgid "Stay on this version"
msgstr "Restez sur cette version"

msgid "Close"
msgstr "Fermer"

msgid "Language selection"
msgstr "Sélection de la langue"

msgid "Flux Language Switcher"
msgstr "Sélecteur de langue de flux"

msgid "Site title"
msgstr "Titre du site"

msgid "Tagline"
msgstr "Slogan"

msgid "Flux SEO: site name"
msgstr "Flux SEO : nom du site"

msgid "Flux SEO: alternate name"
msgstr "Flux SEO : nom alternatif"

msgid "Flux SEO: home page title"
msgstr "Flux SEO : titre de la page d’accueil"

msgid "Flux SEO: home page description"
msgstr "Flux SEO : description de la page d'accueil"

msgid "Only the default language is active; the site is single-language."
msgstr "Seule la langue par défaut est active ; le site est monolingue."

msgid "WordPress language packs"
msgstr "Packs de langues WordPress"

msgid "Not installed: %s. Pick it once in Settings › General › Site Language and save (the pack downloads), then switch back."
msgstr "Non installé :%s. Choisissez-le une fois dans Paramètres > Général > Langue du site et enregistrez (le pack télécharge), puis revenez."

msgid "All active languages have WordPress translations."
msgstr "Toutes les langues actives ont des traductions WordPress."

msgid "General settings"
msgstr "Paramètres généraux"

msgid "Page translations: %s"
msgstr "Traductions de pages :%s"

msgid "%1$d / %2$d pages translated. %3$s"
msgstr "Pages%1$d/%2$dtraduites.  FLXTOK2FIN. %3$s"

msgid "Untranslated ones are shown in Turkish (canonical address is Turkish)."
msgstr "Ceux qui ne sont pas traduits sont affichés en turc (l'adresse canonique est turque)."

msgid "Untranslated ones are hidden in this language."
msgstr "Les non traduits sont cachés dans cette langue."

msgid "Pages"
msgstr "Pages"

msgid "Visitor country"
msgstr "Pays du visiteur"

msgid "No visitor has been checked for a language suggestion yet."
msgstr "Aucun visiteur n'a encore été vérifié pour une suggestion de langue."

msgid "The server sends no country information; the browser time zone is used (Türkiye time = Turkish). If Cloudflare is enabled, the country code is used automatically."
msgstr "Le serveur n'envoie aucune information sur le pays ; le fuseau horaire du navigateur est utilisé (heure Türkiye = turc). Si Cloudflare est activé, le code du pays est utilisé automatiquement."

msgid "Country information comes from the %s header."
msgstr "Les informations sur le pays proviennent de l'en-tête%s."

msgid "Permalinks"
msgstr "Liens permanents"

msgid "Plain (?p=) links are in use; choose the \"Post name\" structure for language addresses."
msgstr "Des liens simples (?p=) sont utilisés ; choisissez la structure \"Nom du message\" pour les adresses linguistiques."

msgid "Name (%s)"
msgstr "Nom (%s)"

msgid "Description (%s)"
msgstr "Description (%s)"

msgid "If left empty, the Turkish name and description are shown."
msgstr "S'il est laissé vide, le nom turc et la description sont affichés."

msgid "[['Makes the site multilingual: language addresses like /en/, translation per page, post, project and event, language-specific visual, hreflang and canonical, English recommendation for those coming from outside Turkey, language selector; Language support for Flux AI & MCP and Flux AI tools.', 'tr']]"
msgstr "[['Rend le site multilingue : adresses de langue comme /en/, traduction par page, publication, projet et événement, visuel spécifique à la langue, hreflang et canonique, recommandation en anglais pour ceux venant de l'extérieur de la Turquie, sélecteur de langue ; Prise en charge linguistique pour les outils Flux AI & MCP et Flux AI.', 'tr']]"
