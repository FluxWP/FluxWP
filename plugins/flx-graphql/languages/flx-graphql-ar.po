msgstr "شفرة كوبون"

msgid "WooCommerce discount type (percent, fixed_cart …)."
msgstr "WooCommerce نوع الخصم (النسبة المئوية، الشاحنات الثابتة ...)."

msgid "Discount without tax."
msgstr "فرز بدون ضرائب."

msgid "Tax part of the discount."
msgstr "جزء ضريبي من التخفيض"

msgid "A fee added to the cart (e.g. a payment fee)."
msgstr "(أ) رسم مضاف إلى العربة (مثل رسوم الدفع)."

msgid "Fee key."
msgstr "مفتاح الطعام."

msgid "Fee name."
msgstr "إسمك."

msgid "Fee without tax."
msgstr "إدفع بدون ضرائب"

msgid "Tax of the fee."
msgstr "ضريبة الرسوم."

msgid "One tax rate in the cart totals."
msgstr "معدل ضريبي واحد في مجاميع العربة"

msgid "Tax name."
msgstr "اسم الضرائب."

msgid "Rate as WooCommerce shows it."
msgstr "المعدل WooCommerce يظهر ذلك."

msgid "Amount."
msgstr "المبلغ."

msgid "Cart totals, as WooCommerce calculated them."
msgstr "مجاميع البطاقة، كما حسبها WooCommerce."

msgid "ISO 4217 currency of the cart."
msgstr "ISO 4217 العملة من العربة."

msgid "Lines before coupons, without tax."
msgstr "خطوط قبل القسائم، بدون ضرائب."

msgid "Tax of the lines."
msgstr "ضريبة على الخطوط"

msgid "Fees without tax."
msgstr "رسوم بدون ضرائب"

msgid "Coupon discounts without tax."
msgstr "خصوم مزدوجة بدون ضرائب"

msgid "Shipping without tax; null until shipping is calculated."
msgstr "الشحن بدون ضرائب؛ لا شيء حتى يتم حساب الشحن."

msgid "All taxes."
msgstr "كل الضرائب"

msgid "Amount to pay."
msgstr "مبلغ للدفع"

msgid "Taxes by rate."
msgstr "الضرائب بالمعدل"

msgid "A shipping option."
msgstr "خيار الشحن."

msgid "Rate ID for flxCartShippingRateSelect."
msgstr "بطاقة تعريف لـ (فوكس كارت) لـ (ريتس سيلكتور)"

msgid "Shipping method (flat_rate, free_shipping …)."
msgstr "- طريقة الشحن (البطاقة، حرية الشحن ...)."

msgid "Name."
msgstr "الاسم."

msgid "Description; may be empty."
msgstr "الوصف، قد يكون فارغاً"

msgid "Delivery time; may be empty."
msgstr "وقت التسليم؛ قد يكون فارغا."

msgid "Price without tax."
msgstr "السعر بدون ضرائب"

msgid "Whether this option is chosen."
msgstr "ما إذا كان هذا الخيار قد اختير."

msgid "A group of lines shipped together and its shipping options."
msgstr "مجموعة من الخطوط تم شحنها معاً وخيارات الشحن"

msgid "Package ID."
msgstr "بطاقة هوية"

msgid "Package name."
msgstr "اسم الطرد."

msgid "Shipping options."
msgstr "خيارات الشحن."

msgid "A billing or shipping address of the cart."
msgstr "عنوان فواتير العربة أو شحنها"

msgid "A problem with the cart the shopper has to fix before paying (e.g. a product went out of stock)."
msgstr "هناك مشكلة مع العربة التي يجب على المتسوق أن يصلحها قبل دفعها (مثلاً، المنتج خرج من المخزن)."

msgid "WooCommerce error code."
msgstr "رمز خطأ WooCommerce"

msgid "Message in the shopper's language."
msgstr "رسالة في لغة المتسوق"

msgid "Where the payment step continues. Payment stays on the WooCommerce Store API checkout; card data never goes through GraphQL."
msgstr "عندما تستمر خطوة الدفع، يبقى الدفع على WooCommerce Store API بيانات البطاقات لا تعبر GraphQL."

msgid "The site's checkout page; null when WooCommerce is not loaded."
msgstr "صفحة دخول الموقع لاغية عندما لا يتم تحميل WooCommerce"

msgid "The site's cart page; null when WooCommerce is not loaded."
msgstr "صفحة الموقع لاغية عندما لا يتم تحميل WooCommerce"

msgid "The shopper's WooCommerce cart (Store API)."
msgstr "عربة المتسوق WooCommerce (المخزن API)"

msgid "Cart token. Send it back as the Cart-Token header (headless front end, mobile); it is also in the Cart-Token response header. Null when WooCommerce gave none."
msgstr "كارت توكين، أعيديه كرئيس لسيارة توكن (الجبهة بلا رأس، متحركة)؛ وهو أيضاً في رأس رد كارت - توكن، حيث لم يعط أي منها WooCommerce."

msgid "Store API nonce for the same-site cookie session (Nonce header). Null when WooCommerce gave none."
msgstr "لم تُعقد دورة كوكي في نفس الموقع (مدير نونس) كما لم يُمنح أي منها رقم WooCommerce."

msgid "Number of units in the cart (quantities added up)."
msgstr "عدد الوحدات في العربة (الكميات المضافة)."

msgid "Lines."
msgstr "خطوط."

msgid "Applied coupons."
msgstr "قسائم مطبقة."

msgid "Fees."
msgstr "رسوم."

msgid "Totals."
msgstr "المجموع."

msgid "Whether the order needs a payment (false for a free cart)."
msgstr "ما إذا كان الأمر يحتاج إلى دفعة (الدفع مقابل عربة مجانية)."

msgid "Whether the order is shipped (false for donations and virtual products)."
msgstr "وسواء كان الأمر مشحناً (نقص التبرعات والمنتجات الافتراضية)."

msgid "Whether shipping was calculated for the current address."
msgstr "ما إذا كانت الشحنة قد حسبت للعنوان الحالي."

msgid "Shipping packages and their options."
msgstr "طرود الشحن وخياراتهم"

msgid "IDs of the payment gateways available for this cart (payment_method of the checkout)."
msgstr "هويات بوابات الدفع المتاحة لهذه العربة (الدفع - ملحد من السحب)."

msgid "Features a gateway must support for this cart (e.g. products, subscriptions)."
msgstr "ويجب أن تدعم البوابة هذه العربة (مثل المنتجات والاشتراكات)."

msgid "Problems to fix before paying."
msgstr "مشاكل في الإصلاح قبل الدفع."

msgid "Billing address."
msgstr "عنوان بيلينغ."

msgid "Shipping address."
msgstr "عنوان الشحن."

msgid "Where the payment step continues."
msgstr "حيث تستمر خطوة الدفع."

msgid "A variation attribute."
msgstr "سمة مختلفة."

msgid "Attribute name or taxonomy (e.g. pa_color)."
msgstr "(أ) تُنسب الاسم أو التحصين (مثلاً (باب - كولور)."

msgid "Chosen value."
msgstr "قيمة مختارة"

msgid "Address fields to change; fields left out keep their value."
msgstr "معالجة الحقول للتغيير؛ وتبقي الحقول قيمة."

msgid "The shopper's cart (Cart-Token session or the WooCommerce session cookie). Never cached."
msgstr "عربة المتسوق (دورة (كارت توك أو كعكة الدورة WooCommerce لم تُخرب قط"

msgid "The cart after the change; null when the change failed."
msgstr "العربة بعد التغيير، لاغية عندما فشل التغيير."

msgid "Adds a product to the cart (Store API cart/add-item)."
msgstr "يضيف منتجا إلى العربة (العربة/البند المضاف من طراز Store API)."

msgid "Product or variation database ID."
msgstr "هوية قاعدة بيانات المنتجات أو التباينات."

msgid "Quantity; default 1."
msgstr "الكمية؛ التقصير 1"

msgid "Variation attributes for a variable product."
msgstr "(ب) خصائص التغير بالنسبة لمنتج متغير."

msgid "Key of the line that was added or increased; null when the change failed."
msgstr "مفتاح السطر الذي أضيف أو زاد؛ لا شيء عندما يفشل التغيير."

msgid "Changes the quantity of a cart line; 0 removes it."
msgstr "يغيّر كمية خط العربات، ولا يزيله أحد."

msgid "Cart item key."
msgstr "مفتاح صنف العربة"

msgid "New quantity."
msgstr "كمية جديدة."

msgid "Removes a cart line."
msgstr "يزيل خط العربة"

msgid "Empties the cart."
msgstr "يفرغ العربة."

msgid "Applies a coupon."
msgstr "يَفْعلُ a قسيمة."

msgid "Removes a coupon."
msgstr "يزيل قسيمة."

msgid "Chooses a shipping option."
msgstr "يختار خيار الشحن."

msgid "Rate ID (FlxCartShippingRate.rateId)."
msgstr "معدل الهوية (FlxCartShippingRate.rateId)."

msgid "Shipping package; left out = every package."
msgstr "رزمة الشحن؛ مُتبقية = كل طرد."

msgid "Changes the billing and/or shipping address; totals, taxes and shipping options follow."
msgstr "(ب) تغيير عنوان الفواتير و/أو الشحن؛ وتلي ذلك المجاميع والضرائب وخيارات النقل البحري."

msgid "Billing address fields to change."
msgstr "بلينغ) يخاطب الحقول للتغيير)"

msgid "Shipping address fields to change."
msgstr "تشحن الحقول لتغييرها"

msgid "First name."
msgstr "الاسم الأول."

msgid "Last name."
msgstr "الاسم الأخير."

msgid "Company."
msgstr "الشركة"

msgid "Address line 1."
msgstr "العنوان 1"

msgid "Address line 2."
msgstr "العنوان 2"

msgid "City."
msgstr "المدينة."

msgid "State or province code."
msgstr "قانون الولاية أو المقاطعة."

msgid "Postcode."
msgstr "البريد."

msgid "E-mail."
msgstr "البريد الإلكتروني."

msgid "Phone."
msgstr "الهاتف."

msgid "Choose a product."
msgstr "اختر منتجاً"

msgid "The quantity must be at least 1."
msgstr "يجب أن تكون الكمية 1 على الأقل"

msgid "The quantity cannot be negative."
msgstr "لا يمكن أن تكون الكمية سلبية."

msgid "Enter a coupon code."
msgstr "أدخل رمز الكوبونات"

msgid "The shop is not available on this site."
msgstr "المتجر غير متاح في هذا الموقع."

msgid "Your cart has expired. Please reload the page."
msgstr "عربتك إنتهت، من فضلك أعد تحميل الصفحة."

msgid "The cart could not be changed. Please reload the page."
msgstr "العربة لا يمكن تغييرها، رجاءً أعيدي تحميل الصفحة"

