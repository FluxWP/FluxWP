msgstr "[%1$s] Аудит сайта: %2$d новые критические/высокие рекомендации"

msgid "The automatic site audit found new recommendations:"
msgstr "Автоматический аудит сайта выявил новые рекомендации:"

msgid "Total: critical %1$d, high %2$d, medium %3$d, low %4$d."
msgstr "Итого: критический %1$d, высокий %2$d, средний %3$d, низкий %4$d."

msgid "Resolved since the previous audit: %d."
msgstr "Устранено после предыдущего аудита: %d."

