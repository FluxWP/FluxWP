msgstr "\"%s\" rengi hazır paletin parçası, silinemez."

msgid "Accent"
msgstr "Vurgu"

msgid "Sorry, that palette does not exist."
msgstr "Bu palet yok."

msgid "Optional token library slug to target; defaults to the active library."
msgstr "Hedeflenecek token kütüphanesinin kısa adı (isteğe bağlı); varsayılan etkin kütüphane."

msgid "The swatch token dot-path."
msgstr "Renk tokenının yolu."

