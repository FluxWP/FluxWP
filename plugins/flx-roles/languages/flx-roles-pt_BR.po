msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: pt_BR\nPlural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Roles and access"
msgstr "Funções e acesso"

msgid "Automatic (first available: Tasks, Certificates, Donations)"
msgstr "Automático (primeiro disponível: Tarefas, Certificados, Doações)"

msgid "Tasks"
msgstr "Tarefas"

msgid "Certificates"
msgstr "Certificados"

msgid "Donations"
msgstr "Doações"

msgid "Dashboard (admin home)"
msgstr "Painel (página inicial do administrador)"

msgid "Profile"
msgstr "Perfil"

msgid "%s person"
msgid_plural "%s people"
msgstr[0] "%spessoa"
msgstr[1] "%spessoas"

msgid "You are not allowed to do this."
msgstr "Você não tem permissão para fazer isso."

msgid "Saved. Permission changes apply immediately."
msgstr "Salvo. As alterações de permissão são aplicadas imediatamente."

msgid "The role is back to its default permissions."
msgstr "A função voltou às permissões padrão."

msgid "Person added to the role."
msgstr "Pessoa adicionada à função."

msgid "Person removed from the role."
msgstr "Pessoa removida da função."

msgid "No user with this username or email. Create the user first."
msgstr "Nenhum usuário com este nome de usuário ou e-mail. Crie o usuário primeiro."

msgid "Administrators can't get this role; they already see everything."
msgstr "Os administradores não podem obter esta função; eles já veem tudo."

msgid "The action could not be completed."
msgstr "A ação não pôde ser concluída."

msgid "Role added; it starts with admin panel access only. Turn on its permissions in the table."
msgstr "Função adicionada; começa apenas com acesso ao painel de administração. Ative suas permissões na tabela."

msgid "Role deleted; its people moved to the default role."
msgstr "Função excluída; seu pessoal passou para a função padrão."

msgid "Role name must be 1-40 characters."
msgstr "O nome da função deve ter de 1 a 40 caracteres."

msgid "Turn on and off what each role can access. A disabled action disappears from the menu and can't be done even by URL. The WordPress Administrator sees everything."
msgstr "Ative e desative o que cada função pode acessar. Uma ação desativada desaparece do menu e não pode ser realizada nem mesmo por URL. O administrador do WordPress vê tudo."

msgid "Delete this role? Its people move to the default role."
msgstr "Excluir esta função? Seu pessoal passa para a função padrão."

msgid "Delete role"
msgstr "Excluir função"

msgid "New role"
msgstr "Nova função"

msgid "For example Volunteer or Accounting. Starts with admin panel access only."
msgstr "Por exemplo Voluntário ou Contabilidade. Começa apenas com acesso ao painel de administração."

msgid "Role name"
msgstr "Nome da função"

msgid "Add role"
msgstr "Adicionar função"

msgid "Access"
msgstr "Acesso"

msgid "%s is not installed"
msgstr "%snão está instalado"

msgid "The setting is saved; it takes effect once the plugin is updated to a version that enforces this permission."
msgstr "A configuração é salva; ele entra em vigor assim que o plug-in é atualizado para uma versão que impõe essa permissão."

msgid "Waiting for %s update"
msgstr "Aguardando atualização do%s"

msgid "broad access"
msgstr "amplo acesso"

msgid "Settings"
msgstr "Configurações"

msgid "%s: screen after login"
msgstr "%s: tela após login"

msgid "Referral link lifetime"
msgstr "Vida útil do link de referência"

msgid "days"
msgstr "dias"

msgid "If a visitor who came through a referral link donates within this period, the donation is credited to that person. If they come through another referral link, the latest one wins."
msgstr "Se um visitante que veio por meio de um link de indicação doar nesse período, a doação será creditada a essa pessoa. Se eles vierem por meio de outro link de indicação, o mais recente vence."

msgid "Save"
msgstr "Salvar"

msgid "Reset this role's permissions to the defaults?"
msgstr "Redefinir as permissões desta função para os padrões?"

msgid "%s: reset to defaults"
msgstr "%s: redefinir para os padrões"

msgid "People"
msgstr "Pessoas"

msgid "Add WhatsApp number"
msgstr "Adicionar número do WhatsApp"

msgid "Referral link"
msgstr "Link de referência"

msgid "Copy"
msgstr "Copiar"

msgid "Remove this person from the role?"
msgstr "Remover esta pessoa da função?"

msgid "Remove from role"
msgstr "Remover da função"

msgid "Nobody yet."
msgstr "Ninguém ainda."

msgid "Username or email"
msgstr "Nome de usuário ou e-mail"

msgid "Add"
msgstr "Adicionar"

msgid "For a new person, first <a href=\"%s\">create a user</a> and choose one of these roles."
msgstr "Para uma nova pessoa, primeiro<a href=\"%s\">crie um usuário</a>e escolha uma destas funções."

msgid "For every permission of every role, see <a href=\"%s\">Admin theme › Permissions</a>."
msgstr "Para cada permissão de cada função, consulte<a href=\"%s\">Tema administrativo › Permissões</a>."

msgid "Copied"
msgstr "Copiado"

msgid "Director"
msgstr "Diretor"

msgid "Has every permission on this page: all donations, certificate and task management, reports. Unlike the WordPress administrator, can't install plugins or change site settings."
msgstr "Tem todas as permissões nesta página: todas as doações, certificados e gerenciamento de tarefas, relatórios. Ao contrário do administrador do WordPress, não é possível instalar plug-ins ou alterar as configurações do site."

msgid "Manager"
msgstr "Gerente"

msgid "Everything Staff can do, plus the donation and certificate dashboards (overall totals) and reports, and sets report schedules."
msgstr "Tudo o que a equipe pode fazer, além dos painéis de doações e certificados (totais gerais) e relatórios, além de definir cronogramas de relatórios."

msgid "Staff"
msgstr "Pessoal"

msgid "Regular user in Tasks, creates certificates, opens donations on behalf of others, sees the donations, donors and certificates they referred."
msgstr "Usuário regular no Tarefas, cria certificados, abre doações em nome de terceiros, vê as doações, doadores e certificados que encaminhou."

msgid "Role added from the panel."
msgstr "Função adicionada do painel."

msgid "General"
msgstr "Geral"

msgid "Can enter the admin panel"
msgstr "Pode entrar no painel de administração"

msgid "Can be a referrer (gets a personal referral link, can be chosen as referrer on certificates and donations)"
msgstr "Pode ser um referenciador (obtém um link de indicação pessoal, pode ser escolhido como referenciador em certificados e doações)"

msgid "Uses Tasks; sees the projects and lists they have access to"
msgstr "Usa Tarefas; vê os projetos e listas aos quais eles têm acesso"

msgid "Creates projects, folders and lists"
msgstr "Cria projetos, pastas e listas"

msgid "Uses AI features in Tasks"
msgstr "Usa recursos de IA em tarefas"

msgid "Manages Tasks (sees every project, usage board, settings)"
msgstr "Gerencia tarefas (vê todos os projetos, quadro de uso, configurações)"

msgid "Creates certificates"
msgstr "Cria certificados"

msgid "Sees only certificates they created or referred"
msgstr "Vê apenas os certificados que eles criaram ou referiram"

msgid "Sends in bulk"
msgstr "Envia em massa"

msgid "Sees the certificate dashboard"
msgstr "Vê o painel do certificado"

msgid "Manages certificates (all, templates, events, settings)"
msgstr "Gerencia certificados (todos, modelos, eventos, configurações)"

msgid "Sees donations they referred"
msgstr "Vê as doações que eles encaminharam"

msgid "Lists their own donors (donors of donations they referred)"
msgstr "Lista seus próprios doadores (doadores de doações que eles indicaram)"

msgid "Creates donations on behalf of others, with themselves as referrer (from the panel or the WhatsApp assistant)"
msgstr "Cria doações em nome de terceiros, tendo eles próprios como referenciadores (a partir do painel ou do assistente do WhatsApp)"

msgid "Gets notified when a donation they referred is paid or cancelled"
msgstr "É notificado quando uma doação indicada é paga ou cancelada"

msgid "Sees the donation dashboard (overall totals)"
msgstr "Vê o painel de doações (totais gerais)"

msgid "Sees all donations and donors"
msgstr "Vê todas as doações e doadores"

msgid "Call Center"
msgstr "Central de atendimento"

msgid "Uses WhatsApp chats"
msgstr "Usa bate-papos do WhatsApp"

msgid "Uses staff tools in the WhatsApp assistant according to their role (if their number is on their profile)"
msgstr "Utiliza ferramentas de equipe no assistente do WhatsApp de acordo com sua função (se o número estiver no perfil)"

msgid "Manages the Call Center (AI assistant, settings)"
msgstr "Gerencia o Call Center (assistente de IA, configurações)"

msgid "Studio"
msgstr "Estúdio"

msgid "Uses Studio (own gallery and shared folders)"
msgstr "Usa Studio (galeria própria e pastas compartilhadas)"

msgid "Manages Studio (everyone's gallery, settings)"
msgstr "Gerencia o Studio (galeria de todos, configurações)"

msgid "Reports"
msgstr "Relatórios"

msgid "Can receive daily/periodic reports"
msgstr "Pode receber relatórios diários/periódicos"

msgid "Sees overall reports (all staff, totals)"
msgstr "Vê relatórios gerais (todos os funcionários, totais)"

msgid "Sets staff and manager report schedules and motivation messages"
msgstr "Define cronogramas de relatórios para funcionários e gerentes e mensagens de motivação"

msgid "Invalid phone number. Write it with the country code or as 05xx."
msgstr "Número de telefone inválido. Escreva com o código do país ou como 05xx."

msgid "This number belongs to another user: %s."
msgstr "Este número pertence a outro usuário:%s."

msgid "WhatsApp number"
msgstr "Número do WhatsApp"

msgid "Phone"
msgstr "Telefone"

msgid "The WhatsApp assistant recognizes whoever writes from this number as this user and enables what their role allows (e.g. donations on behalf of others, their own donors). Only an administrator can change the number."
msgstr "O assistente do WhatsApp reconhece quem escreve a partir deste número como este usuário e permite o que sua função permite (por exemplo, doações em nome de terceiros, seus próprios doadores). Somente um administrador pode alterar o número."

msgid "Personal link"
msgstr "Link pessoal"

msgid "Donations from visitors who come through this link show you as the referrer."
msgstr "As doações de visitantes que passam por este link mostram você como referenciador."

msgid "To share another page, add %s to the end of its address."
msgstr "Para compartilhar outra página, adicione%sao final do endereço."

msgid "Flux Roles"
msgstr "Funções de fluxo"

msgid "FluxWP roles"
msgstr "Funções do FluxWP"

msgid "Missing role: %s. Deactivate and reactivate the plugin."
msgstr "Função ausente:%s. Desative e reative o plugin."

msgid "Staff WhatsApp numbers"
msgstr "Números de WhatsApp da equipe"

msgid "%s people have no WhatsApp number on their profile; the assistant won't recognize them."
msgstr "Pessoas%snão possuem número de WhatsApp em seu perfil; o assistente não os reconhecerá."

msgid "Everyone in the roles has a number."
msgstr "Todos nas funções têm um número."

msgid "Plugins enforcing role permissions"
msgstr "Plugins que impõem permissões de função"

msgid "Some enabled permissions aren't enforced yet; waiting for updates of: %s. Until then these people can't see the related screen."
msgstr "Algumas permissões habilitadas ainda não foram aplicadas; aguardando atualizações de:%s. Até então, essas pessoas não poderão ver a tela relacionada."

msgid "All enabled permissions are enforced."
msgstr "Todas as permissões habilitadas são aplicadas."

msgid "Roles"
msgstr "Funções"

msgid "[['Adds Staff, Administrator and Manager roles (new role is also added from the panel); You can turn on and off Task, Certificate, Donation, Call Center, Studio and report access for roles from a single page. Personal reference link and user phone number (for WhatsApp assistant) are here.', 'tr']]"
msgstr "[['Adiciona funções de equipe, administrador e gerente (nova função também é adicionada no painel); Você pode ativar e desativar o acesso a tarefas, certificados, doações, call center, estúdio e relatórios para funções em uma única página. O link de referência pessoal e o número de telefone do usuário (para o assistente do WhatsApp) estão aqui.', 'tr']]"
