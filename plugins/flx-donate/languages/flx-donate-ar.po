msgid "[['In the iyzico merchant panel, open the notification settings, switch payment notifications on and paste this address. iyzico allows one address per merchant; Flux Donate passes WooCommerce notifications on to the iyzico WooCommerce plugin, so the same address serves both.\\n"
msgstr "[['في لوحة التاجر iyzico، افتح إعدادات الإشعارات، وقم بتشغيل إشعارات الدفع والصق هذا العنوان. تسمح iyzico بعنوان واحد لكل تاجر؛ يقوم Flux Donate بتمرير إشعارات WooCommerce إلى المكون الإضافي iyzico WooCommerce، بحيث يخدم نفس العنوان كلا الأمرين.\\n"

msgid "\\nMerchant notifications URL (İşyeri Bildirimleri Url)\\n"
msgstr "\\nعنوان URL لإعلامات التاجر (عنوان URL لـ İşyeri Bildirimleri)\\n"

msgid "\\nSubscription notification URLs (Başarılı / Başarısız Abonelik Bildirimleri Url): not needed, leave them off.\\n"
msgstr "\\nعناوين URL لإشعارات الاشتراك (Başarılı / Başarısız Abonelik Bildirimleri URL): غير مطلوبة، اتركها معطلة.\\n"

msgid "\\nThey belong to iyzico's own subscription product; Flux Donate renews recurring donations with the saved card and its own scheduled task.\\n"
msgstr "\\nإنها تنتمي إلى منتج الاشتراك الخاص بشركة iyzico؛ يقوم Flux Donate بتجديد التبرعات المتكررة باستخدام البطاقة المحفوظة والمهمة المجدولة الخاصة به.\\n"

msgid "\\nCallback URL (sent automatically with every payment, nothing to paste):\\n"
