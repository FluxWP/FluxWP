msgid "\"Do Not Track\""
msgstr "\"No realizar seguimiento\""

msgid "Do not count visitors whose browser sends \"Do Not Track\" or GPC"
msgstr "No cuente a los visitantes cuyo navegador envía \"No rastrear\" o GPC"

