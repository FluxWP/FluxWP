msgstr "Les paquets d'expédition et leurs options."

msgid "IDs of the payment gateways available for this cart (payment_method of the checkout)."
msgstr "ID des passerelles de paiement disponibles pour ce panier (paiement_méthode de la caisse)."

msgid "Features a gateway must support for this cart (e.g. products, subscriptions)."
msgstr "Caractéristiques d'une passerelle doit soutenir ce panier (p. ex. produits, abonnements)."

msgid "Problems to fix before paying."
msgstr "Problèmes à régler avant de payer."

msgid "Billing address."
msgstr "Adresse postale."

msgid "Shipping address."
msgstr "Adresse de livraison."

msgid "Where the payment step continues."
msgstr "Là où se poursuit l'étape de paiement."

msgid "A variation attribute."
msgstr "Un attribut de variation."

msgid "Attribute name or taxonomy (e.g. pa_color)."
msgstr "Attribuer le nom ou la taxonomie (p. ex. pa_color)."

msgid "Chosen value."
msgstr "La valeur choisie."

msgid "Address fields to change; fields left out keep their value."
msgstr "Adresser les champs à changer; les champs laissés hors de portée conservent leur valeur."

msgid "The shopper's cart (Cart-Token session or the WooCommerce session cookie). Never cached."
msgstr "Le chariot de la trémie (session de jeton-cart ou le cookie de session WooCommerce). Jamais mis en cache."

msgid "The cart after the change; null when the change failed."
msgstr "Le chariot après le changement; null lorsque le changement a échoué."

msgid "Adds a product to the cart (Store API cart/add-item)."
msgstr "Ajouter un produit au panier (Store API panier/add-item)."

msgid "Product or variation database ID."
msgstr "ID de base de données de produits ou de variations."

msgid "Quantity; default 1."
msgstr "Quantité; par défaut 1."

msgid "Variation attributes for a variable product."
msgstr "Les attributs de variation pour un produit variable."

msgid "Key of the line that was added or increased; null when the change failed."
msgstr "Clé de la ligne qui a été ajoutée ou augmentée; null lorsque le changement a échoué."

msgid "Changes the quantity of a cart line; 0 removes it."
msgstr "Change la quantité d'une ligne de panier; 0 la retire."

msgid "Cart item key."
msgstr "Clé d'élément de panier."

msgid "New quantity."
msgstr "Nouvelle quantité."

msgid "Removes a cart line."
msgstr "Enlève une ligne de panier."

msgid "Empties the cart."
msgstr "Il vide le chariot."

msgid "Applies a coupon."
msgstr "Ça correspond à un coupon."

msgid "Removes a coupon."
msgstr "Enlève un coupon."

msgid "Chooses a shipping option."
msgstr "Choisissez une option d'expédition."

msgid "Rate ID (FlxCartShippingRate.rateId)."
msgstr "ID de taux (FlxCartShippingRate.rateId)."

msgid "Shipping package; left out = every package."
msgstr "Emballage de livraison; laissé hors = tous les colis."

msgid "Changes the billing and/or shipping address; totals, taxes and shipping options follow."
msgstr "Modification de l'adresse de facturation et/ou d'expédition; les totaux, les taxes et les options d'expédition suivent."

msgid "Billing address fields to change."
msgstr "Les champs d'adresses de facturation à changer."

msgid "Shipping address fields to change."
msgstr "Les champs d'adresses de livraison à changer."

msgid "First name."
msgstr "Prénom."

msgid "Last name."
msgstr "Nom."

msgid "Company."
msgstr "Compagnie."

msgid "Address line 1."
msgstr "Ligne d'adresse 1."

msgid "Address line 2."
msgstr "Ligne d'adresse 2."

msgid "City."
msgstr "Ville."

msgid "State or province code."
msgstr "Code de l'État ou de la province."

msgid "Postcode."
msgstr "Code postal."

msgid "ISO 3166-1 alpha-2 country code."
msgstr "ISO 3166-1 Code de pays alpha-2."

msgid "E-mail."
msgstr "E-mail."

msgid "Phone."
msgstr "Téléphone."

msgid "Choose a product."
msgstr "Choisissez un produit."

msgid "The quantity must be at least 1."
msgstr "La quantité doit être d'au moins 1."

msgid "The quantity cannot be negative."
msgstr "La quantité ne peut pas être négative."

msgid "Enter a coupon code."
msgstr "Entrez un code promo."

msgid "The shop is not available on this site."
msgstr "La boutique n'est pas disponible sur ce site."

msgid "Your cart has expired. Please reload the page."
msgstr "Votre panier a expiré. Veuillez recharger la page."

msgid "The cart could not be changed. Please reload the page."
msgstr "Le panier n'a pas pu être modifié. Veuillez recharger la page."

