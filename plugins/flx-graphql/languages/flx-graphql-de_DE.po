msgstr "E.164 Formular (+905301234567); leer, wenn die Nummer nicht gültig ist."

msgid "Digits only (905301234567)."
msgstr "Nur Digits (905301234567)."

msgid "Number as entered, for display."
msgstr "Nummer wie eingegeben, für Anzeige."

msgid "A stored file."
msgstr "Eine gespeicherte Datei."

msgid "File ID (upload ID or the package's own ID)."
msgstr "Datei-ID (Upload-ID oder die eigene ID des Pakets)."

msgid "File name."
msgstr "Dateiname."

msgid "MIME type."
msgstr "MIME-Typ."

msgid "Size in bytes."
msgstr "Größe in Bytes."

msgid "Download address (may need the same sign-in)."
msgstr "Adresse herunterladen (es kann das gleiche Sign-in benötigen)."

msgid "The file is an image."
msgstr "Die Datei ist ein Bild."

msgid "Thumbnail address for images."
msgstr "Thumbnail-Adresse für Bilder."

msgid "A person (donor, customer, contact). Flux CRM owns the record; other packages return it."
msgstr "Eine Person (Spender, Kunde, Kontakt). Flux CRM besitzt den Datensatz; andere Pakete geben ihn zurück."

msgid "Person ID in the shared people table."
msgstr "Personalausweis im Gemeinschaftstisch."

msgid "Full name."
msgstr "Voller Name."

msgid "E-mail address."
msgstr "E-Mail-Adresse."

msgid "Phone number."
msgstr "Telefonnummer."

msgid "Picture address."
msgstr "Bildadresse."

msgid "You are not allowed to manage plugins."
msgstr "Sie dürfen keine Plugins verwalten."

msgid "This screen needs JavaScript."
msgstr "Dieser Bildschirm benötigt JavaScript ."

msgid "Loading the screen…"
msgstr "Die Seite wird geladen..."

msgid "A separately installed WPGraphQL plugin is active and FluxWP cannot use it. Deactivate it under Plugins; FluxWP has its own copy."
msgstr "Ein separat installiertes WPGraphQL Plugin ist aktiv und FluxWP kann es nicht verwenden. Deaktivieren Sie es unter Plugins; FluxWP hat eine eigene Kopie."

msgid "Flux GraphQL is not ready on this site. Check Flux GraphQL under Plugins."
msgstr "Flux GraphQL ist auf dieser Seite nicht bereit. Überprüfen Sie Flux GraphQL unter Plugins."

msgid "The screen files of this plugin are missing. Update or reinstall the plugin."
msgstr "Die Bildschirmdateien dieses Plugins fehlen. Update oder Reinstallieren Sie das Plugin."

msgid "If the plugin was just updated, the browser or site cache may still hold old files. Hard-reload the page (Ctrl/Cmd + Shift + R); if it persists, purge the site cache."
msgstr "Wenn das Plugin gerade aktualisiert wurde, kann der Browser oder der Website-Cache noch alte Dateien halten. Hard-Reload der Seite (Ctrl/Cmd + Shift + R); wenn es fortbesteht, spülen Sie den Website-Cache."

msgid "This screen could not be loaded"
msgstr "Diese Ansicht konnte nicht geladen werden"

msgid "Reload page"
msgstr "Seite neu laden"

msgid "Uploads are not accepted for this screen."
msgstr "Uploads werden für diesen Bildschirm nicht akzeptiert."

msgid "You do not have permission to upload files here."
msgstr "Sie haben keine Erlaubnis, Dateien hier hochzuladen."

msgid "Too many uploads. Wait a few minutes and try again."
msgstr "Zu viele Uploads. Warten Sie ein paar Minuten und versuchen Sie es wieder."

msgid "The file did not arrive. Try again."
msgstr "Die Datei ist nicht angekommen. Versuchen Sie es erneut."

msgid "The file is larger than %s."
msgstr "Die Datei ist größer als %s ."

msgid "This file type is not allowed."
msgstr "Dieser Dateityp ist nicht zulässig."

msgid "The file could not be saved on the server."
msgstr "Die Datei konnte nicht auf dem Server gespeichert werden."

msgid "The uploaded file was not found. Upload it again."
msgstr "Die hochgeladene Datei wurde nicht gefunden. Laden Sie sie erneut hoch."

msgid "A name and value shown under a cart line (variation attribute or line detail)."
msgstr "Ein Name und Wert, der unter einer Warenkorbzeile angezeigt wird (Variationsattribut oder Zeilenausschnitt)."

msgid "Label."
msgstr "Label."

msgid "Value as plain text."
msgstr "Wert als Klartext."

msgid "Quantities a cart line accepts."
msgstr "Mengen, die eine Warenkorblinie akzeptiert."

msgid "Lowest quantity."
msgstr "Niedrigste Menge."

msgid "Highest quantity."
msgstr "Höchste Menge."

msgid "The quantity is a multiple of this."
msgstr "Die Menge ist ein Vielfaches davon."

msgid "Whether the shopper may change the quantity (false for fixed lines such as a donation)."
msgstr "Ob der Käufer die Menge ändern kann (false für feste Linien wie eine Spende)."

msgid "A line in the cart."
msgstr "Eine Linie im Warenkorb."

msgid "Cart item key; flxCartItemUpdate and flxCartItemRemove take it."
msgstr "Warenkorb-Artikel-Schlüssel; flxCartItemUpdate und flxCartItemRemove nehmen Sie es."

msgid "What the line is: \"product\", or a name a package gives its own lines (Flux Donate: \"donation\"). Filter flx_gql_cart_item_kind."
msgstr "Was die Linie ist: \"Produkt\", oder ein Name ein Paket gibt seine eigenen Zeilen (Flux Donate: \"donation\"). Filter flx_gql_cart_item_kind."

msgid "WooCommerce product (or variation) database ID."
msgstr "WooCommerce Produkt (oder Variation) Datenbank ID."

msgid "WooCommerce product type (simple, variation …)."
msgstr "WooCommerce Produkttyp (einfach, Variante ...)."

msgid "Product name."
msgstr "Produktname."

msgid "SKU; empty when the product has none."
msgstr "Artikelnummer; leer, wenn das Produkt keine hat."

msgid "Product page; null for products without a page."
msgstr "Produktseite; null für Produkte ohne Seite."

msgid "First product image; null without an image."
msgstr "Erstes Produktbild; null ohne Bild."

msgid "Alternative text of the image."
msgstr "Alternativer Text des Bildes."

msgid "Quantity."
msgstr "Menge."

msgid "Quantities this line accepts."
msgstr "Mengen, die diese Linie akzeptiert."

msgid "Only one of this product per order."
msgstr "Nur eines dieser Produkte pro Bestellung."

msgid "Price of one unit."
msgstr "Preis einer Einheit."

