msgid "Enter the Meta ad account ID and a Marketing API key in Settings › Meta."
msgstr "Ayarlar › Meta'ya reklam hesabı kimliğini ve Marketing API anahtarını girin."

msgid "Campaign not found."
msgstr "Kampanya bulunamadı."

msgid "Status can only be Active or Paused."
msgstr "Durum yalnız Etkin ya da Duraklatıldı olabilir."

msgid "Enter a daily budget greater than zero."
msgstr "Sıfırdan büyük bir günlük bütçe girin."

msgid "This item has no daily budget here (lifetime budget, or the budget is set on the campaign / ad sets). Change it in Meta Ads Manager."
msgstr "Bunun burada günlük bütçesi yok (toplam bütçe ya da bütçe kampanyada / reklam setlerinde). Meta Reklam Yöneticisi'nden değiştirin."

msgid "%1$s starts in %2$s day. Write the campaign now so Meta has time to review and learn."
msgid_plural "%1$s starts in %2$s days. Write the campaign now so Meta has time to review and learn."
msgstr[0] "%1$s %2$s gün sonra başlıyor. Meta'nın inceleyip öğrenmesine zaman kalsın diye kampanyayı şimdi yazın."
msgstr[1] "%1$s %2$s gün sonra başlıyor. Meta'nın inceleyip öğrenmesine zaman kalsın diye kampanyayı şimdi yazın."

msgid "Pause campaign"
msgstr "Kampanyayı duraklat"

msgid "Lower budget"
msgstr "Bütçeyi düşür"

msgid "Raise budget"
msgstr "Bütçeyi artır"

msgid "Pause weak ad"
msgstr "Zayıf reklamı duraklat"

msgid "New ad text"
msgstr "Yeni reklam metni"

msgid "Season coming"
msgstr "Sezon yaklaşıyor"

msgid "Waiting"
msgstr "Bekliyor"

msgid "Applied"
msgstr "Uygulandı"

msgid "Dismissed"
msgstr "Kapatıldı"

