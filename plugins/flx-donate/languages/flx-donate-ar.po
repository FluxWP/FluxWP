msgid "\\nWP-Cron only runs on visits and may be blocked by the host or a security plugin. Use \"Test cron\" or add a server cron job.\\n"
msgstr "\\nيتم تشغيل WP-Cron فقط أثناء الزيارات وقد يتم حظره بواسطة المضيف أو مكون إضافي للأمان. استخدم \"اختبار cron\" أو قم بإضافة مهمة cron للخادم.\\n"

