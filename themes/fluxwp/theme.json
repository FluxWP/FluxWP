{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "760px", "wideSize": "1240px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "primary", "name": "Orman Yeşili", "color": "#0E7A56" },
        { "slug": "primary-dark", "name": "Koyu Yeşil", "color": "#0A5A40" },
        { "slug": "leaf", "name": "Yaprak", "color": "#6DBE45" },
        { "slug": "ink", "name": "Lacivert Başlık", "color": "#14324A" },
        { "slug": "text", "name": "Metin", "color": "#4A5B66" },
        { "slug": "mint", "name": "Nane", "color": "#EAF5EE" },
        { "slug": "mint-soft", "name": "Açık Nane", "color": "#F5FAF6" },
        { "slug": "line", "name": "Çizgi", "color": "#DCE9E0" },
        { "slug": "white", "name": "Beyaz", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "heading", "name": "Nunito", "fontFamily": "Nunito, 'Segoe UI', system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Nunito", "fontWeight": "600 900", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/nunito-latin-ext.woff2"], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "fontFamily": "Nunito", "fontWeight": "600 900", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/nunito-latin.woff2"], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "body", "name": "Nunito Sans", "fontFamily": "'Nunito Sans', 'Segoe UI', system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Nunito Sans", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/nunitosans-latin-ext.woff2"], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "fontFamily": "Nunito Sans", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/nunitosans-latin.woff2"], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        },
        {
          "slug": "hand", "name": "Caveat", "fontFamily": "Caveat, 'Comic Sans MS', cursive",
          "fontFace": [
            { "fontFamily": "Caveat", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/caveat-latin-ext.woff2"], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "fontFamily": "Caveat", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/caveat-latin.woff2"], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Çok küçük", "size": "0.8125rem", "fluid": false },
        { "slug": "small", "name": "Küçük", "size": "0.9375rem", "fluid": false },
        { "slug": "medium", "name": "Orta", "size": "1.0625rem", "fluid": false },
        { "slug": "large", "name": "Büyük", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
        { "slug": "x-large", "name": "Çok büyük", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
        { "slug": "xx-large", "name": "Dev", "size": "3.5rem", "fluid": { "min": "2.4rem", "max": "3.5rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "1rem" },
        { "slug": "40", "name": "M", "size": "1.75rem" },
        { "slug": "50", "name": "L", "size": "clamp(2.5rem, 5vw, 3.75rem)" },
        { "slug": "60", "name": "XL", "size": "clamp(3.5rem, 7vw, 5.5rem)" },
        { "slug": "70", "name": "XXL", "size": "clamp(4.5rem, 9vw, 7rem)" }
      ]
    },
    "custom": { "radius": { "card": "16px", "media": "24px" }, "shadow": { "card": "0 10px 30px rgba(20,50,74,.08)" } }
  },
  "styles": {
    "color": { "background": "var:preset|color|white", "text": "var:preset|color|text" },
    "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.65" },
    "spacing": { "padding": { "left": "clamp(20px, 5vw, 56px)", "right": "clamp(20px, 5vw, 56px)" }, "blockGap": "1.5rem" },
    "elements": {
      "heading": { "color": { "text": "var:preset|color|ink" }, "typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "800", "lineHeight": "1.15" } },
      "h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
      "link": { "color": { "text": "var:preset|color|primary" }, ":hover": { "color": { "text": "var:preset|color|primary-dark" } } },
      "button": {
        "color": { "background": "var:preset|color|primary", "text": "var:preset|color|white" },
        "border": { "radius": "999px" },
        "typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "fontSize": "var:preset|font-size|small" },
        "spacing": { "padding": { "top": "0.8em", "bottom": "0.8em", "left": "1.7em", "right": "1.7em" } },
        ":hover": { "color": { "background": "var:preset|color|primary-dark" } }
      }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "fontSize": "var:preset|font-size|small" }, "color": { "text": "var:preset|color|ink" } },
      "core/post-title": { "typography": { "fontWeight": "800" } },
      "core/post-date": { "typography": { "fontSize": "var:preset|font-size|x-small" } },
      "core/quote": { "border": { "width": "0" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "checkout-header", "title": "Ödeme Header", "area": "header" }
  ],
  "customTemplates": [
    { "name": "page-full", "title": "Tam genişlik sayfa", "postTypes": ["page"] }
  ]
}
