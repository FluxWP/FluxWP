msgstr "Using Flux Mail connection: %s."

msgid "Hâlâ Flux Certificates'daki eski sağlayıcı kullanılıyor; bağlantıyı Flux Mail'e taşıyıp burada seçin."
msgstr "Still using the old provider in Flux Certificates; move the connection to Flux Mail and select it here."

msgid "Flux Certificates'daki Evolution sağlayıcısı kullanılıyor."
msgstr "Using the Evolution provider from Flux Certificates."

msgid "API adresi, key ve instance bu eklentide girilmiş."
msgstr "API URL, key and instance are entered in this plugin."

msgid "%s: hat durumu"
msgstr "%s: line status"

