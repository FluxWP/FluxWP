msgid "%1$scannot run because required PHP functions are unavailable (%2$s). Ask your hosting provider to enable the required PHP extension or remove the listed functions from disabled_functions in php.ini."
msgstr "%1$sne peut pas s'exécuter car les fonctions PHP requises ne sont pas disponibles (%2$s). Demandez à votre fournisseur d'hébergement d'activer l'extension PHP requise ou supprimez les fonctions répertoriées de Disabled_functions dans php.ini."

msgid "This add-on is not included in Flux Forms."
msgstr "Ce module complémentaire n'est pas inclus dans Flux Forms."

