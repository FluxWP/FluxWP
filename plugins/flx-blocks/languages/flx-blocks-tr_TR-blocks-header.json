rent header.":["Saydam header için yazı ya da sayfadaki ayarları devral."],"Sticky Background Settings":["Yapışkan arka plan ayarları"],"Transparent Border Settings":["Saydam kenarlık ayarları"],"Sticky Border Settings":["Yapışkan kenarlık ayarları"],"Container Size Settings":["Kapsayıcı boyut ayarları"],"Screen size to switch to mobile header":["Mobil header'a geçilecek ekran boyutu"],"Note: this ONLY affects when the header changes to it's mobile content. It DOES NOT affect responsive breakpoints for any other blocks or settings.":["Not: Bu YALNIZ header'ın mobil içeriğine geçtiği noktayı etkiler. Diğer blokların ya da ayarların responsive kırılma noktalarını ETKİLEMEZ."],"Header Tag":["Header etiketi"],"<header>":["<header>"],"<div>":["<div>"],"Flux Header":["Flux Header"],"The selected header is in the trash.":["Seçilen header çöp kutusunda."],"Mobile Layout":["Mobil düzen"],"block title\u0004Header (Adv)":["Header (gelişmiş)"],"block description\u0004Create an advanced header or footer for your website.":["Siteniz için gelişmiş bir header ya da footer oluşturun."],"header":["header"],"footer":["footer"],"Call To Action":["Harekete geç"],"Secondary":["İkincil"],"Call to Action":["Eylem çağrısı"],"Call to action":["Harekete geç"],"Chat or support":["Sohbet ya da destek"],"Join Today":["Hemen katıl"],"Facebook":["Facebook"],"Instagram":["Instagram"],"Youtube":["YouTube"],"svg":["svg"],"1":["1"],"Tab":["Sekme"],"block description\u0004A collection of blocks that allow visitors to get around your site.":["Ziyaretçilerin sitenizde gezinmesini sağlayan bloklar."],"block keyword\u0004header":["header"],"block keyword\u0004footer":["footer"],"block keyword\u0004navigation":["menü"],"block description\u0004Flux header column":["Flux header sütunu"],"block title\u0004Desktop Header":["Masaüstü header"],"block description\u0004Flux header desktop":["Flux masaüstü header"],"block title\u0004Tablet Header":["Tablet header"],"block description\u0004Flux tablet container":["Fl