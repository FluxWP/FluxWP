msgid "\"Do Not Track\""
msgstr "„Nicht verfolgen“"

msgid "Do not count visitors whose browser sends \"Do Not Track\" or GPC"
msgstr "Zählen Sie keine Besucher, deren Browser „Do Not Track“ oder GPC sendet"

