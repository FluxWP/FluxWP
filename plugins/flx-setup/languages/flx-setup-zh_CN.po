msgid "Latest posts"
msgstr "最新帖子"

msgid "Home"
msgstr "首页"

msgid "Calm and serious; fits anything."
msgstr "冷静、严肃;适合任何东西。"

msgid "Trustworthy, corporate."
msgstr "值得信赖,企业。"

msgid "Quiet and modern."
msgstr "安静而现代。"

msgid "Lively; tech and education."
msgstr "活泼;科技和教育。"

msgid "Nature; for nonprofits and foundations."
msgstr "自然;对于非营利组织和基金会。"

msgid "Your name and logo first, then preset, colour and pages. The preview on the right updates right away."
msgstr "首先是您的名称和徽标,然后是预设、颜色和页面。右侧的预览会立即更新。"

msgctxt "context_ac58193b5653"
msgid "Contact"
msgstr "联系方式"

msgid "I accept the %1$s and %2$s; I have read the %3$s."
msgstr "我接受%1$s和%2$s;我已阅读%3$s。"

msgid "Terms of Use"
msgstr "使用条款"

msgid "Privacy Policy"
msgstr "隐私政策"

msgid "KVKK Privacy Notice"
msgstr "KVKK 隐私声明"

msgid "Help us improve FluxWP (send usage data)"
msgstr "帮助我们改进 FluxWP(发送使用数据)"

msgid "Optional. WordPress and PHP version, language and time zone, plus anonymous version and error data for FluxWP plugins. The site address and country are always recorded for updates (IPs are not stored). Updates work when this is off; change it under FluxWP Panel › Settings."
msgstr "可选。 WordPress 和 PHP 版本、语言和时区,以及 FluxWP 插件的匿名版本和错误数据。始终记录站点地址和国家/地区以供更新(不存储 IP)。关闭时更新工作;在 FluxWP 面板 > 设置下更改它。"

msgid "Accept the terms to continue."
msgstr "接受条款以继续。"

msgid "Usage data consent saved."
msgstr "已保存使用数据同意。"

msgid "Usage data will not be sent."
msgstr "使用数据将不会被发送。"

msgid "Usage data"
msgstr "使用数据"

msgid "Update checks always send the site address; the server also looks up the country from the IP and does not store the IP (mandatory record). When on, update checks also send the WordPress and PHP version, time zone and language, and FluxWP plugin versions and errors are sent anonymously. When off, only what updates need is sent and updates work the same. You can withdraw consent here at any time."
msgstr "更新检查始终发送站点地址;服务器还会根据 IP 查找国家/地区,并且不存储 IP(强制记录)。启用后,更新检查还会发送 WordPress 和 PHP 版本、时区和语言,并且 FluxWP 插件版本和错误会匿名发送。关闭时,仅发送需要的更新,并且更新的工作方式相同。您可以随时在此处撤回同意。"

msgid "Anonymous usage data"
msgstr "Anonymous usage data"

msgid "On"
msgstr "开"

msgid "Sent."
msgstr "已发送。"

msgid "Show the data that will be sent"
msgstr "显示将要发送的数据"

msgid "Could not send. Check the URL and that the Flux Analytics telemetry hub is on at the target site."
msgstr "无法发送。检查 URL 以及 Flux Analytics 遥测中心是否在目标站点上打开。"

msgid "Sent: a random install ID, WordPress and PHP version, site language, country (from the time zone or store country), active FluxWP plugins and theme, PHP errors from FluxWP (with paths, domain, emails and IPs removed), setup wizard progress and choices. Site address, IP, users and content are never sent."
msgstr "发送:随机安装 ID、WordPress 和 PHP 版本、站点语言、国家/地区(来自时区或商店国家/地区)、活动的 FluxWP 插件和主题、FluxWP 中的 PHP 错误(已删除路径、域、电子邮件和 IP)、安装向导进度和选择。站点地址、IP、用户和内容永远不会发送。"

msgid "Not sent yet. Sent at most once a day."
msgstr "还没发送。每天最多发送一次。"

msgid "Nothing is sent. Tick \"Help us improve the product\" to turn it on."
msgstr "没有发送任何内容。勾选“帮助我们改进产品”将其打开。"

msgid "Saved."
msgstr "已保存。"

msgid "Last sent %s. Sent at most once a day."
msgstr "最后发送%s。每天最多发送一次。"

msgid "Telemetry URL"
msgstr "遥测网址"

msgid "Send now"
msgstr "立即发送"

msgid "Leave empty to send to FluxWP. To run your own hub, turn on Flux Analytics › Settings › Telemetry hub on one site and paste that address here. https only."
msgstr "留空以发送到 FluxWP。要运行您自己的中心,请在一个站点上打开 Flux Analytics › 设置 › 遥测中心,然后将该地址粘贴到此处。仅限 https。"

msgid "Be found on Google"
msgstr "在 Google 上可以找到"

msgid "Watch from the panel how the site looks in Google search, how many people arrive, and how fast pages open. Google Site Kit brings Search Console, Analytics and PageSpeed into one screen."
msgstr "从面板上观察网站在 Google 搜索中的外观、访问人数以及页面打开速度。 Google Site Kit 将 Search Console、Analytics 和 PageSpeed 整合到一个屏幕中。"

msgid "Install Google Site Kit"
msgstr "安装 Google 站点工具包"

msgid "Activate Google Site Kit"
msgstr "激活 Google 站点工具包"

msgid "Show your products on Google"
msgstr "在 Google 上展示您的产品"

msgid "Your Google account is connected. With Google for WooCommerce your products are listed for free on Google Shopping, Search, YouTube and Images; you can also run ads."
msgstr "您的 Google 帐户已连接。通过 Google for WooCommerce,您的产品可以在 Google 购物、搜索、YouTube 和图片上免费列出;您还可以投放广告。"

msgid "Install Google for WooCommerce"
msgstr "安装 Google for WooCommerce"

msgid "Activate Google for WooCommerce"
msgstr "激活 Google for WooCommerce"

msgid "Not needed"
msgstr "不需要"

msgid "Could not download %s from wordpress.org."
msgstr "无法从 wordpress.org 下载%s。"

msgid "Try from Plugins › Add New"
msgstr "从插件尝试 › 添加新的"

msgid "Next attempt: %s."
msgstr "下一次尝试:%s。"

msgid "Update distribution is temporarily paused on the server. Nothing is wrong with your site; updates will resume when distribution is turned back on."
msgstr "服务器上的更新分发暂时暂停。您的网站没有任何问题;重新打开分发后,更新将恢复。"

msgid "The update server does not accept requests from this site's country. Contact the server administrator for access."
msgstr "更新服务器不接受来自该站点所在国家/地区的请求。请联系服务器管理员获取访问权限。"

msgid "The update server does not accept keyless requests from this site's country. Enter a site key or contact the server administrator."
msgstr "更新服务器不接受来自该站点所在国家/地区的无密钥请求。输入站点密钥或联系服务器管理员。"

msgid "This server has turned off keyless updates. Enter a site key to keep receiving packages."
msgstr "该服务器已关闭无密钥更新。输入站点密钥以继续接收包裹。"

msgid "The site key is disabled on the server and keyless updates are off, so no packages are available. Ask the server administrator to re-enable the key."
msgstr "服务器上的站点密钥已禁用,并且无密钥更新已关闭,因此没有可用的软件包。请服务器管理员重新启用该密钥。"

msgid "The server cannot respond right now (HTTP %d)."
msgstr "服务器现在无法响应 (HTTP%d)。"

msgid "Distribution paused"
msgstr "分发暂停"

msgid "Blocked in this region"
msgstr "该地区被封锁"

msgid "Site key required"
msgstr "需要站点密钥"

msgid "Site key disabled"
msgstr "站点密钥已禁用"

msgid "Support and feedback: %s"
msgstr "支持和反馈:%s"

