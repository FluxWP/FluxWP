msgstr "\\nActiver la fonctionnalité de notification par e-mail\\n"

msgid "\\nTo receive email notifications from your forms, verify your email server by following these steps:\\n"
msgstr "\\nPour recevoir des notifications par e-mail à partir de vos formulaires, vérifiez votre serveur de messagerie en suivant ces étapes :\\n"

msgid "\\nGo to the<a href=\"%s\" style=\"font-weight:600;\">Flux Forms Panel</a>\\n"
msgstr "\\nAccédez au panneau Flux Forms<a href=\"%s\" style=\"font-weight:600;\"></a>\\n"

msgid "\\nClick Settings from the top menu\\n"
msgstr "\\nCliquez sur Paramètres dans le menu supérieur\\n"

