msgstr "On shared hosting PHP sees the disk shared by every account on the machine; this is not your quota."

msgid "Disk"
msgstr "Disk"

msgid "Sunucu verisi (data/)"
msgstr "Server data (data/)"

msgid "Eski zipleri temizle"
msgstr "Clean old zips"

msgid "Erişim günlüğü silinsin mi?"
msgstr "Delete the access log?"

