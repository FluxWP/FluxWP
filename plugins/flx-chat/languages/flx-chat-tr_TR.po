msgstr "Personel %1$s sertifikayı WhatsApp'tan yeniden gönderdi: %2$s"

msgid "✅ Your donor paid: *%1$s* · %2$s #%3$d"
msgstr "✅ Bağışçınız ödedi: *%1$s* · %2$s #%3$d"

msgid "❌ Donation cancelled: *%1$s* · %2$s #%3$d"
msgstr "❌ Bağış iptal edildi: *%1$s* · %2$s #%3$d"

