msgstr "{kod} — ваш код для просмотра пожертвований"

msgid "Your verification code"
msgstr "Ваш код подтверждения"

msgid "Enter this code on the \"My donations\" page to see your donations and download your certificates:"
msgstr "Введите этот код на странице «Мои пожертвования», чтобы увидеть пожертвования и скачать сертификаты:"

msgid "The code is valid for {dakika} minutes. If you did not ask for it, you can ignore this e-mail."
msgstr "Код действует {dakika} минут. Если вы его не запрашивали, просто проигнорируйте это письмо."

msgid "Enter a valid e-mail address or phone number."
msgstr "Введите правильный адрес электронной почты или номер телефона."

msgid "Codes cannot be sent by phone at the moment. Please use your e-mail address."
msgstr "Сейчас коды нельзя отправить на телефон. Используйте адрес электронной почты."

msgid "Codes cannot be sent by e-mail at the moment. Please use your phone number."
msgstr "Сейчас коды нельзя отправить по электронной почте. Используйте номер телефона."

msgid "Too many attempts. Please wait a few minutes and try again."
msgstr "Слишком много попыток. Подождите несколько минут и попробуйте снова."

msgid "The code could not be sent. Please try again later or contact us."
msgstr "Не удалось отправить код. Попробуйте позже или свяжитесь с нами."

msgid "If there is a donation with this number, we have sent a 6-digit code to it on WhatsApp."
msgstr "Если есть пожертвование с этим номером, мы отправили на него 6-значный код в WhatsApp."

msgid "If there is a donation with this number, we have sent a 6-digit code to it by SMS."
msgstr "Если есть пожертвование с этим номером, мы отправили на него 6-значный код по SMS."

msgid "If there is a donation with this address, we have sent a 6-digit code to it. Check your spam folder too."
msgstr "Если есть пожертвование с этим адресом, мы отправили на него 6-значный код. Проверьте также папку «Спам»."

msgid "%1$s is your code to view your donations at %2$s. Valid for 10 minutes. Do not share it with anyone."
msgstr "%1$s — ваш код для просмотра пожертвований в %2$s. Действует 10 минут. Никому его не сообщайте."

msgid "The code is wrong or has expired."
msgstr "Код неверный или устарел."

msgid "Send code"
msgstr "Отправить код"

msgid "Sending…"
msgstr "Отправка…"

msgid "Show my donations"
msgstr "Показать мои пожертвования"

msgid "Checking…"
msgstr "Проверка…"

msgid "Send again"
msgstr "Отправить снова"

msgid "Send again in %s s"
msgstr "Отправить снова через %s с"

msgid "6-digit code"
msgstr "6-значный код"

msgid "Sign out"
msgstr "Выйти"

msgid "Verified: %s"
msgstr "Подтверждено: %s"

