msgstr "Тестирование сервера электронной почты не смогло проверить возможности электронной почты."

msgid "Email capability verified"
msgstr "Возможность электронной почты проверена"

msgid "Server confirmed ability to send emails."
msgstr "Сервер подтвердил возможность отправлять электронную почту."

msgid "Your emails are being delivered to spam"
msgstr "Ваши письма попадают в спам"

msgid "WordPress sent the test email, but delivery has not been confirmed yet."
msgstr "WordPress отправил тестовое письмо, но доставка еще не подтверждена."

msgid "Email delivery failed:%s"
msgstr "Не удалось доставить электронное письмо:%s"

