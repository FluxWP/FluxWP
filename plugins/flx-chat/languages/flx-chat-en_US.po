msgstr "Opted out (blocklist)"

msgid "Gönderilen hatırlatıcı"
msgstr "Reminders sent"

msgid "Gönderilen kod · e-posta {e} · WhatsApp {w} · SMS {s}"
msgstr "Codes sent · e-mail {e} · WhatsApp {w} · SMS {s}"

msgid "Doğrulanan · telefon {p} · e-posta {e}"
msgstr "Verified · phone {p} · e-mail {e}"

msgid "Kod sorunu · yanlış {w} · süresi doldu {x} · gitmedi {f}"
msgstr "Code issues · wrong {w} · expired {x} · not delivered {f}"

