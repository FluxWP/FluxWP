msgid "The security code is incorrect."
msgstr "セキュリティコードは間違っています。"

msgid "The security code is incomplete."
msgstr "セキュリティコードは不完全です。"

msgid "The postal code failed validation."
msgstr "郵便番号は検証に失敗しました。"

msgid "Invalid postal code; please correct it and try again."
msgstr "無効な郵便番号。修正して再度お試しください。"

msgid "The card was declined."
msgstr "カードは断られた。"

msgid "The card has insufficient funds or limit."
msgstr "カードには資金または制限が不十分です。"

msgid "The card issuer did not approve the payment."
msgstr "カード発行者は支払いを承認しなかった。"

msgid "The card's transaction limit was exceeded."
msgstr "カードの取引制限を超えました。"

msgid "The bank requires card authentication (3D Secure)."
msgstr "カード認証(3D Secure)が必要です。"

msgid "3D Secure authentication failed; try again or use another card."
msgstr "3D セキュア認証が失敗し、再度試すか、別のカードを使用します。"

msgid "An error occurred while processing the card; please try again."
msgstr "カード処理中にエラーが発生しました。"

msgid "The email address is invalid."
msgstr "メールアドレスが無効です。"

msgid "The payment could not be processed; try again or use another method."
msgstr "支払いは処理できませんでした。もう一度試すか、別の方法を使用します。"

msgid "The payment is processing at Stripe."
msgstr "支払いはStripeで処理されます。"

msgid "Waiting for payment authentication."
msgstr "支払い認証待ち。"

msgid "The payment was canceled."
msgstr "支払いはキャンセルされました。"

msgid "This provider sends no notifications."
msgstr "このプロバイダーは通知を送信しません。"

msgid "This provider has no refunds from the site; make them in the provider's panel."
msgstr "このプロバイダーはサイトから払い戻しを受けません。"

msgid "This provider has no voids from the site."
msgstr "このプロバイダーはサイトから空白がありません。"

msgid "This provider has no status query."
msgstr "このプロバイダーはステータスクエリを持ちません。"

msgid "Error code %s"
msgstr "エラーコード %s"

msgid "The payment was not approved."
msgstr "支払いは承認されていませんでした。"

msgid "%1$s did not respond (HTTP %2$d)."
msgstr "%1$s は、HTTP で応答しません。 %2$d)."

msgid "Redirect: the bank or provider page opens full screen"
msgstr "リダイレクト: 銀行またはプロバイダーのページが全画面を開きます。"

msgid "Popup: in a frame, without leaving checkout"
msgstr "ポップアップ: フレーム内で、チェックアウトを離れずに。"

msgid "On site: in a frame, with the site's header and footer"
msgstr "サイト上:フレーム内、サイトのヘッダーとフッター付き。"

msgid "This provider has no connection test; try a small payment with a test card."
msgstr "このプロバイダーは接続テストを持っていません。"

msgid "Connection works, the keys were accepted."
msgstr "接続作業、鍵が受け入れられた。"

msgid "Automatic"
msgstr "自動"

msgid "Show all"
msgstr "すべて表示"

msgid "WooCommerce is not active."
msgstr "WooCommerce はアクティブではありません。"

msgid "Add a POS account before turning on the Pay by card method."
msgstr "カード決済の方法を有効にする前に、POSアカウントを追加します。"

msgid "Refund from the panel"
msgstr "パネルからの払い戻し"

msgid "No active POS account; card payments are not taken."
msgstr "アクティブなPOSアカウントはありません。カードの支払いは行われません。"

msgid "An account is in test mode, no real money is charged: %s"
msgstr "アカウントはテストモードであり、実際のお金は請求されません。 %s"

msgid "%d account is active in live mode."
msgid_plural "%d accounts are active in live mode."
msgstr[0] "%d アカウントは、ライブモードでアクティブです。"

msgid "%s: no webhook signing secret. The payment return is still read, but if the payer closes the page before returning the order stays pending. Add the notification URL in the Stripe Dashboard and enter the whsec_… secret."
msgstr "%s : ウェブフックの署名秘密はありません。支払いのリターンがまだ読み込まれていますが、支払い担当者が注文を返す前にページを閉じている場合、保留状態です。"

msgid "The official WooCommerce Stripe plugin is also active. Pick a single card method in Flux POS › Methods so payers do not see two card options."
msgstr "WooCommerce Stripeの公式プラグインもアクティブです。"

msgid "The site is not on HTTPS; banks do not send the card result to the return address and the card form is not secure."
msgstr "銀行はカード結果をリターンアドレスに送信せず、カードフォームは安全ではありません。"

msgid "Key encryption"
msgstr "キーの暗号化"

msgid "PHP sodium or openssl is missing; POS keys cannot be encrypted."
msgstr "PHP sodium または openssl が欠落しています。POS キーは暗号化できません。"

msgid "Keys are encrypted with the WordPress salts. If the wp-config.php salts change, enter the POS keys again."
msgstr "キーは暗号化されます。 WordPress salts.wp-config.php の塩が変わったら、POS キーを再度入力します。"

msgid "The check could not run: %s"
msgstr "チェックは実行できませんでした。 %s"
