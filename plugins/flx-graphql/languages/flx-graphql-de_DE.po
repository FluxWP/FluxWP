msgstr "Regelmäßiger Preis einer Einheit (vor dem Verkauf)."

msgid "Line total before coupons."
msgstr "Linie insgesamt vor Coupons."

msgid "Line total after coupons, without tax."
msgstr "Linie insgesamt nach Coupons, ohne Steuern."

msgid "Tax of the line."
msgstr "Steuer auf die Linie."

msgid "Chosen variation attributes."
msgstr "Wählen Sie Variable Attribute."

msgid "Line details other plugins add (e.g. a donation's names and certificate)."
msgstr "Zeilendetails andere Plugins hinzufügen (z.B. Namen und Zertifikat einer Spende)."

msgid "A coupon applied to the cart."
msgstr "Ein Gutschein, der auf den Warenkorb gelegt wird."

msgid "Coupon code."
msgstr "Gutscheincode."

msgid "WooCommerce discount type (percent, fixed_cart …)."
msgstr "WooCommerce Rabatt-Typ (prozentig, fix_cart ...)."

msgid "Discount without tax."
msgstr "Rabatt ohne Steuern."

msgid "Tax part of the discount."
msgstr "Steuerteil des Rabatts."

msgid "A fee added to the cart (e.g. a payment fee)."
msgstr "Eine in den Warenkorb gelegte Gebühr (z.B. Zahlung)."

msgid "Fee key."
msgstr "Fee Schlüssel."

msgid "Fee without tax."
msgstr "Gebühren ohne Steuern."

msgid "Tax of the fee."
msgstr "Steuer auf die Gebühr."

msgid "One tax rate in the cart totals."
msgstr "Ein Steuersatz im Warenkorb insgesamt."

msgid "Tax name."
msgstr "Steuername."

msgid "Rate as WooCommerce shows it."
msgstr "Rate wie WooCommerce zeigt es."

msgid "Amount."
msgstr "Betrag."

msgid "Cart totals, as WooCommerce calculated them."
msgstr "Die Wagensummen, wie WooCommerce sie berechnet."

msgid "ISO 4217 currency of the cart."
msgstr "ISO 4217 Währung des Warenkorbs."

msgid "Lines before coupons, without tax."
msgstr "Linien vor Coupons, ohne Steuern."

msgid "Tax of the lines."
msgstr "Steuer der Leitungen."

msgid "Fees without tax."
msgstr "Gebühren ohne Steuern."

msgid "Coupon discounts without tax."
msgstr "Gutschein-Rabatte ohne Steuern."

msgid "Shipping without tax; null until shipping is calculated."
msgstr "Versand ohne Steuer; Null bis Versand berechnet wird."

msgid "All taxes."
msgstr "Alle Steuern."

msgid "Amount to pay."
msgstr "Betrag zu zahlen."

msgid "Taxes by rate."
msgstr "Steuersätze."

msgid "A shipping option."
msgstr "Eine Versandoption."

msgid "Rate ID for flxCartShippingRateSelect."
msgstr "Rate ID für flxCartShippingRateSelect."

msgid "Shipping method (flat_rate, free_shipping …)."
msgstr "Versandmethode (flat_rate, free_shipping ...)."

msgid "Name."
msgstr "Name."

msgid "Description; may be empty."
msgstr "Beschreibung; kann leer sein."

msgid "Delivery time; may be empty."
msgstr "Lieferzeit; kann leer sein."

msgid "Price without tax."
msgstr "Preis ohne Steuern."

msgid "Whether this option is chosen."
msgstr "Ob diese Option gewählt wird."

msgid "A group of lines shipped together and its shipping options."
msgstr "Eine Gruppe von Linien, die zusammen und seine Versandoptionen ausgeliefert werden."

msgid "Package ID."
msgstr "Paket-ID."

msgid "Package name."
msgstr "Paketname."

msgid "Shipping options."
msgstr "Versandoptionen."

msgid "E-mail; null on the shipping address."
msgstr "E-Mail; null auf der Versandadresse."

msgid "A billing or shipping address of the cart."
msgstr "Eine Abrechnungs- oder Versandadresse des Warenkorbs."

msgid "A problem with the cart the shopper has to fix before paying (e.g. a product went out of stock)."
msgstr "Ein Problem mit dem Warenkorb muss der Käufer vor der Bezahlung beheben (z.B. ein Produkt ausverkauft)."

msgid "WooCommerce error code."
msgstr "WooCommerce Fehlercode."

msgid "Message in the shopper's language."
msgstr "Nachricht in der Sprache des Käufers."

