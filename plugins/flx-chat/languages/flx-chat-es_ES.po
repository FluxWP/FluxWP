msgstr "QR, estados y cuentas: Comunicación › Conexiones"

msgid "Set up webhook"
msgstr "Configurar webhook"

msgid "Import recent chats"
msgstr "Importar chats recientes"

msgid "The webhook URL and test buttons appear after saving."
msgstr "La URL del webhook y los botones de prueba aparecen después de guardar."

msgid "Appearance"
msgstr "Apariencia"

msgid "Panel title"
msgstr "Título del panel"

msgid "Site name if empty. The {brand} variable uses this too."
msgstr "Nombre del sitio si está vacío. La variable{brand}también usa esto."

msgid "Accent color"
msgstr "Color de acento"

msgid "Behavior"
msgstr "Comportamiento"

msgid "Send read receipts (blue ticks) when a chat is opened"
msgstr "Enviar recibos de lectura (marcas azules) cuando se abre un chat"

msgid "Prefix messages with the agent's name (*Name:*)"
msgstr "Mensajes con prefijo con el nombre del agente (*Nombre:*)"

msgid "Agents see only chats assigned to them and unassigned chats (admins see all)"
msgstr "Los agentes ven solo los chats que tienen asignados y los chats no asignados (los administradores ven todos)"

msgid "Also show WhatsApp group messages"
msgstr "Mostrar también mensajes grupales de WhatsApp"

msgid "New interface (experimental): the Chats page opens with the same screen as the desktop and mobile app"
msgstr "Nueva interfaz (experimental): la página de Chats se abre con la misma pantalla que la aplicación de escritorio y móvil"

msgid "Live update interval (sec)"
msgstr "Intervalo de actualización en vivo (seg.)"

msgid "Agents"
msgstr "Agentes"

msgid "Give a user the %s role; they see only the chat screen and cannot open settings. Administrators always have access."
msgstr "Asigne a un usuario el rol%s; solo ven la pantalla de chat y no pueden abrir la configuración. Los administradores siempre tienen acceso."

msgid "Add new user"
msgstr "Agregar nuevo usuario"

msgid "Data"
msgstr "Datos"

msgid "Also delete all chats, messages and media files when the plugin is deleted"
msgstr "También elimine todos los chats, mensajes y archivos multimedia cuando se elimine el complemento."

msgid "Media files are kept in wp-content/uploads/flx-chat, closed to outside access. They move with uploads when the site is migrated."
msgstr "Los archivos multimedia se guardan en wp-content/uploads/flx-chat, cerrados al acceso externo. Se mueven con las cargas cuando se migra el sitio."

