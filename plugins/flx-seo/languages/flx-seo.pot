msgid "Ana sayfa başarılı durum kodu döndürmüyor"
msgstr ""

msgid "Sayfa 200 dönmeli. Bakım modu, yönlendirme döngüsü ya da PHP hatası olabilir; Sistem Kontrolü ve hata günlüğüne bakın."
msgstr ""

msgid "Sayfa arama motorlarına kapalı"
msgstr ""

msgid "Ayarlar › Okuma › \"Arama motorlarının siteyi dizine eklemesini engelle\" kutusunu kaldırın; sayfanın kendi SEO panelindeki noindex işaretini kapatın."
msgstr ""

msgid "robots.txt tüm siteyi engelliyor"
msgstr ""

msgid "Kökteki robots.txt dosyasında \"User-agent: *\" altında \"Disallow: /\" olmamalı. Dosyayı silin ya da düzeltin; WordPress kendi robots.txt'sini üretir."
msgstr ""

msgid "Sayfa başlığı (<title>) yok"
msgstr ""

msgid "Tema add_theme_support( 'title-tag' ) desteklemeli; SEO & MCP › Genel'de ana sayfa başlığını doldurun."
msgstr ""

msgid "Sayfa başlığı uzun"
msgstr ""

msgid "Başlığı 60 karakter civarında tutun; Google sonrasını keser."
msgstr ""

msgid "Meta açıklama yok"
msgstr ""

msgid "SEO çıktısını açın ve ana sayfa açıklamasını (150–160 karakter) yazın."
msgstr ""

msgid "Canonical bağlantısı eksik ya da birden fazla"
msgstr ""

msgid "Her sayfada tek bir rel=canonical olmalı. Başka bir eklenti ya da tema da ekliyorsa birini kapatın."
msgstr ""

msgid "Çok dilli sitede hreflang yok"
msgstr ""

msgid "Flux Lang etkinse dil sürümleri hreflang ile bağlanmalı; Flux Lang ayarlarında dil eşleştirmelerini kontrol edin."
msgstr ""

msgid "Ana başlık (H1) yok ya da birden fazla"
msgstr ""

msgid "Her sayfada konuyu anlatan tek bir H1 olsun; ara başlıklar H2/H3."
msgstr ""

msgid "Yapılandırılmış veri (JSON-LD) yok ya da bozuk"
msgstr ""

msgid "Flux SEO çıktısı açıkken Organization, WebSite ve Breadcrumb schema eklenir. Bozuk JSON-LD üreten blok ya da eklentiyi bulun."
msgstr ""

msgid "Bağlantı metinleri açıklayıcı değil"
msgstr ""

msgid "\"Tıklayın\", \"devamı\", \"buraya\" yerine hedefi anlatan metin yazın (ör. \"Bağış seçeneklerini görün\")."
msgstr ""

msgid "Aynı başlıkta birden fazla yayın var"
msgstr ""

msgid "Kopya sayfayı (çoğunlukla adresi -2 ile biten) silin ya da asıl sayfaya yönlendirin; gerekiyorsa başlıkları ayırın. Aynı metinli bağlantılar farklı adreslere gidince \"Aynı bağlantılar aynı amaca sahip\" denetimi de düşer."
msgstr ""

msgid "WordPress sürümü sayfada görünüyor"
msgstr ""

msgid "meta generator etiketi sürümü ele verir. Tema remove_action( 'wp_head', 'wp_generator' ) yapmalı; Flux SEO güvenlik başlıkları açıkken kaldırılır."
msgstr ""

msgid "Yakınlaştırma engellenmiş (user-scalable=no / maximum-scale)"
msgstr ""

msgid "Viewport etiketinden user-scalable=no ve maximum-scale=1 kaldırın: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">. Az gören kullanıcılar sayfayı büyütemiyor; Erişilebilirlik puanı doğrudan düşer."
msgstr ""

msgid "Viewport etiketi yok"
msgstr ""

msgid "Tema <head> içine <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"> eklemeli; yoksa mobilde sayfa masaüstü genişliğinde açılır."
msgstr ""

msgid "ARIA rolü gerekli alt öğeleri içermiyor"
msgstr ""

msgid "Ör. role=\"tablist\" yalnız role=\"tab\" öğeleri içermeli. <ol role=\"tablist\"><li><button role=\"tab\"> yerine <div role=\"tablist\"><button role=\"tab\"> kullanın ya da li öğelerine role=\"presentation\" verin. Erişilebilirlik ağacı bozulur; Lighthouse \"Ajan uyumu\" puanını da düşürür."
msgstr ""

msgid "ARIA rolü gerekli üst öğenin içinde değil"
msgstr ""

msgid "role=\"tab\" doğrudan role=\"tablist\" içinde, role=\"option\" role=\"listbox\" içinde olmalı. Aradaki li/div öğelerini kaldırın ya da role=\"presentation\" verin."
msgstr ""

msgid "Liste öğeleri (<li>) liste içinde değil"
msgstr ""

msgid "<li> yalnız <ul>, <ol> ya da <menu> içinde olmalı ve üst listeye liste dışı bir role verilmemeli (ör. <ol role=\"tablist\">)."
msgstr ""

msgid "Görsellerde alt metin yok"
msgstr ""

msgid "Her anlamlı görsele içeriği anlatan alt metin yazın; süs görselleri alt=\"\" alsın. Medya kütüphanesinde alt metni doldurun ya da SEO & MCP › Genel › Görseller seçeneğini açın."
msgstr ""

msgid "Adı olmayan bağlantılar var"
msgstr ""

msgid "Yalnız simge içeren bağlantılara aria-label ya da görünmez metin (screen-reader-text) ekleyin."
msgstr ""

msgid "Adı olmayan düğmeler var"
msgstr ""

msgid "Simge düğmelerine aria-label verin (ör. \"Menüyü aç\"). Ajanlar ve ekran okuyucular düğmenin ne yaptığını bilemez."
msgstr ""

msgid "Etiketi olmayan form alanları var"
msgstr ""

msgid "Her alanın <label for> ya da aria-label ile bir adı olmalı; placeholder etiket yerine geçmez."
msgstr ""

msgid "<html> etiketinde dil (lang) yok"
msgstr ""

msgid "Tema <html <?php language_attributes(); ?>> kullanmalı."
msgstr ""

msgid "Yinelenen ya da bulunmayan id başvuruları"
msgstr ""

msgid "Aynı id iki öğede olmamalı; aria-controls, aria-labelledby ve label for var olan bir id'yi göstermeli."
msgstr ""

msgid "Başlık sırası atlıyor"
msgstr ""

msgid "Başlıklar sırayla inmeli (H2 → H3); görünüm için seviye atlamayın, CSS ile boyutlandırın."
msgstr ""

msgid "tabindex değeri 0'dan büyük"
msgstr ""

msgid "tabindex=\"1\" gibi değerler klavye sırasını bozar; 0 ya da -1 kullanın."
msgstr ""

msgid "Aynı metinli bağlantılar farklı adreslere gidiyor"
msgstr ""

msgid "Aynı adı taşıyan bağlantılar aynı sayfaya gitmeli. Kopya sayfayı kaldırın ya da bağlantı metinlerini ayırın."
msgstr ""

msgid "Başlıksız iframe"
msgstr ""

msgid "Her <iframe> title almalı (ör. \"Konum haritası\")."
msgstr ""

msgid "Sayfada <main> bölgesi yok"
msgstr ""

msgid "Ana içerik <main> içinde olmalı; ekran okuyucu ve ajanlar ana içeriği böyle bulur."
msgstr ""

msgid "Metin/zemin karşıtlığı yetersiz"
msgstr ""

msgid "Normal metin için en az 4.5:1, büyük metin için 3:1 karşıtlık. Tema paletindeki soluk renkleri koyulaştırın."
msgstr ""

msgid "Oluşturmayı engelleyen istekler"
msgstr ""

msgid "İlk ekran için gereken kritik CSS'i satır içine alın, gerisini media=\"print\" onload ile ya da sayfa sonunda yükleyin; JS'e defer verin. LiteSpeed Cache › Page Optimization › CSS/JS ayarları ya da temanın kendi birleştirilmiş CSS'i."
msgstr ""

msgid "Kullanılmayan CSS"
msgstr ""

msgid "Tek büyük CSS dosyasını sayfa türüne göre bölün ya da kullanılmayan kuralları ayıklayın (LiteSpeed \"Remove Unused CSS\"). Kazanç çoğunlukla LCP'ye yansır."
msgstr ""

msgid "Sıkıştırılmamış (minify edilmemiş) JavaScript"
msgstr ""

msgid "Tema/eklenti JS dosyalarının .min sürümünü yayınlayın ya da LiteSpeed \"JS Minify\"ı açın."
msgstr ""

msgid "Sıkıştırılmamış CSS"
msgstr ""

msgid "CSS'i minify edin (LiteSpeed \"CSS Minify\" ya da derleme adımı)."
msgstr ""

msgid "GPU'da çalışmayan animasyonlar"
msgstr ""

msgid "Animasyonları transform ve opacity ile yapın; stroke-dashoffset, top/left, width gibi özellikler her karede yeniden çizim yapar. prefers-reduced-motion'da durdurun."
msgstr ""

msgid "DOM çok büyük"
msgstr ""

msgid "1.500 öğenin altını hedefleyin. Kayan şeritlerdeki (marquee) kopyaları azaltın, gizli menüleri ve uzun listeleri ihtiyaç olunca oluşturun, iç içe sarmalayıcıları sadeleştirin."
msgstr ""

msgid "En büyük içerik (LCP) geç çiziliyor"
msgstr ""

msgid "LCP öğesi metinse yazı tipini preload edip font-display: swap kullanın ve giriş animasyonunu ilk karede göstermeyin; görselse fetchpriority=\"high\" verin, lazy load etmeyin."
msgstr ""

msgid "Yerleşim kayması (CLS) kaynakları"
msgstr ""

msgid "Görsellere width/height, sonradan gelen bloklara sabit yükseklik verin; web fontları için size-adjust/fallback metrikleri kullanın; absolute konumlu animasyonlu katmanlar yerleşimi itmesin."
msgstr ""

msgid "Yazı tipleri metni geciktiriyor"
msgstr ""

msgid "@font-face içinde font-display: swap kullanın, ilk ekranda kullanılan 1-2 yazı tipini <link rel=\"preload\" as=\"font\" crossorigin> ile önden yükleyin, kullanılmayan ağırlıkları kaldırın."
msgstr ""

msgid "Kritik istek zinciri uzun"
msgstr ""

msgid "CSS içinden yüklenen fontlar zinciri uzatır; ilk ekran fontlarını preload edin, zincirdeki gereksiz istekleri (ör. guest.vary.php) ertelenmiş yükleyin."
msgstr ""

msgid "Zorunlu yeniden yerleşim (forced reflow)"
msgstr ""

msgid "JS'te stil değiştirdikten sonra offsetWidth/getBoundingClientRect okumayın; okumaları önce, yazmaları sonra requestAnimationFrame içinde yapın."
msgstr ""

msgid "Uzun ana iş parçacığı görevleri"
msgstr ""

msgid "Açılışta çalışan JS'i bölün, görünür olmayan bölümlerin işini IntersectionObserver ile erteleyin."
msgstr ""

msgid "Görseller büyük ya da eski biçimde"
msgstr ""

msgid "WebP/AVIF kullanın, görünen boyuttan büyük görsel göndermeyin (srcset), görsel sıkıştırmayı açın."
msgstr ""

msgid "Genişlik/yükseklik vermeyen görseller"
msgstr ""

msgid "<img> etiketlerine width ve height verin; tarayıcı yer ayırır, sayfa kaymaz."
msgstr ""

msgid "İlk ekrandaki görsel lazy yükleniyor"
msgstr ""

msgid "Sayfanın ilk görseline loading=\"lazy\" vermeyin, fetchpriority=\"high\" verin. LiteSpeed lazy load açıksa ilk görseli hariç tutun (data-no-lazy ya da \"Lazy Load Image Excludes\")."
msgstr ""

msgid "Sunucu yanıtı yavaş"
msgstr ""

msgid "Sayfa önbelleğini (LiteSpeed Cache) açın; Flux Speed › yavaş eklentiler ve cron raporuna bakın."
msgstr ""

msgid "Metin sıkıştırma (gzip/brotli) yok"
msgstr ""

msgid "Sunucuda gzip ya da brotli açın (Hostinger/LiteSpeed'de varsayılan açıktır; CDN ayarını kontrol edin)."
msgstr ""

msgid "HTML belgesi büyük"
msgstr ""

msgid "Satır içi SVG ikonları sprite'a, büyük satır içi CSS/JSON'u dosyaya taşıyın."
msgstr ""

msgid "WordPress emoji betiği yükleniyor"
msgstr ""

msgid "Modern tarayıcılar emojiyi kendisi çizer; tema print_emoji_detection_script'i kaldırabilir."
msgstr ""

msgid "Largest Contentful Paint (LCP) yavaş"
msgstr ""

msgid "Hedef 2,5 sn altı. Engelleyen CSS'i azaltın, LCP yazı tipini/görselini önden yükleyin, sunucu önbelleğini açın."
msgstr ""

msgid "Cumulative Layout Shift (CLS) yüksek"
msgstr ""

msgid "Hedef 0,1 altı. Görsellere boyut verin, fontların kaymasını önleyin, sonradan eklenen öğelere yer ayırın."
msgstr ""

msgid "Total Blocking Time (TBT) yüksek"
msgstr ""

msgid "Hedef 200 ms altı. Açılış JS'ini azaltın, üçüncü taraf betikleri erteleyin."
msgstr ""

msgid "First Contentful Paint (FCP) yavaş"
msgstr ""

msgid "Hedef 1,8 sn altı. Engelleyen CSS/JS ve sunucu yanıt süresini azaltın."
msgstr ""

msgid "Speed Index yavaş"
msgstr ""

msgid "İlk ekranın hızlı dolması için kritik CSS ve yazı tiplerini önceliklendirin, giriş animasyonlarını kısaltın."
msgstr ""

msgid "Site HTTPS değil ya da karışık içerik var"
msgstr ""

msgid "Ayarlar › Genel'de adresleri https:// yapın, http:// ile yüklenen görsel/betikleri düzeltin."
msgstr ""

msgid "HSTS politikası zayıf"
msgstr ""

msgid "Strict-Transport-Security: max-age=31536000; includeSubDomains. Tüm alt alan adları HTTPS ise \"preload\" da ekleyip hstspreload.org'a başvurabilirsiniz."
msgstr ""

msgid "İçerik Güvenlik Politikası (CSP) yok ya da eksik"
msgstr ""

msgid "Flux SEO temel CSP'yi (object-src 'none'; base-uri 'self'; frame-ancestors 'self') ekleyebilir. Tam script-src politikası WordPress'te eklentileri bozabilir; önce Content-Security-Policy-Report-Only ile deneyin."
msgstr ""

msgid "Tıklama korsanlığına (clickjacking) karşı koruma yok"
msgstr ""

msgid "X-Frame-Options: SAMEORIGIN ve CSP frame-ancestors 'self' gönderin. Siteniz başka sitelerde iframe ile gösteriliyorsa açmayın."
msgstr ""

msgid "Pencere yalıtımı (COOP) yok"
msgstr ""

msgid "Cross-Origin-Opener-Policy: same-origin-allow-popups gönderin; ödeme ve giriş açılır pencereleri çalışmaya devam eder."
msgstr ""

msgid "Trusted Types tanımlı değil"
msgstr ""

msgid "DOM tabanlı XSS'e karşı ileri seviye koruma. WordPress eklentilerinin çoğu henüz uyumlu değil; yalnız özel temalı, az eklentili sitelerde Report-Only ile deneyin."
msgstr ""

msgid "X-Content-Type-Options başlığı yok"
msgstr ""

msgid "X-Content-Type-Options: nosniff. Flux SEO bunu kendiliğinden gönderir; sunucu ya da önbellek eklentisi siliyor olabilir."
msgstr ""

msgid "HTML doctype ya da charset eksik"
msgstr ""

msgid "Sayfa <!DOCTYPE html> ile başlamalı ve <meta charset=\"UTF-8\"> ilk satırlarda olmalı."
msgstr ""

msgid "llms.txt yok"
msgstr ""

msgid "Yapay zekâ ajanları siteyi /llms.txt ile özetler. Flux SEO site adı, açıklama, menü sayfaları ve son içeriklerden kendiliğinden üretir; açmak için tek tık."
msgstr ""

msgid "llms.txt önerilen biçimde değil"
msgstr ""

msgid "İlk satır \"# Site adı\", ardından \"> kısa özet\" ve [başlık](adres) biçiminde bağlantı listeleri olmalı. Kökte elle konmuş eski bir dosya varsa silin; Flux SEO üretir."
msgstr ""

msgid "Formlar WebMCP aracı olarak tanımlı değil"
msgstr ""

msgid "WebMCP, tarayıcıdaki ajanların formları araç olarak çağırmasını sağlar (form toolname/tooldescription). Flux SEO arama formuna kendiliğinden ekler; kendi formlarınıza da ekleyin."
msgstr ""

msgid "robots.txt yapay zekâ tarayıcılarını engelliyor"
msgstr ""

msgid "GPTBot, ClaudeBot, Google-Extended, PerplexityBot gibi tarayıcılar engelliyse içeriğiniz yapay zekâ yanıtlarında görünmez. Bilerek engellemediyseniz robots.txt'den kaldırın."
msgstr ""

