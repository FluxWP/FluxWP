msgstr "لقد انقضت فترة الدفع، يرجى إدخال تفاصيل البطاقة مرة أخرى."

msgid "The result will come with the PayTR notification."
msgstr "وستأتي النتيجة مع إخطار سجل المعاملات الدولي."

msgid "%s did not respond."
msgstr "%s لم يرد."

msgid "The bank did not complete the 3D check."
msgstr "البنك لم يكمل الشيك 3D"

msgid "The result will come with the Shopier notification."
msgstr "النتيجة ستتأتى مع إخطار (شوبير)"

msgid "Stripe keys are missing: a publishable key and a secret key are required."
msgstr "مفاتيح التعري مفقودة: مفتاح قابل للنشر ومفتاح سري مطلوب."

msgid "One Stripe key is test and the other is live. Both must be in the same mode."
msgstr "مفتاح وحيد هو اختبار والآخر على الهواء يجب أن يكون كلاهما بنفس الطريقة"

msgid "The account is in test mode but the Stripe keys are live. Enter test keys (sk_test_… / pk_test_…) or turn test mode off."
msgstr "الحساب في حالة الإختبار لكن مفاتيح (تري) على الهواء، مفاتيح اختبار الدخول (إختبار)"

msgid "The account is live but the Stripe keys are test keys. Enter live keys or turn test mode on."
msgstr "الحساب على الهواء لكن مفاتيح (روي) هي مفاتيح الاختبار أدخل المفاتيح الحية أو طريقة الاختبار"

msgid "The card number is not valid."
msgstr "رقم البطاقة غير صحيح"

msgid "The card number is incorrect."
msgstr "رقم البطاقة غير صحيح"

msgid "The card number is incomplete."
msgstr "رقم البطاقة غير مكتمل"

msgid "The expiry month is invalid."
msgstr "شهر الإنهاء غير صحيح"

msgid "The expiry year is invalid."
msgstr "سنة الإنهاء باطلة"

msgid "The expiry year is in the past."
msgstr "سنة الإنهاء في الماضي"

msgid "The expiry date is incomplete."
msgstr "تاريخ الإنهاء غير مكتمل"

msgid "The card has expired."
msgstr "البطاقة انتهت"

msgid "The security code is invalid."
msgstr "قانون الأمن غير صحيح"

msgid "The security code is incorrect."
msgstr "الرمز الأمني غير صحيح"

msgid "The security code is incomplete."
msgstr "الرمز الأمني غير مكتمل"

msgid "The postal code failed validation."
msgstr "تعذّر التحقق من الرمز البريدي."

msgid "Invalid postal code; please correct it and try again."
msgstr "رمز بريدي غير قابل للانفصال؛ يرجى تصحيحه ومحاولة مرة أخرى."

msgid "The card was declined."
msgstr "لقد تم رفض البطاقة"

msgid "The card has insufficient funds or limit."
msgstr "البطاقة ليس لديها أموال أو حدود كافية."

msgid "The card issuer did not approve the payment."
msgstr "لم يوافق مُصدر البطاقات على الدفع."

msgid "The card's transaction limit was exceeded."
msgstr "لقد تم تجاوز الحد الأقصى لصفقات البطاقة"

msgid "An error occurred while processing the card; please try again."
msgstr "وقع خطأ أثناء تجهيز البطاقة، حاول مرة أخرى."

msgid "The email address is invalid."
msgstr "العنوان البريدي غير صحيح"

msgid "The payment could not be processed; try again or use another method."
msgstr "ولا يمكن تجهيز المبلغ؛ أو محاولة استخدام طريقة أخرى."

msgid "The payment is processing at Stripe."
msgstr "الدفع هو تجهيز في (روي)."

msgid "Waiting for payment authentication."
msgstr "في انتظار التوثيق بالدفع"

msgid "The payment was canceled."
msgstr "تم إلغاء الدفع"

msgid "This provider sends no notifications."
msgstr "ولا يرسل هذا المزود أي إخطارات."

msgid "This provider has no refunds from the site; make them in the provider's panel."
msgstr "هذا المزود ليس لديه اي رد من الموقع اجعلهم في لوحة المزود"

msgid "This provider has no voids from the site."
msgstr "هذا المزود ليس لديه فراغات من الموقع"

msgid "This provider has no status query."
msgstr "هذا المزود ليس لديه أي استفسار عن الوضع"

msgid "Error code %s"
msgstr "الرمز %s"

msgid "The payment was not approved."
msgstr "ولم تتم الموافقة على الدفع."

msgid "%1$s did not respond (HTTP %2$d)."
msgstr "%1$s لم يرد (HTTP %2$d)."

msgid "Redirect: the bank or provider page opens full screen"
msgstr "إعادة التوجيه: يفتح المصرف أو صفحة مقدمي الخدمات شاشات كاملة"

msgid "Popup: in a frame, without leaving checkout"
msgstr "في إطار، بدون مغادرة"

msgid "On site: in a frame, with the site's header and footer"
msgstr "على الموقع: في إطار، مع رأس الموقع وقدمه"

msgid "This provider has no connection test; try a small payment with a test card."
msgstr "هذا المزود ليس لديه اختبار اتصال؛ جرب دفعة صغيرة ببطاقة اختبار."

msgid "Connection works, the keys were accepted."
msgstr "أعمال الإتصال، تم قبول المفاتيح."

msgid "Automatic"
msgstr "تلقائي"

msgid "Show all"
msgstr "إظهار الكل"

msgid "WooCommerce is not active."
msgstr "WooCommerce غير نشط."

msgid "Add a POS account before turning on the Pay by card method."
msgstr "أضف حساباً من نوع POS قبل تحويل الأجر عن طريق البطاقة."

msgid "Refund from the panel"
msgstr "المبالغ المردودة من الفريق"

msgid "No active POS account; card payments are not taken."
msgstr "لا يوجد حساب تشغيلي للبرمجيات الحرة والمفتوحة المصدر؛ ولا تؤخذ مدفوعات البطاقات."

msgid "An account is in test mode, no real money is charged: %s"
msgstr "الحساب في حالة الإختبار، لا يوجد مال حقيقي محمل: %s"

msgid "%d account is active in live mode."
msgid_plural "%d accounts are active in live mode."
msgstr[0] "%d حسابات نشطة في حالة حية."
msgstr[1] "%d الحساب نشط في حالة الحياة."
msgstr[2] "%d حسابات نشطة في حالة حية."
msgstr[3] "%d حسابات نشطة في حالة حية."
msgstr[4] "%d حسابات نشطة في حالة حية."
msgstr[5] "%d حسابات نشطة في حالة حية."

msgid "%s: no webhook signing secret. The payment return is still read, but if the payer closes the page before returning the order stays pending. Add the notification URL in the Stripe Dashboard and enter the whsec_… secret."
msgstr "%s: لا يوجد سر للتوقيع على موقع الويب، ولا تزال عملية إعادة الدفع تُقرأ، ولكن إذا كان المدفع يغلق الصفحة قبل إعادة الأمر يبقى معلقاً."

msgid "The official WooCommerce Stripe plugin is also active. Pick a single card method in Flux POS › Methods so payers do not see two card options."
msgstr "المسؤول WooCommerce وثبات البلوجين المتعري نشط أيضاً، واختيار طريقة واحدة للبطاقة في أساليب الـ (فلوكس بي أو) حتى لا يرى المدفوعون خيارين للبطاقات."

msgid "The site is not on HTTPS; banks do not send the card result to the return address and the card form is not secure."
msgstr "والموقع ليس على موقع شركة HTTPS؛ ولا ترسل المصارف نتيجة البطاقة إلى عنوان العودة، ولا تكون استمارة البطاقة آمنة."

msgid "Key encryption"
msgstr "تشفير المفاتيح"

msgid "PHP sodium or openssl is missing; POS keys cannot be encrypted."
msgstr "PHP صوديوم أو فتحات مفقودة؛ ولا يمكن تشفير مفاتيح POS."

msgid "Keys are encrypted with the WordPress salts. If the wp-config.php salts change, enter the POS keys again."
msgstr "المفاتيح مشفرة بملح WordPress، إذا تغيرت أملاح الـ \"ديب سيكغ\"."

msgid "The check could not run: %s"
msgstr "لم يكن الشيك قادراً على الركض: %s"
