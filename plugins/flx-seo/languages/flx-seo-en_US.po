msgstr "The theme must declare add_theme_support( 'title-tag' ); fill in the home title in SEO › General."

msgid "Page title is long"
msgstr "Page title is long"

msgid "Keep the title around 60 characters; Google cuts the rest."
msgstr "Keep the title around 60 characters; Google cuts the rest."

msgid "No meta description"
msgstr "No meta description"

msgid "Turn on SEO output and write the home description (150–160 characters)."
msgstr "Turn on SEO output and write the home description (150–160 characters)."

msgid "Canonical link missing or duplicated"
msgstr "Canonical link missing or duplicated"

msgid "Each page needs exactly one rel=canonical. If another plugin or the theme also adds one, turn one off."
msgstr "Each page needs exactly one rel=canonical. If another plugin or the theme also adds one, turn one off."

msgid "No hreflang on a multilingual site"
msgstr "No hreflang on a multilingual site"

msgid "With Flux Lang active, language versions must be linked with hreflang; check the language pairs in Flux Lang settings."
msgstr "With Flux Lang active, language versions must be linked with hreflang; check the language pairs in Flux Lang settings."

msgid "Main heading (H1) missing or repeated"
msgstr "Main heading (H1) missing or repeated"

msgid "Each page needs one H1 that names the topic; subheadings are H2/H3."
msgstr "Each page needs one H1 that names the topic; subheadings are H2/H3."

msgid "Structured data (JSON-LD) missing or broken"
msgstr "Structured data (JSON-LD) missing or broken"

msgid "With Flux SEO output on, Organization, WebSite and Breadcrumb schema are added. Find the block or plugin that outputs broken JSON-LD."
msgstr "With Flux SEO output on, Organization, WebSite and Breadcrumb schema are added. Find the block or plugin that outputs broken JSON-LD."

msgid "Link texts are not descriptive"
msgstr "Link texts are not descriptive"

msgid "Write text that names the target instead of \"click here\", \"more\", \"here\" (e.g. \"See donation options\")."
msgstr "Write text that names the target instead of \"click here\", \"more\", \"here\" (e.g. \"See donation options\")."

msgid "More than one post with the same title"
msgstr "More than one post with the same title"

msgid "Delete the duplicate (usually the address ending in -2) or redirect it to the original; give different titles if both are needed. When links with the same text go to different addresses, the \"Identical links have the same purpose\" audit also fails."
msgstr "Delete the duplicate (usually the address ending in -2) or redirect it to the original; give different titles if both are needed. When links with the same text go to different addresses, the \"Identical links have the same purpose\" audit also fails."

msgid "WordPress version is visible on the page"
msgstr "WordPress version is visible on the page"

msgid "The meta generator tag reveals the version. The theme should call remove_action( 'wp_head', 'wp_generator' ); Flux SEO removes it when security headers are on."
msgstr "The meta generator tag reveals the version. The theme should call remove_action( 'wp_head', 'wp_generator' ); Flux SEO removes it when security headers are on."

msgid "Zoom is blocked (user-scalable=no / maximum-scale)"
msgstr "Zoom is blocked (user-scalable=no / maximum-scale)"

msgid "Remove user-scalable=no and maximum-scale=1 from the viewport tag: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">. Users with low vision cannot zoom; the Accessibility score drops directly."
msgstr "Remove user-scalable=no and maximum-scale=1 from the viewport tag: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">. Users with low vision cannot zoom; the Accessibility score drops directly."

msgid "No viewport tag"
msgstr "No viewport tag"

msgid "The theme must add <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"> to <head>; otherwise the page opens at desktop width on mobile."
msgstr "The theme must add <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"> to <head>; otherwise the page opens at desktop width on mobile."

msgid "ARIA role is missing required children"
msgstr "ARIA role is missing required children"

msgid "E.g. role=\"tablist\" may only contain role=\"tab\" elements. Use <div role=\"tablist\"><button role=\"tab\"> instead of <ol role=\"tablist\"><li><button role=\"tab\">, or give the li elements role=\"presentation\". The accessibility tree breaks and Lighthouse also lowers the Agentic Browsing score."
msgstr "E.g. role=\"tablist\" may only contain role=\"tab\" elements. Use <div role=\"tablist\"><button role=\"tab\"> instead of <ol role=\"tablist\"><li><button role=\"tab\">, or give the li elements role=\"presentation\". The accessibility tree breaks and Lighthouse also lowers the Agentic Browsing score."

msgid "ARIA role is not inside its required parent"
msgstr "ARIA role is not inside its required parent"

msgid "role=\"tab\" must sit directly inside role=\"tablist\", role=\"option\" inside role=\"listbox\". Remove the li/div elements in between or give them role=\"presentation\"."
msgstr "role=\"tab\" must sit directly inside role=\"tablist\", role=\"option\" inside role=\"listbox\". Remove the li/div elements in between or give them role=\"presentation\"."

msgid "List items (<li>) are not inside a list"
msgstr "List items (<li>) are not inside a list"

msgid "<li> may only sit inside <ul>, <ol> or <menu>, and the parent list must not get a non-list role (e.g. <ol role=\"tablist\">)."
msgstr "<li> may only sit inside <ul>, <ol> or <menu>, and the parent list must not get a non-list role (e.g. <ol role=\"tablist\">)."

msgid "Images without alt text"
msgstr "Images without alt text"

msgid "Give every meaningful image alt text that describes it; decorative images get alt=\"\". Fill in alt text in the media library or turn on SEO › General › Images."
msgstr "Give every meaningful image alt text that describes it; decorative images get alt=\"\". Fill in alt text in the media library or turn on SEO › General › Images."

msgid "Links without a name"
msgstr "Links without a name"

msgid "Add aria-label or hidden text (screen-reader-text) to icon-only links."
msgstr "Add aria-label or hidden text (screen-reader-text) to icon-only links."

msgid "Buttons without a name"
msgstr "Buttons without a name"

msgid "Give icon buttons an aria-label (e.g. \"Open menu\"). Agents and screen readers cannot tell what the button does."
msgstr "Give icon buttons an aria-label (e.g. \"Open menu\"). Agents and screen readers cannot tell what the button does."

msgid "Form fields without a label"
msgstr "Form fields without a label"

msgid "Each field needs a name through <label for> or aria-label; a placeholder is not a label."
msgstr "Each field needs a name through <label for> or aria-label; a placeholder is not a label."

msgid "<html> has no lang attribute"
msgstr "<html> has no lang attribute"

msgid "The theme should use <html <?php language_attributes(); ?>>."
msgstr "The theme should use <html <?php language_attributes(); ?>>."

msgid "Duplicate or missing id references"
msgstr "Duplicate or missing id references"

msgid "No id may be used twice; aria-controls, aria-labelledby and label for must point to an existing id."
msgstr "No id may be used twice; aria-controls, aria-labelledby and label for must point to an existing id."

msgid "Heading levels skip"
msgstr "Heading levels skip"

msgid "Headings should step down in order (H2 → H3); do not skip levels for looks, size them with CSS."
msgstr "Headings should step down in order (H2 → H3); do not skip levels for looks, size them with CSS."

msgid "tabindex greater than 0"
msgstr "tabindex greater than 0"

msgid "Values like tabindex=\"1\" break keyboard order; use 0 or -1."
msgstr "Values like tabindex=\"1\" break keyboard order; use 0 or -1."

msgid "Links with the same text go to different addresses"
msgstr "Links with the same text go to different addresses"

msgid "Links with the same name should go to the same page. Remove the duplicate page or make the link texts different."
msgstr "Links with the same name should go to the same page. Remove the duplicate page or make the link texts different."

msgid "iframe without a title"
msgstr "iframe without a title"

msgid "Every <iframe> needs a title (e.g. \"Location map\")."
msgstr "Every <iframe> needs a title (e.g. \"Location map\")."

msgid "No <main> landmark on the page"
msgstr "No <main> landmark on the page"

msgid "Main content must be inside <main>; screen readers and agents find the main content this way."
msgstr "Main content must be inside <main>; screen readers and agents find the main content this way."

msgid "Insufficient text/background contrast"
msgstr "Insufficient text/background contrast"

msgid "At least 4.5:1 for normal text and 3:1 for large text. Darken the pale colors in the theme palette."
msgstr "At least 4.5:1 for normal text and 3:1 for large text. Darken the pale colors in the theme palette."

msgid "Render-blocking requests"
msgstr "Render-blocking requests"

msgid "Inline the critical CSS for the first screen, load the rest with media=\"print\" onload or at the end of the page, and defer JS. LiteSpeed Cache › Page Optimization › CSS/JS settings, or the theme's own combined CSS."
msgstr "Inline the critical CSS for the first screen, load the rest with media=\"print\" onload or at the end of the page, and defer JS. LiteSpeed Cache › Page Optimization › CSS/JS settings, or the theme's own combined CSS."

msgid "Unused CSS"
msgstr "Unused CSS"

msgid "Split the one large CSS file by page type, or drop unused rules (LiteSpeed \"Remove Unused CSS\"). The gain usually shows up in LCP."
msgstr "Split the one large CSS file by page type, or drop unused rules (LiteSpeed \"Remove Unused CSS\"). The gain usually shows up in LCP."

msgid "Unminified JavaScript"
msgstr "Unminified JavaScript"

msgid "Ship .min versions of theme/plugin JS or turn on LiteSpeed \"JS Minify\"."
msgstr "Ship .min versions of theme/plugin JS or turn on LiteSpeed \"JS Minify\"."

msgid "Unminified CSS"
msgstr "Unminified CSS"

msgid "Minify CSS (LiteSpeed \"CSS Minify\" or a build step)."
msgstr "Minify CSS (LiteSpeed \"CSS Minify\" or a build step)."

msgid "Non-composited animations"
msgstr "Non-composited animations"

msgid "Animate with transform and opacity; properties like stroke-dashoffset, top/left and width repaint on every frame. Stop them under prefers-reduced-motion."
msgstr "Animate with transform and opacity; properties like stroke-dashoffset, top/left and width repaint on every frame. Stop them under prefers-reduced-motion."

msgid "DOM is too large"
msgstr "DOM is too large"

msgid "Aim for under 1,500 elements. Reduce copies in marquees, build hidden menus and long lists on demand, simplify nested wrappers."
msgstr "Aim for under 1,500 elements. Reduce copies in marquees, build hidden menus and long lists on demand, simplify nested wrappers."

msgid "Largest content (LCP) paints late"
msgstr "Largest content (LCP) paints late"

msgid "If the LCP element is text, preload its font, use font-display: swap and do not hide it behind an entrance animation on the first frame; if it is an image, give it fetchpriority=\"high\" and do not lazy load it."
msgstr "If the LCP element is text, preload its font, use font-display: swap and do not hide it behind an entrance animation on the first frame; if it is an image, give it fetchpriority=\"high\" and do not lazy load it."

msgid "Layout shift (CLS) culprits"
msgstr "Layout shift (CLS) culprits"

msgid "Give images width/height and late blocks a fixed height; use size-adjust/fallback metrics for web fonts; absolutely positioned animated layers must not push the layout."
msgstr "Give images width/height and late blocks a fixed height; use size-adjust/fallback metrics for web fonts; absolutely positioned animated layers must not push the layout."

msgid "Fonts delay text"
msgstr "Fonts delay text"

msgid "Use font-display: swap in @font-face, preload the 1-2 fonts used on the first screen with <link rel=\"preload\" as=\"font\" crossorigin>, remove unused weights."
msgstr "Use font-display: swap in @font-face, preload the 1-2 fonts used on the first screen with <link rel=\"preload\" as=\"font\" crossorigin>, remove unused weights."

msgid "Critical request chain is long"
msgstr "Critical request chain is long"

msgid "Fonts loaded from CSS lengthen the chain; preload first-screen fonts and defer unneeded requests in the chain (e.g. guest.vary.php)."
msgstr "Fonts loaded from CSS lengthen the chain; preload first-screen fonts and defer unneeded requests in the chain (e.g. guest.vary.php)."

msgid "Forced reflow"
msgstr "Forced reflow"

msgid "Do not read offsetWidth/getBoundingClientRect after changing styles in JS; read first, then write inside requestAnimationFrame."
msgstr "Do not read offsetWidth/getBoundingClientRect after changing styles in JS; read first, then write inside requestAnimationFrame."

msgid "Long main-thread tasks"
msgstr "Long main-thread tasks"

msgid "Split JS that runs at startup and defer work for off-screen sections with IntersectionObserver."
msgstr "Split JS that runs at startup and defer work for off-screen sections with IntersectionObserver."

msgid "Images are large or in an old format"
msgstr "Images are large or in an old format"

msgid "Use WebP/AVIF, never send images larger than displayed (srcset), turn on image compression."
msgstr "Use WebP/AVIF, never send images larger than displayed (srcset), turn on image compression."

msgid "Images without width/height"
msgstr "Images without width/height"

msgid "Give <img> tags width and height; the browser reserves space and the page does not shift."
msgstr "Give <img> tags width and height; the browser reserves space and the page does not shift."

msgid "First-screen image is lazy loaded"
msgstr "First-screen image is lazy loaded"

msgid "Do not give the page's first image loading=\"lazy\"; give it fetchpriority=\"high\". If LiteSpeed lazy load is on, exclude the first image (data-no-lazy or \"Lazy Load Image Excludes\")."
msgstr "Do not give the page's first image loading=\"lazy\"; give it fetchpriority=\"high\". If LiteSpeed lazy load is on, exclude the first image (data-no-lazy or \"Lazy Load Image Excludes\")."

msgid "Slow server response"
msgstr "Slow server response"

msgid "Turn on page cache (LiteSpeed Cache); check slow plugins and the cron report in Flux Speed."
msgstr "Turn on page cache (LiteSpeed Cache); check slow plugins and the cron report in Flux Speed."

msgid "No text compression (gzip/brotli)"
msgstr "No text compression (gzip/brotli)"

msgid "Turn on gzip or brotli on the server (on by default on Hostinger/LiteSpeed; check the CDN settings)."
msgstr "Turn on gzip or brotli on the server (on by default on Hostinger/LiteSpeed; check the CDN settings)."

msgid "HTML document is large"
msgstr "HTML document is large"

msgid "Move inline SVG icons into a sprite and large inline CSS/JSON into files."
msgstr "Move inline SVG icons into a sprite and large inline CSS/JSON into files."

msgid "WordPress emoji script is loaded"
msgstr "WordPress emoji script is loaded"

msgid "Modern browsers draw emoji themselves; the theme can remove print_emoji_detection_script."
msgstr "Modern browsers draw emoji themselves; the theme can remove print_emoji_detection_script."

msgid "Largest Contentful Paint (LCP) is slow"
msgstr "Largest Contentful Paint (LCP) is slow"

msgid "Target under 2.5 s. Reduce render-blocking CSS, preload the LCP font/image, turn on the server cache."
msgstr "Target under 2.5 s. Reduce render-blocking CSS, preload the LCP font/image, turn on the server cache."

msgid "Cumulative Layout Shift (CLS) is high"
msgstr "Cumulative Layout Shift (CLS) is high"

msgid "Target under 0.1. Size images, prevent font shifts, reserve space for elements added later."
msgstr "Target under 0.1. Size images, prevent font shifts, reserve space for elements added later."

msgid "Total Blocking Time (TBT) is high"
msgstr "Total Blocking Time (TBT) is high"

msgid "Target under 200 ms. Reduce startup JS and defer third-party scripts."
msgstr "Target under 200 ms. Reduce startup JS and defer third-party scripts."

msgid "First Contentful Paint (FCP) is slow"
msgstr "First Contentful Paint (FCP) is slow"

msgid "Target under 1.8 s. Reduce render-blocking CSS/JS and server response time."
msgstr "Target under 1.8 s. Reduce render-blocking CSS/JS and server response time."

msgid "Speed Index is slow"
msgstr "Speed Index is slow"

msgid "Prioritize critical CSS and fonts so the first screen fills quickly; shorten entrance animations."
msgstr "Prioritize critical CSS and fonts so the first screen fills quickly; shorten entrance animations."

msgid "Site is not HTTPS or has mixed content"
msgstr "Site is not HTTPS or has mixed content"

msgid "Set the addresses to https:// in Settings › General and fix images/scripts loaded over http://."
msgstr "Set the addresses to https:// in Settings › General and fix images/scripts loaded over http://."

msgid "Weak HSTS policy"
msgstr "Weak HSTS policy"

msgid "Strict-Transport-Security: max-age=31536000; includeSubDomains. If every subdomain is HTTPS, you can also add \"preload\" and submit to hstspreload.org."
msgstr "Strict-Transport-Security: max-age=31536000; includeSubDomains. If every subdomain is HTTPS, you can also add \"preload\" and submit to hstspreload.org."

msgid "No or incomplete Content Security Policy (CSP)"
msgstr "No or incomplete Content Security Policy (CSP)"

msgid "Flux SEO can add a basic CSP (object-src 'none'; base-uri 'self'; frame-ancestors 'self'). A full script-src policy can break plugins on WordPress; try Content-Security-Policy-Report-Only first."
msgstr "Flux SEO can add a basic CSP (object-src 'none'; base-uri 'self'; frame-ancestors 'self'). A full script-src policy can break plugins on WordPress; try Content-Security-Policy-Report-Only first."

msgid "No clickjacking protection"
msgstr "No clickjacking protection"

msgid "Send X-Frame-Options: SAMEORIGIN and CSP frame-ancestors 'self'. Do not turn on if your site is embedded in other sites with an iframe."
msgstr "Send X-Frame-Options: SAMEORIGIN and CSP frame-ancestors 'self'. Do not turn on if your site is embedded in other sites with an iframe."

msgid "No origin isolation (COOP)"
msgstr "No origin isolation (COOP)"

msgid "Send Cross-Origin-Opener-Policy: same-origin-allow-popups; payment and login popups keep working."
msgstr "Send Cross-Origin-Opener-Policy: same-origin-allow-popups; payment and login popups keep working."

msgid "Trusted Types not set"
msgstr "Trusted Types not set"

msgid "Advanced protection against DOM-based XSS. Most WordPress plugins are not compatible yet; try it with Report-Only only on custom-theme sites with few plugins."
msgstr "Advanced protection against DOM-based XSS. Most WordPress plugins are not compatible yet; try it with Report-Only only on custom-theme sites with few plugins."

msgid "No X-Content-Type-Options header"
msgstr "No X-Content-Type-Options header"

msgid "X-Content-Type-Options: nosniff. Flux SEO sends it by default; the server or a cache plugin may be removing it."
msgstr "X-Content-Type-Options: nosniff. Flux SEO sends it by default; the server or a cache plugin may be removing it."

msgid "HTML doctype or charset missing"
