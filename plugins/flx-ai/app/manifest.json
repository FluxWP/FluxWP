{
  "id": "ai",
  "plugin": "flx-ai",
  "min_app": "1.0.0",
  "title": "Flux AI",
  "icon": "chat",
  "menu": "flx-ai",
  "entry": "settings",
  "tabs": ["settings", "log"],
  "fallback": { "web": "admin.php?page=flx-ai-settings" },
  "routes": {
    "admin.php?page=flx-ai": { "screen": "chat" },
    "admin.php?page=flx-ai-settings": { "screen": "settings" },
    "admin.php?page=flx-ai-log": { "screen": "log" },
    "admin.php?page=flx-ai-billing": { "screen": "billing" },
    "admin.php?page=flx-ai-systems": { "screen": "systems" },
    "admin.php?page=flx-ai-tools": { "screen": "tools" },
    "admin.php?page=flx-ai-mcp": { "screen": "mcp" }
  },
  "sources": {
    "log": {
      "path": "flx-ai/v1/log",
      "paging": { "mode": "page", "param": "page", "size_param": "per_page", "size": 25, "items": "items", "total": "total", "pages": "pages" },
      "key": "id",
      "cache": { "stale": 30 }
    }
  },
  "screens": {
    "settings": { "type": "native", "title": "$t:aiSettings.title", "component": "flxai-settings", "fallback": { "web": "admin.php?page=flx-ai-settings" } },
    "log": {
      "type": "list",
      "title": "Kayıtlar",
      "source": "log",
      "search": { "param": "q", "placeholder": "Model, araç ya da hata" },
      "filters": [
        {
          "param": "kind",
          "label": "Tür",
          "type": "select",
          "options": [
            { "value": "", "label": "Tümü" },
            { "value": "model", "label": "Model" },
            { "value": "tool", "label": "Araç" }
          ]
        }
      ],
      "columns": [
        { "label": "Kayıt", "value": "{{title}}", "width": 3 },
        { "label": "Kaynak", "value": "{{source}}" },
        { "label": "Süre", "value": "{{ms|number}}", "align": "end" },
        { "label": "Zaman", "value": "{{ts_label}}", "align": "end" }
      ],
      "item": {
        "title": "{{title}}",
        "subtitle": "{{source}}",
        "meta": "{{ms|number}}",
        "caption": "{{ts_label}}",
        "badges": [
          { "text": "Hata", "tone": "danger", "when": { "path": "ok", "op": "eq", "value": 0 } },
          { "text": "Araç", "tone": "muted", "when": { "path": "kind", "op": "eq", "value": "tool" } }
        ]
      },
      "actions": { "header": ["open_chat"] },
      "empty": { "title": "Kayıt yok", "body": "Model ve araç çağrıları burada listelenir. İstek içeriği uygulamaya gelmez." }
    },
    "chat": {
      "type": "native",
      "title": "Sohbet",
      "component": "flxai-chat",
      "fallback": { "web": "admin.php?page=flx-ai" }
    },
    "billing": { "type": "native", "title": "Faturalandırma", "component": "flxai-billing", "fallback": { "web": "admin.php?page=flx-ai-billing" } },
    "systems": { "type": "native", "title": "$t:aiSystems.title", "component": "flxai-systems", "fallback": { "web": "admin.php?page=flx-ai-systems" } },
    "tools": { "type": "native", "title": "Araçlar", "component": "flxai-tools", "fallback": { "web": "admin.php?page=flx-ai-tools" } },
    "mcp": { "type": "native", "title": "$t:aiMcp.title", "component": "flxai-mcp", "fallback": { "web": "admin.php?page=flx-ai-mcp" } }
  },
  "actions": {
    "open_chat": {
      "label": "Sohbet",
      "icon": "chat",
      "navigate": { "target": "screen:ai/chat" }
    }
  }
}
