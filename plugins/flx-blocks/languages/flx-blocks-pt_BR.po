msgstr "Esse ID é usado por um token do sistema."

msgid "A custom token with that id already exists."
msgstr "Um símbolo personalizado com esse id já existe."

msgid "That id is reserved by the system."
msgstr "Esse ID é reservado pelo sistema."

msgid "System primitives cannot be deleted."
msgstr "Os primitivos do sistema não podem ser excluídos."

msgid "This primitive has references that cannot be automatically resolved. Remove them manually before deleting."
msgstr "Este primitivo tem referências que não podem ser resolvidas automaticamente. Remova-as manualmente antes de apagar."

msgid "This primitive has references that cannot be automatically resolved. Remove them manually before renaming."
msgstr "Este primitivo tem referências que não podem ser resolvidas automaticamente. Remova-as manualmente antes de renomear."

msgid "The stored definition has no $type and cannot be renamed."
msgstr "A definição armazenada não tem $type e não pode ser renomeada."

msgid "The new id is already in use."
msgstr "O novo ID já está em uso."

msgid "The new id is reserved by the system."
msgstr "O novo id é reservado pelo sistema."

msgid "The canonical dot-path id of the user primitive."
msgstr "O id dot-path canônico do usuário primitivo."

msgid "The human-readable label stored in the provenance map."
msgstr "O rótulo legível humano armazenado no mapa de provação."

msgid "The cache-busting version hash for the token library."
msgstr "O hash de versão em cache para a biblioteca de token."

msgid "Whether the primitive can be safely deleted (all references are supported)."
msgstr "Se o primitivo pode ser excluído com segurança (todas as referências são suportadas)."

msgid "All alias references to this primitive found in the document."
msgstr "Todas as referências a esse primitivo encontrado no documento."

msgid "The id must be a canonical custom primitive path (primitive.<type>.custom.<slug>)."
msgstr "O id deve ser um caminho primitivo personalizado canônico (primitivo. <type> .personalizado. <slug> )."

msgid "The version token the client last read."
msgstr "A versão token the client last read."

msgid "The terminal slug for the new primitive (kebab-case, no dots)."
msgstr "A lesma terminal para o novo primitivo (caso de xbab, sem pontos)."

msgid "The DTCG $type for the new primitive."
msgstr "O tipo DTCG para o novo primitivo."

msgid "The DTCG $value for the new primitive."
msgstr "O valor DTCG para o novo primitivo."

msgid "Optional human-readable label."
msgstr "Rolo de leitura humana opcional."

msgid "Optional stable machine key for the UI group this primitive should join."
msgstr "Chave de máquina estável opcional para o grupo UI este primitivo deve se juntar."

msgid "The canonical dot-path id of the user primitive to delete."
msgstr "O id dot-path canônico do usuário primitivo para excluir."

msgid "The canonical dot-path id of the user primitive to rename."
msgstr "O id dot-path canônico do usuário primitivo para renomear."

