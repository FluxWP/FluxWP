# Address of the WordPress site.
FLUX_WP_URL=https://cms.example.com
# Connection key from FluxWP › Headless (shown when you save a front end with a new secret).
FLUX_KEY=

# Optional, instead of the key or to override it:
# FLUX_GRAPHQL_URL=https://cms.example.com/graphql
# FLUX_FRONTEND_ID=main
# FLUX_REVALIDATE_SECRET=
# Previews through an application password instead of the key:
# FLUX_PREVIEW_USER=
# FLUX_PREVIEW_APP_PASSWORD=
