msgstr "組織"

msgid "Organization name"
msgstr "組織名"

msgid "Organization type"
msgstr "組織の種類"

msgid "Open in panel"
msgstr "パネルで開く"

msgid "Scores"
msgstr "スコア"

msgid "NGO"
msgstr "NGO"

