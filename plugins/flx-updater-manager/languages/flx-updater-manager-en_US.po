msgstr "%1$s countries · %2$s blocked requests"

msgid "Ülke veritabanı yok"
msgstr "No country database"

msgid "Cloudflare arkasında değilseniz ülkeler bilinmiyor görünür."
msgstr "Unless you are behind Cloudflare, countries show as unknown."

msgid "Veritabanını indir"
msgstr "Download the database"

