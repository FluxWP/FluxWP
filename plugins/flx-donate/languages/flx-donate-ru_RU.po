msgstr "Задача не запланирована; он добавляется снова при следующей загрузке страницы."

msgid "Test cron"
msgstr "Проверить cron"

msgid "Overdue scheduled tasks"
msgstr "Просроченные запланированные задачи"

msgid "%1$dtask is more than 15 minutes late:%2$s.%1$dtasks are more than 15 minutes late:%2$s."
msgstr " Задача%1$dзадерживается более чем на 15 минут:%2$s. Задачи%1$dзадерживаются более чем на 15 минут:%2$s."

msgid "A few late tasks right after a quiet period are normal; many mean cron is not running."
msgstr "Несколько опоздавших задач сразу после периода затишья — это нормально; многие означают, что cron не запущен."

msgid "No task is late."
msgstr "Ни одна задача не задерживается."

msgid "Cron test"
msgstr "Крон-тест"

msgid "Not tested. The test asks this server to call wp-cron.php once, as WordPress does after a visit."
msgstr "Не проверялось. Тест просит этот сервер один раз вызвать wp-cron.php, как это делает WordPress после посещения."

msgid "Card payment provider"
msgstr "Поставщик карточных платежей"

msgid "No payment provider is available."
msgstr "Нет доступной платежной системы."

msgid "Payment settings"
msgstr "Настройки платежей"

msgid "Card payments are taken with%s."
msgstr "Платежи по карте принимаются с помощью%s."

msgid "%sis the active provider but its keys are missing, so donation forms show \"Online payment is unavailable\"."
msgstr "%s— активный провайдер, но его ключи отсутствуют, поэтому в формах пожертвований отображается сообщение «Онлайн-платеж недоступен»."

msgid "Enter keys"
msgstr "Введите ключи"

msgid "Keys are read from the iyzico Subscription plugin settings."
msgstr "Ключи считываются из настроек плагина подписки iyzico."

msgid "Keys are entered in Donations › Payments › iyzico."
msgstr "Ключи вводятся в Пожертвования › Платежи › iyzico."

msgid "No iyzico API key and secret key found (neither in the iyzico WooCommerce plugin nor in Flux Donate)."
msgstr "Не найден ключ API iyzico и секретный ключ (ни в плагине iyzico WooCommerce, ни в Flux Donate)."

msgid "Mode: sandbox (test). No real money is collected; switch to live keys before launch."
msgstr "Режим: песочница (тестовый). Никаких реальных денег не собирается; переключитесь на живые ключи перед запуском."

msgid "Mode: live. Real payments are taken."
msgstr "Режим: прямой эфир. Принимаются реальные платежи."

msgid "Use \"Test connection\" to check the keys with iyzico."
msgstr "Используйте «Проверить соединение», чтобы проверить ключи с помощью iyzico."

msgid "iyzico keys"
msgstr "\\клавиши нийзико"

msgid "Paste into iyzico panel › Merchant notifications URL (İşyeri Bildirimleri Url):%s. Subscription notification URLs are not needed."
msgstr "Вставьте на панель iyzico › URL-адрес уведомлений продавца (İşyeri Bildirimleri Url):%s. URL-адреса уведомлений о подписке не нужны."

msgid "Last notification received:%s."
msgstr "Последнее полученное уведомление:%s."

msgid "No notification received in the last 30 days (normal until the address is saved in the iyzico panel and a payment is made)."
msgstr "За последние 30 дней не было получено ни одного уведомления (обычное явление, пока адрес не будет сохранен на панели iyzico и не будет произведен платеж)."

msgid "Notifications for WooCommerce orders are forwarded to the iyzico WooCommerce plugin."
msgstr "Уведомления о заказах WooCommerce перенаправляются в плагин iyzico WooCommerce."

msgid "iyzico notification URL"
msgstr "iyzico URL-адрес уведомления"

msgid "Show addresses"
msgstr "Показать адреса"

msgid "Failed recurring charges"
msgstr "Неудачные регулярные платежи"

msgid "%drecurring donation stopped after its card was declined 3 times."
msgid_plural "%drecurring donations stopped after their cards were declined 3 times."
msgstr[0] " Регулярное пожертвование%dпрекращено после того, как его карта была отклонена 3 раза."
msgstr[1] "%dпрекратили регулярные пожертвования после того, как их карты были отклонены 3 раза."
msgstr[2] "%dпрекратили регулярные пожертвования после того, как их карты были отклонены 3 раза."

msgid "Stripe keys"
msgstr "Полосы клавиш"

msgid "The Stripe publishable key and secret key are missing."
msgstr "Публикуемый ключ и секретный ключ Stripe отсутствуют."

msgid "Mode: live."
msgstr "Режим: прямой эфир."

msgid "Mode: test (pk_test_). No real money is collected."
msgstr "Режим: тестовый (pk_test_). Реальные деньги не собираются."

msgid "Webhook signing secret is set."
msgstr "Секрет подписи вебхука установлен."

msgid "Webhook signing secret is missing: refunds and renewals made in Stripe will not show up in Flux Donate."
msgstr "Отсутствует секрет подписи Webhook: возврат средств и продление, сделанные в Stripe, не будут отображаться в Flux Donate."

msgid "Flux Forms is not active. Donation forms and card payments need it."
msgstr "Flux Forms не активен. Это необходимо для форм пожертвований и карточных платежей."

msgid "Active, version%s."
msgstr "Активна, версия%s."

msgid "Version%1$sis active; Flux Donate needs%2$sor later for payments and prices to work together."
msgstr "Версия%1$sактивна; Для Flux Donate требуется%2$sили более поздняя версия, чтобы платежи и цены работали вместе."

msgid "Active, version%s. Certificates can be sent after donations."
msgstr "Активна, версия%s. Сертификаты можно отправлять после пожертвований."

msgid "Version%1$sis active;%2$sor later is recommended."
msgstr "Версия%1$sактивна; Рекомендуется%2$sили более поздняя версия."

msgid "Not active. Donations are recorded, but no certificate is created or sent."
msgstr "Не активно. Пожертвования записываются, но сертификаты не создаются и не отправляются."

msgid "WooCommerce is older than%s. Flux Donate 2.0 takes donations through WooCommerce; update it."
msgstr "WooCommerce старше%s. Flux Donate 2.0 принимает пожертвования через WooCommerce; обновите его."

msgid "WooCommerce is not active. Flux Donate 2.0 takes donations through the WooCommerce cart and checkout; until it is active, only the older Flux Forms payment layer works."
msgstr "WooCommerce не активен. Flux Donate 2.0 принимает пожертвования через корзину WooCommerce и оформление заказа; пока он не активен, работает только старый уровень оплаты Flux Forms."

msgid "The old Flux WooCommerce Bağış plugin is still active. Flux Donate 2.0 replaces it: deactivate and delete it, otherwise orders get two certificates and two messages."
msgstr "Старый плагин Flux WooCommerce Bagış все еще активен. Flux Donate 2.0 заменяет его: деактивируйте и удалите, иначе заказы получат два сертификата и два сообщения."

msgid "WooCommerce is active."
msgstr "WooCommerce активен."

msgid "The iyzico WooCommerce plugin is active: it takes one-time card payments, and Flux Donate reads its iyzico keys for monthly donations."
msgstr "Плагин iyzico WooCommerce активен: он принимает одноразовые платежи по картам, а Flux Donate считывает свои ключи iyzico для ежемесячных пожертвований."

msgid "The iyzico WooCommerce plugin is not active, but its saved keys are still used."
msgstr "Плагин iyzico WooCommerce не активен, но его сохраненные ключи все еще используются."

msgid "The iyzico WooCommerce plugin is not active; Flux Donate uses its own iyzico keys."
msgstr "Плагин iyzico WooCommerce не активен; Flux Donate использует собственные ключи iyzico."

msgid "The iyzico Subscription plugin is active; it renews WooCommerce subscriptions only. Flux Donate recurring donations use their own hourly task."
msgstr "Плагин подписки iyzico активен; он продлевает только подписки WooCommerce. Регулярные пожертвования Flux Donate используют свою почасовую задачу."

msgid "WooCommerce and iyzico plugins"
msgstr "Плагины WooCommerce и iyzico"

msgid "Open donation types"
msgstr "Открытые типы пожертвований"

msgid "%ddonation type is open and priced."
msgid_plural "%ddonation types are open and priced."
msgstr[0] " Тип пожертвования%dявляется открытым и платным."
msgstr[1] " Типы пожертвований%dоткрыты и платны."
msgstr[2] " Типы пожертвований%dоткрыты и платны."

msgid "No donation type is open with a price (or free amount), so forms cannot take donations."
msgstr "Ни один тип пожертвования не открыт с указанием цены (или бесплатной суммы), поэтому формы не могут принимать пожертвования."

msgid "Forms of open donation types"
msgstr "Формы открытых пожертвований"

msgid "No (existing) form is linked to:%s. Visitors cannot give to these types online."
msgstr "Нет (существующей) формы, связанной с:%s. Посетители не могут делать пожертвования этим типам онлайн."

msgid "Every open donation type has a form."
msgstr "Каждый тип открытого пожертвования имеет форму."

msgid "Default currency:%s."
msgstr "Валюта по умолчанию:%s."

msgid "iyzico is not set up for this currency (Donations › Payments › iyzico › currencies)."
msgstr "iyzico не настроен для этой валюты (Пожертвования › Платежи › iyzico › валюты)."

msgid "Bank accounts (transfer)"
msgstr "Банковские счета (перевод)"

msgid "%dbank account is listed for bank transfer gifts."
msgid_plural "%dbank accounts are listed for bank transfer gifts."
msgstr[0] " Банковский счет%dуказан для подарков банковским переводом."
msgstr[1] " Банковские счета%dуказаны для подарков банковским переводом."
msgstr[2] " Банковские счета%dуказаны для подарков банковским переводом."

msgid "No bank account is listed. They come from the theme (filter flxb_bank_accounts) and are used when recording bank transfer gifts."
msgstr "Банковский счет не указан. Они берутся из темы (фильтр flxb_bank_accounts) и используются при записи подарков банковским переводом."

msgid "Receipts and e-mails show \"%s\"."
msgstr "В квитанциях и электронных письмах отображается \"%s\"."

msgid "Not set; receipts and e-mails use the site title \"%s\"."
msgstr "Не установлено; в квитанциях и электронных письмах используется заголовок сайта «%s»."

msgid "E-mail sending"
msgstr "Отправка электронной почты"

msgid "Not tested. Donor e-mails (recurring donation started, card declined) go out with wp_mail. The test sends one message to%s."
msgstr "Не проверялось. Электронные письма донорам (начато регулярное пожертвование, карта отклонена) отправляются с помощью wp_mail. Тест отправляет одно сообщение на%s."

msgid "Send test e-mail"
msgstr "Отправить тестовое письмо"

msgid "Plain permalinks are in use. Payment callbacks still work through ?rest_route=, but some hosts and security plugins block that; choose \"Post name\"."
msgstr "Используются обычные постоянные ссылки. Обратные вызовы платежей по-прежнему работают через ?rest_route=, но некоторые хосты и плагины безопасности блокируют это; выберите «Название публикации»."

msgid "Pretty permalinks are on; REST callbacks use /wp-json/."
msgstr "Довольно постоянные ссылки включены; Обратные вызовы REST используют /wp-json/."

msgid "The site runs on HTTPS."
msgstr "Сайт работает по протоколу HTTPS."

msgid "Local test site without HTTPS. The live site must use HTTPS; payment providers refuse plain HTTP."
msgstr "Локальный тестовый сайт без HTTPS. Действующий сайт должен использовать HTTPS; поставщики платежей отказываются использовать простой HTTP."

msgid "The site address is not HTTPS. Card payments and payment callbacks need HTTPS (Settings › General, and an SSL certificate from the host)."
msgstr "Адрес сайта не HTTPS. Для карточных платежей и обратных вызовов требуется HTTPS (Настройки > Общие и SSL-сертификат от хоста)."

msgid "WordPress security keys (salts)"
msgstr "Ключи безопасности WordPress (соли)"

msgid "Missing or weak in wp-config.php:%s. Saved iyzico cards are encrypted with these keys; set unique values once (https://api.wordpress.org/secret-key/1.1/salt/) and do not change them afterwards, or saved cards stop working."
msgstr "Отсутствует или слаб в wp-config.php:%s. Сохраненные карты iyzico зашифрованы этими ключами; задайте уникальные значения один раз (https://api.wordpress.org/secret-key/1.1/salt/) и не меняйте их в дальнейшем, иначе сохраненные карты перестанут работать."

msgid "Set in wp-config.php. Saved iyzico cards are encrypted with them: do not change them, or saved cards stop working."
msgstr "Установите в wp-config.php. Сохраненные карты iyzico зашифрованы с их помощью: не меняйте их, иначе сохраненные карты перестанут работать."

msgid "Up to date (%s)."
msgstr "Актуально (%s)."

msgid "Tables are at version%1$s, expected%2$s. Deactivate and activate Flux Donate to update them."
msgstr "Таблицы имеют версию%1$s, ожидается%2$s. Деактивируйте и активируйте Flux Donate, чтобы обновить их."

msgid "No iyzico keys to test."
msgstr "Нет ключей iyzico для проверки."

msgid "sandbox"
msgstr "sandbox"

msgid "Connected; iyzico accepted the keys (%s)."
msgstr "Подключено; iyzico принял ключи (%s)."

msgid "iyzico refused the keys (%1$s):%2$s. Check that the keys belong to this environment."
msgstr "iyzico отказался от ключей (%1$s):%2$s. Убедитесь, что ключи принадлежат этой среде."

msgid "This server could not reach its own wp-cron.php (%s). WP-Cron cannot start from visits; add a server cron job."
msgstr "Этому серверу не удалось связаться с собственным wp-cron.php (%s). WP-Cron не может запускаться с посещений; добавьте задание cron сервера."

msgid "wp-cron.php answered; WP-Cron can start."
msgstr "wp-cron.php ответил; WP-Cron может запуститься."

msgid "wp-cron.php answered with HTTP%d(blocked by the host or a security plugin?). Add a server cron job."
msgstr "wp-cron.php ответил HTTP%d(заблокировано хостом или плагином безопасности?). Добавьте задание cron сервера."

msgid "[%s] Test e-mail from Flux Donate"
msgstr "[%s] Тестовое письмо от Flux Donate"

msgid "This is a test from Donations › Settings › System check. If you can read it, donor e-mails can be sent."
msgstr "Это тест из Пожертвования › Настройки › Проверка системы. Если вы можете его прочитать, можно отправлять электронные письма донорам."

msgid "Sent to%s. Check that it arrived (and not in spam)."
msgstr "Отправлено на%s. Проверьте, что оно пришло (а не в спаме)."

msgid "Sending failed:%s. Set up SMTP (e.g. an SMTP plugin with your mail account)."
msgstr "Отправка не удалась:%s. Настройте SMTP (например, плагин SMTP для вашей учетной записи электронной почты)."

msgid "Donations on WooCommerce: donation types and sapling packages sold as hidden products, cart and checkout (iyzico, bank transfer with receipt upload), monthly donations, online and printed certificates, donors, campaigns and a donation dashboard. Includes Flux WooCommerce Bağış."
msgstr "Пожертвования в WooCommerce: типы пожертвований и пакеты саженцев, продаваемые как скрытые продукты, корзина и оформление заказа (iyzico, банковский перевод с загрузкой квитанций), ежемесячные пожертвования, онлайн- и печатные сертификаты, доноры, кампании и панель пожертвований. Включает Flux WooCommerce Bagış."

msgid "%1$sdonation ·%2$sreceived%1$sdonations ·%2$sreceived"
msgid_plural "%1$sdonation ·%2$sreceived%1$sdonations ·%2$sreceived"
msgstr[0] "%1$sпожертвование ·%2$sполучено%1$sпожертвование ·%2$sполучено"
msgstr[1] "%1$sпожертвование ·%2$sполучено%1$sпожертвование ·%2$sполучено"
msgstr[2] "%1$sпожертвование ·%2$sполучено%1$sпожертвование ·%2$sполучено"

msgid "%1$spaid gift ·%2$s%1$spaid gifts ·%2$s"
msgid_plural "%1$spaid gift ·%2$s%1$spaid gifts ·%2$s"
msgstr[0] "%1$sплатный подарок ·%2$s%1$sплатный подарок ·%2$s"
msgstr[1] "%1$sплатный подарок ·%2$s%1$sплатный подарок ·%2$s"
msgstr[2] "%1$sплатный подарок ·%2$s%1$sплатный подарок ·%2$s"

msgid "%dactive type has its hidden WooCommerce product.%dactive types have their hidden WooCommerce products."
msgid_plural "%dactive type has its hidden WooCommerce product.%dactive types have their hidden WooCommerce products."
msgstr[0] " Активный тип%dсодержит скрытый продукт WooCommerce. Активные типы%dимеют скрытые продукты WooCommerce."
msgstr[1] " Активный тип%dсодержит скрытый продукт WooCommerce. Активные типы%dимеют скрытые продукты WooCommerce."
msgstr[2] " Активный тип%dсодержит скрытый продукт WooCommerce. Активные типы%dимеют скрытые продукты WooCommerce."

msgid "%1$dtask is more than 15 minutes late:%2$s.%1$dtasks are more than 15 minutes late:%2$s."
msgid_plural "%1$dtask is more than 15 minutes late:%2$s.%1$dtasks are more than 15 minutes late:%2$s."
msgstr[0] " Задача%1$dзадерживается более чем на 15 минут:%2$s. Задачи%1$dзадерживаются более чем на 15 минут:%2$s."
msgstr[1] " Задача%1$dзадерживается более чем на 15 минут:%2$s. Задачи%1$dзадерживаются более чем на 15 минут:%2$s."
msgstr[2] " Задача%1$dзадерживается более чем на 15 минут:%2$s. Задачи%1$dзадерживаются более чем на 15 минут:%2$s."

msgid "Donation lookup code"
msgstr "Код для просмотра пожертвований"

msgid "One-time code a donor enters on the \"My donations\" page to see their donations and certificates."
msgstr "Одноразовый код, который жертвователь вводит на странице «Мои пожертвования», чтобы увидеть свои пожертвования и сертификаты."

msgid "Minutes the code is valid"
msgstr "Срок действия кода в минутах"

msgid "Lookup page"
msgstr "Страница просмотра"

