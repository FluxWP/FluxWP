msgstr "A consulta de doações está desativada (Doações › Configurações › Consulta de doações)."

msgid "My donations and certificates"
msgstr "Minhas doações e certificados"

msgid "Enter the e-mail address or phone number you used when donating. We will send you a one-time code; no account or password is needed."
msgstr "Digite o e-mail ou telefone que você usou ao doar. Enviaremos um código de uso único; não é preciso conta nem senha."

msgid "E-mail address"
msgstr "E-mail"

msgid "name@example.com"
msgstr "nome@exemplo.com"

