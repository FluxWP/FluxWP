<?php
/**
 * Return types of the untyped Flux Donate helpers the GraphQL services call.
 * PHPStan reads these instead of the sources, so the legacy files stay untouched.
 */

/**
 * @param array<string, mixed> $args
 * @return list<array{id: int, slug: string, title: string, description: string, image_url: string, currency: string, state: string, state_message: string, category: string, category_label: string, options: list<array{key: string, label: string, price: float|null, prices: array<string, float>, unit: string|null, unit_label: string|null, units_per: int, active: bool}>, allow_free: bool, min_amount: float, allow_quantity: bool, requires_proxy: bool, progress: array{raised: float, gifts: int, goal: float, percent: float, currency: string}|null}>
 */
function flxb_get_types( array $args = array() ) {}

/**
 * @param int|string $id_or_slug
 * @return array{id: int, slug: string, title: string, description: string, image_url: string, currency: string, state: string, state_message: string, category: string, category_label: string, options: list<array{key: string, label: string, price: float|null, prices: array<string, float>, unit: string|null, unit_label: string|null, units_per: int, active: bool}>, allow_free: bool, min_amount: float, allow_quantity: bool, requires_proxy: bool, progress: array{raised: float, gifts: int, goal: float, percent: float, currency: string}|null}|null
 */
function flxb_get_type( $id_or_slug ) {}

/** @return array{holder: string, iban: string, iban_display: string, bank: string}|null */
function flxb_bank_account() {}

class FLXB_Types {
	/** @return array<string, mixed>|null */
	public static function get( mixed $id ) {}

	/**
	 * @param array<string, mixed> $t
	 * @return bool
	 */
	public static function requires_proxy( array $t ) {}
}

class FLXB_App {
	/** @return list<array<int, array<string, mixed>>> */
	public static function gifts( mixed $user_id ) {}

	/**
	 * @param array<int, array<string, mixed>> $g
	 * @return array{id: int, order_id: int, date: string, title: string, amount: float, currency: string, status: string}
	 */
	public static function gift_out( array $g ) {}
}

class FLXB_Lookup {
	/** @return array{on: int, page_id: int, channels: list<string>} */
