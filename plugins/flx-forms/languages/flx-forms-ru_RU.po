msgid "\\nor click to browse — you can add multiple service accounts at once\\n"
msgstr "\\или не нажимайте для просмотра — вы можете добавить несколько сервисных аккаунтов одновременно\\n"

msgid "\\nConnected service accounts\\n"
msgstr "\\nПодключенные сервисные аккаунты\\n"

msgid "\\nOne-time setup (≈3 min)\\n"
msgstr "\\nОднократная установка (≈3 минуты)\\n"

msgid "\\nGo to<a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noopener noreferrer\">console.cloud.google.com</a>→ Project dropdown (top-left) → New Project → name it → Create\\n"
msgstr "\\nПерейдите на<a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noopener noreferrer\">console.cloud.google.com</a>→ раскрывающийся список «Проект» (вверху слева) → «Новый проект» → назовите его → «Создать».\\n"

msgid "\\nAPIs & Services → Library → enable<strong>Google Sheets API</strong><em>and</em><strong>Google Drive API</strong>\\n"
msgstr "\\nAPI и службы → Библиотека → включить<strong>Google Sheets API</strong><em>и</em><strong>Google Drive API</strong>\\n"

