msgstr "Akışın hazırlandığı token kütüphanesinin kısa adı."

msgid "The token structure, grouped for the UI."
msgstr "Arayüz için gruplanmış token yapısı."

msgid "Per-block preset structure and resolved preview values."
msgstr "Blok başına preset yapısı ve çözülmüş önizleme değerleri."

