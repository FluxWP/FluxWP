msgstr "\\nLe test hebdomadaire de livraison des e-mails s'est terminé avec succès.\\n"

msgid "\\nThe weekly email delivery test found an email delivery problem.\\n"
msgstr "\\nLe test hebdomadaire de livraison des e-mails a révélé un problème de livraison des e-mails.\\n"

msgid "\\nThe main WordPress administrator email address is not valid.\\n"
msgstr "\\nL'adresse e-mail principale de l'administrateur WordPress n'est pas valide.\\n"

