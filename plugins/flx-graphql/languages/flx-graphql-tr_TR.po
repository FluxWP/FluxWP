msgstr ""
"Project-Id-Version: Flux GraphQL\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: tr_TR\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Flux GraphQL"
msgstr "Flux GraphQL"

msgid "Settings"
msgstr "Ayarlar"

msgid "You do not have permission to do this."
msgstr "Bunu yapmaya yetkiniz yok."

msgid "One GraphQL API for the FluxWP plugins. Screens in wp-admin, the FluxWP desktop and mobile apps and a headless front end all read the same typed schema."
msgstr "FluxWP eklentileri için tek GraphQL API. wp-admin ekranları, FluxWP masaüstü ve mobil uygulamaları ve headless ön yüz aynı tipli şemayı okur."

msgid "Settings saved."
msgstr "Ayarlar kaydedildi."

msgid "The separate WPGraphQL plugin was deactivated; the built-in copy is in use."
msgstr "Ayrı WPGraphQL eklentisi devre dışı bırakıldı; yerleşik kopya kullanılıyor."

msgid "Status"
msgstr "Durum"

msgid "Endpoint"
msgstr "Adres"

msgid "WPGraphQL"
msgstr "WPGraphQL"

msgid "%s (built in)"
msgstr "%s (yerleşik)"

msgid "%s (separate plugin)"
msgstr "%s (ayrı eklenti)"

msgid "not loaded"
msgstr "yüklenmedi"

msgid "working"
msgstr "çalışıyor"

msgid "off"
msgstr "kapalı"

msgid "Known queries"
msgstr "Tanınan sorgular"

msgid "%1$d from %2$d packages"
msgstr "%2$d paketten %1$d"

msgid "Upload endpoint"
msgstr "Yükleme adresi"

msgid "Use the Flux GraphQL version"
msgstr "Flux GraphQL sürümünü kullan"

msgid "Open GraphiQL IDE"
msgstr "GraphiQL IDE'yi aç"

msgid "Access"
msgstr "Erişim"

msgid "Only queries shipped with FluxWP packages (recommended)"
msgstr "Yalnız FluxWP paketleriyle gelen sorgular (önerilen)"

msgid "Administrators may also send any query"
msgstr "Yöneticiler her sorguyu da gönderebilir"

msgid "Anyone may send any query (public headless API)"
msgstr "Herkes her sorguyu gönderebilir (herkese açık headless API)"

msgid "Which queries run"
msgstr "Hangi sorgular çalışır"

msgid "Persisted queries keep the API small and let LiteSpeed cache public reads."
msgstr "Kayıtlı sorgular API'yi dar tutar ve herkese açık okumaların LiteSpeed önbelleğine girmesini sağlar."

msgid "Front-end origins"
msgstr "Ön yüz adresleri"

msgid "Sites allowed to call /graphql from the browser, one per line. This site is always allowed."
msgstr "Tarayıcıdan /graphql çağırabilecek siteler, her satıra bir tane. Bu site her zaman izinlidir."

msgid "GraphiQL IDE for administrators"
msgstr "Yöneticiler için GraphiQL IDE"

msgid "Also lets administrators run any query while it is on."
msgstr "Açıkken yöneticiler her sorguyu da çalıştırabilir."

msgid "Public schema introspection"
msgstr "Herkese açık şema okuma (introspection)"

msgid "Administrators can always read the schema."
msgstr "Yöneticiler şemayı her zaman okuyabilir."

msgid "Debug messages for administrators"
msgstr "Yöneticiler için hata ayıklama mesajları"

msgid "Limits"
msgstr "Sınırlar"

msgid "Deepest nesting"
msgstr "En derin iç içelik"

msgid "Highest complexity"
msgstr "En yüksek karmaşıklık"

msgid "Records per page"
msgstr "Sayfa başına kayıt"

msgid "Queries per batch"
msgstr "Toplu istekte sorgu"

msgid "Public cache"
msgstr "Herkese açık önbellek"

msgid "sec"
msgstr "sn"

msgid "Largest upload"
msgstr "En büyük yükleme"

msgid "The FluxWP form fields could not load. Reinstall Flux GraphQL."
msgstr "FluxWP form alanları yüklenemedi. Flux GraphQL'i yeniden kurun."

msgid "Shared hosting: keep the limits low. A query that goes over them is refused before it runs."
msgstr "Paylaşımlı barındırmada sınırları düşük tutun. Sınırı aşan sorgu çalışmadan reddedilir."

msgid "Save"
msgstr "Kaydet"

msgid "GraphQL server"
msgstr "GraphQL sunucusu"

msgid "Flux GraphQL settings"
msgstr "Flux GraphQL ayarları"

msgid "Built-in WPGraphQL %s is running."
msgstr "Yerleşik WPGraphQL %s çalışıyor."

msgid "A separately installed WPGraphQL %1$s is running instead of the built-in %2$s. It works, but its updates are not tested with FluxWP. Use the built-in copy unless another plugin needs the separate one."
msgstr "Yerleşik %2$s yerine ayrı kurulmuş WPGraphQL %1$s çalışıyor. Çalışır, ama güncellemeleri FluxWP ile test edilmez. Başka bir eklenti ayrı kopyaya ihtiyaç duymuyorsa yerleşik kopyayı kullanın."

msgid "A separately installed WPGraphQL %1$s is active. FluxWP needs %2$s or newer and below %3$s, so FluxWP GraphQL screens fall back to the classic pages. Deactivate it to use the built-in copy."
msgstr "Ayrı kurulmuş WPGraphQL %1$s etkin. FluxWP %2$s veya üstünü ve %3$s altını ister; bu yüzden FluxWP GraphQL ekranları klasik sayfalara döner. Yerleşik kopyayı kullanmak için onu devre dışı bırakın."

msgid "The built-in WPGraphQL files are missing. Reinstall Flux GraphQL from FluxWP Panel › Packages."
msgstr "Yerleşik WPGraphQL dosyaları eksik. Flux GraphQL'i FluxWP Panel › Paketler'den yeniden kurun."

msgid "GraphQL queries"
msgstr "GraphQL sorguları"

msgid "Anyone may send any GraphQL query. Keep this only for a public headless front end; depth and complexity limits still apply."
msgstr "Herkes her GraphQL sorgusunu gönderebilir. Bunu yalnız herkese açık bir headless ön yüz için açık tutun; derinlik ve karmaşıklık sınırları yine geçerlidir."

msgid "GraphQL types"
msgstr "GraphQL tipleri"

msgid "Some GraphQL fields were refused because they break the FluxWP rules: %s. Update the package that adds them."
msgstr "Bazı GraphQL alanları FluxWP kurallarına uymadığı için reddedildi: %s. Onları ekleyen paketi güncelleyin."

msgid "Flux GraphQL: the separately installed WPGraphQL %s is not supported, so FluxWP GraphQL screens are off."
msgstr "Flux GraphQL: ayrı kurulmuş WPGraphQL %s desteklenmiyor, bu yüzden FluxWP GraphQL ekranları kapalı."

msgid "Only queries shipped with FluxWP packages run (%d known)."
msgstr "Yalnız FluxWP paketleriyle gelen sorgular çalışır (%d tanınan)."

msgid "You are not allowed to manage plugins."
msgstr "Eklentileri yönetmeye yetkiniz yok."

msgid "Uploads are not accepted for this screen."
msgstr "Bu ekran için dosya yüklenemez."

msgid "You do not have permission to upload files here."
msgstr "Buraya dosya yüklemeye yetkiniz yok."

msgid "Too many uploads. Wait a few minutes and try again."
msgstr "Çok fazla yükleme. Birkaç dakika bekleyip yeniden deneyin."

msgid "The file did not arrive. Try again."
msgstr "Dosya ulaşmadı. Yeniden deneyin."

msgid "The file is larger than %s."
msgstr "Dosya %s boyutundan büyük."

msgid "This file type is not allowed."
msgstr "Bu dosya türüne izin verilmiyor."

msgid "The file could not be saved on the server."
msgstr "Dosya sunucuya kaydedilemedi."

msgid "The uploaded file was not found. Upload it again."
msgstr "Yüklenen dosya bulunamadı. Yeniden yükleyin."

msgid "Where a page sits in a list."
msgstr "Sayfanın listedeki yeri."

msgid "More records follow this page."
msgstr "Bu sayfadan sonra başka kayıt var."

msgid "Records come before this page."
msgstr "Bu sayfadan önce kayıt var."

msgid "Cursor of the first record on this page."
msgstr "Bu sayfadaki ilk kaydın imleci."

msgid "Cursor of the last record on this page; pass it as \"after\" for the next page."
msgstr "Bu sayfadaki son kaydın imleci; sonraki sayfa için \"after\" olarak verin."

msgid "One %s in a list, with its cursor."
msgstr "Listedeki bir %s, imleciyle."

msgid "Opaque cursor of this record."
msgstr "Bu kaydın opak imleci."

msgid "The record."
msgstr "Kayıt."

msgid "A page of %s records."
msgstr "Bir sayfa %s kaydı."

msgid "Records with their cursors."
msgstr "İmleçleriyle kayıtlar."

msgid "Records of this page."
msgstr "Bu sayfanın kayıtları."

msgid "Paging information."
msgstr "Sayfalama bilgisi."

msgid "All matching records (null when counting would be slow)."
msgstr "Eşleşen tüm kayıtlar (saymak yavaş olacaksa null)."

msgid "Records per page (at most %d)."
msgstr "Sayfa başına kayıt (en fazla %d)."

msgid "Cursor to continue after (pageInfo.endCursor)."
msgstr "Sonrasından devam edilecek imleç (pageInfo.endCursor)."

msgid "The page cursor is not valid."
msgstr "Sayfa imleci geçerli değil."

msgid "Please sign in again."
msgstr "Lütfen yeniden giriş yapın."

msgid "The record was not found."
msgstr "Kayıt bulunamadı."

msgid "Some fields are not valid."
msgstr "Bazı alanlar geçerli değil."

msgid "The record was changed by someone else. Reload and try again."
msgstr "Kaydı başka biri değiştirdi. Yenileyip yeniden deneyin."

msgid "Too many requests. Wait a moment and try again."
msgstr "Çok fazla istek. Biraz bekleyip yeniden deneyin."

msgid "Something went wrong. Please try again."
msgstr "Bir sorun oluştu. Lütfen yeniden deneyin."

msgid "This query is not known to the site. Update the app or the FluxWP packages."
msgstr "Bu sorgu sitede tanınmıyor. Uygulamayı ya da FluxWP paketlerini güncelleyin."

msgid "Only queries shipped with FluxWP packages may run on this site."
msgstr "Bu sitede yalnız FluxWP paketleriyle gelen sorgular çalışabilir."

msgid "The ID is not valid."
msgstr "Kimlik geçerli değil."

msgid "Global ID."
msgstr "Genel kimlik (global ID)."

msgid "Database ID."
msgstr "Veritabanı kimliği."

msgid "Input problems to show next to the form fields. Empty when the mutation succeeded."
msgstr "Form alanlarının yanında gösterilecek girdi sorunları. İşlem başarılıysa boş."

msgid "Changes to %s. Only the fields you send are changed."
msgstr "%s değişiklikleri. Yalnız gönderdiğiniz alanlar değişir."

msgid "Panel settings of the installed FluxWP packages (from flx_settings_schema)."
msgstr "Kurulu FluxWP paketlerinin panel ayarları (flx_settings_schema'dan)."

msgid "Panel settings of the installed FluxWP packages."
msgstr "Kurulu FluxWP paketlerinin panel ayarları."

msgid "Changes panel settings. Only the groups and fields you send are written."
msgstr "Panel ayarlarını değiştirir. Yalnız gönderdiğiniz gruplar ve alanlar yazılır."

msgid "Settings after the change."
msgstr "Değişiklikten sonraki ayarlar."

msgid "This setting cannot be changed here."
msgstr "Bu ayar burada değiştirilemez."

msgid "A list or object is expected."
msgstr "Liste ya da nesne bekleniyor."

msgid "This choice is not available."
msgstr "Bu seçenek yok."

msgid "Enter a colour like #1F6FEB."
msgstr "#1F6FEB gibi bir renk girin."

msgid "Free-form JSON value (object, list, string, number or boolean)."
msgstr "Serbest JSON değeri (nesne, liste, metin, sayı ya da mantıksal)."

msgid "A problem with the input of a mutation, shown next to the form field."
msgstr "Bir işlemin girdisindeki sorun; form alanının yanında gösterilir."

msgid "Stable code: INVALID_INPUT, CONFLICT, …"
msgstr "Sabit kod: INVALID_INPUT, CONFLICT, …"

msgid "Message in the user's language."
msgstr "Kullanıcının dilinde mesaj."

msgid "Input field (dotted path) the problem belongs to."
msgstr "Sorunun ait olduğu girdi alanı (noktalı yol)."

msgid "A point in time with labels in the user's language."
msgstr "Kullanıcının dilinde etiketleriyle bir zaman."

msgid "ISO 8601 in UTC (2026-11-15T14:59:00Z)."
msgstr "UTC'de ISO 8601 (2026-11-15T14:59:00Z)."

msgid "Unix timestamp."
msgstr "Unix zaman damgası."

msgid "Date and time for display, in the site time zone and the user's language."
msgstr "Gösterim için tarih ve saat; site saat diliminde ve kullanıcının dilinde."

msgid "Relative time for display (\"5 minutes ago\")."
msgstr "Gösterim için göreli zaman (\"5 dakika önce\")."

msgid "An amount of money."
msgstr "Bir para tutarı."

msgid "Amount in the currency unit (150.5)."
msgstr "Para biriminde tutar (150.5)."

msgid "ISO 4217 code (TRY, USD)."
msgstr "ISO 4217 kodu (TRY, USD)."

msgid "Amount with the currency sign for display."
msgstr "Gösterim için para işaretiyle tutar."

msgid "A phone number."
msgstr "Bir telefon numarası."

msgid "E.164 form (+905301234567); empty when the number is not valid."
msgstr "E.164 biçimi (+905301234567); numara geçersizse boş."

msgid "Digits only (905301234567)."
msgstr "Yalnız rakamlar (905301234567)."

msgid "Number as entered, for display."
msgstr "Gösterim için girildiği gibi numara."

msgid "A stored file."
msgstr "Saklanan bir dosya."

msgid "File ID (upload ID or the package's own ID)."
msgstr "Dosya kimliği (yükleme kimliği ya da paketin kendi kimliği)."

msgid "File name."
msgstr "Dosya adı."

msgid "MIME type."
msgstr "MIME türü."

msgid "Size in bytes."
msgstr "Bayt cinsinden boyut."

msgid "Download address (may need the same sign-in)."
msgstr "İndirme adresi (aynı giriş gerekebilir)."

msgid "The file is an image."
msgstr "Dosya bir görsel."

msgid "Thumbnail address for images."
msgstr "Görseller için küçük resim adresi."

msgid "A person (donor, customer, contact). Flux CRM owns the record; other packages return it."
msgstr "Bir kişi (bağışçı, müşteri, kişi). Kaydın sahibi Flux CRM; diğer paketler onu döndürür."

msgid "Person ID in the shared people table."
msgstr "Ortak kişi tablosundaki kişi kimliği."

msgid "Full name."
msgstr "Ad soyad."

msgid "E-mail address."
msgstr "E-posta adresi."

msgid "Phone number."
msgstr "Telefon numarası."

msgid "Picture address."
msgstr "Resim adresi."

