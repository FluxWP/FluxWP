msgid "No PageSpeed run yet. Press \"Measure with PageSpeed\" (mobile + desktop takes about 1 minute)."
msgstr "Nenhum PageSpeed foi executado ainda. Pressione \"Medir com PageSpeed\" (móvel + desktop leva cerca de 1 minuto)."

msgid "Agentic browsing"
msgstr "Navegação agente"

msgid "MCP server on"
msgstr "Servidor MCP ativado"

msgid "MCP server off"
msgstr "Servidor MCP desligado"

