msgid "\\nStep-by-Step Setup\\n"
msgstr "\\nStep-by-Step Setup\\n"

msgid "\\nCreate or Select a Project\\n"
msgstr "\\nCreate or Select a Project\\n"

msgid "\\nOpen console.cloud.google.com and log in → click the Project dropdown (top-left) → New Project (or pick an existing one) → enter a name → Create', 'en']]"
msgstr "\\nOpen console.cloud.google.com and log in → click the Project dropdown (top-left) → New Project (or pick an existing one) → enter a name → Create', 'en']]"

msgid "\\nEnable both Google APIs\\n"
msgstr "\\nEnable both Google APIs\\n"

msgid "\\nAPIs & Services → Library → enable<strong>Google Sheets API</strong>and<strong>Google Drive API</strong>(both are required — Drive lists and creates the files)\\n"
msgstr "\\nAPIs & Services → Library → enable<strong>Google Sheets API</strong>and<strong>Google Drive API</strong>(both are required — Drive lists and creates the files)\\n"

msgid "\\nCreate a Service Account\\n"
msgstr "\\nCreate a Service Account\\n"

msgid "\\nAPIs & Services → Credentials → Create Credentials → Service Account → enter a name → Done\\n"
msgstr "\\nAPIs & Services → Credentials → Create Credentials → Service Account → enter a name → Done\\n"

msgid "\\nCreate a JSON Key\\n"
msgstr "\\nCreate a JSON Key\\n"

msgid "\\nOpen the service account → Keys tab → Add Key → Create New Key → choose JSON (file downloads automatically)\\n"
msgstr "\\nOpen the service account → Keys tab → Add Key → Create New Key → choose JSON (file downloads automatically)\\n"

msgid "\\nDrop the Key File\\n"
msgstr "\\nDrop the Key File\\n"

msgid "\\nDrag the downloaded file into the Connections tab — it is verified automatically and you’ll see a green “Connected” badge\\n"
msgstr "\\nDrag the downloaded file into the Connections tab — it is verified automatically and you’ll see a green “Connected” badge\\n"

msgid "\\nAdd Your Google Email\\n"
msgstr "\\nAdd Your Google Email\\n"

msgid "\\nOn the Connections tab, fill in “Your Google email” and Save — sheets the plugin creates are then shared to you so they appear in your own Drive\\n"
msgstr "\\nOn the Connections tab, fill in “Your Google email” and Save — sheets the plugin creates are then shared to you so they appear in your own Drive\\n"

msgid "\\nBind a Form (create a sheet)\\n"
msgstr "\\nBind a Form (create a sheet)\\n"

msgid "\\nForm Bindings → pick a form →<strong>Create New Sheet</strong>→ Save. No manual sharing needed — this is the easiest path\\n"
msgstr "\\nForm Bindings → pick a form →<strong>Create New Sheet</strong>→ Save. No manual sharing needed — this is the easiest path\\n"

msgid "\\n...or use an existing sheet\\n"
msgstr "\\n...or use an existing sheet\\n"

msgid "\\nPrefer your own sheet? Open it → Share → paste the service account email (copy button on its card) → Editor → then Browse My Sheets in the wizard\", 'en']]"
msgstr "\\nPrefer your own sheet? Open it → Share → paste the service account email (copy button on its card) → Editor → then Browse My Sheets in the wizard\", 'en']]"

msgid "FAQ"
msgstr "FAQ"

msgid "\\nI created a sheet — where did it go?\\n"
msgstr "\\nI created a sheet — where did it go?\\n"

msgid "\\nService accounts create files in their own hidden Drive. Add “Your Google email” on the Connections tab and the plugin shares every new sheet to you automatically — it then appears under “Shared with me” in your Google Drive. Each sheet also has an “Open” link right in this dashboard.\\n"
msgstr "\\nService accounts create files in their own hidden Drive. Add “Your Google email” on the Connections tab and the plugin shares every new sheet to you automatically — it then appears under “Shared with me” in your Google Drive. Each sheet also has an “Open” link right in this dashboard.\\n"

msgid "\\nWhy don’t I see my existing sheet in the picker?\\n"
msgstr "\\nWhy don’t I see my existing sheet in the picker?\\n"

msgid "\\nIt must be shared with the service account’s email first: open the sheet → Share → paste the email (use the copy button on the connection card) → set Editor → Share. Then click “Browse My Sheets” again.\\n"
msgstr "\\nIt must be shared with the service account’s email first: open the sheet → Share → paste the email (use the copy button on the connection card) → set Editor → Share. Then click “Browse My Sheets” again.\\n"

msgid "\\nTest result: Google API is not enabled.\\n"
msgstr "\\nTest result: Google API is not enabled.\\n"

msgid "\\nOpen Google Cloud Console for the same project → APIs & Services → Library, and enable BOTH “Google Sheets API” and “Google Drive API”. Wait a minute, then retest.\\n"
msgstr "\\nOpen Google Cloud Console for the same project → APIs & Services → Library, and enable BOTH “Google Sheets API” and “Google Drive API”. Wait a minute, then retest.\\n"

msgid "\\nTest result: Access/Permission denied\\n"
msgstr "\\nTest result: Access/Permission denied\\n"

msgid "\\nThe service account can authenticate but can’t reach that specific spreadsheet. Re-share the sheet with the service account email as Editor, or create a new sheet instead.\\n"
msgstr "\\nThe service account can authenticate but can’t reach that specific spreadsheet. Re-share the sheet with the service account email as Editor, or create a new sheet instead.\\n"

