msgstr "Precio, stock y enlace; Los productos aparecen como tarjetas en la ventana."

msgid "Product cards"
msgstr "Tarjetas de producto"

msgid "Image, price, \"View\" and \"Add to cart\"."
msgstr "Imagen, precio, \"Ver\" y \"Añadir al carrito\"."

msgid "Flux Wiki pages"
msgstr "Páginas Wiki de flujo"

msgid "Order status"
msgstr "Estado del pedido"

