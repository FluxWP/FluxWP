{
  "id": "wiki",
  "plugin": "flx-wiki",
  "min_app": "1.0.0",
  "title": "Wiki",
  "icon": "note",
  "menu": "edit.php?post_type=flx_wiki",
  "entry": "pages",
  "tabs": ["pages", "search"],
  "fallback": { "web": "edit.php?post_type=flx_wiki" },
  "search": {
    "source": "search",
    "param": "query",
    "item": { "title": "{{title}}", "subtitle": "{{section}}" },
    "onPress": { "target": "screen:wiki/page", "params": { "id": "{{pageId}}" } }
  },
  "routes": {
    "edit.php?post_type=flx_wiki": { "screen": "pages" },
    "post.php?post={id}&action=edit": { "screen": "page", "params": { "id": "{id}" } }
  },
  "sources": {
    "pages": {
      "graphql": {
        "op": "FlxWikiPages",
        "variables": { "statuses": ["PUBLISH", "DRAFT", "PENDING", "PRIVATE"] },
        "data": "flxWikiPages"
      },
      "paging": { "mode": "cursor", "size": 20, "items": "nodes", "next": "pageInfo.endCursor", "has_next": "pageInfo.hasNextPage", "total": "totalCount" },
      "key": "databaseId",
      "cache": { "stale": 60, "persist": true }
    },
    "page": {
      "graphql": { "op": "FlxWikiPageRead", "variables": { "id": "{{params.id}}" }, "data": "flxWikiPage" },
      "cache": { "stale": 30 }
    },
    "page_edit": {
      "graphql": { "op": "FlxWikiPageEdit", "variables": { "id": "{{params.id}}" }, "data": "flxWikiPage" },
      "cache": { "stale": 0 }
    },
    "search": {
      "graphql": { "op": "FlxWikiSearch", "variables": { "query": "", "limit": 20 }, "data": "flxWikiSearch" },
      "paging": { "mode": "none", "items": "hits" },
      "key": "pageId",
      "cache": { "stale": 30 }
    }
  },
  "screens": {
    "pages": {
      "type": "list",
      "title": "Sayfalar",
      "source": "pages",
      "search": { "param": "search", "placeholder": "Sayfalarda ara" },
      "item": {
        "title": "{{title}}",
        "subtitle": "{{section.name}}",
        "caption": "{{modified.relative}}"
      },
      "onPress": { "target": "screen:wiki/page", "params": { "id": "{{databaseId}}" } },
      "actions": { "header": ["page_new"], "fab": "page_new" },
      "empty": { "title": "Sayfa yok", "body": "İlk wiki sayfasını buradan ekleyin." }
    },
    "page": {
      "type": "content",
      "title": "Sayfa",
      "source": "page",
      "format": "html",
      "path": "html",
      "value": "{{html}}",
      "actions": { "header": ["page_edit", "page_web"] }
    },
    "page_form": {
      "type": "form",
      "title": "Sayfa",
      "can": "edit",
      "load": "page_edit",
      "submit": {
        "graphql_create": { "op": "FlxWikiPageSave", "data": "flxWikiPageSave" },
        "graphql_update": { "op": "FlxWikiPageSave", "variables": { "input": { "id": "{{params.id}}" } }, "data": "flxWikiPageSave" }
      },
      "fields": [
        { "name": "title", "type": "text", "label": "Başlık", "required": true },
        { "name": "markdown", "type": "markdown", "label": "İçerik" },
        {
          "name": "status",
          "type": "select",
          "label": "Durum",
          "default": "DRAFT",
          "options": [
            { "value": "PUBLISH", "label": "Yayımlandı" },
            { "value": "DRAFT", "label": "Taslak" }
          ]
        }
      ],
      "dirty_guard": true,
      "after": { "toast": "Kaydedildi", "back": true, "invalidate": ["pages", "page", "page_edit", "search"] }
    },
    "search": {
      "type": "list",
      "title": "Arama",
      "source": "search",
      "search": { "param": "query", "placeholder": "Wiki'de ara" },
      "item": { "title": "{{title}}", "subtitle": "{{section}}", "caption": "{{heading}}" },
      "onPress": { "target": "screen:wiki/page", "params": { "id": "{{pageId}}" } },
      "empty": { "title": "Sonuç yok", "body": "Bir kelime yazın." }
    }
  },
  "actions": {
    "page_new": { "label": "Yeni sayfa", "icon": "plus", "can": "edit", "navigate": { "target": "screen:wiki/page_form" } },
    "page_edit": { "label": "Düzenle", "icon": "edit", "can": "edit", "navigate": { "target": "screen:wiki/page_form", "params": { "id": "{{databaseId}}" } } },
    "page_web": { "label": "Panelde aç", "icon": "globe", "web": "post.php?post={{databaseId}}&action=edit" }
  }
}
