msgid "At most %d images."
msgstr "Максимум изображений%d."

msgid "At most %d videos."
msgstr "Максимум%dвидео."

msgid "Images and video cannot be used together in one post."
msgstr "Изображения и видео не могут использоваться вместе в одном сообщении."

msgid "Media files must be reachable at a public https address."
msgstr "Медиа-файлы должны быть доступны по общедоступному https-адресу."

msgid "This network does not connect via OAuth."
msgstr "Эта сеть не подключается через OAuth."

msgid "The connection expired, please reconnect."
msgstr "Срок соединения истек, пожалуйста, переподключитесь."

msgid "This network does not allow editing a published post."
msgstr "Эта сеть не позволяет редактировать опубликованное сообщение."

msgid "This network does not allow deleting posts via the API; delete it in the app."
msgstr "Эта сеть не позволяет удалять посты через API; удалите его в приложении."

msgid "First comment is not supported on this network."
msgstr "Первый комментарий не поддерживается в этой сети."

msgid "First enter this network's keys under Settings › Apps."
msgstr "Сначала введите ключи этой сети в разделе «Настройки» > «Приложения»."

msgid "Choose a video for YouTube."
msgstr "Выберите видео для YouTube."

msgid "YouTube title can be at most 100 characters."
msgstr "Название YouTube может содержать не более 100 символов."

msgid "YouTube does not accept < and > in the title and description."
msgstr "YouTube не принимает< and >в названии и описании."

msgid "This Google account has no YouTube channel."
msgstr "В этом аккаунте Google нет канала YouTube."

msgid "Video file not found on the server."
msgstr "Видеофайл не найден на сервере."

msgid "Could not read the video file."
msgstr "Не удалось прочитать видеофайл."

msgid "Video not found on YouTube."
msgstr "Видео не найдено на YouTube."

msgid "An event/offer post needs a title and a start date."
msgstr "Публикация о событии/предложении должна иметь заголовок и дату начала."

msgid "Could not get business accounts (requires Google's Business Profile API access approval)"
msgstr "Не удалось получить бизнес-аккаунты (требуется одобрение доступа к Google Business Profile API)."

msgid "No managed business location found on this Google account."
msgstr "В этом аккаунте Google не найден управляемый адрес компании."

msgid "LinkedIn could not process the video."
msgstr "LinkedIn не удалось обработать видео."

msgid "LinkedIn video processing took too long."
msgstr "Обработка видео в LinkedIn заняла слишком много времени."

msgid "No Facebook page you manage was found. Make sure you selected the pages during login."
msgstr "Ни одна страница Facebook, которой вы управляете, не найдена. Убедитесь, что вы выбрали страницы при входе в систему."

msgid "A story has a single image or video."
msgstr "История состоит из одного изображения или видео."

msgid "Instagram accepts at most 30 hashtags."
msgstr "Instagram принимает не более 30 хэштегов."

msgid "Instagram feed image aspect ratio must be between 4:5 and 1.91:1 (except stories)."
msgstr "Соотношение сторон изображения в ленте Instagram должно быть от 4:5 до 1,91:1 (кроме историй)."

msgid "First enter the keys under Settings › Apps › Instagram login."
msgstr "Сначала введите ключи в разделе «Настройки» > «Приложения» > «Вход в Instagram»."

msgid "Instagram could not process a carousel item (format/size not suitable)."
msgstr "Instagram не смог обработать элемент карусели (неподходящий формат/размер)."

msgid "Instagram could not process the media. Video: MP4 (H.264/AAC), 3–90 s (Reels 15 min), up to 1 GB; image: JPEG, up to 8 MB."
msgstr "Instagram не смог обработать медиа. Видео: MP4 (H.264/AAC), 3–90 с (Барабан 15 мин), до 1 ГБ; изображение: JPEG, до 8 МБ."

msgid "Instagram video processing did not finish in 30 minutes."
msgstr "Обработка видео в Instagram не завершилась за 30 минут."

msgid "Pinterest title can be at most 100 characters."
msgstr "Название Pinterest может содержать не более 100 символов."

msgid "Pinterest could not process the video."
msgstr "Pinterest не удалось обработать видео."

msgid "Pinterest video processing took too long."
msgstr "Обработка видео Pinterest заняла слишком много времени."

msgid "Because the TikTok app has not been audited yet, only \"Only me\" visibility can be used."
msgstr "Поскольку приложение TikTok еще не прошло аудит, можно использовать только видимость «Только я»."

msgid "Draft sent to the TikTok app; publish it from the notification in the app."
msgstr "Черновик отправлен в приложение TikTok; опубликуйте его из уведомления в приложении."

msgid "TikTok processing took too long; check in the TikTok app."
msgstr "Обработка TikTok заняла слишком много времени; проверьте приложение TikTok."

msgid "No WhatsApp connection. Set up an Evolution connection in Flux Mail or Flux Chat."
msgstr "Нет подключения к WhatsApp. Настройте соединение Evolution в Flux Mail или Flux Chat."

msgid "WhatsApp Status"
msgstr "Статус WhatsApp"

msgid "Free (no cost, low write limit, no metrics)"
msgstr "Бесплатно (бесплатно, низкий лимит записи, без метрик)"

msgid "Basic (paid monthly)"
msgstr "Базовый (оплачивается ежемесячно)"

msgid "Pro (paid monthly)"
msgstr "Про (оплачивается ежемесячно)"

msgid "Pay-as-you-go"
msgstr "Оплата по мере использования"

msgid "X: a video or GIF is shared on its own."
msgstr "X: видео или GIF публикуются отдельно."

msgid "The monthly limit of %d posts set for X has been reached."
msgstr "Достигнут месячный лимит публикаций%d, установленный для X."

msgid "First enter the API Key and API Key Secret under Settings › Apps › X."
msgstr "Сначала введите ключ API и секретный ключ API в разделе «Настройки» > «Приложения» > «X»."

msgid "Connection refused."
msgstr "В соединении отказано."

msgid "Could not read the media file."
msgstr "Не удалось прочитать медиафайл."

msgid "video could not be processed"
msgstr "видео не удалось обработать"

msgid "Nothing this month"
msgstr "В этом месяце ничего"

msgid "Delete this post?"
msgstr "Удалить этот пост?"

msgid "Search posts"
msgstr "Поиск сообщений"

msgid "Account enabled"
msgstr "Аккаунт включен"

msgid "Open the panel to connect an account."
msgstr "Откройте панель для подключения аккаунта."

msgid "Account disabled"
msgstr "Аккаунт отключен"

msgid "No accounts"
msgstr "Нет аккаунтов"

msgid "Note"
msgstr "Примечание"

msgid "Review"
msgstr "Обзор"

msgid "Approved"
msgstr "Утверждено"

msgid "Open in panel"
msgstr "Открыть на панели"

msgid "Deleted"
msgstr "Удалено"

msgid "New posts are composed in the media composer."
msgstr "Новые посты пишутся в медиакомпозиторе."

msgid "Scheduled and published posts show up here."
msgstr "Здесь отображаются запланированные и опубликованные публикации."

msgid "[['Social media management within the site: account linking (keys from panel), content per account, scheduling, network edit/delete, calendar, dashboard, Flux AI writing assistance and MCP tools. Facebook, Instagram, YouTube, X, LinkedIn, TikTok, Pinterest, Google Business, WhatsApp.', 'tr']]"
msgstr "[['Управление социальными сетями на сайте: привязка учетных записей (ключи с панели), контент для каждой учетной записи, планирование, редактирование/удаление сети, календарь, панель мониторинга, помощь в написании Flux AI и инструменты MCP. Facebook, Instagram, YouTube, X, LinkedIn, TikTok, Pinterest, Google Business, WhatsApp.', 'tr']]"
