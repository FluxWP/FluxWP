msgstr "Добавить еще один чек"

msgid "\\nReceipt under review\\n"
msgstr "\\nКвитанция на рассмотрении\\n"

msgid "\\nPlease write a WhatsApp number or an e-mail address (at least one).\\n"
msgstr "\\nПожалуйста, напишите номер WhatsApp или адрес электронной почты (хотя бы один).\\n"

