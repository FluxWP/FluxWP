msgstr "Refreshes every 30 s"

msgid "Modeller"
msgstr "Models"

msgid "En çok hafızası olan kişiler"
msgstr "Contacts with the most memory"

msgid "Token"
msgstr "Tokens"

msgid "Günlük"
msgstr "Daily"

msgid "Bu aralıkta kayıt yok."
msgstr "No records in this range."

msgid "Cevap"
msgstr "Replies"

msgid "Devir"
msgstr "Handoff"

msgid "Yalnız gerçek sohbetler sayılır; test sohbeti ve benchmark hariç. \"Onaylanan\" asistanın açtığı ve ödendi işaretlenen bağışlardır."
msgstr "Only real chats are counted; test chat and benchmark are excluded. \"Confirmed\" means donations created by the assistant and marked paid."

msgid "Asistanın yazdığı sohbet"
msgstr "Chats the assistant wrote in"

msgid "Ekipte / beklemede"
msgstr "With the team / paused"

msgid "Bağış kaydı açılan"
msgstr "Donation record created"

msgid "Asistan henüz bir sohbete cevap vermedi."
msgstr "The assistant has not replied to any chat yet."

msgid "Daha fazla"
msgstr "Load more"

msgid "Sohbet kapalı"
msgstr "Chat closed"

msgid "Hitap: {h}"
msgstr "Address: {h}"

msgid "{n} asistan mesajı"
msgstr "{n} assistant messages"

msgid "Bağış #{id}"
msgstr "Donation #{id}"

msgid "Sürüm {id}"
msgstr "Version {id}"

msgid "Değişiklik notu (ör. Kurban sorusu eklendi)"
msgstr "Change note (e.g. Added sacrifice question)"

msgid "Asistan talimatı"
msgstr "Assistant instructions"

