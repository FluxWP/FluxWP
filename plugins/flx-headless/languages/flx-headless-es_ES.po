msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: es_ES\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Settings"
msgstr "Configuración"

msgid "Serves headless front ends over GraphQL"
msgstr "Servir frontal sin cabeza termina más de GraphQL"

msgid "Headless"
msgstr "Sin cabeza"

msgid "This screen needs Flux GraphQL (0.4.0 or newer). Install or update it from the FluxWP Packages screen."
msgstr "Esta pantalla necesita Flux GraphQL (0.4.0 o más reciente). Instalar o actualizar desde la pantalla de paquetes FluxWP."

msgid "This front end does not exist any more."
msgstr "Este extremo frontal ya no existe."

msgid "At most %d front ends can be added."
msgstr "A la mayoría de los extremos delanteros %d se puede añadir."

msgid "Give the front end a name."
msgstr "Dale un nombre al frente."

msgid "Enter the front end address with https:// (http:// only for localhost)."
msgstr "Ingrese la dirección principal con https:// (http:// solamente para localhost)."

msgid "The front end cannot have the same address as this WordPress. Move WordPress to another address (e.g. cms.example.com) first."
msgstr "El extremo frontal no puede tener la misma dirección que este WordPress . Move WordPress a otra dirección (por ejemplo cms.example.com) primero."

msgid "Another front end already has this address."
msgstr "Otro extremo frontal ya tiene esta dirección."

msgid "Enter the webhook address with https:// (http:// only for localhost)."
msgstr "Ingrese la dirección webhook con https:// (http:// solamente para localhost)."

msgid "The language \"%s\" is not on this site."
msgstr "El idioma \" %s\" no está en este sitio."

msgid "The preview path starts with \"/\" (e.g. /api/preview)."
msgstr "El camino de vista previa comienza con \"/\" (por ejemplo /api/preview)."

msgid "The secret must be at least 24 characters. Use the Generate button."
msgstr "El secreto debe ser por lo menos 24 caracteres. Utilice el botón Generar."

msgid "The secret could not be stored securely on this server."
msgstr "El secreto no se puede almacenar de forma segura en este servidor."

msgid "A webhook needs a secret so the front end can check that the call comes from this site."
msgstr "Un webhook necesita un secreto para que el extremo frontal pueda comprobar que la llamada viene de este sitio."

msgid "Choose what WordPress does with its own pages."
msgstr "Elija lo que WordPress hace con sus propias páginas."

msgid "Add a front end first; WordPress pages point visitors and search engines to it."
msgstr "Añada un extremo delantero primero; WordPress páginas apuntan visitantes y motores de búsqueda a él."

msgid "Enter the webhook address and the secret first."
msgstr "Ingrese la dirección webhook y el secreto primero."

msgid "Sent without waiting for the answer."
msgstr "Enviado sin esperar la respuesta."

msgid "The front end accepted the call."
msgstr "La parte delantera aceptó la llamada."

msgid "The front end answered with HTTP %d."
msgstr "La parte delantera respondió con HTTP %d ."

msgid "Home"
msgstr "Inicio"

msgid "No front end is added yet; GraphQL works, but links, canonical addresses and the webhook have no front end to point at."
msgstr "Aún no se ha añadido el extremo delantero; GraphQL funciona, pero los enlaces, direcciones canónicas y el webhook no tienen ningún extremo frontal a punto."

msgid "The last webhook call failed for: %s. Open the delivery log on the Headless page."
msgstr "La última llamada webhook falló: %s . Abra el registro de entrega en la página sin cabeza."

msgid "No revalidate webhook for: %s. These front ends show changes only when their cache runs out."
msgstr "No revalidate webhook for: %s . Estos extremos delanteros muestran cambios sólo cuando su caché se agota."

msgid "%d front end, webhook set."
msgid_plural "%d front ends, webhooks set."
msgstr[0] "%d frontal, webhook set."
msgstr[1] "%d extremos delanteros, webhooks set."

msgid "Headless front ends"
msgstr "Encabezamientos frontales sin cabeza"
