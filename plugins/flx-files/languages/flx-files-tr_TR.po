msgid "A folder cannot be moved into itself."
msgstr "Bir klasör kendi içine taşınamaz."

msgid "Could not move (permissions)."
msgstr "Taşınamadı (izinler)."

msgid "AI cannot read or copy protected files."
msgstr "AI korumalı dosyaları okuyamaz ve kopyalayamaz."

msgid "A folder cannot be copied into itself."
