msgstr "Akışı okunacak token kütüphanesinin kısa adı."

msgid "A swatch value or label is required."
msgstr "Renk değeri ya da etiketi gerekli."

msgid "A swatch value cannot be empty."
msgstr "Renk değeri boş olamaz."

msgid "A swatch label cannot be empty."
msgstr "Renk etiketi boş olamaz."

msgid "A swatch label is structural and can only be set on the library's default palette."
msgstr "Renk etiketi yapısaldır, yalnız kütüphanenin varsayılan paletinde ayarlanabilir."

msgid "The current palette must name a palette the library defines."
msgstr "Geçerli palet, kütüphanede tanımlı bir palet olmalı."

msgid "The palette id."
msgstr "Palet kimliği."

msgid "The palette label."
msgstr "Palet etiketi."

msgid "The ordered color groups, each an ordered list of swatches."
msgstr "Sıralı renk grupları; her biri sıralı renk listesidir."

msgid "The color palette failed validation."
msgstr "Renk paleti doğrulanamadı."

msgid "The color palette could not be encoded."
msgstr "Renk paleti kodlanamadı."

msgid "The color palette could not be saved."
msgstr "Renk paleti kaydedilemedi."

msgid "The palette label must be a string."
msgstr "Palet etiketi metin olmalı."

