msgid "Not enough disk space."
msgstr "Não há espaço em disco suficiente."

msgid "The upload was interrupted. Try again."
msgstr "O upload foi interrompido. Tente novamente."

msgid "Only folders inside the uploads folder can be shared on the site."
msgstr "Apenas pastas dentro da pasta de uploads podem ser compartilhadas no site."

msgid "Version not found."
msgstr "Versão não encontrada."

msgid "This item is no longer in the trash."
msgstr "Este item já não está no lixo."

msgid "Could not restore (permissions)."
msgstr "Não foi possível restaurar (permissões)."

msgid "%d item"
msgid_plural "%d items"
msgstr[0] "%d item"
msgstr[1] "Itens %d"

msgid "Trash and versions folder"
msgstr "Pasta de lixo e versões"

msgid "Deleted files and earlier versions are kept in a private folder closed to the web."
msgstr "Arquivos excluídos e versões anteriores são mantidos em uma pasta privada fechada para a web."

msgid "The private folder under wp-content cannot be written. Deleting and versioning will fail; check the wp-content permissions."
msgstr "A pasta privada sob wp-content não pode ser escrita. A exclusão e a versão falharão; verifique as permissões wp-content."

msgid "ZIP support"
msgstr "Suporte ZIP"

msgid "Folders can be downloaded as ZIP, archived and extracted."
msgstr "As pastas podem ser baixadas como ZIP, arquivados e extraídos."

msgid "The PHP zip extension is missing; ZIP download, archive and extract are off. Enable \"zip\" in the hosting PHP extensions."
msgstr "A extensão PHP zip está faltando; ZIP download, arquivo e extrato estão desligados. Ativar \"zip\" na hospedagem PHP extensões."

msgid "File changes"
msgstr "Alterações de arquivo"

msgid "DISALLOW_FILE_MODS is on: Flux Files is read-only."
msgstr "DISALLOW_FILE_MODS está em: Flux Files é somente leitura."

msgid "Only administrators can use Flux Files. wp-config.php, .htaccess and WordPress core folders are protected from deletion."
msgstr "Apenas os administradores podem usar arquivos Flux. wp-config.php, .htaccess e WordPress pastas principais são protegidos da exclusão."

msgid "DISALLOW_FILE_EDIT is on: code files (.php, .htaccess …) cannot be edited or uploaded."
msgstr "DISALLOW_FILE_EDIT está em: arquivos de código (.php, .htaccess ...) não podem ser editados ou enviados."

msgid "AI and MCP file access"
msgstr "Acesso ao arquivo AI e MCP"

msgid "External MCP clients can change and delete files. Turn this off when you no longer need it."
msgstr "Clientes externos MCP podem alterar e excluir arquivos. Desligue isso quando você não precisa mais dele."

msgid "AI chat asks before every change; external MCP clients can only read. Secret files are never shared."
msgstr "O chat AI pergunta antes de cada mudança; os clientes externos MCP só podem ler."

msgid "Trash cleanup"
msgstr "Limpeza de lixo"

msgid "The trash was last cleaned %s. It is also cleaned when an administrator opens Flux Files."
msgstr "O lixo foi limpo pela última vez %s . Também é limpo quando um administrador abre arquivos Flux."
