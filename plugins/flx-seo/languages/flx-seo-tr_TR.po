msgstr "Webmaster panel adresi."

msgid "Link text."
msgstr "Bağlantı metni."

msgid "Example tag."
msgstr "Örnek etiket."

msgid "How to verify the site."
msgstr "Site nasıl doğrulanır."

msgid "Field of flxSettings.flxseo that holds the verification code (verifyGoogle …)."
msgstr "Doğrulama kodunu tutan flxSettings.flxseo alanı (verifyGoogle …)."

msgid "What the settings tabs show besides the setting values."
msgstr "Ayar sekmelerinin ayar değerleri dışında gösterdikleri."

msgid "Another SEO plugin is active; this plugin's meta and schema output is off."
msgstr "Başka bir SEO eklentisi etkin; bu eklentinin meta ve schema çıktısı kapalı."

msgid "Flux AI & MCP (the shared MCP server) is installed."
msgstr "Flux AI & MCP (ortak MCP sunucusu) kurulu."

msgid "WordPress site name (placeholder of the site name field)."
msgstr "WordPress site adı (site adı alanının örneği)."

msgid "Site address."
msgstr "Site adresi."

msgid "Sitemap address."
msgstr "Sitemap adresi."

msgid "Logo used when none is set."
msgstr "Ayarlı logo yoksa kullanılan logo."

msgid "Share image used when none is set."
msgstr "Ayarlı paylaşım görseli yoksa kullanılan görsel."

msgid "Home page title in use (placeholder)."
msgstr "Kullanılan ana sayfa başlığı (örnek)."

msgid "Home page description in use (placeholder)."
msgstr "Kullanılan ana sayfa açıklaması (örnek)."

msgid "Google Site Kit is connected to a Google account."
msgstr "Google Site Kit bir Google hesabına bağlı."

msgid "The site is visible to search engines (Settings › Reading)."
msgstr "Site arama motorlarına açık (Ayarlar › Okuma)."

msgid "IndexNow key file name (without .txt). It is public: search engines read it."
msgstr "IndexNow anahtar dosyasının adı (.txt olmadan). Herkese açıktır: arama motorları okur."

msgid "IndexNow key file address."
msgstr "IndexNow anahtar dosyası adresi."

msgid "Text of the last bulk submission; empty when none."
msgstr "Son toplu gönderimin metni; yoksa boş."

msgid "IndexNow can send now (on, site public, not a local site)."
msgstr "IndexNow şimdi gönderebilir (açık, site herkese açık, yerel site değil)."

msgid "A PageSpeed API key is saved. The key itself is never returned."
msgstr "Bir PageSpeed API anahtarı kayıtlı. Anahtarın kendisi asla döndürülmez."

msgid "Site admin email (default report address)."
msgstr "Site yöneticisinin e-postası (varsayılan rapor adresi)."

msgid "Search engines that take a verification tag."
msgstr "Doğrulama etiketi alan arama motorları."

msgid "Section titles of the new site build guide."
msgstr "Yeni site kurulum rehberinin bölüm başlıkları."

msgid "The new site build guide (rules and checklist) as Markdown."
msgstr "Yeni site kurulum rehberi (kurallar ve kontrol listesi), Markdown olarak."

msgid "Guide text."
msgstr "Rehber metni."

msgid "Section titles."
msgstr "Bölüm başlıkları."

msgid "Language of the text."
msgstr "Metnin dili."

msgid "SEO fields of a page, post or term (the data in the page head)."
msgstr "Bir sayfa, yazı ya da terimin SEO alanları (sayfa başındaki veriler)."

msgid "Own SEO title; empty = the automatic one."
msgstr "Kendi SEO başlığı; boş = otomatik olan."

msgid "Own meta description; empty = the automatic one."
msgstr "Kendi meta açıklaması; boş = otomatik olan."

msgid "Hidden from search engines."
msgstr "Arama motorlarından gizli."

msgid "Own share image address; empty = the featured or default image."
msgstr "Kendi paylaşım görseli adresi; boş = öne çıkan ya da varsayılan görsel."

msgid "Title the page uses."
msgstr "Sayfanın kullandığı başlık."

msgid "Description the page uses."
msgstr "Sayfanın kullandığı açıklama."

msgid "Focus keyword the editor set; only editors can read it."
msgstr "Editörün ayarladığı odak anahtar kelime; yalnız editörler okuyabilir."

msgid "SEO fields of this content (the data in the page head). Empty only when the SEO fields cannot be read."
msgstr "Bu içeriğin SEO alanları (sayfa başındaki veriler). Yalnız SEO alanları okunamıyorsa boş."

msgid "SEO title and description of this term."
msgstr "Bu terimin SEO başlığı ve açıklaması."

msgid "The current site audit report."
msgstr "Güncel site denetim raporu."

msgid "Reports to return (1–90). Default 30."
msgstr "Döndürülecek rapor sayısı (1–90). Varsayılan 30."

msgid "SEO check of the published content: what is missing or too long, per item."
msgstr "Yayındaki içeriğin SEO kontrolü: içerik başına eksik ya da çok uzun olanlar."

msgid "Check one post type only. Default: every public type."
msgstr "Yalnız bir içerik türünü kontrol et. Varsayılan: her herkese açık tür."

msgid "Items to check (1–500). Default 300."
msgstr "Kontrol edilecek içerik sayısı (1–500). Varsayılan 300."

msgid "What the settings tabs show besides the setting values: search engines, sitemap, IndexNow state."
msgstr "Ayar sekmelerinin ayar değerleri dışında gösterdikleri: arama motorları, sitemap, IndexNow durumu."

msgid "The new site build guide (rules and checklist for SEO, speed, accessibility, security and agent readiness)."
msgstr "Yeni site kurulum rehberi (SEO, hız, erişilebilirlik, güvenlik ve ajan hazırlığı için kurallar ve kontrol listesi)."

msgid "Language. Default: the user's language (Turkish or English)."
msgstr "Dil. Varsayılan: kullanıcının dili (Türkçe ya da İngilizce)."

msgid "Runs an audit: the on-site audit, or one PageSpeed measurement (15–40 s; call it for mobile, then desktop, then run the on-site audit)."
msgstr "Bir denetim çalıştırır: site içi denetim ya da tek bir PageSpeed ölçümü (15–40 sn; önce mobil, sonra masaüstü için çağırın, ardından site içi denetimi çalıştırın)."

msgid "Kind of audit."
msgstr "Denetim türü."

msgid "Device for a PageSpeed run. Default mobile."
msgstr "PageSpeed ölçümü için cihaz. Varsayılan mobil."

msgid "Address of this site to audit. Any other address audits the home page."
msgstr "Bu sitenin denetlenecek adresi. Başka bir adres ana sayfayı denetler."

msgid "The report after the run."
msgstr "Çalıştırmadan sonraki rapor."

msgid "Saved reports after the run."
msgstr "Çalıştırmadan sonraki kayıtlı raporlar."

msgid "Turns on a one-click fix a recommendation offers, then refreshes the on-site audit."
msgstr "Önerinin sunduğu tek tıkla düzeltmeyi açar, sonra site içi denetimi yeniler."

msgid "Fix id (a finding's fixId)."
msgstr "Düzeltme kimliği (bulgunun fixId değeri)."

msgid "The report after the fix."
msgstr "Düzeltmeden sonraki rapor."

msgid "Saves or deletes the PageSpeed Insights API key. The key is never returned."
msgstr "PageSpeed Insights API anahtarını kaydeder ya da siler. Anahtar asla döndürülmez."

msgid "New key. Empty keeps the saved key."
msgstr "Yeni anahtar. Boş bırakılırsa kayıtlı anahtar kalır."

msgid "Delete the saved key."
msgstr "Kayıtlı anahtarı sil."

msgid "A key is saved after the change."
msgstr "Değişiklikten sonra bir anahtar kayıtlı."

msgid "Sends every public address of the site to Bing, Yandex and the other IndexNow search engines now."
msgstr "Sitenin tüm herkese açık adreslerini şimdi Bing, Yandex ve diğer IndexNow arama motorlarına gönderir."

msgid "Addresses sent."
msgstr "Gönderilen adres sayısı."

msgid "Setup info after the submission (last submission text)."
msgstr "Gönderimden sonraki kurulum bilgisi (son gönderim metni)."

msgid "Changes the SEO fields of a post or page. Fields you leave out stay as they are."
msgstr "Bir yazı ya da sayfanın SEO alanlarını değiştirir. Göndermediğiniz alanlar olduğu gibi kalır."

msgid "Own SEO title; empty = automatic."
msgstr "Kendi SEO başlığı; boş = otomatik."

msgid "Own meta description; empty = automatic."
msgstr "Kendi meta açıklaması; boş = otomatik."

msgid "Focus keyword."
msgstr "Odak anahtar kelime."

msgid "Hide from search engines."
msgstr "Arama motorlarından gizle."

msgid "Own share image address; empty = automatic."
msgstr "Kendi paylaşım görseli adresi; boş = otomatik."

msgid "SEO fields after the change."
msgstr "Değişiklikten sonraki SEO alanları."

