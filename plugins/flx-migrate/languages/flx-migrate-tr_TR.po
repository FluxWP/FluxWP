msgstr "Veriler yeni adlara taşınacak. Yedek aldınız mı?"

msgid "Post meta"
msgstr "Yazı meta verileri"

msgid "Posts and pages"
msgstr "Yazılar ve sayfalar"

msgid "Upload folders"
