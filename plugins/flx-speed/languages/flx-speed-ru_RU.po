msgstr "%1$dCSS,%2$dКопии JS ·%3$s"

msgid "Compare"
msgstr "Сравнить"

msgid "Optimized"
msgstr "Оптимизированный"

msgid "Off (?flxp_off=1)"
msgstr "Выкл. (?flxp_off=1)"

msgid "Adding ?flxp_off=1 to a URL opens the page without optimizations; if the page looks different, the cause is here."
msgstr "Добавление ?flxp_off=1 к URL-адресу открывает страницу без оптимизации; если страница выглядит по-другому, причина здесь."

msgid "Measure"
msgstr "Мера"

msgid "Flux SEO › Site audit"
msgstr "Flux SEO › Аудит сайта"

msgid "The site audit suggests these settings itself and turns them on with one click."
msgstr "Аудит сайта сам предлагает эти настройки и включает их одним кликом."

msgid "Clear cache"
msgstr "Очистить кеш"

msgid "Animations not running on the GPU"
msgstr "Анимации не запускаются на графическом процессоре"

msgid "Lighthouse \"non-composited animations\": properties other than transform and opacity (stroke-dashoffset, background, width…) repaint every frame. A setting cannot fix this; the theme or preset must rewrite them with transform/opacity."
msgstr "«Некомпозитная анимация» Lighthouse: свойства, отличные от преобразования и непрозрачности (смещение штриха-штриха, фон, ширина...), перерисовываются в каждом кадре. Настройка не может это исправить; тема или пресет должны переписать их с помощью преобразования/непрозрачности."

msgid "Animation"
msgstr "Анимация"

