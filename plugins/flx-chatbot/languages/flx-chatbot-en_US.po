msgstr "Question"

msgid "Avatar"
msgstr "Avatar"

msgid "Düğme yanı etiketi"
msgstr "Label next to the button"

msgid "Boşsa yalnız düğme görünür. Örnek: Yardım lazım mı?"
msgstr "When empty only the button shows. Example: Need help?"

msgid "Yok"
msgstr "None"

msgid "Konum"
msgstr "Position"

msgid "Sağ alt"
msgstr "Bottom right"

msgid "Sol alt"
msgstr "Bottom left"

msgid "Düğme boyutu"
msgstr "Button size"

