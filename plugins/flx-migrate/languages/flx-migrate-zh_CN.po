msgstr "%1$s不为空:它已备份为%2$s并替换为%3$s。"

msgid "%3$d items from %1$s were moved into %2$s."
msgstr "%1$s中的%3$d项已移至%2$s中。"

msgid "%2$d files in %1$s already existed in the new folder; the old copies were left in place."
msgstr "%1$s中的%2$d文件已存在于新文件夹中;旧副本保留在原处。"

