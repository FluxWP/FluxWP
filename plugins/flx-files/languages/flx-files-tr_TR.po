msgstr "Klasörde %s'den fazla dosya var; SSH ya da bir yedekleme aracıyla kopyalayın."

msgid "Could not copy (permissions or disk space)."
msgstr "Kopyalanamadı (izinler ya da disk alanı)."

msgid "AI can only delete folders with fewer than 2,000 files."
msgstr "AI yalnız 2.000'den az dosyası olan klasörleri silebilir."

msgid "Could not move to the trash (permissions)."
msgstr "Çöp kutusuna taşınamadı (izinler)."

msgid "Permissions can only be changed from the Flux Files screen."
msgstr "İzinler yalnız Flux Files ekranından değiştirilebilir."

msgid "Enter permissions as three digits, e.g. 644 or 755."
msgstr "İzinleri üç haneli girin, ör. 644 ya da 755."

msgid "World-writable permissions (e.g. 777) are not allowed."
msgstr "Herkese yazma izni (ör. 777) verilemez."

msgid "Permissions could not be changed."
msgstr "İzinler değiştirilemedi."

msgid "Type at least 2 characters."
msgstr "En az 2 karakter yazın."

msgid "The PHP zip extension is not available on this server."
msgstr "Bu sunucuda PHP zip uzantısı yok."

msgid "Nothing selected."
msgstr "Hiçbir şey seçilmedi."

msgid "The archive could not be created."
msgstr "Arşiv oluşturulamadı."

msgid "Too many files for one archive."
msgstr "Tek arşiv için çok fazla dosya var."

msgid "This archive could not be opened."
msgstr "Bu arşiv açılamadı."

msgid "Too many files in this archive."
msgstr "Bu arşivde çok fazla dosya var."

msgid "The archive contains unsafe paths and was not extracted."
msgstr "Arşivde güvenli olmayan yollar var; çıkarılmadı."

msgid "Not enough disk space to extract this archive."
msgstr "Bu arşivi çıkarmak için yeterli disk alanı yok."

msgid "%1$d result for \"%2$s\""
msgid_plural "%1$d results for \"%2$s\""
msgstr[0] "\"%2$s\" için %1$d sonuç"
msgstr[1] "\"%2$s\" için %1$d sonuç"

msgid "This folder is not shared. Open Flux Files, right-click the folder and choose \"Share on site\"."
msgstr "Bu klasör paylaşılmıyor. Flux Files'ı açın, klasöre sağ tıklayıp \"Sitede paylaş\"ı seçin."

msgid "Search files…"
msgstr "Dosya ara…"

msgid "Search files"
msgstr "Dosya ara"

msgid "Clear"
msgstr "Temizle"

msgid "No files found."
msgstr "Dosya bulunamadı."

msgid "This folder is empty."
msgstr "Bu klasör boş."

msgid "List files"
msgstr "Dosyaları listele"

msgid "Read file"
msgstr "Dosya oku"

msgid "File activity"
msgstr "Dosya etkinliği"

msgid "Files in trash"
msgstr "Çöp kutusundaki dosyalar"

msgid "Write file"
msgstr "Dosya yaz"

msgid "Edit file (find and replace)"
msgstr "Dosya düzenle (bul ve değiştir)"

msgid "Create folder"
msgstr "Klasör oluştur"

msgid "Move or rename"
msgstr "Taşı ya da yeniden adlandır"

msgid "Delete (to trash)"
msgstr "Sil (çöp kutusuna)"

msgid "Restore from trash"
msgstr "Çöp kutusundan geri yükle"

msgid "Only folders inside the uploads folder can be shared on the site."
msgstr "Sitede yalnız uploads içindeki klasörler paylaşılabilir."

msgid "Unknown action."
msgstr "Bilinmeyen işlem."

msgid "The upload failed. The file may be larger than the server allows."
msgstr "Yükleme başarısız. Dosya sunucunun izin verdiğinden büyük olabilir."

msgid "The upload failed. Try again."
msgstr "Yükleme başarısız. Yeniden deneyin."

msgid "Not enough disk space."
msgstr "Yeterli disk alanı yok."

msgid "The upload was interrupted. Try again."
msgstr "Yükleme yarıda kesildi. Yeniden deneyin."

msgid "%d item"
msgid_plural "%d items"
msgstr[0] "%d öğe"
msgstr[1] "%d öğe"

msgid "Version not found."
msgstr "Sürüm bulunamadı."

msgid "This item is no longer in the trash."
msgstr "Bu öğe artık çöp kutusunda değil."

msgid "Could not restore (permissions)."
msgstr "Geri yüklenemedi (izinler)."

msgid "Trash and versions folder"
msgstr "Çöp kutusu ve sürüm klasörü"

msgid "Deleted files and earlier versions are kept in a private folder closed to the web."
msgstr "Silinen dosyalar ve önceki sürümler web'e kapalı özel bir klasörde saklanır."

msgid "The private folder under wp-content cannot be written. Deleting and versioning will fail; check the wp-content permissions."
msgstr "wp-content altındaki özel klasöre yazılamıyor. Silme ve sürüm saklama çalışmaz; wp-content izinlerini kontrol edin."

msgid "ZIP support"
msgstr "ZIP desteği"

msgid "Folders can be downloaded as ZIP, archived and extracted."
msgstr "Klasörler ZIP olarak indirilebilir, arşivlenebilir ve arşivden çıkarılabilir."

msgid "The PHP zip extension is missing; ZIP download, archive and extract are off. Enable \"zip\" in the hosting PHP extensions."
msgstr "PHP zip uzantısı yok; ZIP indirme, arşivleme ve çıkarma kapalı. Hosting'in PHP uzantılarından \"zip\"i açın."

msgid "File changes"
msgstr "Dosya değişiklikleri"

msgid "DISALLOW_FILE_MODS is on: Flux Files is read-only."
msgstr "DISALLOW_FILE_MODS açık: Flux Files salt okunur."

msgid "Only administrators can use Flux Files. wp-config.php, .htaccess and WordPress core folders are protected from deletion."
msgstr "Flux Files'ı yalnız yöneticiler kullanabilir. wp-config.php, .htaccess ve WordPress çekirdek klasörleri silinmeye karşı korumalı."

msgid "DISALLOW_FILE_EDIT is on: code files (.php, .htaccess …) cannot be edited or uploaded."
msgstr "DISALLOW_FILE_EDIT açık: kod dosyaları (.php, .htaccess …) düzenlenemez ve yüklenemez."

msgid "AI and MCP file access"
msgstr "AI ve MCP dosya erişimi"

msgid "External MCP clients can change and delete files. Turn this off when you no longer need it."
msgstr "Dış MCP istemcileri dosya değiştirip silebilir. Artık gerekmiyorsa kapatın."

msgid "AI chat asks before every change; external MCP clients can only read. Secret files are never shared."
msgstr "AI sohbeti her değişiklikten önce sorar; dış MCP istemcileri yalnız okur. Gizli dosyalar asla paylaşılmaz."

msgid "Trash cleanup"
msgstr "Çöp kutusu temizliği"

msgid "The trash was last cleaned %s. It is also cleaned when an administrator opens Flux Files."
msgstr "Çöp kutusu en son %s temizlendi. Bir yönetici Flux Files'ı açınca da temizlenir."
