{
  "id": "ai",
  "plugin": "flx-ai",
  "min_app": "1.0.0",
  "title": "Flux AI",
  "icon": "chat",
  "menu": "flx-ai",
  "entry": "settings",
  "tabs": ["settings", "log"],
  "fallback": { "web": "admin.php?page=flx-ai-settings" },
  "routes": {
    "admin.php?page=flx-ai": { "screen": "chat" },
    "admin.php?page=flx-ai-settings": { "screen": "settings" },
    "admin.php?page=flx-ai-log": { "screen": "log" },
    "admin.php?page=flx-ai-billing": { "screen": "billing" },
    "admin.php?page=flx-ai-systems": { "screen": "systems" },
    "admin.php?page=flx-ai-tools": { "screen": "tools" },
    "admin.php?page=flx-ai-mcp": { "screen": "mcp" }
  },
  "sources": {
    "settings": {
      "graphql": { "op": "FlxAiSettingsScreen", "data": "flxAiSettings" },
      "cache": { "stale": 0 }
    },
    "log": {
      "graphql": { "op": "FlxAiLogs", "data": "flxAiLogs" },
      "paging": { "mode": "cursor", "size": 25, "items": "nodes", "next": "pageInfo.endCursor", "has_next": "pageInfo.hasNextPage", "total": "totalCount" },
      "key": "databaseId",
      "cache": { "stale": 30 }
    }
  },
  "screens": {
    "settings": {
      "type": "form",
      "title": "Settings",
      "load": "settings",
      "submit": { "graphql": { "op": "FlxAiSettingsUpdate", "data": "flxAiSettingsUpdate" } },
      "fields": [
        { "name": "model", "type": "text", "label": "Default model", "help": "Empty picks one from the saved keys." },
        { "name": "chatModel", "type": "text", "label": "Chat model" },
        {
          "name": "cache",
          "type": "segmented",
          "label": "Prompt cache",
          "options": [
            { "value": "OFF", "label": "Off" },
            { "value": "FIVE_MINUTES", "label": "5 minutes" },
            { "value": "ONE_HOUR", "label": "1 hour" }
          ]
        },
        {
          "name": "effort",
          "type": "segmented",
          "label": "Effort",
          "options": [
            { "value": "LOW", "label": "Low" },
            { "value": "MEDIUM", "label": "Medium" },
            { "value": "HIGH", "label": "High" }
          ]
        },
        { "name": "thinking", "type": "switch", "label": "Thinking summary" },
        { "name": "limitDay", "type": "money", "label": "Daily limit (USD)", "min": 0, "help": "0 means no limit." },
        { "name": "limitWeek", "type": "money", "label": "Weekly limit (USD)", "min": 0 },
        { "name": "limitMonth", "type": "money", "label": "Monthly limit (USD)", "min": 0 },
        {
          "name": "limitAction",
          "type": "segmented",
          "label": "When the limit is reached",
          "options": [
            { "value": "BLOCK", "label": "Stop" },
            { "value": "WARN", "label": "Warn" }
          ]
        },
        { "name": "chatAdmin", "type": "switch", "label": "Chat in wp-admin" },
        { "name": "chatFront", "type": "switch", "label": "Chat on the site" },
        {
          "name": "chatMode",
          "type": "segmented",
          "label": "Chat layout",
          "options": [
            { "value": "BUBBLE", "label": "Window" },
            { "value": "DOCK", "label": "Docked" },
            { "value": "PAGE", "label": "Page" }
          ]
        },
        { "name": "chatInstructions", "type": "textarea", "label": "Chat instructions" },
        { "name": "logBodies", "type": "switch", "label": "Keep request contents" },
        { "name": "logDays", "type": "number", "label": "Keep log (days)", "min": 0, "help": "0 means forever." },
        { "name": "logBodyDays", "type": "number", "label": "Keep contents (days)", "min": 0, "help": "0 means forever." }
      ],
      "dirty_guard": true,
      "after": { "toast": "Saved", "back": false, "invalidate": ["settings"] }
    },
    "log": {
      "type": "list",
      "title": "Log",
      "source": "log",
      "filters": [
        {
          "param": "kind",
          "label": "Type",
          "type": "segmented",
          "options": [
            { "value": "", "label": "All" },
            { "value": "MODEL", "label": "Model" },
            { "value": "TOOL", "label": "Tool" }
          ]
        },
        { "param": "errorsOnly", "label": "Errors", "type": "toggle" }
      ],
      "columns": [
        { "label": "Entry", "value": "{{modelLabel|default:tool}}", "width": 3 },
        { "label": "Source", "value": "{{sourceLabel}}" },
        { "label": "Time (ms)", "value": "{{ms|number}}", "align": "end" },
        { "label": "When", "value": "{{time.label}}", "align": "end" }
      ],
      "item": {
        "title": "{{modelLabel|default:tool}}",
        "subtitle": "{{sourceLabel}} · {{purposeLabel}}",
        "meta": "{{ms|number}} ms",
        "caption": "{{time.label}} · {{userName}}",
        "badges": [
          { "text": "{{errorLabel|default:'Error'}}", "tone": "danger", "when": { "path": "ok", "op": "falsy" } },
          { "text": "Tool", "tone": "muted", "when": { "path": "kind", "op": "eq", "value": "TOOL" } }
        ]
      },
      "actions": { "header": ["open_chat"] },
      "empty": { "title": "No entries", "body": "Model and tool calls are listed here. Request contents are not sent to the app." }
    },
    "chat": {
      "type": "native",
      "title": "Chat",
      "component": "flxai-chat",
      "fallback": { "web": "admin.php?page=flx-ai" }
    },
    "billing": { "type": "web", "title": "Billing", "path": "admin.php?page=flx-ai-billing" },
    "systems": { "type": "web", "title": "Connected systems", "path": "admin.php?page=flx-ai-systems" },
    "tools": { "type": "web", "title": "Tools", "path": "admin.php?page=flx-ai-tools" },
    "mcp": { "type": "web", "title": "MCP", "path": "admin.php?page=flx-ai-mcp" }
  },
  "actions": {
    "open_chat": {
      "label": "Chat",
      "icon": "chat",
      "navigate": { "target": "screen:ai/chat" }
    }
  }
}
