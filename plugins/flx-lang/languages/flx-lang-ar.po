msgstr "أعادت منظمة العفو الدولية إجابة فارغة."

msgid "The AI answer was cut off."
msgstr "تم قطع إجابة الذكاء الاصطناعي."

msgid "Translation job not found or expired."
msgstr "لم يتم العثور على مهمة الترجمة أو انتهت صلاحيتها."

msgid "Alternative text (%s)"
msgstr "النص البديل (%s)"

msgid "Image (%s)"
msgstr "الصورة (%s)"

msgid "ID of the image shown instead of this one in this language (e.g. the translated version of a poster with text). Empty: same image."
msgstr "معرف الصورة المعروضة بدلاً من هذه الصورة بهذه اللغة (على سبيل المثال، النسخة المترجمة من الملصق الذي يحتوي على نص). فارغة: نفس الصورة."

