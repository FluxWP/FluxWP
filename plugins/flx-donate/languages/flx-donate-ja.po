msgstr "\\n作成された証明書:%1$s(%2$s)。%3$s\\n"

msgid "\\nCertificates made again (%d); the old ones were revoked.\\n"
msgstr "\\n証明書が再度作成されました (%d);古いものは取り消されました。\\n"

msgid "\\nNo delivery channel is chosen.\\n"
msgstr "\\n配信チャネルが選択されていません。\\n"

msgid "\\nQueued:%s.\\n"
msgstr "\\nキューに登録されました:%s。\\n"

msgid "\\nCopy to the donor:%s.\\n"
msgstr "\\n寄付者にコピーします:%s。\\n"

