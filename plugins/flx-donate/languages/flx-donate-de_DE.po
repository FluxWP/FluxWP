msgstr "MM/JJ"

msgid "CVC"
msgstr "CVC"

msgid "Save my card for next time"
msgstr "Speichern Sie meine Karte für das nächste Mal."

msgid "iyzico keeps the card; this site never stores card numbers."
msgstr "iyzico behält die Karte; Diese Website speichert niemals Kartennummern."

msgid "For the monthly donation iyzico keeps your card and charges it once a month. You can cancel at any time."
msgstr "Für die monatliche Spende behält iyzico Ihre Karte und lädt sie einmal im Monat auf. Sie können jederzeit kündigen."

msgid "Use another card"
msgstr "Verwenden Sie eine andere Karte"

msgid "Your saved cards"
msgstr "Ihre gespeicherten Karten"

msgid "Installments"
msgstr "Ratenzahlungen"

msgid "Single payment"
msgstr "Einzelzahlung"

msgid "%1$s installments × %2$s (total %3$s)"
msgstr "%1$s-Raten ×%2$s(insgesamt %3$s)"

msgid "Installment options appear after the card number."
msgstr "Ratenzahlungsoptionen erscheinen nach der Kartennummer."

msgid "Please check the card number."
msgstr "Bitte überprüfen Sie die Kartennummer."

msgid "Please write the name on the card."
msgstr "Bitte schreiben Sie den Namen auf die Karte."

msgid "Please check the expiry date."
msgstr "Bitte überprüfen Sie das Ablaufdatum."

msgid "Please check the security code (CVC)."
msgstr "Bitte überprüfen Sie den Sicherheitscode (CVC)."

