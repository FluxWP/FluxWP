msgstr "الشهر السابق"

msgid "Next month"
msgstr "الشهر التالي"

msgid "Previous year"
msgstr "السنة السابقة"

msgid "Next year"
msgstr "السنة التالية"

msgid "Choose month"
msgstr "اختر الشهر"

msgid "Choose year"
msgstr "اختر السنة"

msgid "OK"
msgstr "موافق"

msgid "Close"
msgstr "إغلاق"

msgid "Are you sure?"
msgstr "هل أنت متأكد؟"

