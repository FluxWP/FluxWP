msgstr "Details"

msgid "Harcama (USD)"
msgstr "Spend (USD)"

msgid "Cevaplanan soru"
msgstr "Questions answered"

msgid "Cevap verilen kişi"
msgstr "People answered"

msgid "Bağışa yönlendirilen kişi"
msgstr "People directed to donate"

msgid "Açılan bağış kaydı"
msgstr "Donation records created"

msgid "Onaylanan bağış · {a}"
msgstr "Confirmed donations · {a}"

msgid "Okunan dekont · ✓{a} ✕{b}"
msgstr "Receipts read · ✓{a} ✕{b}"

msgid "Ekibe devir"
msgstr "Handoff to the team"

msgid "Hafıza token · {p} kişi"
msgstr "Memory tokens · {p} contacts"

