msgstr "監査が更新されました"

msgid "Audit schedule"
msgstr "監査スケジュール"

msgid "Findings show up here after an audit runs."
msgstr "監査の実行後に検出結果がここに表示されます。"

msgid "Run audit"
msgstr "監査の実行"

msgid "Email"
msgstr "電子メール"

msgid "Don't index tags"
msgstr "タグのインデックスを作成しない"

msgid "IndexNow"
msgstr "今すぐインデックス"

