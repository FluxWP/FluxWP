msgstr "Lo siento, no se le permite gestionar fichas de diseño."

msgid "The requested design token library does not exist."
msgstr "La biblioteca de token de diseño solicitada no existe."

msgid "The token library was modified since you last read it. Reload and try again."
msgstr "La biblioteca de token fue modificada desde que la última vez que la leyó. Recargar e intentarlo de nuevo."

msgid "The user primitive document invariant failed."
msgstr "El invariante documento primitivo del usuario falló."

