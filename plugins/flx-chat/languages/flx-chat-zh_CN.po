msgstr "没有用户具有代理角色;目前只有管理员可以使用它。"

msgid "Live panel updates"
msgstr "实时面板更新"

msgid "Last update request %1$s. While the panel is open it checks for new messages every %2$d s (60 s in a background tab)."
msgstr "最后更新请求%1$s。当面板打开时,它会每隔%2$d秒(在后台选项卡中为 60 秒)检查新消息。"

msgid "The chat screen has not been opened yet."
msgstr "聊天屏幕尚未打开。"

msgid "WhatsApp line"
msgstr "WhatsApp专线"

msgid "No line added."
msgstr "没有添加任何行。"

