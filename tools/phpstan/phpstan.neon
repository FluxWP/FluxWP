# Strict analysis: new and migrated code (Flux GraphQL kit, package services/ and graphql/ folders).
# Level max, PHP 8.1–8.5. Every GraphQL work package adds its folders under `paths` (plan §2.7).
#   tools/phpstan/vendor/bin/phpstan analyse -c tools/phpstan/phpstan.neon
includes:
  - types.neon
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: max
  phpVersion:
    min: 80100
    max: 80500
  tmpDir: .cache
  bootstrapFiles:
    - bootstrap.php
  scanFiles:
    - ../../plugins/flx-graphql/vendor/wp-graphql/access-functions.php
    - ../../plugins/flx-app/flx-app.php
    - ../../plugins/flx-seo/flx-seo.php
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
  scanDirectories:
    - ../../plugins/flx-graphql/includes/flx-brand
    - ../../plugins/flx-graphql/vendor/wp-graphql/src
    - ../../plugins/flx-graphql/vendor/wp-graphql/vendor/webonyx
    - ../../plugins/flx-graphql/vendor/wp-graphql/vendor/ivome
    # Legacy code the strict folders call (scanned for symbols only).
    - ../../plugins/flx-tasks/includes
    - ../../plugins/flx-roles/includes
    - ../../themes/fluxwp/inc
    - ../../plugins/flx-blocks/includes
    - ../../plugins/flx-setup/includes
    - ../../plugins/flx-app/includes
    - ../../plugins/flx-lang/includes
    - ../../plugins/flx-seo/includes
    - ../../plugins/flx-crm/includes
  paths:
    - ../../plugins/flx-graphql/flx-graphql.php
    - ../../plugins/flx-graphql/uninstall.php
    - ../../plugins/flx-graphql/includes
    # Flux Tasks (GraphQL pilot)
    - ../../plugins/flx-tasks/includes/services
    - ../../plugins/flx-tasks/includes/graphql
    # Flux Roles (Faz 1)
    - ../../plugins/flx-roles/includes/services
    - ../../plugins/flx-roles/includes/graphql
    # FluxWP theme
    - ../../themes/fluxwp/inc/services
    - ../../themes/fluxwp/inc/graphql
    # Flux Block Editor (Faz 4)
    - ../../plugins/flx-blocks/includes/services
    - ../../plugins/flx-blocks/includes/graphql
    # FluxWP Panel (Faz 1)
    - ../../plugins/flx-setup/includes/services
    - ../../plugins/flx-setup/includes/graphql
    # Flux App (Faz 1)
    - ../../plugins/flx-app/includes/services
    - ../../plugins/flx-app/includes/graphql
    # Flux Lang (Faz 1)
    - ../../plugins/flx-lang/includes/services
    - ../../plugins/flx-lang/includes/graphql
    # Flux SEO (Faz 1)
    - ../../plugins/flx-seo/includes/services
    - ../../plugins/flx-seo/includes/graphql
    # Flux CRM (Faz 1)
    - ../../plugins/flx-crm/includes/services
    - ../../plugins/flx-crm/includes/graphql
  excludePaths:
    - ../../plugins/flx-graphql/includes/flx-brand
  treatPhpDocTypesAsCertain: false
  ignoreErrors:
    # The wizard steps file is loaded on demand (FLXK_DIR points at tools/phpstan here).
    - message: '#Path in require_once\(\) ".*/includes/onboarding\.php" is not a file#'
      path: ../../plugins/flx-setup/includes/graphql/schema.php
