msgid "The folder has more than %s files; copy it with SSH or a backup tool."
msgstr "У папки больше, чем у папки. %s - файлы; копировать их с SSH или с помощью резервного инструмента."

msgid "Could not copy (permissions or disk space)."
msgstr "Невозможно копировать (выбросы или дисковое пространство)."

msgid "AI can only delete folders with fewer than 2,000 files."
msgstr "Я могу удалить только буклеты с менее чем 2000 файлов."

msgid "Could not move to the trash (permissions)."
msgstr "Не мог переехать в мусор (выбросы)."

msgid "Permissions can only be changed from the Flux Files screen."
msgstr "Разрешения могут быть изменены только с экрана Flux Files."

msgid "Enter permissions as three digits, e.g. 644 or 755."
msgstr "Допускается на три цифры, например 644 или 755."

msgid "World-writable permissions (e.g. 777) are not allowed."
msgstr "Мировые разрешения (например, 777) не допускаются."

msgid "Permissions could not be changed."
msgstr "Разрешения не могут быть изменены."

msgid "Type at least 2 characters."
msgstr "Тип не менее двух знаков."

msgid "The PHP zip extension is not available on this server."
msgstr "На этом сервере отсутствует распространение PHP ципов."

msgid "Nothing selected."
msgstr "Ничего не выбранного."

msgid "The archive could not be created."
msgstr "Архив не мог быть создан."

msgid "Too many files for one archive."
msgstr "Слишком много файлов для одного архива."

msgid "This archive could not be opened."
msgstr "Этот архив не может быть открыт."

msgid "Too many files in this archive."
msgstr "Слишком много файлов в архиве."

msgid "The archive contains unsafe paths and was not extracted."
msgstr "Архив содержит небезопасные пути и не был извлечен."

msgid "Not enough disk space to extract this archive."
msgstr "Недостаточно дискового пространства для извлечения этого архива."

msgid "This folder is not shared. Open Flux Files, right-click the folder and choose \"Share on site\"."
msgstr "Открывайте Флюксы, направьте папку и выберите \"Шарь на месте\"."

msgid "Search files…"
msgstr "Обычные файлы..."

msgid "Search files"
msgstr "Обычные файлы"

msgid "%1$d result for \"%2$s\""
msgid_plural "%1$d results for \"%2$s\""
msgstr[0] "%1$d результат %2$s"
msgstr[1] "%1$d результаты %2$s"
msgstr[2] "%1$d результаты %2$s"

msgid "Clear"
msgstr "Очистить"

msgid "No files found."
msgstr "Никаких файлов."

msgid "This folder is empty."
msgstr "Эта папка пуста."

msgid "List files"
msgstr "Список файлов"

msgid "Read file"
msgstr "Файл для чтения"

msgid "File activity"
msgstr "Вид деятельности"

msgid "Files in trash"
msgstr "Фильмы в мусоре"

msgid "Write file"
msgstr "Письменный файл"

msgid "Edit file (find and replace)"
msgstr "Файл редактирования (окончается и заменяется)"

msgid "Create folder"
msgstr "Создать папку"

msgid "Move or rename"
msgstr "Переведено или переименовано"

msgid "Delete (to trash)"
msgstr "Исключить (в мусор)"

msgid "Restore from trash"
msgstr "Ресторан из мусора"

msgid "Unknown action."
msgstr "Неизвестное действие."

msgid "The upload failed. The file may be larger than the server allows."
msgstr "Загрузка не сработала, файл может быть больше, чем позволяет сервер."

msgid "The upload failed. Try again."
msgstr "Загрузка провалилась, попробуй еще раз."

msgid "Not enough disk space."
msgstr "Недостаточно дискового пространства."

msgid "The upload was interrupted. Try again."
msgstr "Загрузка была прервана."

msgid "Only folders inside the uploads folder can be shared on the site."
msgstr "На этом объекте могут быть размещены только патрубки внутри загрузочной папки."

msgid "Version not found."
msgstr "Версия не найдена."

msgid "This item is no longer in the trash."
msgstr "Этот предмет больше не в мусорке."

msgid "Could not restore (permissions)."
msgstr "Невозможно восстановить (выбросы)."

msgid "%d item"
msgid_plural "%d items"
msgstr[0] "%d"
msgstr[1] "%d элементы"
msgstr[2] "%d элементы"

msgid "Trash and versions folder"
msgstr "Папка для каталогов и версий"

msgid "Deleted files and earlier versions are kept in a private folder closed to the web."
msgstr "Удаленные файлы и более ранние варианты хранятся в закрытом помещении в Интернете."

msgid "The private folder under wp-content cannot be written. Deleting and versioning will fail; check the wp-content permissions."
msgstr "Не может быть написана личная папка под вентиляционным контентом."

msgid "ZIP support"
msgstr "Поддержка ЗИП"

msgid "Folders can be downloaded as ZIP, archived and extracted."
msgstr "Папки можно загружать в качестве ZIP, архивировать и извлекать."

msgid "The PHP zip extension is missing; ZIP download, archive and extract are off. Enable \"zip\" in the hosting PHP extensions."
msgstr "Пропуск PHP цип отсутствует; загрузка, архив и экстракция ZIP отключены."

msgid "File changes"
msgstr "Изменения скорости"

msgid "DISALLOW_FILE_MODS is on: Flux Files is read-only."
msgstr "ДИСАЛЛО_ФИЛЕ-МОДС включен: Флюксы - это только для чтения."

msgid "Only administrators can use Flux Files. wp-config.php, .htaccess and WordPress core folders are protected from deletion."
msgstr "Только администраторы могут использовать фильы Flux, а вентиляционные листки, вентиляционные и WordPress стержневые патрубки защищены от исключения."

msgid "DISALLOW_FILE_EDIT is on: code files (.php, .htaccess …) cannot be edited or uploaded."
msgstr "DESALOW_FILE_EDIT включен: файлы кодов (.php, .htacess ...) не могут быть отредактированы или загружены."

msgid "AI and MCP file access"
msgstr "AI and MCP Доступ к файлам"

msgid "External MCP clients can change and delete files. Turn this off when you no longer need it."
msgstr "Внешние клиенты MCP могут изменить и исключить файлы, выключить их, когда тебе больше не нужно."

msgid "AI chat asks before every change; external MCP clients can only read. Secret files are never shared."
msgstr "I talk asks before every change; external MCP Клиенты могут читать только секретные файлы никогда не делятся."

msgid "Trash cleanup"
msgstr "Траш-уборка"

msgid "The trash was last cleaned %s. It is also cleaned when an administrator opens Flux Files."
msgstr "Последний мусор был очищен %s и он также очищен, когда администратор открывает Флукс Филс."
