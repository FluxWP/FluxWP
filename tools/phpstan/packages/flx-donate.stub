	/** @return string */
	public static function h( mixed $s ) {}

	/** @return bool */
	public static function rate( mixed $key, mixed $max, mixed $window ) {}

	/** @return string */
	public static function sent_message( mixed $via ) {}

	/** @return string|false */
	public static function deliver( mixed $type, mixed $value, mixed $code ) {}

	/** @return array{who: string, account: bool, count: int, total_label: string, items: list<array{id: int, title: string, status: string, date: string, amount: float, currency: string}>, certificates: list<array{code: string}>, donate_url: string} */
	public static function proven( mixed $type, mixed $value ) {}

	/** @return array{who: string, account: bool, count: int, total_label: string, items: list<array{id: int, title: string, status: string, date: string, amount: float, currency: string}>, certificates: list<array{code: string}>, donate_url: string} */
	public static function account( mixed $user_id ) {}

	/** @return list<array<int, array<string, mixed>>> */
	public static function gifts( mixed $type, mixed $value ) {}

	/** @return void */
	public static function set_cookie( mixed $value, mixed $expire ) {}

	/** @return array{type: string, value: string}|null */
