{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "680px", "wideSize": "1040px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "white", "name": "Beyaz", "color": "#FFFFFF" },
        { "slug": "ink", "name": "Metin", "color": "#1D2327" },
        { "slug": "muted", "name": "Soluk", "color": "#646970" },
        { "slug": "line", "name": "Çizgi", "color": "#E5E7EB" },
        { "slug": "green", "name": "Yeşil", "color": "#1F8A4C" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        { "slug": "system", "name": "Sistem", "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Küçük", "size": "0.9rem" },
        { "slug": "medium", "name": "Orta", "size": "1.0625rem" },
        { "slug": "large", "name": "Büyük", "size": "1.5rem", "fluid": { "min": "1.3rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Çok büyük", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vh", "vw" ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|white", "text": "var:preset|color|ink" },
    "typography": { "fontFamily": "var:preset|font-family|system", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.6" },
    "spacing": { "padding": { "top": "0", "bottom": "0", "left": "20px", "right": "20px" }, "blockGap": "1.25rem" },
    "elements": {
      "link": { "color": { "text": "var:preset|color|green" } },
      "heading": { "typography": { "fontWeight": "700", "lineHeight": "1.25" } },
      "h1": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|large" } }
    }
  },
  "templateParts": [],
  "customTemplates": []
}
