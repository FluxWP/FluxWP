msgid "\\n%sSapling Donation\\n"
msgstr "\\n%s苗木の寄付\\n"

msgid "\\nCertificate no\\n"
msgstr "\\n証明書がありません\\n"

msgid "\\nThe certificate could not be made: no Flux Certificates template was found (Donations › Settings › WooCommerce).\\n"
msgstr "\\n証明書を作成できませんでした。Flux 証明書テンプレートが見つかりませんでした (寄付 › 設定 › WooCommerce)。\\n"

msgid "\\nThe certificate could not be made:%s\\n"
msgstr "\\n証明書を作成できませんでした:%s\\n"

msgid "\\nNot sent yet.\\n"
msgstr "\\nまだ送信されていません。\\n"

