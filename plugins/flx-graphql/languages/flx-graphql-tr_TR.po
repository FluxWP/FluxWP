msgid ""
msgstr ""
"Project-Id-Version: Flux GraphQL\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: tr_TR\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Flux GraphQL"
msgstr "Flux GraphQL"

msgid "Settings"
msgstr "Ayarlar"

msgid "You do not have permission to do this."
msgstr "Bunu yapmaya yetkiniz yok."

msgid "One GraphQL API for the FluxWP plugins. Screens in wp-admin, the FluxWP desktop and mobile apps and a headless front end all read the same typed schema."
msgstr "FluxWP eklentileri için tek GraphQL API. wp-admin ekranları, FluxWP masaüstü ve mobil uygulamaları ve headless ön yüz aynı tipli şemayı okur."

msgid "Settings saved."
msgstr "Ayarlar kaydedildi."

msgid "The separate WPGraphQL plugin was deactivated; the built-in copy is in use."
msgstr "Ayrı WPGraphQL eklentisi devre dışı bırakıldı; yerleşik kopya kullanılıyor."

msgid "Status"
msgstr "Durum"

msgid "Endpoint"
msgstr "Adres"

msgid "WPGraphQL"
msgstr "WPGraphQL"

msgid "%s (built in)"
msgstr "%s (yerleşik)"

msgid "%s (separate plugin)"
msgstr "%s (ayrı eklenti)"

msgid "not loaded"
msgstr "yüklenmedi"

msgid "working"
msgstr "çalışıyor"

msgid "off"
msgstr "kapalı"

msgid "Known queries"
msgstr "Tanınan sorgular"

msgid "%1$d from %2$d packages"
msgstr "%2$d paketten %1$d"

msgid "Upload endpoint"
msgstr "Yükleme adresi"

msgid "Use the Flux GraphQL version"
msgstr "Flux GraphQL sürümünü kullan"

msgid "Open GraphiQL IDE"
msgstr "GraphiQL IDE'yi aç"

msgid "Access"
msgstr "Erişim"

msgid "Only queries shipped with FluxWP packages (recommended)"
msgstr "Yalnız FluxWP paketleriyle gelen sorgular (önerilen)"

msgid "Administrators may also send any query"
msgstr "Yöneticiler her sorguyu da gönderebilir"

msgid "Anyone may send any query (public headless API)"
msgstr "Herkes her sorguyu gönderebilir (herkese açık headless API)"

msgid "Which queries run"
msgstr "Hangi sorgular çalışır"

msgid "Persisted queries keep the API small and let LiteSpeed cache public reads."
msgstr "Kayıtlı sorgular API'yi dar tutar ve herkese açık okumaların LiteSpeed önbelleğine girmesini sağlar."

msgid "Front-end origins"
msgstr "Ön yüz adresleri"

msgid "Sites allowed to call /graphql from the browser, one per line. This site is always allowed."
msgstr "Tarayıcıdan /graphql çağırabilecek siteler, her satıra bir tane. Bu site her zaman izinlidir."

msgid "GraphiQL IDE for administrators"
msgstr "Yöneticiler için GraphiQL IDE"

msgid "Also lets administrators run any query while it is on."
msgstr "Açıkken yöneticiler her sorguyu da çalıştırabilir."

msgid "Public schema introspection"
msgstr "Herkese açık şema okuma (introspection)"

msgid "Administrators can always read the schema."
msgstr "Yöneticiler şemayı her zaman okuyabilir."

msgid "Debug messages for administrators"
msgstr "Yöneticiler için hata ayıklama mesajları"

msgid "Limits"
msgstr "Sınırlar"

msgid "Deepest nesting"
msgstr "En derin iç içelik"

msgid "Highest complexity"
msgstr "En yüksek karmaşıklık"

msgid "Records per page"
msgstr "Sayfa başına kayıt"

msgid "Queries per batch"
msgstr "Toplu istekte sorgu"

msgid "Public cache"
msgstr "Herkese açık önbellek"

msgid "sec"
msgstr "sn"

msgid "Largest upload"
msgstr "En büyük yükleme"

msgid "The FluxWP form fields could not load. Reinstall Flux GraphQL."
msgstr "FluxWP form alanları yüklenemedi. Flux GraphQL'i yeniden kurun."

msgid "Shared hosting: keep the limits low. A query that goes over them is refused before it runs."
msgstr "Paylaşımlı barındırmada sınırları düşük tutun. Sınırı aşan sorgu çalışmadan reddedilir."

msgid "Save"
msgstr "Kaydet"

msgid "GraphQL server"
msgstr "GraphQL sunucusu"

msgid "Flux GraphQL settings"
msgstr "Flux GraphQL ayarları"

msgid "Built-in WPGraphQL %s is running."
msgstr "Yerleşik WPGraphQL %s çalışıyor."

msgid "A separately installed WPGraphQL %1$s is running instead of the built-in %2$s. It works, but its updates are not tested with FluxWP. Use the built-in copy unless another plugin needs the separate one."
msgstr "Yerleşik %2$s yerine ayrı kurulmuş WPGraphQL %1$s çalışıyor. Çalışır, ama güncellemeleri FluxWP ile test edilmez. Başka bir eklenti ayrı kopyaya ihtiyaç duymuyorsa yerleşik kopyayı kullanın."

msgid "A separately installed WPGraphQL %1$s is active. FluxWP needs %2$s or newer and below %3$s, so FluxWP GraphQL screens fall back to the classic pages. Deactivate it to use the built-in copy."
msgstr "Ayrı kurulmuş WPGraphQL %1$s etkin. FluxWP %2$s veya üstünü ve %3$s altını ister; bu yüzden FluxWP GraphQL ekranları klasik sayfalara döner. Yerleşik kopyayı kullanmak için onu devre dışı bırakın."

msgid "The built-in WPGraphQL files are missing. Reinstall Flux GraphQL from FluxWP Panel › Packages."
msgstr "Yerleşik WPGraphQL dosyaları eksik. Flux GraphQL'i FluxWP Panel › Paketler'den yeniden kurun."

msgid "GraphQL queries"
msgstr "GraphQL sorguları"

msgid "Anyone may send any GraphQL query. Keep this only for a public headless front end; depth and complexity limits still apply."
msgstr "Herkes her GraphQL sorgusunu gönderebilir. Bunu yalnız herkese açık bir headless ön yüz için açık tutun; derinlik ve karmaşıklık sınırları yine geçerlidir."

msgid "GraphQL types"
msgstr "GraphQL tipleri"

msgid "Some GraphQL fields were refused because they break the FluxWP rules: %s. Update the package that adds them."
msgstr "Bazı GraphQL alanları FluxWP kurallarına uymadığı için reddedildi: %s. Onları ekleyen paketi güncelleyin."

msgid "Flux GraphQL: the separately installed WPGraphQL %s is not supported, so FluxWP GraphQL screens are off."
msgstr "Flux GraphQL: ayrı kurulmuş WPGraphQL %s desteklenmiyor, bu yüzden FluxWP GraphQL ekranları kapalı."

msgid "Only queries shipped with FluxWP packages run (%d known)."
msgstr "Yalnız FluxWP paketleriyle gelen sorgular çalışır (%d tanınan)."

msgid "You are not allowed to manage plugins."
msgstr "Eklentileri yönetmeye yetkiniz yok."

msgid "This screen needs JavaScript."
msgstr "Bu ekran JavaScript gerektirir."

msgid "Loading the screen…"
msgstr "Ekran yükleniyor…"

msgid "Uploads are not accepted for this screen."
msgstr "Bu ekran için dosya yüklenemez."

msgid "You do not have permission to upload files here."
msgstr "Buraya dosya yüklemeye yetkiniz yok."

msgid "Too many uploads. Wait a few minutes and try again."
msgstr "Çok fazla yükleme. Birkaç dakika bekleyip yeniden deneyin."

msgid "The file did not arrive. Try again."
msgstr "Dosya ulaşmadı. Yeniden deneyin."

msgid "The file is larger than %s."
msgstr "Dosya %s boyutundan büyük."

msgid "This file type is not allowed."
msgstr "Bu dosya türüne izin verilmiyor."

msgid "The file could not be saved on the server."
msgstr "Dosya sunucuya kaydedilemedi."

msgid "The uploaded file was not found. Upload it again."
msgstr "Yüklenen dosya bulunamadı. Yeniden yükleyin."

msgid "A name and value shown under a cart line (variation attribute or line detail)."
msgstr "Sepet satırının altında görünen ad ve değer (varyasyon özelliği ya da satır ayrıntısı)."

msgid "Label."
msgstr "Etiket."

msgid "Value as plain text."
msgstr "Düz metin değer."

msgid "Quantities a cart line accepts."
msgstr "Sepet satırının kabul ettiği adetler."

msgid "Lowest quantity."
msgstr "En düşük adet."

msgid "Highest quantity."
msgstr "En yüksek adet."

msgid "The quantity is a multiple of this."
msgstr "Adet bunun katıdır."

msgid "Whether the shopper may change the quantity (false for fixed lines such as a donation)."
msgstr "Alışveriş yapan adedi değiştirebilir mi (bağış gibi sabit satırlarda false)."

msgid "A line in the cart."
msgstr "Sepetteki bir satır."

msgid "Cart item key; flxCartItemUpdate and flxCartItemRemove take it."
msgstr "Sepet satırı anahtarı; flxCartItemUpdate ve flxCartItemRemove bunu alır."

msgid "What the line is: \"product\", or a name a package gives its own lines (Flux Donate: \"donation\"). Filter flx_gql_cart_item_kind."
msgstr "Satırın türü: \"product\" ya da bir paketin kendi satırlarına verdiği ad (Flux Donate: \"donation\"). Filtre flx_gql_cart_item_kind."

msgid "WooCommerce product (or variation) database ID."
msgstr "WooCommerce ürün (ya da varyasyon) veritabanı ID'si."

msgid "WooCommerce product type (simple, variation …)."
msgstr "WooCommerce ürün türü (simple, variation …)."

msgid "Product name."
msgstr "Ürün adı."

msgid "SKU; empty when the product has none."
msgstr "Stok kodu; ürünün yoksa boş."

msgid "Product page; null for products without a page."
msgstr "Ürün sayfası; sayfası olmayan üründe null."

msgid "First product image; null without an image."
msgstr "İlk ürün görseli; görsel yoksa null."

msgid "Alternative text of the image."
msgstr "Görselin alternatif metni."

msgid "Quantity."
msgstr "Adet."

msgid "Quantities this line accepts."
msgstr "Bu satırın kabul ettiği adetler."

msgid "Only one of this product per order."
msgstr "Siparişte bu üründen yalnız bir tane."

msgid "Price of one unit."
msgstr "Birim fiyat."

msgid "Regular price of one unit (before a sale)."
msgstr "Birimin normal fiyatı (indirimden önce)."

msgid "Line total before coupons."
msgstr "Kuponlardan önce satır toplamı."

msgid "Line total after coupons, without tax."
msgstr "Kuponlardan sonra, vergisiz satır toplamı."

msgid "Tax of the line."
msgstr "Satırın vergisi."

msgid "Chosen variation attributes."
msgstr "Seçilen varyasyon özellikleri."

msgid "Line details other plugins add (e.g. a donation's names and certificate)."
msgstr "Diğer eklentilerin eklediği satır ayrıntıları (ör. bağışın adları ve sertifikası)."

msgid "A coupon applied to the cart."
msgstr "Sepete uygulanan kupon."

msgid "Coupon code."
msgstr "Kupon kodu."

msgid "WooCommerce discount type (percent, fixed_cart …)."
msgstr "WooCommerce indirim türü (percent, fixed_cart …)."

msgid "Discount without tax."
msgstr "Vergisiz indirim."

msgid "Tax part of the discount."
msgstr "İndirimin vergi kısmı."

msgid "A fee added to the cart (e.g. a payment fee)."
msgstr "Sepete eklenen ücret (ör. ödeme ücreti)."

msgid "Fee key."
msgstr "Ücret anahtarı."

msgid "Fee name."
msgstr "Ücret adı."

msgid "Fee without tax."
msgstr "Vergisiz ücret."

msgid "Tax of the fee."
msgstr "Ücretin vergisi."

msgid "One tax rate in the cart totals."
msgstr "Sepet toplamındaki bir vergi oranı."

msgid "Tax name."
msgstr "Vergi adı."

msgid "Rate as WooCommerce shows it."
msgstr "WooCommerce'in gösterdiği oran."

msgid "Amount."
msgstr "Tutar."

msgid "Cart totals, as WooCommerce calculated them."
msgstr "WooCommerce'in hesapladığı sepet toplamları."

msgid "ISO 4217 currency of the cart."
msgstr "Sepetin ISO 4217 para birimi."

msgid "Lines before coupons, without tax."
msgstr "Kuponlardan önce, vergisiz satırlar."

msgid "Tax of the lines."
msgstr "Satırların vergisi."

msgid "Fees without tax."
msgstr "Vergisiz ücretler."

msgid "Coupon discounts without tax."
msgstr "Vergisiz kupon indirimleri."

msgid "Shipping without tax; null until shipping is calculated."
msgstr "Vergisiz kargo; kargo hesaplanana kadar null."

msgid "All taxes."
msgstr "Tüm vergiler."

msgid "Amount to pay."
msgstr "Ödenecek tutar."

msgid "Taxes by rate."
msgstr "Orana göre vergiler."

msgid "A shipping option."
msgstr "Bir kargo seçeneği."

msgid "Rate ID for flxCartShippingRateSelect."
msgstr "flxCartShippingRateSelect için seçenek ID'si."

msgid "Shipping method (flat_rate, free_shipping …)."
msgstr "Kargo yöntemi (flat_rate, free_shipping …)."

msgid "Name."
msgstr "Ad."

msgid "Description; may be empty."
msgstr "Açıklama; boş olabilir."

msgid "Delivery time; may be empty."
msgstr "Teslim süresi; boş olabilir."

msgid "Price without tax."
msgstr "Vergisiz fiyat."

msgid "Whether this option is chosen."
msgstr "Bu seçenek seçili mi."

msgid "A group of lines shipped together and its shipping options."
msgstr "Birlikte gönderilen satırlar ve kargo seçenekleri."

msgid "Package ID."
msgstr "Paket ID'si."

msgid "Package name."
msgstr "Paket adı."

msgid "Shipping options."
msgstr "Kargo seçenekleri."

msgid "E-mail; null on the shipping address."
msgstr "E-posta; teslimat adresinde null."

msgid "A billing or shipping address of the cart."
msgstr "Sepetin fatura ya da teslimat adresi."

msgid "A problem with the cart the shopper has to fix before paying (e.g. a product went out of stock)."
msgstr "Ödemeden önce düzeltilmesi gereken sepet sorunu (ör. ürün stoktan çıktı)."

msgid "WooCommerce error code."
msgstr "WooCommerce hata kodu."

msgid "Message in the shopper's language."
msgstr "Alışveriş yapanın dilinde mesaj."

msgid "Where the payment step continues. Payment stays on the WooCommerce Store API checkout; card data never goes through GraphQL."
msgstr "Ödeme adımının devam ettiği yer. Ödeme WooCommerce Store API checkout'unda kalır; kart verisi hiçbir zaman GraphQL'den geçmez."

msgid "Store API checkout URL (POST with the same Cart-Token, billing address and payment method)."
msgstr "Store API checkout adresi (aynı Cart-Token, fatura adresi ve ödeme yöntemiyle POST)."

msgid "The site's checkout page; null when WooCommerce is not loaded."
msgstr "Sitenin ödeme sayfası; WooCommerce yüklü değilse null."

msgid "The site's cart page; null when WooCommerce is not loaded."
msgstr "Sitenin sepet sayfası; WooCommerce yüklü değilse null."

msgid "The shopper's WooCommerce cart (Store API)."
msgstr "Alışveriş yapanın WooCommerce sepeti (Store API)."

msgid "Cart token. Send it back as the Cart-Token header (headless front end, mobile); it is also in the Cart-Token response header. Null when WooCommerce gave none."
msgstr "Sepet belirteci. Cart-Token başlığıyla geri gönderin (headless ön yüz, mobil); Cart-Token yanıt başlığında da gelir. WooCommerce vermediyse null."

msgid "Store API nonce for the same-site cookie session (Nonce header). Null when WooCommerce gave none."
msgstr "Aynı site çerez oturumu için Store API nonce'u (Nonce başlığı). WooCommerce vermediyse null."

msgid "Number of units in the cart (quantities added up)."
msgstr "Sepetteki toplam adet."

msgid "Lines."
msgstr "Satırlar."

msgid "Applied coupons."
msgstr "Uygulanan kuponlar."

msgid "Fees."
msgstr "Ücretler."

msgid "Totals."
msgstr "Toplamlar."

msgid "Whether the order needs a payment (false for a free cart)."
msgstr "Sipariş ödeme gerektiriyor mu (ücretsiz sepette false)."

msgid "Whether the order is shipped (false for donations and virtual products)."
msgstr "Sipariş kargoyla gönderilecek mi (bağış ve sanal üründe false)."

msgid "Whether shipping was calculated for the current address."
msgstr "Kargo mevcut adres için hesaplandı mı."

msgid "Shipping packages and their options."
msgstr "Kargo paketleri ve seçenekleri."

msgid "IDs of the payment gateways available for this cart (payment_method of the checkout)."
msgstr "Bu sepet için kullanılabilen ödeme yöntemlerinin ID'leri (checkout'taki payment_method)."

msgid "Features a gateway must support for this cart (e.g. products, subscriptions)."
msgstr "Bu sepet için ödeme yönteminin desteklemesi gereken özellikler (ör. products, subscriptions)."

msgid "Problems to fix before paying."
msgstr "Ödemeden önce düzeltilecek sorunlar."

msgid "Billing address."
msgstr "Fatura adresi."

msgid "Shipping address."
msgstr "Teslimat adresi."

msgid "Where the payment step continues."
msgstr "Ödeme adımının devam ettiği yer."

msgid "A variation attribute."
msgstr "Bir varyasyon özelliği."

msgid "Attribute name or taxonomy (e.g. pa_color)."
msgstr "Özellik adı ya da taksonomisi (ör. pa_color)."

msgid "Chosen value."
msgstr "Seçilen değer."

msgid "Address fields to change; fields left out keep their value."
msgstr "Değişecek adres alanları; verilmeyen alanlar değişmez."

msgid "The shopper's cart (Cart-Token session or the WooCommerce session cookie). Never cached."
msgstr "Alışveriş yapanın sepeti (Cart-Token oturumu ya da WooCommerce oturum çerezi). Asla önbelleğe alınmaz."

msgid "The cart after the change; null when the change failed."
msgstr "Değişiklikten sonraki sepet; değişiklik başarısızsa null."

msgid "Adds a product to the cart (Store API cart/add-item)."
msgstr "Sepete ürün ekler (Store API cart/add-item)."

msgid "Product or variation database ID."
msgstr "Ürün ya da varyasyon veritabanı ID'si."

msgid "Quantity; default 1."
msgstr "Adet; varsayılan 1."

msgid "Variation attributes for a variable product."
msgstr "Varyasyonlu ürün için varyasyon özellikleri."

msgid "Key of the line that was added or increased; null when the change failed."
msgstr "Eklenen ya da artırılan satırın anahtarı; değişiklik başarısızsa null."

msgid "Changes the quantity of a cart line; 0 removes it."
msgstr "Sepet satırının adedini değiştirir; 0 satırı siler."

msgid "Cart item key."
msgstr "Sepet satırı anahtarı."

msgid "New quantity."
msgstr "Yeni adet."

msgid "Removes a cart line."
msgstr "Sepet satırını siler."

msgid "Empties the cart."
msgstr "Sepeti boşaltır."

msgid "Applies a coupon."
msgstr "Kupon uygular."

msgid "Removes a coupon."
msgstr "Kuponu kaldırır."

msgid "Chooses a shipping option."
msgstr "Kargo seçeneği seçer."

msgid "Rate ID (FlxCartShippingRate.rateId)."
msgstr "Seçenek ID'si (FlxCartShippingRate.rateId)."

msgid "Shipping package; left out = every package."
msgstr "Kargo paketi; verilmezse tüm paketler."

msgid "Changes the billing and/or shipping address; totals, taxes and shipping options follow."
msgstr "Fatura ve/veya teslimat adresini değiştirir; toplamlar, vergiler ve kargo seçenekleri buna göre güncellenir."

msgid "Billing address fields to change."
msgstr "Değişecek fatura adresi alanları."

msgid "Shipping address fields to change."
msgstr "Değişecek teslimat adresi alanları."

msgid "First name."
msgstr "Ad."

msgid "Last name."
msgstr "Soyad."

msgid "Company."
msgstr "Şirket."

msgid "Address line 1."
msgstr "Adres satırı 1."

msgid "Address line 2."
msgstr "Adres satırı 2."

msgid "City."
msgstr "Şehir."

msgid "State or province code."
msgstr "İl kodu."

msgid "Postcode."
msgstr "Posta kodu."

msgid "ISO 3166-1 alpha-2 country code."
msgstr "ISO 3166-1 alpha-2 ülke kodu."

msgid "E-mail."
msgstr "E-posta."

msgid "Phone."
msgstr "Telefon."

msgid "Choose a product."
msgstr "Bir ürün seçin."

msgid "The quantity must be at least 1."
msgstr "Adet en az 1 olmalı."

msgid "The quantity cannot be negative."
msgstr "Adet negatif olamaz."

msgid "Enter a coupon code."
msgstr "Kupon kodu girin."

msgid "The shop is not available on this site."
msgstr "Bu sitede mağaza kullanılamıyor."

msgid "Your cart has expired. Please reload the page."
msgstr "Sepetinizin süresi doldu. Lütfen sayfayı yenileyin."

msgid "The cart could not be changed. Please reload the page."
msgstr "Sepet değiştirilemedi. Lütfen sayfayı yenileyin."

msgid "The user making the request and what they may do."
msgstr "İsteği yapan kullanıcı ve yapabildikleri."

msgid "Whether the request is signed in."
msgstr "İstek giriş yapmış bir kullanıcıdan mı."

msgid "User ID; empty for a visitor."
msgstr "Kullanıcı ID'si; ziyaretçide boş."

msgid "Display name; empty for a visitor."
msgstr "Görünen ad; ziyaretçide boş."

msgid "Whether the user manages the site (manage_options)."
msgstr "Kullanıcı siteyi yönetiyor mu (manage_options)."

msgid "Capabilities from the FluxWP catalog that the user has."
msgstr "FluxWP kataloğundan kullanıcıda olan yetkiler."

msgid "Whether the user has this capability."
msgstr "Kullanıcıda bu yetki var mı."

msgid "Capability name, e.g. flxg_use."
msgstr "Yetki adı, ör. flxg_use."

msgid "A capability a FluxWP package checks."
msgstr "Bir FluxWP paketinin kontrol ettiği yetki."

msgid "What the capability allows, in the user's language."
msgstr "Yetkinin neye izin verdiği, kullanıcının dilinde."

msgid "Group label (usually the package); empty when not given."
msgstr "Grup adı (genelde paket); verilmezse boş."

msgid "Package slug that declares it; empty when not given."
msgstr "Yetkiyi bildiren paketin slug'ı; verilmezse boş."

msgid "Whether the current user has it."
msgstr "Geçerli kullanıcıda var mı."

msgid "The user making the request. A visitor gets loggedIn false and no capabilities."
msgstr "İsteği yapan kullanıcı. Ziyaretçide loggedIn false, yetki listesi boş."

msgid "The FluxWP capability catalog, with what the current user has."
msgstr "FluxWP yetki kataloğu ve geçerli kullanıcıda olanlar."

msgid "Where a page sits in a list."
msgstr "Sayfanın listedeki yeri."

msgid "More records follow this page."
msgstr "Bu sayfadan sonra başka kayıt var."

msgid "Records come before this page."
msgstr "Bu sayfadan önce kayıt var."

msgid "Cursor of the first record on this page."
msgstr "Bu sayfadaki ilk kaydın imleci."

msgid "Cursor of the last record on this page; pass it as \"after\" for the next page."
msgstr "Bu sayfadaki son kaydın imleci; sonraki sayfa için \"after\" olarak verin."

msgid "One %s in a list, with its cursor."
msgstr "Listedeki bir %s, imleciyle."

msgid "Opaque cursor of this record."
msgstr "Bu kaydın opak imleci."

msgid "The record."
msgstr "Kayıt."

msgid "A page of %s records."
msgstr "Bir sayfa %s kaydı."

msgid "Records with their cursors."
msgstr "İmleçleriyle kayıtlar."

msgid "Records of this page."
msgstr "Bu sayfanın kayıtları."

msgid "Paging information."
msgstr "Sayfalama bilgisi."

msgid "All matching records (null when counting would be slow)."
msgstr "Eşleşen tüm kayıtlar (saymak yavaş olacaksa null)."

msgid "Records per page (at most %d)."
msgstr "Sayfa başına kayıt (en fazla %d)."

msgid "Cursor to continue after (pageInfo.endCursor)."
msgstr "Sonrasından devam edilecek imleç (pageInfo.endCursor)."

msgid "The page cursor is not valid."
msgstr "Sayfa imleci geçerli değil."

msgid "Please sign in again."
msgstr "Lütfen yeniden giriş yapın."

msgid "The record was not found."
msgstr "Kayıt bulunamadı."

msgid "Some fields are not valid."
msgstr "Bazı alanlar geçerli değil."

msgid "The record was changed by someone else. Reload and try again."
msgstr "Kaydı başka biri değiştirdi. Yenileyip yeniden deneyin."

msgid "Too many requests. Wait a moment and try again."
msgstr "Çok fazla istek. Biraz bekleyip yeniden deneyin."

msgid "Something went wrong. Please try again."
msgstr "Bir sorun oluştu. Lütfen yeniden deneyin."

msgid "This query is not known to the site. Update the app or the FluxWP packages."
msgstr "Bu sorgu sitede tanınmıyor. Uygulamayı ya da FluxWP paketlerini güncelleyin."

msgid "Only queries shipped with FluxWP packages may run on this site."
msgstr "Bu sitede yalnız FluxWP paketleriyle gelen sorgular çalışabilir."

msgid "The ID is not valid."
msgstr "Kimlik geçerli değil."

msgid "Global ID."
msgstr "Genel kimlik (global ID)."

msgid "Database ID."
msgstr "Veritabanı kimliği."

msgid "Input problems to show next to the form fields. Empty when the mutation succeeded."
msgstr "Form alanlarının yanında gösterilecek girdi sorunları. İşlem başarılıysa boş."

msgid "Changes to %s. Only the fields you send are changed."
msgstr "%s değişiklikleri. Yalnız gönderdiğiniz alanlar değişir."

msgid "Panel settings of the installed FluxWP packages (from flx_settings_schema)."
msgstr "Kurulu FluxWP paketlerinin panel ayarları (flx_settings_schema'dan)."

msgid "Panel settings of the installed FluxWP packages."
msgstr "Kurulu FluxWP paketlerinin panel ayarları."

msgid "Changes panel settings. Only the groups and fields you send are written."
msgstr "Panel ayarlarını değiştirir. Yalnız gönderdiğiniz gruplar ve alanlar yazılır."

msgid "Settings after the change."
msgstr "Değişiklikten sonraki ayarlar."

msgid "This setting cannot be changed here."
msgstr "Bu ayar burada değiştirilemez."

msgid "A list or object is expected."
msgstr "Liste ya da nesne bekleniyor."

msgid "This choice is not available."
msgstr "Bu seçenek yok."

msgid "Enter a colour like #1F6FEB."
msgstr "#1F6FEB gibi bir renk girin."

msgid "Free-form JSON value (object, list, string, number or boolean)."
msgstr "Serbest JSON değeri (nesne, liste, metin, sayı ya da mantıksal)."

msgid "A problem with the input of a mutation, shown next to the form field."
msgstr "Bir işlemin girdisindeki sorun; form alanının yanında gösterilir."

msgid "Stable code: INVALID_INPUT, CONFLICT, …"
msgstr "Sabit kod: INVALID_INPUT, CONFLICT, …"

msgid "Message in the user's language."
msgstr "Kullanıcının dilinde mesaj."

msgid "Input field (dotted path) the problem belongs to."
msgstr "Sorunun ait olduğu girdi alanı (noktalı yol)."

msgid "A point in time with labels in the user's language."
msgstr "Kullanıcının dilinde etiketleriyle bir zaman."

msgid "ISO 8601 in UTC (2026-11-15T14:59:00Z)."
msgstr "UTC'de ISO 8601 (2026-11-15T14:59:00Z)."

msgid "Unix timestamp."
msgstr "Unix zaman damgası."

msgid "Date and time for display, in the site time zone and the user's language."
msgstr "Gösterim için tarih ve saat; site saat diliminde ve kullanıcının dilinde."

msgid "Relative time for display (\"5 minutes ago\")."
msgstr "Gösterim için göreli zaman (\"5 dakika önce\")."

msgid "An amount of money."
msgstr "Bir para tutarı."

msgid "Amount in the currency unit (150.5)."
msgstr "Para biriminde tutar (150.5)."

msgid "ISO 4217 code (TRY, USD)."
msgstr "ISO 4217 kodu (TRY, USD)."

msgid "Amount with the currency sign for display."
msgstr "Gösterim için para işaretiyle tutar."

msgid "A phone number."
msgstr "Bir telefon numarası."

msgid "E.164 form (+905301234567); empty when the number is not valid."
msgstr "E.164 biçimi (+905301234567); numara geçersizse boş."

msgid "Digits only (905301234567)."
msgstr "Yalnız rakamlar (905301234567)."

msgid "Number as entered, for display."
msgstr "Gösterim için girildiği gibi numara."

msgid "A stored file."
msgstr "Saklanan bir dosya."

msgid "File ID (upload ID or the package's own ID)."
msgstr "Dosya kimliği (yükleme kimliği ya da paketin kendi kimliği)."

msgid "File name."
msgstr "Dosya adı."

msgid "MIME type."
msgstr "MIME türü."

msgid "Size in bytes."
msgstr "Bayt cinsinden boyut."

msgid "Download address (may need the same sign-in)."
msgstr "İndirme adresi (aynı giriş gerekebilir)."

msgid "The file is an image."
msgstr "Dosya bir görsel."

msgid "Thumbnail address for images."
msgstr "Görseller için küçük resim adresi."

msgid "A person (donor, customer, contact). Flux CRM owns the record; other packages return it."
msgstr "Bir kişi (bağışçı, müşteri, kişi). Kaydın sahibi Flux CRM; diğer paketler onu döndürür."

msgid "Person ID in the shared people table."
msgstr "Ortak kişi tablosundaki kişi kimliği."

msgid "Full name."
msgstr "Ad soyad."

msgid "E-mail address."
msgstr "E-posta adresi."

msgid "Phone number."
msgstr "Telefon numarası."

msgid "Picture address."
msgstr "Resim adresi."

