msgid "QR Menüler"
msgstr "QR Menus"

msgid "Menü açabilir"
msgstr "Can create menus"

msgid "Adres/alt alan adı değiştirebilir"
msgstr "Can change address/subdomain"

msgid "QR Menülerim"
msgstr "My QR menus"

msgid "Size atanmış menü yok."
msgstr "No menus are assigned to you."

msgid "QR Menü yetkileri"
msgstr "QR Menu permissions"

msgid "Menü yöneticisi"
msgstr "Menu manager"

msgid "Menü yöneticisi yalnız kendi açtığı ve kendisine atanan menüleri görür. Menüye atama, menünün Paylaş sekmesinden yapılır."
msgstr "A menu manager only sees menus they created or were assigned to. Assign menus on the menu's Share tab."

msgid "Adres yalnız küçük harf (a-z), rakam ve tire içerebilir; tireyle başlayıp bitemez."
msgstr "The address may only contain lowercase letters (a-z), digits and hyphens, and cannot start or end with a hyphen."

msgid "\"%s\" WordPress tarafından kullanılıyor, başka bir adres seçin."
msgstr "\"%s\" is used by WordPress, choose another address."

