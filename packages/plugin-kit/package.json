{
  "name": "@fluxwp/plugin-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build wp-admin screens for a WordPress plugin on the Flux runtime (Flux GraphQL): Vite preset, runtime module list.",
  "exports": {
    "./vite": "./src/vite.ts",
    "./modules": "./src/modules.ts",
    "./runtime-exports.json": "./runtime-exports.json"
  },
  "scripts": {
    "exports": "bun scripts/runtime-exports.ts",
    "exports:check": "bun scripts/runtime-exports.ts --check",
    "typecheck": "tsc -p . && tsc -p example",
    "example": "cd example && vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "postcss-prefix-selector": "^2.2.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
