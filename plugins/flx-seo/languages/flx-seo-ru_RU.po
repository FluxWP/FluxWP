msgid "Optional"
msgstr "Необязательно"

msgid "Sitemap"
msgstr "Карта сайта"

msgid "List of all public pages"
msgstr "Список всех общедоступных страниц"

msgid "RSS feed"
msgstr "RSS-канал"

msgid "Searches the site and opens the results page."
msgstr "Выполняет поиск по сайту и открывает страницу результатов."

msgid "Words to search for"
msgstr "Слова для поиска"

msgid "Unknown fix."
msgstr "Неизвестное исправление."

msgid "Turn on llms.txt"
msgstr "Включите llms.txt"

msgid "Flux SEO builds /llms.txt from the site name, description, menu and recent content."
msgstr "Flux SEO создает файл /llms.txt из имени сайта, описания, меню и недавнего контента."

msgid "Turn on the WebMCP search tool"
msgstr "Включите инструмент поиска WebMCP."

msgid "Adds toolname/tooldescription to the search form so browser agents see it as a tool."
msgstr "Добавляет имя/описание инструмента в форму поиска, чтобы агенты браузера воспринимали его как инструмент."

msgid "Turn on security headers"
msgstr "Включить заголовки безопасности"

msgid "X-Frame-Options: SAMEORIGIN, COOP same-origin-allow-popups and a basic CSP (object-src 'none'; base-uri 'self'; frame-ancestors 'self'). Do not turn on if the site is embedded in other sites with an iframe."
msgstr "Параметры X-Frame: SAMEORIGIN, COOP, всплывающие окна с одинаковым происхождением и базовый CSP (object-src «none»; base-uri «self»; Frame-ancestors «self»). Не включать, если сайт встроен в другие сайты с помощью iframe."

msgid "HSTS includeSubDomains"
msgstr "HSTS включает поддомены"

msgid "If every subdomain is HTTPS, HSTS also covers subdomains."
msgstr "Если каждый субдомен является HTTPS, HSTS также распространяется на субдомены."

msgid "Turned on. Run the site audit again."
msgstr "Включен. Запустите аудит сайта еще раз."

msgid "General"
msgstr "Общий"

msgid "Organization and social"
msgstr "Организация и соц."

