msgid "Backup tables (sample data of the new plugins)"
msgstr "バックアップテーブル(新規プラグインのサンプルデータ)"

msgid "Old upload folders"
msgstr "古いアップロードフォルダー"

msgid "Old plugins (inactive)"
msgstr "古いプラグイン (非アクティブ)"

msgid "Old themes"
msgstr "古いテーマ"

msgid "Old settings"
msgstr "古い設定"

msgid "Leftovers"
msgstr "残り物"

