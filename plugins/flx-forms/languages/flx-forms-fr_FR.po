msgid "\\nIf the score is above 70 — enable the \"This site can send emails\" switch and save\\n"
msgstr "\\nSi le score est supérieur à 70 : activez le bouton \"Ce site peut envoyer des e-mails\" et enregistrez\\n"

msgid "\\nOtherwise, follow the instructions shown in the test results\\n"
msgstr "\\nSinon, suivez les instructions indiquées dans les résultats du test\\n"

