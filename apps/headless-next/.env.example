# GraphQL endpoint of the WordPress site (Flux GraphQL).
FLUX_GRAPHQL_URL=https://cms.example.com/graphql
# Front end id from FluxWP › Headless (optional with one front end).
FLUX_FRONTEND_ID=main
# Webhook secret saved for this front end (FluxWP › Headless › Edit › Secret).
FLUX_REVALIDATE_SECRET=
# Previews: a WordPress user who can edit posts and one of their application passwords (Users › Profile).
FLUX_PREVIEW_USER=
FLUX_PREVIEW_APP_PASSWORD=
