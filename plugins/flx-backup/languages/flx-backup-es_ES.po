msgstr "%1$s/%2$s utilizado (%3$s%%)."

msgid "The oldest unlocked backups will be deleted to make room for new ones; increase the quota or review the locked backups."
msgstr "Las copias de seguridad desbloqueadas más antiguas se eliminarán para dejar espacio para las nuevas; aumentar la cuota o revisar las copias de seguridad bloqueadas."

msgid "There are no backups yet. Take the first one from the dashboard with \"Back up now\"."
msgstr "Aún no hay copias de seguridad. Tome el primero del tablero con \"Hacer copia de seguridad ahora\"."

msgid "%1$s (%2$s): %3$s"
msgstr "%1$s(%2$s): %3$s"

