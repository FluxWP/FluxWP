msgid "No PageSpeed run yet. Press \"Measure with PageSpeed\" (mobile + desktop takes about 1 minute)."
msgstr "Aucune exécution de PageSpeed pour l'instant. Appuyez sur « Mesurer avec PageSpeed ​​» (mobile + ordinateur prend environ 1 minute)."

msgid "Agentic browsing"
msgstr "Navigation agent"

msgid "MCP server on"
msgstr "Serveur MCP activé"

msgid "MCP server off"
msgstr "Serveur MCP éteint"

