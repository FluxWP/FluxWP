msgid "AI & MCP"
msgstr "ИИ и MCP"

msgid "Connects assistants over MCP (only tools their own permissions allow)"
msgstr "Подключает ассистентов по MCP (только инструменты, которые разрешают их собственные права)"

msgid "No MCP access"
msgstr "Нет доступа к MCP"

msgid "On Apache or LiteSpeed, if you see \"Invalid key\", add SetEnvIf Authorization \"(.*)\" HTTP_AUTHORIZATION=$1 to .htaccess."
msgstr "В Apache или LiteSpeed, если вы видите «Неверный ключ», добавьте SetEnvIf Authorization \"(.*)\" HTTP_AUTHORIZATION=$1 в .htaccess."

msgid "Other clients"
msgstr "Другие клиенты"

msgid "Roles and access"
msgstr "Роли и доступ"

msgid "Send the key in the Authorization: Bearer header, or in the X-MCP-Key header. Do not put the key in the URL."
msgstr "Отправляйте ключ в заголовке Authorization: Bearer или в заголовке X-MCP-Key. Не помещайте ключ в URL."

msgid "This user can't use MCP."
msgstr "Этот пользователь не может использовать MCP."

msgid "Who can connect: users with the flxai_mcp capability. Roles that can edit posts have it by default, and administrators always do."
msgstr "Кто может подключаться: пользователи с возможностью flxai_mcp. Роли, которые могут редактировать записи, получают её по умолчанию, администраторы — всегда."

msgid "Your account can't connect an assistant (the MCP capability is required)."
msgstr "Ваша учётная запись не может подключить ассистента (нужна возможность MCP)."

