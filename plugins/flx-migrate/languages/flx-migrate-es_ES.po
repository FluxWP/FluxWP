msgstr "Meta usuario"

msgid "Table contents"
msgstr "Contenido de la tabla"

msgid "Tables"
msgstr "Mesas"

msgid "Taxonomies"
msgstr "Taxonomías"

msgid "Done"
msgstr "hecho"

msgid "Scan"
msgstr "Escanear"

msgid "Theme"
msgstr "Tema"

msgid "Term meta"
msgstr "Término meta"

msgid "Data will be moved to the new names. Did you take a backup?"
msgstr "Los datos se moverán a los nuevos nombres. ¿Hiciste una copia de seguridad?"

msgid "Post meta"
msgstr "Publicar meta"

msgid "Posts and pages"
msgstr "Publicaciones y páginas"

msgid "Upload folders"
msgstr "Subir carpetas"

msgid "Working…"
msgstr "Trabajando..."

msgid "Upload these new packages first (do not activate them):"
msgstr "Cargue estos nuevos paquetes primero (no los active):"

