msgstr "Not tested yet. Press \"Test connection\"."

msgid "Telefon bağlı değil (durum: %1$s, %2$s). \"QR ile bağla\" ile yeniden bağlayın."
msgstr "Phone not connected (state: %1$s, %2$s). Reconnect with \"Connect with QR\"."

msgid "%s: Evolution API sürümü"
msgstr "%s: Evolution API version"

msgid "Evolution API %s kullanılıyor. Gizli numaralı (@lid) kişilere cevap gitmeyebilir; sunucuyu 2.3 veya üstüne güncelleyin."
msgstr "Evolution API %s is in use. Replies to hidden-number (@lid) contacts may fail; update the server to 2.3 or later."

msgid "%s: webhook (gelen mesajlar)"
msgstr "%s: webhook (incoming messages)"

msgid "Evolution'dan hiç olay gelmedi; gelen mesajlar panele düşmez. \"Webhook'u kur\" düğmesine basın."
msgstr "No event has arrived from Evolution; incoming messages will not reach the panel. Press \"Set up webhook\"."

msgid "Son olay %s geldi. Hat sessiz olabilir; emin olmak için kendinize mesaj atın ya da webhook'u yeniden kurun."
msgstr "Last event arrived %s. The line may just be quiet; send yourself a message or set up the webhook again to be sure."

msgid "Son olay %s geldi."
msgstr "Last event arrived %s."

msgid "Flux Mail entegrasyonu"
msgstr "Flux Mail integration"

msgid "Etkin: WhatsApp bağlantıları İletişim › Bağlantılar'dan alınır."
msgstr "Active: WhatsApp connections are taken from Communication › Connections."

msgid "Flux Mail etkin değil; bağlantılar Flux Certificates'dan ya da bu eklentiden alınır."
msgstr "Flux Mail is not active; connections are taken from Flux Certificates or from this plugin."

msgid "Flux Certificates entegrasyonu"
msgstr "Flux Certificates integration"

msgid "Etkin: sohbetten sertifika oluşturulup gönderilebilir."
msgstr "Active: certificates can be created and sent from chats."

msgid "Flux Certificates etkin değil; sohbetten sertifika işlemleri kapalı."
msgstr "Flux Certificates is not active; certificate actions in chats are off."

msgid "Flux Donate entegrasyonu"
msgstr "Flux Donate integration"

msgid "Etkin: sohbetten bağış kaydı, dekont eşleştirme ve asistan kullanılabilir."
msgstr "Active: donation records, receipt matching and the assistant are available from chats."

msgid "Flux Donate etkin değil; bağış kaydı, dekont eşleştirme ve bağış asistanı kapalı."
msgstr "Flux Donate is not active; donation records, receipt matching and the donation assistant are off."

msgid "Flux AI & MCP eklentisi kurulu değil; yapay zekâ özellikleri (öneri, asistan, dekont okuma, sesli mesaj, özet) kapalı. Flux AI'yi kurup anahtarı oraya girin."
msgstr "The Flux AI & MCP plugin is not installed; AI features (suggestions, assistant, receipt reading, voice messages, summaries) are off. Install Flux AI and enter the key there."

msgid "Flux AI'de anahtar girilmemiş; mesaj önerisi ve asistan kapalı."
msgstr "No key has been entered in Flux AI; message suggestions and the assistant are off."

msgid "Anahtar var ama model seçilmemiş."
msgstr "Key saved but no model selected."

msgid "Seçili model (%s) için Flux AI'de sağlayıcının anahtarı girilmemiş."
msgstr "No provider key has been entered in Flux AI for the selected model (%s)."

msgid "Anahtar kayıtlı, model: %s. Canlı deneme için \"Bağlantıyı test et\"."
msgstr "Key saved, model: %s. Use \"Test connection\" for a live check."

msgid "Bağış asistanı"
msgstr "Donation assistant"

msgid "Kapalı."
msgstr "Off."

msgid "Yapay zekâ anahtarı veya modeli eksik."
msgstr "AI key or model is missing."

msgid "Açık ama konuşmuyor: "
msgstr "On but not replying: "

msgid "Açık. Sunulan bağış türleri: %s."
msgstr "On. Donation types offered: %s."

msgid "%s araç (tools) desteklemiyor; asistan için araç destekli bir model seçin."
msgstr "%s does not support tools; choose a tool-capable model for the assistant."

msgid "Dekont okuma modeli"
msgstr "Receipt reading model"

msgid "%s görsel okuyamıyor; dekont ön kontrolü çalışmaz. Görsel destekli bir dekont okuma modeli seçin."
msgstr "%s cannot read images; the receipt pre-check will not work. Choose an image-capable receipt reading model."

msgid "Asistanın ödeme bilgileri"
msgstr "Assistant payment details"

msgid "Alıcı adı ve IBAN tanımlı."
msgstr "Recipient name and IBAN set."

msgid "Alıcı adı veya IBAN eksik; onaydan sonra havale bilgisi gönderilemez."
msgstr "Recipient name or IBAN missing; bank details cannot be sent after confirmation."

msgid "Bağış sayfası linki"
msgstr "Donation page link"

msgid "Bağış sayfası bulunamadı; asistan link göndermez."
msgstr "Donation page not found; the assistant will not send a link."

msgid "Arka plan istekleri"
msgstr "Background requests"

msgid "Site kendine arka plan isteği atamadı (%1$s: %2$s). Sıradaki cevaplar ve benchmark yavaş ilerleyebilir; güvenlik eklentisi ya da sunucu güvenlik duvarı /wp-json/flx-chat/ isteklerini engelliyor olabilir."
msgstr "The site could not send a background request to itself (%1$s: %2$s). Queued replies and the benchmark may move slowly; a security plugin or the server firewall may be blocking /wp-json/flx-chat/ requests."

msgid "hata"
msgstr "error"

msgid "uyarı"
msgstr "warning"

msgid "tamam"
msgstr "ok"

msgid "{marka} doğrulama kodunuz: {kod}"
msgstr "Your {marka} verification code: {kod}"

msgid "Kod {dk} dakika geçerlidir. Bu kodu WhatsApp'ta bizimle olan sohbete yazın. Bu isteği siz yapmadıysanız dikkate almayın."
msgstr "The code is valid for {dk} minutes. Type it in your WhatsApp chat with us. If you did not ask for it, ignore this message."

msgid "Bir sıkıntı oldu, ekibimiz en kısa sürede sizinle iletişime geçecek 🌱 Bu arada başka bir sorunuz olursa yazabilirsiniz."
msgstr "Something went wrong; our team will contact you as soon as possible 🌱 Meanwhile, feel free to ask anything else."

msgid "Doğrulama denemesi başarısız (%1$d/%2$d): %3$s"
msgstr "Verification attempt failed (%1$d/%2$d): %3$s"

msgid "Kişi kayıtlarını görmek istedi, doğrulama yapılamadı; ekipten biri iletişime geçmeli"
msgstr "The person wanted to see their records but could not be verified; someone from the team should get in touch"

msgid "e-posta gönderilemedi (Flux Mail › SMTP ayarlarını kontrol edin)"
msgstr "e-mail could not be sent (check Flux Mail › SMTP settings)"

msgid "Asistan %1$s için doğrulama kodu gönderdi (%2$s)."
msgstr "The assistant sent a verification code for %1$s (%2$s)."

msgid "kodun süresi doldu"
msgstr "code expired"

msgid "yanlış kod"
msgstr "wrong code"

msgid "Kişi %s için kodu doğruladı; kayıt sorgusuna eklendi."
msgstr "The person verified the code for %s; it is added to their record lookups."

msgid "Claude modelleri ses okuyamaz; Ayarlar › Yapay zekâ › Sesli mesaj modelinden ses okuyan bir OpenRouter modeli seçin."
msgstr "Claude models cannot read audio; choose an audio-capable OpenRouter model in Settings › AI › Voice message model."

msgid "Ses metne çevrilemedi."
msgstr "The audio could not be transcribed."

msgid "Ses dosyası okunamadı."
msgstr "The audio file could not be read."

msgid "Sesli mesaj (%1$s) metne çevrildi: %2$s"
msgstr "Voice message (%1$s) transcribed: %2$s"

msgid "Sesli mesaj (%1$s) dinlenemedi: %2$s"
msgstr "Voice message (%1$s) could not be processed: %2$s"

msgid "Resmi WhatsApp Cloud API hattında bu işlem yok."
msgstr "This action is not available on an official WhatsApp Cloud API line."

msgid "WhatsApp 24 saat kuralı: kişi son 24 saatte yazmadığı için Cloud API serbest mesaj göndermiyor; yalnız onaylı şablon gider. Kişi yazınca yeniden deneyin."
msgstr "WhatsApp 24-hour rule: the contact has not written in the last 24 hours, so the Cloud API will not send a free-form message; only an approved template can be sent. Try again once they write."

msgid "Cloud API hattı için Flux Mail 1.10.0 veya üstü gerekli."
msgstr "A Cloud API line needs Flux Mail 1.10.0 or later."

msgid "Cloud API bu adrese (gizli numara ya da grup) gönderemez."
msgstr "The Cloud API cannot send to this address (hidden number or group)."

msgid "Cloud API hesabına ulaşılamadı (İletişim › Bağlantılar)."
msgstr "Could not reach the Cloud API account (İletişim › Connections)."

msgid "Cloud API hattında QR yok; hesap İletişim › Bağlantılar'da kurulur."
msgstr "A Cloud API line has no QR code; the account is set up in İletişim › Connections."

msgid "Dosya hazırlanamadı."
msgstr "The file could not be prepared."

msgid "Flux AI görsel desteği yok."
msgstr "Flux AI has no image support."

msgid "Görsel çevrilemedi."
msgstr "The image could not be rendered."

msgid "Asistanın görseli gönderilemedi: "
msgstr "The assistant's image could not be sent: "

msgid "Merhaba {first_name}, bağış kaydınızı oluşturduk: {donation}, toplam {amount}.\n\n{bank}\n\nÖdemeyi yaptıktan sonra dekontu buradan gönderebilirsiniz. Teşekkür ederiz."
msgstr "Hello {first_name}, we have created your donation record: {donation}, total {amount}.\n\n{bank}\n\nAfter paying, you can send the receipt here. Thank you."

msgid "Merhaba {first_name}, bağışınız kaydedildi: {donation}, toplam {amount}.\n\nDesteğiniz için teşekkür ederiz."
msgstr "Hello {first_name}, your donation has been recorded: {donation}, total {amount}.\n\nThank you for your support."


msgid "Bu kullanıcının personel araçları yetkisi yok."
msgstr "This user is not allowed to use the staff tools."

msgid "%1$s bu sohbeti personel olarak bağladı: %2$s"
msgstr "%1$s linked this chat to staff member %2$s"

msgid "%s sohbetin personel bağlantısını kaldırdı"
msgstr "%s removed the staff link of this chat"

msgid "Sohbet personele bağlandı"
msgstr "Chat linked to staff member"

msgid "Personel bağlantısı kaldırıldı"
msgstr "Staff link removed"

msgid "— Personel değil —"
msgstr "— Not staff —"

msgid "WhatsApp bu kişinin numarasını gizliyor, asistan personeli numaradan tanıyamaz. Bu kişi ekibinizdense buradan bağlayın; asistan personel araçlarını açar."
msgstr "WhatsApp hides this person's number, so the assistant cannot recognise staff by number. If this person is on your team, link them here and the assistant opens the staff tools."

msgid "Asistan personeli Flux Roles profilindeki numaradan tanır. Numara eşleşmiyorsa buradan bağlayabilirsiniz; numarası bilinen sohbette numara önceliklidir."
msgstr "The assistant recognises staff by the number in their Flux Roles profile. If the number does not match, you can link them here; in a chat with a known number the number comes first."

msgid "Bu kanal şu an kullanılamıyor."
msgstr "This channel is not available right now."

msgid "Site sohbeti"
msgstr "Site chat"

msgid "WhatsApp, site sohbeti ve diğer kanallardan gelen tüm mesajlar burada canlı görünür. Soldan bir sohbet seçin."
msgstr "All messages from WhatsApp, site chat and other channels appear here live. Pick a chat on the left."
