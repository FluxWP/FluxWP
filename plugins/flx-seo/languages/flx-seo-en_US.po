msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Project-Id-Version: Flux SEO\n"
"Language: en_US\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Sayfalar"
msgstr "Pages"

msgid "Son yazılar"
msgstr "Recent posts"

msgid "Ürünler"
msgstr "Products"

msgid "İsteğe bağlı"
msgstr "Optional"

msgid "Site haritası"
msgstr "Sitemap"

msgid "Tüm herkese açık sayfaların listesi"
msgstr "List of all public pages"

msgid "RSS beslemesi"
msgstr "RSS feed"

msgid "Sitede arama yapar ve sonuç sayfasını açar."
msgstr "Searches the site and opens the results page."

msgid "Aranacak kelimeler"
msgstr "Words to search for"

msgid "Bilinmeyen düzeltme."
msgstr "Unknown fix."

msgid "llms.txt'i aç"
msgstr "Turn on llms.txt"

msgid "Flux SEO /llms.txt dosyasını site adı, açıklama, menü ve son içeriklerden üretir."
msgstr "Flux SEO builds /llms.txt from the site name, description, menu and recent content."

msgid "WebMCP arama aracını aç"
msgstr "Turn on the WebMCP search tool"

msgid "Arama formuna toolname/tooldescription eklenir; tarayıcıdaki ajanlar formu araç olarak görür."
msgstr "Adds toolname/tooldescription to the search form so browser agents see it as a tool."

msgid "Güvenlik başlıklarını aç"
msgstr "Turn on security headers"

msgid "X-Frame-Options: SAMEORIGIN, COOP same-origin-allow-popups ve temel CSP (object-src 'none'; base-uri 'self'; frame-ancestors 'self'). Site başka sitelerde iframe ile gösteriliyorsa açmayın."
msgstr "X-Frame-Options: SAMEORIGIN, COOP same-origin-allow-popups and a basic CSP (object-src 'none'; base-uri 'self'; frame-ancestors 'self'). Do not turn on if the site is embedded in other sites with an iframe."

msgid "HSTS includeSubDomains"
msgstr "HSTS includeSubDomains"

msgid "Tüm alt alan adları HTTPS ise HSTS alt alan adlarını da kapsar."
msgstr "If every subdomain is HTTPS, HSTS also covers subdomains."

msgid "Açıldı. Site denetimini yeniden çalıştırın."
msgstr "Turned on. Run the site audit again."

msgid "Genel"
msgstr "General"

msgid "Kurum ve sosyal"
msgstr "Organization and social"

msgid "SEO kontrolü"
msgstr "SEO check"

msgid "Site denetimi"
msgstr "Site audit"

msgid "Yapay zekâ (MCP)"
msgstr "AI (MCP)"

msgid "llms.txt önerilere uygun"
msgstr "llms.txt follows recommendations"

msgid "Erişilebilirlik ağacı düzgün"
msgstr "Accessibility tree is well-formed"

msgid "Formlar WebMCP aracı"
msgstr "Forms are WebMCP tools"

msgid "Yerleşim kayması düşük (CLS)"
msgstr "Low layout shift (CLS)"

msgid "Site içi"
msgstr "On-site"

msgid "PageSpeed mobil"
msgstr "PageSpeed mobile"

msgid "PageSpeed masaüstü"
msgstr "PageSpeed desktop"

msgid "PageSpeed Insights'ın beş başlığı (Performans, Erişilebilirlik, En iyi uygulamalar, SEO, Ajan uyumu) önceliğe göre. Site içi denetim anahtarsız ve her gün kendiliğinden çalışır; PageSpeed ölçümü Google'ın gerçek Lighthouse sonucunu ekler."
msgstr "The five PageSpeed Insights sections (Performance, Accessibility, Best Practices, SEO, Agentic Browsing) by priority. The on-site audit needs no key and runs by itself every day; a PageSpeed run adds Google's real Lighthouse result."

#, php-format
msgid "Site içi denetim: %1$s · %2$s"
msgstr "On-site audit: %1$s · %2$s"

msgid "Henüz denetim yapılmadı."
msgstr "No audit has run yet."

msgid "Denetlenecek adres"
msgstr "Address to audit"

msgid "Site içi denetim"
msgstr "On-site audit"

msgid "PageSpeed ile ölç"
msgstr "Measure with PageSpeed"

msgid "Mobil"
msgstr "Mobile"

msgid "Masaüstü"
msgstr "Desktop"

msgid "PageSpeed ölçümü yok. \"PageSpeed ile ölç\" düğmesine basın (mobil + masaüstü yaklaşık 1 dakika)."
msgstr "No PageSpeed run yet. Press \"Measure with PageSpeed\" (mobile + desktop takes about 1 minute)."

msgid "Ajan uyumu"
msgstr "Agentic browsing"

msgid "MCP sunucusu açık"
msgstr "MCP server on"

msgid "MCP sunucusu kapalı"
msgstr "MCP server off"

msgid "Öneriler"
msgstr "Recommendations"

msgid "Önceliğe göre süz"
msgstr "Filter by priority"

msgid "Tümü"
msgstr "All"

msgid "Başlık"
msgstr "Section"

msgid "Tüm başlıklar"
msgstr "All sections"

msgid "Denetimi başlatın; öneriler burada önceliğe göre sıralanır."
msgstr "Start the audit; recommendations are listed here by priority."

msgid "Öneri yok. Her şey yolunda."
msgstr "No recommendations. All good."

msgid "Nasıl düzeltilir:"
msgstr "How to fix:"

#, php-format
msgid "Düzeltme yeri: %s"
msgstr "Where to fix: %s"

msgid "Düzelt"
msgstr "Fix"

msgid "Ayarlar"
msgstr "Settings"

msgid "PageSpeed Insights API anahtarı"
msgstr "PageSpeed Insights API key"

msgid "Kayıtlı (değiştirmek için yazın)"
msgstr "Saved (type to replace)"

msgid "Anahtarı sil"
msgstr "Delete key"

msgid "İsteğe bağlı ama önerilir: anahtarsız kota paylaşımlı ve çabuk dolar. Google Cloud Console › API'ler › \"PageSpeed Insights API\"yi etkinleştirip ücretsiz anahtar oluşturun."
msgstr "Optional but recommended: the keyless quota is shared and runs out quickly. In Google Cloud Console › APIs, enable \"PageSpeed Insights API\" and create a free key."

msgid "/llms.txt üret (site adı, açıklama, menü sayfaları, son içerikler)"
msgstr "Generate /llms.txt (site name, description, menu pages, recent content)"

msgid "llms.txt giriş metni (isteğe bağlı)"
msgstr "llms.txt intro text (optional)"

msgid "Ör. Kurumumuz kimdir, ne yapar, ajanlar hangi sayfaları öncelikle okumalı."
msgstr "E.g. who your organization is, what it does, which pages agents should read first."

msgid "WebMCP: arama formunu tarayıcı ajanlarına araç olarak tanıt"
msgstr "WebMCP: expose the search form to browser agents as a tool"

msgid "Güvenlik başlıkları"
msgstr "Security headers"

msgid "Clickjacking koruması (X-Frame-Options: SAMEORIGIN, frame-ancestors 'self')"
msgstr "Clickjacking protection (X-Frame-Options: SAMEORIGIN, frame-ancestors 'self')"

msgid "Pencere yalıtımı (Cross-Origin-Opener-Policy: same-origin-allow-popups)"
msgstr "Origin isolation (Cross-Origin-Opener-Policy: same-origin-allow-popups)"

msgid "Temel CSP (object-src 'none'; base-uri 'self'; upgrade-insecure-requests)"
msgstr "Basic CSP (object-src 'none'; base-uri 'self'; upgrade-insecure-requests)"

msgid "HSTS alt alan adlarını kapsasın (includeSubDomains)"
msgstr "HSTS covers subdomains (includeSubDomains)"

msgid "HSTS preload (geri alması aylar sürer; tüm alt alan adları HTTPS olmalı)"
msgstr "HSTS preload (takes months to undo; every subdomain must be HTTPS)"

msgid "Kaydet"
msgstr "Save"

msgid "Yeni site yapım rehberi"
msgstr "New site build guide"

msgid "Yeni sayfa, tema ya da ön ayar yaparken SEO, performans, erişilebilirlik, güvenlik ve ajan uyumu için kurallar ve kontrol listesi. Yapay zekâ ajanları aynı rehberi MCP aracı site_build_guide ile, Flux AI sohbeti de araç olarak alır."
msgstr "Rules and a checklist for SEO, performance, accessibility, security and agent readiness when you build a new page, theme or preset. AI agents get the same guide with the MCP tool site_build_guide, and Flux AI chat gets it as a tool."

msgid "Türkçe (.md) indir"
msgstr "Download Turkish (.md)"

msgid "İngilizce (.md) indir"
msgstr "Download English (.md)"

msgid "Site içi denetim çalışıyor…"
msgstr "On-site audit running…"

msgid "PageSpeed mobil ölçülüyor (30–40 sn)…"
msgstr "Measuring PageSpeed mobile (30–40 s)…"

msgid "PageSpeed masaüstü ölçülüyor…"
msgstr "Measuring PageSpeed desktop…"

msgid "Bitti, sayfa yenileniyor…"
msgstr "Done, reloading…"

msgid "Olmadı:"
msgstr "Failed:"

msgid "Yetkiniz yok."
msgstr "You do not have permission."

msgid "Kaydedildi."
msgstr "Saved."

msgid "Açıldı ve denetim yenilendi. Sayfa önbelleği (LiteSpeed) varsa Purge All yapın."
msgstr "Turned on and the audit was refreshed. If a page cache (LiteSpeed) is on, run Purge All."

msgid "Kritik"
msgstr "Critical"

msgid "Yüksek"
msgstr "High"

msgid "Orta"
msgstr "Medium"

msgid "Düşük"
msgstr "Low"

msgid "Performans"
msgstr "Performance"

msgid "Erişilebilirlik"
msgstr "Accessibility"

msgid "En iyi uygulamalar"
msgstr "Best practices"

msgid "SEO"
msgstr "SEO"

msgid "Tema / ön ayar"
msgstr "Theme / preset"

msgid "İçerik"
msgstr "Content"

msgid "Sunucu"
msgstr "Server"

msgid "Flux SEO (tek tık)"
msgstr "Flux SEO (one click)"

msgid "WordPress ayarı"
msgstr "WordPress setting"

msgid "Ana sayfa başarılı durum kodu döndürmüyor"
msgstr "Home page does not return a successful status code"

msgid "Sayfa 200 dönmeli. Bakım modu, yönlendirme döngüsü ya da PHP hatası olabilir; Sistem Kontrolü ve hata günlüğüne bakın."
msgstr "The page must return 200. It may be maintenance mode, a redirect loop or a PHP error; check System Check and the error log."

msgid "Sayfa arama motorlarına kapalı"
msgstr "Page is blocked from search engines"

msgid "Ayarlar › Okuma › \"Arama motorlarının siteyi dizine eklemesini engelle\" kutusunu kaldırın; sayfanın kendi SEO panelindeki noindex işaretini kapatın."
msgstr "Untick Settings › Reading › \"Discourage search engines from indexing this site\" and turn off noindex in the page's own SEO panel."

msgid "robots.txt tüm siteyi engelliyor"
msgstr "robots.txt blocks the whole site"

msgid "Kökteki robots.txt dosyasında \"User-agent: *\" altında \"Disallow: /\" olmamalı. Dosyayı silin ya da düzeltin; WordPress kendi robots.txt'sini üretir."
msgstr "The robots.txt in the web root must not have \"Disallow: /\" under \"User-agent: *\". Delete or fix the file; WordPress generates its own robots.txt."

msgid "Sayfa başlığı (<title>) yok"
msgstr "Page has no <title>"

msgid "Tema add_theme_support( 'title-tag' ) desteklemeli; SEO & MCP › Genel'de ana sayfa başlığını doldurun."
msgstr "The theme must declare add_theme_support( 'title-tag' ); fill in the home title in SEO & MCP › General."

msgid "Sayfa başlığı uzun"
msgstr "Page title is long"

msgid "Başlığı 60 karakter civarında tutun; Google sonrasını keser."
msgstr "Keep the title around 60 characters; Google cuts the rest."

msgid "Meta açıklama yok"
msgstr "No meta description"

msgid "SEO çıktısını açın ve ana sayfa açıklamasını (150–160 karakter) yazın."
msgstr "Turn on SEO output and write the home description (150–160 characters)."

msgid "Canonical bağlantısı eksik ya da birden fazla"
msgstr "Canonical link missing or duplicated"

msgid "Her sayfada tek bir rel=canonical olmalı. Başka bir eklenti ya da tema da ekliyorsa birini kapatın."
msgstr "Each page needs exactly one rel=canonical. If another plugin or the theme also adds one, turn one off."

msgid "Çok dilli sitede hreflang yok"
msgstr "No hreflang on a multilingual site"

msgid "Flux Lang etkinse dil sürümleri hreflang ile bağlanmalı; Flux Lang ayarlarında dil eşleştirmelerini kontrol edin."
msgstr "With Flux Lang active, language versions must be linked with hreflang; check the language pairs in Flux Lang settings."

msgid "Ana başlık (H1) yok ya da birden fazla"
msgstr "Main heading (H1) missing or repeated"

msgid "Her sayfada konuyu anlatan tek bir H1 olsun; ara başlıklar H2/H3."
msgstr "Each page needs one H1 that names the topic; subheadings are H2/H3."

msgid "Yapılandırılmış veri (JSON-LD) yok ya da bozuk"
msgstr "Structured data (JSON-LD) missing or broken"

msgid "Flux SEO çıktısı açıkken Organization, WebSite ve Breadcrumb schema eklenir. Bozuk JSON-LD üreten blok ya da eklentiyi bulun."
msgstr "With Flux SEO output on, Organization, WebSite and Breadcrumb schema are added. Find the block or plugin that outputs broken JSON-LD."

msgid "Bağlantı metinleri açıklayıcı değil"
msgstr "Link texts are not descriptive"

msgid "\"Tıklayın\", \"devamı\", \"buraya\" yerine hedefi anlatan metin yazın (ör. \"Bağış seçeneklerini görün\")."
msgstr "Write text that names the target instead of \"click here\", \"more\", \"here\" (e.g. \"See donation options\")."

msgid "Aynı başlıkta birden fazla yayın var"
msgstr "More than one post with the same title"

msgid "Kopya sayfayı (çoğunlukla adresi -2 ile biten) silin ya da asıl sayfaya yönlendirin; gerekiyorsa başlıkları ayırın. Aynı metinli bağlantılar farklı adreslere gidince \"Aynı bağlantılar aynı amaca sahip\" denetimi de düşer."
msgstr "Delete the duplicate (usually the address ending in -2) or redirect it to the original; give different titles if both are needed. When links with the same text go to different addresses, the \"Identical links have the same purpose\" audit also fails."

msgid "WordPress sürümü sayfada görünüyor"
msgstr "WordPress version is visible on the page"

msgid "meta generator etiketi sürümü ele verir. Tema remove_action( 'wp_head', 'wp_generator' ) yapmalı; Flux SEO güvenlik başlıkları açıkken kaldırılır."
msgstr "The meta generator tag reveals the version. The theme should call remove_action( 'wp_head', 'wp_generator' ); Flux SEO removes it when security headers are on."

msgid "Yakınlaştırma engellenmiş (user-scalable=no / maximum-scale)"
msgstr "Zoom is blocked (user-scalable=no / maximum-scale)"

msgid "Viewport etiketinden user-scalable=no ve maximum-scale=1 kaldırın: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">. Az gören kullanıcılar sayfayı büyütemiyor; Erişilebilirlik puanı doğrudan düşer."
msgstr "Remove user-scalable=no and maximum-scale=1 from the viewport tag: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">. Users with low vision cannot zoom; the Accessibility score drops directly."

msgid "Viewport etiketi yok"
msgstr "No viewport tag"

msgid "Tema <head> içine <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"> eklemeli; yoksa mobilde sayfa masaüstü genişliğinde açılır."
msgstr "The theme must add <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"> to <head>; otherwise the page opens at desktop width on mobile."

msgid "ARIA rolü gerekli alt öğeleri içermiyor"
msgstr "ARIA role is missing required children"

msgid "Ör. role=\"tablist\" yalnız role=\"tab\" öğeleri içermeli. <ol role=\"tablist\"><li><button role=\"tab\"> yerine <div role=\"tablist\"><button role=\"tab\"> kullanın ya da li öğelerine role=\"presentation\" verin. Erişilebilirlik ağacı bozulur; Lighthouse \"Ajan uyumu\" puanını da düşürür."
msgstr "E.g. role=\"tablist\" may only contain role=\"tab\" elements. Use <div role=\"tablist\"><button role=\"tab\"> instead of <ol role=\"tablist\"><li><button role=\"tab\">, or give the li elements role=\"presentation\". The accessibility tree breaks and Lighthouse also lowers the Agentic Browsing score."

msgid "ARIA rolü gerekli üst öğenin içinde değil"
msgstr "ARIA role is not inside its required parent"

msgid "role=\"tab\" doğrudan role=\"tablist\" içinde, role=\"option\" role=\"listbox\" içinde olmalı. Aradaki li/div öğelerini kaldırın ya da role=\"presentation\" verin."
msgstr "role=\"tab\" must sit directly inside role=\"tablist\", role=\"option\" inside role=\"listbox\". Remove the li/div elements in between or give them role=\"presentation\"."

msgid "Liste öğeleri (<li>) liste içinde değil"
msgstr "List items (<li>) are not inside a list"

msgid "<li> yalnız <ul>, <ol> ya da <menu> içinde olmalı ve üst listeye liste dışı bir role verilmemeli (ör. <ol role=\"tablist\">)."
msgstr "<li> may only sit inside <ul>, <ol> or <menu>, and the parent list must not get a non-list role (e.g. <ol role=\"tablist\">)."

msgid "Görsellerde alt metin yok"
msgstr "Images without alt text"

msgid "Her anlamlı görsele içeriği anlatan alt metin yazın; süs görselleri alt=\"\" alsın. Medya kütüphanesinde alt metni doldurun ya da SEO & MCP › Genel › Görseller seçeneğini açın."
msgstr "Give every meaningful image alt text that describes it; decorative images get alt=\"\". Fill in alt text in the media library or turn on SEO & MCP › General › Images."

msgid "Adı olmayan bağlantılar var"
msgstr "Links without a name"

msgid "Yalnız simge içeren bağlantılara aria-label ya da görünmez metin (screen-reader-text) ekleyin."
msgstr "Add aria-label or hidden text (screen-reader-text) to icon-only links."

msgid "Adı olmayan düğmeler var"
msgstr "Buttons without a name"

msgid "Simge düğmelerine aria-label verin (ör. \"Menüyü aç\"). Ajanlar ve ekran okuyucular düğmenin ne yaptığını bilemez."
msgstr "Give icon buttons an aria-label (e.g. \"Open menu\"). Agents and screen readers cannot tell what the button does."

msgid "Etiketi olmayan form alanları var"
msgstr "Form fields without a label"

msgid "Her alanın <label for> ya da aria-label ile bir adı olmalı; placeholder etiket yerine geçmez."
msgstr "Each field needs a name through <label for> or aria-label; a placeholder is not a label."

msgid "<html> etiketinde dil (lang) yok"
msgstr "<html> has no lang attribute"

msgid "Tema <html <?php language_attributes(); ?>> kullanmalı."
msgstr "The theme should use <html <?php language_attributes(); ?>>."

msgid "Yinelenen ya da bulunmayan id başvuruları"
msgstr "Duplicate or missing id references"

msgid "Aynı id iki öğede olmamalı; aria-controls, aria-labelledby ve label for var olan bir id'yi göstermeli."
msgstr "No id may be used twice; aria-controls, aria-labelledby and label for must point to an existing id."

msgid "Başlık sırası atlıyor"
msgstr "Heading levels skip"

msgid "Başlıklar sırayla inmeli (H2 → H3); görünüm için seviye atlamayın, CSS ile boyutlandırın."
msgstr "Headings should step down in order (H2 → H3); do not skip levels for looks, size them with CSS."

msgid "tabindex değeri 0'dan büyük"
msgstr "tabindex greater than 0"

msgid "tabindex=\"1\" gibi değerler klavye sırasını bozar; 0 ya da -1 kullanın."
msgstr "Values like tabindex=\"1\" break keyboard order; use 0 or -1."

msgid "Aynı metinli bağlantılar farklı adreslere gidiyor"
msgstr "Links with the same text go to different addresses"

msgid "Aynı adı taşıyan bağlantılar aynı sayfaya gitmeli. Kopya sayfayı kaldırın ya da bağlantı metinlerini ayırın."
msgstr "Links with the same name should go to the same page. Remove the duplicate page or make the link texts different."

msgid "Başlıksız iframe"
msgstr "iframe without a title"

msgid "Her <iframe> title almalı (ör. \"Konum haritası\")."
msgstr "Every <iframe> needs a title (e.g. \"Location map\")."

msgid "Sayfada <main> bölgesi yok"
msgstr "No <main> landmark on the page"

msgid "Ana içerik <main> içinde olmalı; ekran okuyucu ve ajanlar ana içeriği böyle bulur."
msgstr "Main content must be inside <main>; screen readers and agents find the main content this way."

msgid "Metin/zemin karşıtlığı yetersiz"
msgstr "Insufficient text/background contrast"

msgid "Normal metin için en az 4.5:1, büyük metin için 3:1 karşıtlık. Tema paletindeki soluk renkleri koyulaştırın."
msgstr "At least 4.5:1 for normal text and 3:1 for large text. Darken the pale colors in the theme palette."

msgid "Oluşturmayı engelleyen istekler"
msgstr "Render-blocking requests"

msgid "İlk ekran için gereken kritik CSS'i satır içine alın, gerisini media=\"print\" onload ile ya da sayfa sonunda yükleyin; JS'e defer verin. LiteSpeed Cache › Page Optimization › CSS/JS ayarları ya da temanın kendi birleştirilmiş CSS'i."
msgstr "Inline the critical CSS for the first screen and load the rest with media=\"print\" onload or at the end of the page; add defer to JS. Use LiteSpeed Cache › Page Optimization › CSS/JS settings or the theme's own combined CSS."

msgid "Kullanılmayan CSS"
msgstr "Unused CSS"

msgid "Tek büyük CSS dosyasını sayfa türüne göre bölün ya da kullanılmayan kuralları ayıklayın (LiteSpeed \"Remove Unused CSS\"). Kazanç çoğunlukla LCP'ye yansır."
msgstr "Split the single big stylesheet by template or strip unused rules (LiteSpeed \"Remove Unused CSS\"). The gain mostly shows in LCP."

msgid "Sıkıştırılmamış (minify edilmemiş) JavaScript"
msgstr "Unminified JavaScript"

msgid "Tema/eklenti JS dosyalarının .min sürümünü yayınlayın ya da LiteSpeed \"JS Minify\"ı açın."
msgstr "Ship .min versions of theme/plugin JS or turn on LiteSpeed \"JS Minify\"."

msgid "Sıkıştırılmamış CSS"
msgstr "Unminified CSS"

msgid "CSS'i minify edin (LiteSpeed \"CSS Minify\" ya da derleme adımı)."
msgstr "Minify CSS (LiteSpeed \"CSS Minify\" or a build step)."

msgid "GPU'da çalışmayan animasyonlar"
msgstr "Non-composited animations"

msgid "Animasyonları transform ve opacity ile yapın; stroke-dashoffset, top/left, width gibi özellikler her karede yeniden çizim yapar. prefers-reduced-motion'da durdurun."
msgstr "Animate with transform and opacity; properties like stroke-dashoffset, top/left and width repaint on every frame. Stop them under prefers-reduced-motion."

msgid "DOM çok büyük"
msgstr "DOM is too large"

msgid "1.500 öğenin altını hedefleyin. Kayan şeritlerdeki (marquee) kopyaları azaltın, gizli menüleri ve uzun listeleri ihtiyaç olunca oluşturun, iç içe sarmalayıcıları sadeleştirin."
msgstr "Aim for under 1,500 elements. Reduce copies in marquees, build hidden menus and long lists on demand, simplify nested wrappers."

msgid "En büyük içerik (LCP) geç çiziliyor"
msgstr "Largest content (LCP) paints late"

msgid "LCP öğesi metinse yazı tipini preload edip font-display: swap kullanın ve giriş animasyonunu ilk karede göstermeyin; görselse fetchpriority=\"high\" verin, lazy load etmeyin."
msgstr "If the LCP element is text, preload its font, use font-display: swap and do not hide it behind an entrance animation on the first frame; if it is an image, give it fetchpriority=\"high\" and do not lazy load it."

msgid "Yerleşim kayması (CLS) kaynakları"
msgstr "Layout shift (CLS) culprits"

msgid "Görsellere width/height, sonradan gelen bloklara sabit yükseklik verin; web fontları için size-adjust/fallback metrikleri kullanın; absolute konumlu animasyonlu katmanlar yerleşimi itmesin."
msgstr "Give images width/height and late blocks a fixed height; use size-adjust/fallback metrics for web fonts; absolutely positioned animated layers must not push the layout."

msgid "Yazı tipleri metni geciktiriyor"
msgstr "Fonts delay text"

msgid "@font-face içinde font-display: swap kullanın, ilk ekranda kullanılan 1-2 yazı tipini <link rel=\"preload\" as=\"font\" crossorigin> ile önden yükleyin, kullanılmayan ağırlıkları kaldırın."
msgstr "Use font-display: swap in @font-face, preload the 1-2 fonts used on the first screen with <link rel=\"preload\" as=\"font\" crossorigin>, remove unused weights."

msgid "Kritik istek zinciri uzun"
msgstr "Critical request chain is long"

msgid "CSS içinden yüklenen fontlar zinciri uzatır; ilk ekran fontlarını preload edin, zincirdeki gereksiz istekleri (ör. guest.vary.php) ertelenmiş yükleyin."
msgstr "Fonts loaded from CSS lengthen the chain; preload first-screen fonts and defer unneeded requests in the chain (e.g. guest.vary.php)."

msgid "Zorunlu yeniden yerleşim (forced reflow)"
msgstr "Forced reflow"

msgid "JS'te stil değiştirdikten sonra offsetWidth/getBoundingClientRect okumayın; okumaları önce, yazmaları sonra requestAnimationFrame içinde yapın."
msgstr "Do not read offsetWidth/getBoundingClientRect after changing styles in JS; read first, then write inside requestAnimationFrame."

msgid "Uzun ana iş parçacığı görevleri"
msgstr "Long main-thread tasks"

msgid "Açılışta çalışan JS'i bölün, görünür olmayan bölümlerin işini IntersectionObserver ile erteleyin."
msgstr "Split JS that runs at startup and defer work for off-screen sections with IntersectionObserver."

msgid "Görseller büyük ya da eski biçimde"
msgstr "Images are large or in an old format"

msgid "WebP/AVIF kullanın, görünen boyuttan büyük görsel göndermeyin (srcset), görsel sıkıştırmayı açın."
msgstr "Use WebP/AVIF, never send images larger than displayed (srcset), turn on image compression."

msgid "Genişlik/yükseklik vermeyen görseller"
msgstr "Images without width/height"

msgid "<img> etiketlerine width ve height verin; tarayıcı yer ayırır, sayfa kaymaz."
msgstr "Give <img> tags width and height; the browser reserves space and the page does not shift."

msgid "İlk ekrandaki görsel lazy yükleniyor"
msgstr "First-screen image is lazy loaded"

msgid "Sayfanın ilk görseline loading=\"lazy\" vermeyin, fetchpriority=\"high\" verin. LiteSpeed lazy load açıksa ilk görseli hariç tutun (data-no-lazy ya da \"Lazy Load Image Excludes\")."
msgstr "Do not give the page's first image loading=\"lazy\"; give it fetchpriority=\"high\". If LiteSpeed lazy load is on, exclude the first image (data-no-lazy or \"Lazy Load Image Excludes\")."

msgid "Sunucu yanıtı yavaş"
msgstr "Slow server response"

msgid "Sayfa önbelleğini (LiteSpeed Cache) açın; Flux Speed › yavaş eklentiler ve cron raporuna bakın."
msgstr "Turn on page cache (LiteSpeed Cache); check slow plugins and the cron report in Flux Speed."

msgid "Metin sıkıştırma (gzip/brotli) yok"
msgstr "No text compression (gzip/brotli)"

msgid "Sunucuda gzip ya da brotli açın (Hostinger/LiteSpeed'de varsayılan açıktır; CDN ayarını kontrol edin)."
msgstr "Turn on gzip or brotli on the server (on by default on Hostinger/LiteSpeed; check the CDN settings)."

msgid "HTML belgesi büyük"
msgstr "HTML document is large"

msgid "Satır içi SVG ikonları sprite'a, büyük satır içi CSS/JSON'u dosyaya taşıyın."
msgstr "Move inline SVG icons into a sprite and large inline CSS/JSON into files."

msgid "WordPress emoji betiği yükleniyor"
msgstr "WordPress emoji script is loaded"

msgid "Modern tarayıcılar emojiyi kendisi çizer; tema print_emoji_detection_script'i kaldırabilir."
msgstr "Modern browsers draw emoji themselves; the theme can remove print_emoji_detection_script."

msgid "Largest Contentful Paint (LCP) yavaş"
msgstr "Largest Contentful Paint (LCP) is slow"

msgid "Hedef 2,5 sn altı. Engelleyen CSS'i azaltın, LCP yazı tipini/görselini önden yükleyin, sunucu önbelleğini açın."
msgstr "Target under 2.5 s. Reduce render-blocking CSS, preload the LCP font/image, turn on the server cache."

msgid "Cumulative Layout Shift (CLS) yüksek"
msgstr "Cumulative Layout Shift (CLS) is high"

msgid "Hedef 0,1 altı. Görsellere boyut verin, fontların kaymasını önleyin, sonradan eklenen öğelere yer ayırın."
msgstr "Target under 0.1. Size images, prevent font shifts, reserve space for elements added later."

msgid "Total Blocking Time (TBT) yüksek"
msgstr "Total Blocking Time (TBT) is high"

msgid "Hedef 200 ms altı. Açılış JS'ini azaltın, üçüncü taraf betikleri erteleyin."
msgstr "Target under 200 ms. Reduce startup JS and defer third-party scripts."

msgid "First Contentful Paint (FCP) yavaş"
msgstr "First Contentful Paint (FCP) is slow"

msgid "Hedef 1,8 sn altı. Engelleyen CSS/JS ve sunucu yanıt süresini azaltın."
msgstr "Target under 1.8 s. Reduce render-blocking CSS/JS and server response time."

msgid "Speed Index yavaş"
msgstr "Speed Index is slow"

msgid "İlk ekranın hızlı dolması için kritik CSS ve yazı tiplerini önceliklendirin, giriş animasyonlarını kısaltın."
msgstr "Prioritize critical CSS and fonts so the first screen fills quickly; shorten entrance animations."

msgid "Site HTTPS değil ya da karışık içerik var"
msgstr "Site is not HTTPS or has mixed content"

msgid "Ayarlar › Genel'de adresleri https:// yapın, http:// ile yüklenen görsel/betikleri düzeltin."
msgstr "Set the addresses to https:// in Settings › General and fix images/scripts loaded over http://."

msgid "HSTS politikası zayıf"
msgstr "Weak HSTS policy"

msgid "Strict-Transport-Security: max-age=31536000; includeSubDomains. Tüm alt alan adları HTTPS ise \"preload\" da ekleyip hstspreload.org'a başvurabilirsiniz."
msgstr "Strict-Transport-Security: max-age=31536000; includeSubDomains. If every subdomain is HTTPS you can also add \"preload\" and apply at hstspreload.org."

msgid "İçerik Güvenlik Politikası (CSP) yok ya da eksik"
msgstr "No or incomplete Content Security Policy (CSP)"

msgid "Flux SEO temel CSP'yi (object-src 'none'; base-uri 'self'; frame-ancestors 'self') ekleyebilir. Tam script-src politikası WordPress'te eklentileri bozabilir; önce Content-Security-Policy-Report-Only ile deneyin."
msgstr "Flux SEO can add a basic CSP (object-src 'none'; base-uri 'self'; frame-ancestors 'self'). A full script-src policy can break plugins on WordPress; try Content-Security-Policy-Report-Only first."

msgid "Tıklama korsanlığına (clickjacking) karşı koruma yok"
msgstr "No clickjacking protection"

msgid "X-Frame-Options: SAMEORIGIN ve CSP frame-ancestors 'self' gönderin. Siteniz başka sitelerde iframe ile gösteriliyorsa açmayın."
msgstr "Send X-Frame-Options: SAMEORIGIN and CSP frame-ancestors 'self'. Do not turn on if your site is embedded in other sites with an iframe."

msgid "Pencere yalıtımı (COOP) yok"
msgstr "No origin isolation (COOP)"

msgid "Cross-Origin-Opener-Policy: same-origin-allow-popups gönderin; ödeme ve giriş açılır pencereleri çalışmaya devam eder."
msgstr "Send Cross-Origin-Opener-Policy: same-origin-allow-popups; payment and login popups keep working."

msgid "Trusted Types tanımlı değil"
msgstr "Trusted Types not set"

msgid "DOM tabanlı XSS'e karşı ileri seviye koruma. WordPress eklentilerinin çoğu henüz uyumlu değil; yalnız özel temalı, az eklentili sitelerde Report-Only ile deneyin."
msgstr "Advanced protection against DOM-based XSS. Most WordPress plugins are not compatible yet; try it with Report-Only only on custom-theme sites with few plugins."

msgid "X-Content-Type-Options başlığı yok"
msgstr "No X-Content-Type-Options header"

msgid "X-Content-Type-Options: nosniff. Flux SEO bunu kendiliğinden gönderir; sunucu ya da önbellek eklentisi siliyor olabilir."
msgstr "X-Content-Type-Options: nosniff. Flux SEO sends it by default; the server or a cache plugin may be removing it."

msgid "HTML doctype ya da charset eksik"
msgstr "HTML doctype or charset missing"

msgid "Sayfa <!DOCTYPE html> ile başlamalı ve <meta charset=\"UTF-8\"> ilk satırlarda olmalı."
msgstr "The page must start with <!DOCTYPE html> and have <meta charset=\"UTF-8\"> in the first lines."

msgid "llms.txt yok"
msgstr "No llms.txt"

msgid "Yapay zekâ ajanları siteyi /llms.txt ile özetler. Flux SEO site adı, açıklama, menü sayfaları ve son içeriklerden kendiliğinden üretir; açmak için tek tık."
msgstr "AI agents summarize a site through /llms.txt. Flux SEO builds it from the site name, description, menu pages and recent content; one click to turn it on."

msgid "llms.txt önerilen biçimde değil"
msgstr "llms.txt is not in the recommended format"

msgid "İlk satır \"# Site adı\", ardından \"> kısa özet\" ve [başlık](adres) biçiminde bağlantı listeleri olmalı. Kökte elle konmuş eski bir dosya varsa silin; Flux SEO üretir."
msgstr "The first line must be \"# Site name\", then \"> short summary\" and link lists in [title](url) form. If an old hand-made file sits in the root, delete it; Flux SEO generates one."

msgid "Formlar WebMCP aracı olarak tanımlı değil"
msgstr "Forms are not declared as WebMCP tools"

msgid "WebMCP, tarayıcıdaki ajanların formları araç olarak çağırmasını sağlar (form toolname/tooldescription). Flux SEO arama formuna kendiliğinden ekler; kendi formlarınıza da ekleyin."
msgstr "WebMCP lets browser agents call forms as tools (form toolname/tooldescription). Flux SEO adds it to the search form; add it to your own forms too."

msgid "robots.txt yapay zekâ tarayıcılarını engelliyor"
msgstr "robots.txt blocks AI crawlers"

msgid "GPTBot, ClaudeBot, Google-Extended, PerplexityBot gibi tarayıcılar engelliyse içeriğiniz yapay zekâ yanıtlarında görünmez. Bilerek engellemediyseniz robots.txt'den kaldırın."
msgstr "If crawlers like GPTBot, ClaudeBot, Google-Extended, PerplexityBot are blocked, your content does not show up in AI answers. Remove them from robots.txt unless you block them on purpose."

