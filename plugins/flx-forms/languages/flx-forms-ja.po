msgstr "スタイルを設定して保存"

msgid "Which form should send data to Google Sheets?"
msgstr "どのフォームから Google スプレッドシートにデータを送信する必要がありますか?"

msgid "Please select a form first."
msgstr "最初にフォームを選択してください。"

msgid "Service Account"
msgstr "サービス アカウント"

msgid "Loading your spreadsheets..."
msgstr "スプレッドシートをロードしています..."

msgid "Click <strong>“Browse My Sheets”</strong> to list spreadsheets this service account can already access, or <strong>“Create New Sheet”</strong> to make a fresh one."
msgstr "<strong>[シートの参照]</strong>をクリックしてこのサービス アカウントが既にアクセスできるスプレッドシートを一覧表示するか、<strong>[新しいシートの作成]</strong>をクリックして新しいシートを作成します。"

msgid "<strong>No spreadsheets are accessible to this service account yet.</strong> You have two options:"
msgstr "<strong>このサービス アカウントにアクセスできるスプレッドシートはまだありません。</strong>2 つのオプションがあります:"

msgid "<strong>Easiest:</strong> click <em>“Create New Sheet”</em> above — it is made for you and shared to your email automatically."
msgstr "<strong>最も簡単:</strong>上の<em>[新しいシートを作成]</em>をクリックします。シートが作成され、自動的にメールに共有されます。"

msgid "<strong>Use an existing sheet:</strong>open it in Google Sheets → Share → paste"
msgstr "<strong>既存のシートを使用します:</strong>Google スプレッドシートで開き → 共有 → 貼り付け"

msgid "→ Editor, then click<em>Browse My Sheets</em>again."
msgstr "→ エディターで、[<em>] [マイ シートを参照]</em>を再度クリックします。"

