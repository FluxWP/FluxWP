msgid "Prefix messages with the agent's name (*Name:*)"
msgstr "Prefixar mensagens com o nome do agente (*Nome:*)"

msgid "Agents see only chats assigned to them and unassigned chats (admins see all)"
msgstr "Os agentes veem apenas os chats atribuídos a eles e os chats não atribuídos (os administradores veem todos)"

