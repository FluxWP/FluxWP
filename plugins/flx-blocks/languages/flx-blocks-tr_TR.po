msgstr "primitive.*.custom.* alanı kullanıcının oluşturduğu temel tokenlara ayrılmıştır. user-primitives uç noktasını kullanın."

msgid "The requested design token library does not exist."
msgstr "İstenen tasarım token kütüphanesi yok."

msgid "Whether the design-token registry is active."
msgstr "Tasarım token kaydı etkin mi."

msgid "Whether the library resolved without a corrupt-store failure."
