{
  "name": "@fluxwp/render-web",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "DOM renderer for flx-app manifests: lists (table + master-detail, virtual scroll), details, forms and actions. Draws @fluxwp/runtime controllers. No data logic.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fluxwp/core": "workspace:*",
    "@fluxwp/manifest": "workspace:*",
    "@fluxwp/runtime": "workspace:*",
    "@fluxwp/ui": "workspace:*",
    "@tanstack/react-virtual": "^3.13.12",
    "lucide-react": "^1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "typescript": "^5.9.3"
  }
}
