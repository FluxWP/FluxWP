msgid "Automatically send form submissions to your Google Sheets. Connect one or more service accounts, link a sheet to each form, and let data flow in real time — no webhook or browser login required."
msgstr "フォームの送信内容を Google スプレッドシートに自動的に送信します。 1 つ以上のサービス アカウントを接続し、シートを各フォームにリンクすると、リアルタイムでデータが流れるようになります。Webhook やブラウザのログインは必要ありません。"

msgid "Not Connected"
msgstr "接続されていません"

msgid "Auto Sync"
msgstr "自動同期"

msgid "Auto Header"
msgstr "自動ヘッダー"

msgid "Sync Logs"
msgstr "ログを同期する"

msgid "Google Sheet Settings"
msgstr "Google シートの設定"

msgid "Active Bindings"
msgstr "アクティブなバインディング"

msgid "No service account connected yet"
msgstr "まだサービス アカウントが接続されていません"

msgid "Form Bindings"
msgstr "フォーム バインディング"

msgid "Help & Guide"
msgstr "ヘルプとガイド"

msgid "Saved successfully."
msgstr "正常に保存されました。"

msgid "Open in Google Sheets"
msgstr "Google スプレッドシートで開く"

msgid "Service Accounts"
msgstr "サービス アカウント"

msgid "Connect one or more Google service accounts — no browser login required"
msgstr "1 つ以上の Google サービス アカウントを接続します - ブラウザへのログインは必要ありません"

msgid "Your server is missing the PHP OpenSSL extension."
msgstr "サーバーには PHP OpenSSL 拡張機能がありません。"

msgid "Google Sheet sync cannot work until it is enabled. Please ask your host to enable the %s PHP extension, then reload this page."
msgstr "Google シートの同期は有効になるまで機能しません。%sPHP 拡張機能を有効にするようホストに依頼してから、このページをリロードしてください。"

msgid "Copy this email"
msgstr "このメールをコピーしてください"

msgid "Copy email"
msgstr "メールをコピー"

msgid "To sync an<strong>existing</strong>sheet: open it in Google Sheets →<strong>Share</strong>→ paste the email above → set role to<strong>Editor</strong>. To create a<strong>new</strong>sheet, just use Form Bindings — no sharing needed."
msgstr "<strong>の既存の</strong>シートを同期するには、Google スプレッドシートで開きます →<strong></strong>を共有 → 上記のメールを貼り付け → ロールを<strong>エディタ</strong>に設定します。新しい<strong></strong>シートを作成するには、フォーム バインディングを使用するだけです。共有は必要ありません。"

msgid "Set Default"
msgstr "デフォルトを設定"

msgid "Retest"
msgstr "再テスト"

msgid "Let’s connect Google Sheets — about 3 minutes, one time"
msgstr "Google スプレッドシートに接続しましょう — 1 回約 3 分"

msgid "Follow the numbered steps on the right to download a free service account key from Google, then drop the file below. You only do this once. After that, creating a sheet for any form is a couple of clicks."
msgstr "右側の番号付きの手順に従って、Google から無料のサービス アカウント キーをダウンロードし、そのファイルを下にドロップします。これを行うのは 1 回だけです。その後は、数回クリックするだけで、任意のフォームのシートを作成できます。"

msgid "Your Google email"
msgstr "Google メールアドレス"

msgid "(recommended)"
msgstr "(推奨)"

msgid "Any sheet the plugin <strong>creates</strong> is automatically shared to this address, so it appears in your own Google Drive under “Shared with me.” Without it, new sheets stay hidden inside the service account."
msgstr "プラグイン<strong></strong>が作成するシートはすべて、このアドレスに自動的に共有されるため、自分の Google ドライブの [共有] の下に表示されます。これがないと、新しいシートはサービス アカウント内に隠されたままになります。"

msgid "Enable Google Sheet Integration"
msgstr "Google シートの統合を有効にする"

msgid "Sync form submissions to your spreadsheets automatically"
msgstr "フォーム送信をスプレッドシートに自動的に同期します"

msgid "Drag & drop service account JSON file(s) here"
msgstr "サービス アカウント JSON ファイルをここにドラッグ アンド ドロップします"

msgid "or click to browse — you can add multiple service accounts at once"
msgstr " クリックして参照 — 複数のサービス アカウントを一度に追加できます"

msgid "Connected service accounts"
msgstr "接続されたサービス アカウント"

msgid "One-time setup (≈3 min)"
msgstr "1 回限りのセットアップ (約 3 分)"

msgid "Go to<a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noopener noreferrer\">console.cloud.google.com</a>→ Project dropdown (top-left) → New Project → name it → Create"
msgstr "<a href=\"https://console.cloud.google.com/\" target=\"_blank\" rel=\"noopener noreferrer\">console.cloud.google.com</a>に移動 → プロジェクト ドロップダウン (左上) → 新しいプロジェクト → 名前を付けます → 作成"

msgid "APIs & Services → Library → enable<strong>Google Sheets API</strong><em>and</em><strong>Google Drive API</strong>"
msgstr "API とサービス → ライブラリ →<strong>Google Sheet API</strong><em>および</em><strong>Google Drive API</strong>を有効にします "

msgid "APIs & Services → Credentials → Create Credentials → Service Account → name it → Done"
msgstr "API とサービス → 認証情報 → 認証情報の作成 → サービス アカウント → 名前を付け → 完了"

msgid "Open the service account → Keys tab → Add Key → Create New Key → JSON (downloads automatically)"
msgstr "サービス アカウントを開く → [キー] タブ → キーの追加 → 新しいキーの作成 → JSON (自動的にダウンロード)"

msgid "Drag that downloaded file into the box on the left — it is tested automatically"
msgstr "ダウンロードしたファイルを左側のボックスにドラッグします。自動的にテストされます"

msgid "Add <strong>Your Google email</strong> above so created sheets land in your Drive"
msgstr "上記の Google メール</strong><strong>を追加すると、作成されたシートがドライブに配置されます"

msgid "Please choose a valid .json key file."
msgstr "有効な .json キー ファイルを選択してください。"

msgid "Could not read file: %s"
msgstr "ファイルを読み取れませんでした:%s"

msgid "Connecting service account..."
msgstr "サービス アカウントを接続中..."

msgid "Service account added."
msgstr "サービス アカウントが追加されました。"

msgid "Saved. New sheets created by the plugin will be shared to %s automatically."
msgstr "保存されました。プラグインによって作成された新しいシートは%sに自動的に共有されます。"

msgid "Email cleared. New sheets will stay inside the service account until you share them."
msgstr "電子メールが消去されました。新しいシートは、共有するまでサービス アカウント内に残ります。"

msgid "Remove this service account?"
msgstr "Remove this service account?"

msgid "Connect each form to a specific Google Sheet tab"
msgstr "各フォームを特定の Google スプレッドシート タブに接続します"

msgid "Connect each form to a specific Google Sheet tab — step by step"
msgstr "各フォームを特定の Google スプレッドシート タブに接続します — ステップバイステップ"

msgid "No service account connected."
msgstr "サービス アカウントが接続されていません。"

msgid "Go to the Connections tab and drop a service account JSON key first."
msgstr "[接続] タブに移動し、最初にサービス アカウントの JSON キーをドロップします。"

msgid "Last sync OK"
msgstr "最後の同期は OK"

msgid "Last sync failed"
msgstr "最後の同期に失敗しました"

msgid "Remove sync? The sheet stays safe."
msgstr "同期を削除しますか?シートは安全なままです。"

msgid "Yes, remove"
msgstr "はい、削除します"

msgid "Remove this sync (your Google Sheet is not deleted)"
msgstr "この同期を削除します (Google スプレッドシートは削除されません)"

