{
  "name": "@fluxwp/manifest",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "FluxWP app contracts (flx-app-manifest/1, flx-app-config/1): types, valibot schemas, template/condition engine, target parser, config layering, fixtures. Pure TS, platform-neutral.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./fixtures/*": "./fixtures/*",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "schema": "bun scripts/json-schema.ts"
  },
  "dependencies": {
    "@fluxwp/core": "workspace:*",
    "@fluxwp/tokens": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0",
    "@valibot/to-json-schema": "^1.8.0"
  }
}
