msgstr "DISABLE_WP_CRON está activado y el trabajo diario no se ha ejecutado durante 2 días. En el panel de Hostinger, llame a wp-cron.php cada 5 a 15 minutos en Avanzado › Trabajos cron."

msgid "The daily task has not run for 2 days; WP-Cron is triggered by visits. Old backups may not be getting deleted."
msgstr "La tarea diaria no se ha ejecutado durante 2 días; WP-Cron se activa con las visitas. Es posible que las copias de seguridad antiguas no se eliminen."

