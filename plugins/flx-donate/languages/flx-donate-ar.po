msgid "[['WP-Cron is turned off in wp-config.php (DISABLE_WP_CRON). That is fine only if a server cron job calls%severy 5–15 minutes; without it recurring charges, retries and other scheduled tasks never run.\\n"
msgstr "[['تم إيقاف تشغيل WP-Cron في wp-config.php (DISABLE_WP_CRON). يعد هذا أمرًا جيدًا فقط إذا كانت مهمة cron للخادم تستدعي%sكل 5-15 دقيقة؛ وبدون هذه الرسوم المتكررة، لن يتم تشغيل عمليات إعادة المحاولة والمهام المجدولة الأخرى.\\n"

msgid "\\nScheduled tasks are running, so a server cron is in place.\\n"
msgstr "\\nالمهام المجدولة قيد التشغيل، لذا تم تفعيل عملية cron للخادم.\\n"

msgid "\\nScheduled tasks have not run recently: check the server cron job (Hostinger: hPanel › Advanced › Cron Jobs).', 'en']]"
msgstr "\\nالمهام المجدولة لم يتم تشغيلها مؤخرًا: تحقق من وظيفة cron للخادم (Hostinger: hPanel › Advanced › Cron Jobs).', 'ar']]"

msgid "\\nWP-Cron runs when someone visits the site. On a quiet site tasks can run late; for reliable recurring charges add a server cron job that calls wp-cron.php every 15 minutes and set DISABLE_WP_CRON to true (see KURULUM.md).\\n"
msgstr "\\nيتم تشغيل WP-Cron عندما يقوم أحد الأشخاص بزيارة الموقع. في الموقع الهادئ، يمكن أن تتأخر المهام؛ للحصول على رسوم متكررة موثوقة، قم بإضافة مهمة cron للخادم التي تستدعي wp-cron.php كل 15 دقيقة وتعيين DISABLE_WP_CRON إلى true (راجع KURULUM.md).\\n"

msgid "\\nALTERNATE_WP_CRON is on.\\n"
msgstr "\\nALTERNATE_WP_CRON قيد التشغيل.\\n"

msgid "\\nFlux Donate hourly task\", 'en']]"
msgstr "\\nمهمة التبرع بالتدفق كل ساعة\"، 'ar']]"

