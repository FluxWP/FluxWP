{
  "id": "analytics",
  "plugin": "flx-analytics",
  "min_app": "1.0.0",
  "title": "Statistics",
  "icon": "chart",
  "menu": "flx-analytics",
  "entry": "overview",
  "tabs": ["overview", "live", "pages", "sources"],
  "fallback": { "web": "admin.php?page=flx-analytics" },
  "routes": {
    "admin.php?page=flx-analytics": { "screen": "overview" }
  },
  "sources": {
    "report": {
      "graphql": { "op": "FlxAnalyticsReport", "variables": { "filter": { "range": "DAYS_30" } }, "data": "flxAnalyticsReport" },
      "cache": { "stale": 60, "persist": true }
    },
    "live": {
      "graphql": { "op": "FlxAnalyticsRealtime", "variables": { "minutes": 30 }, "data": "flxAnalyticsRealtime" },
      "cache": { "stale": 15 },
      "poll": 15
    },
    "pages": {
      "graphql": { "op": "FlxAnalyticsPages", "variables": { "filter": { "range": "DAYS_30" } }, "data": "flxAnalyticsPages" },
      "paging": { "mode": "cursor", "size": 25, "items": "nodes", "next": "pageInfo.endCursor", "has_next": "pageInfo.hasNextPage", "total": "totalCount" },
      "key": "path",
      "cache": { "stale": 60, "persist": true }
    },
    "referrers": {
      "graphql": { "op": "FlxAnalyticsReferrers", "variables": { "filter": { "range": "DAYS_30" } }, "data": "flxAnalyticsReferrers" },
      "paging": { "mode": "cursor", "size": 25, "items": "nodes", "next": "pageInfo.endCursor", "has_next": "pageInfo.hasNextPage", "total": "totalCount" },
      "key": "host",
      "cache": { "stale": 60, "persist": true }
    },
    "channels": {
      "graphql": { "op": "FlxAnalyticsBreakdown", "variables": { "filter": { "range": "DAYS_30" }, "kind": "CHANNEL" }, "data": "flxAnalyticsBreakdown" },
      "paging": { "mode": "cursor", "size": 25, "items": "nodes", "next": "pageInfo.endCursor", "has_next": "pageInfo.hasNextPage", "total": "totalCount" },
      "key": "value",
      "cache": { "stale": 60, "persist": true }
    }
  },
  "screens": {
    "overview": {
      "type": "dashboard",
      "title": "Last 30 days",
      "sources": ["report"],
      "sections": [
        {
          "type": "stats",
          "items": [
            { "label": "Visitors", "value": "{{kpi.totals.visitors|number}}" },
            { "label": "Page views", "value": "{{kpi.totals.pageviews|number}}" },
            { "label": "Sessions", "value": "{{kpi.visits.sessions|number}}" },
            { "label": "Right now", "value": "{{realtime.active|number}}", "tone": "accent", "onPress": { "target": "screen:analytics/live" } }
          ]
        },
        {
          "type": "chart",
          "chart": "bar",
          "title": "Visitors and page views",
          "path": "kpi.series.items",
          "x": "date",
          "series": [
            { "key": "visitors", "label": "Visitors" },
            { "key": "pageviews", "label": "Page views" }
          ]
        },
        {
          "type": "list",
          "title": "Pages",
          "path": "pages.items",
          "item": { "title": "{{title}}", "subtitle": "{{path}}", "meta": "{{pageviews|number}}" },
          "onPress": { "target": "screen:analytics/pages" }
        },
        {
          "type": "list",
          "title": "Referring sites",
          "path": "referrers.items",
          "item": { "title": "{{host}}", "subtitle": "{{channelLabel}}", "meta": "{{visitors|number}}" },
          "onPress": { "target": "screen:analytics/sources" }
        },
        { "type": "actions", "items": ["open_panel"] }
      ]
    },
    "live": {
      "type": "dashboard",
      "title": "Live",
      "sources": ["live"],
      "sections": [
        {
          "type": "stats",
          "items": [
            { "label": "Right now", "value": "{{active|number}}", "tone": "accent" },
            { "label": "Visitors", "value": "{{visitors|number}}" },
            { "label": "Page views", "value": "{{pageviews|number}}" }
          ]
        },
        { "type": "chart", "chart": "bar", "title": "Last minutes", "path": "perMinute" },
        {
          "type": "list",
          "title": "Pages being viewed",
          "path": "pages",
          "item": { "title": "{{title}}", "subtitle": "{{path}}", "meta": "{{pageviews|number}}" }
        },
        {
          "type": "list",
          "title": "Referrers",
          "path": "referrers",
          "item": { "title": "{{host}}", "meta": "{{pageviews|number}}" }
        },
        {
          "type": "list",
          "title": "Countries",
          "path": "countries",
          "item": { "title": "{{label}}", "meta": "{{visitors|number}}" }
        }
      ]
    },
    "pages": {
      "type": "list",
      "title": "Pages",
      "source": "pages",
      "layout": "rows",
      "columns": [
        { "label": "Page", "value": "{{title}}", "width": 3 },
        { "label": "Address", "value": "{{path}}", "width": 2 },
        { "label": "Visitors", "value": "{{visitors|number}}", "align": "end" },
        { "label": "Page views", "value": "{{pageviews|number}}", "align": "end" }
      ],
      "search": { "param": "q", "placeholder": "Search address" },
      "filters": [{ "param": "only404", "label": "Not found (404)", "type": "toggle" }],
      "item": {
        "title": "{{title|default:path}}",
        "subtitle": "{{path}}",
        "meta": "{{pageviews|number}}",
        "caption": "{{visitors|number}} visitors",
        "badges": [{ "text": "404", "tone": "danger", "when": { "path": "is404", "op": "truthy" } }]
      },
      "empty": { "title": "No pages", "body": "No page was viewed in this period." }
    },
    "sources": {
      "type": "tabs",
      "title": "Sources",
      "tabs": [
        { "screen": "referrers", "title": "Sites" },
        { "screen": "channels", "title": "Channels" }
      ]
    },
    "referrers": {
      "type": "list",
      "title": "Referring sites",
      "source": "referrers",
      "search": { "param": "q", "placeholder": "Search site" },
      "item": { "title": "{{host}}", "subtitle": "{{channelLabel}}", "meta": "{{visitors|number}}" },
      "empty": { "title": "No referrers", "body": "No outside site sent visitors in this period." }
    },
    "channels": {
      "type": "list",
      "title": "Channels",
      "source": "channels",
      "item": { "title": "{{label}}", "meta": "{{visitors|number}}", "caption": "{{pageviews|number}} page views" },
      "empty": { "title": "No channels", "body": "No channel breakdown for this period." }
    }
  },
  "actions": {
    "open_panel": {
      "label": "Open in panel",
      "icon": "globe",
      "web": "admin.php?page=flx-analytics"
    }
  }
}
