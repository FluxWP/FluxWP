msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Project-Id-Version: Flux reCAPTCHA\n"
"Language: en_US\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Ayarlar"
msgstr "Settings"

msgid "Formları spam ve bot saldırılarına karşı korur"
msgstr "Protects forms against spam and bot attacks"

msgid "reCAPTCHA"
msgstr "reCAPTCHA"

msgid "Önce site anahtarını yazın."
msgstr "Enter the site key first."

msgid "Gizli anahtarı yazın."
msgstr "Enter the secret key."

msgid "Google reCAPTCHA yükleniyor…"
msgstr "Loading Google reCAPTCHA…"

msgid "Kutucuğu işaretleyin; işaretlenince test kendiliğinden sürer."
msgstr "Tick the box; the test continues on its own once it is ticked."

msgid "Google ile doğrulanıyor…"
msgstr "Verifying with Google…"

msgid "Google reCAPTCHA yüklenemedi. Site anahtarını ve alan adını kontrol edin; Google erişilemiyorsa \"recaptcha.net\" seçeneğini deneyin."
msgstr "Google reCAPTCHA could not be loaded. Check the site key and the domain; if Google is unreachable, try the \"recaptcha.net\" option."

msgid "Site anahtarı değişti; testi yeni anahtarla yapmak için sayfa yenileniyor…"
msgstr "The site key changed; reloading the page to test with the new key…"

msgid "Bir şey ters gitti. Tekrar deneyin."
msgstr "Something went wrong. Please try again."

msgid "Anahtarlar kaydedildi; koruma açık."
msgstr "Keys saved; protection is on."

msgid "Formlar henüz korunmuyor. Google reCAPTCHA anahtarlarını girip test edin."
msgstr "Forms are not protected yet. Enter your Google reCAPTCHA keys and test them."

msgid "Ayarlara git"
msgstr "Go to settings"

msgid "Bu işlem için yetkiniz yok."
msgstr "You are not allowed to do this."

msgid "Giriş, kayıt, yorum, ödeme, bağış ve form gönderimlerini botlara karşı Google reCAPTCHA ile korur. Hangi formun korunacağını aşağıdan seçin."
msgstr "Protects login, registration, comments, checkout, donations and form submissions from bots with Google reCAPTCHA. Choose below which forms to protect."

msgid "Koruma kurtarma sabitiyle kapalı."
msgstr "Protection is turned off by the recovery constant."

msgid "wp-config.php dosyasındaki FLXRC_DISABLE satırını silince koruma yeniden çalışır."
msgstr "Remove the FLXRC_DISABLE line from wp-config.php to turn protection back on."

msgid "Koruma henüz çalışmıyor."
msgstr "Protection is not running yet."

msgid "Anahtarları girip \"Test et\"e basın. Test geçmeden hiçbir forma doğrulama eklenmez; böylece yanlış anahtarla giriş ekranına kilitlenmezsiniz."
msgstr "Enter your keys and press \"Test\". No form is checked until the test passes, so a wrong key can never lock you out of the login screen."

msgid "Google gizli anahtarı reddetti"
msgstr "Google rejected the secret key"

msgid "Google'a ulaşılamadı"
msgstr "Google could not be reached"

msgid "O sırada gönderimler doğrulamasız geçirildi."
msgstr "Submissions were let through without a check at that time."

msgid "O sırada gönderimler engellendi."
msgstr "Submissions were blocked at that time."

msgid "Kapalı"
msgstr "Off"

msgid "Açık"
msgstr "On"

msgid "v3 · görünmez"
msgstr "v3 · invisible"

msgid "v2 · kutucuk"
msgstr "v2 · checkbox"

msgid "Test bekliyor"
msgstr "Awaiting test"

msgid "Anahtarları test edin"
msgstr "Test your keys"

msgid "Koruma"
msgstr "Protection"

msgid "Korunan form"
msgstr "Protected forms"

msgid "%1$s / %2$s"
msgstr "%1$s / %2$s"

msgid "kurulu eklentilerdeki formlar"
msgstr "forms of installed plugins"

msgid "Geçen gönderim"
msgstr "Passed"

msgid "son 30 gün"
msgstr "last 30 days"

msgid "Engellenen"
msgstr "Blocked"

msgid "Anahtarlar"
msgstr "Keys"

msgid "Test edildi"
msgstr "Tested"

msgid "Test edilmedi"
msgstr "Not tested"

msgid "Anahtarları %s alın: reCAPTCHA türünü seçin ve alan adınızı ekleyin. Site anahtarı ile gizli anahtar aynı kayda ait olmalı."
msgstr "Get your keys %s: choose the reCAPTCHA type and add your domain. The site key and the secret key must belong to the same entry."

msgid "Google reCAPTCHA konsolundan"
msgstr "from the Google reCAPTCHA console"

msgid "reCAPTCHA türü"
msgstr "reCAPTCHA type"

msgid "v3 · Görünmez"
msgstr "v3 · Invisible"

msgid "Ziyaretçiye hiçbir şey sorulmaz; Google 0–1 arası puan verir. Önerilen."
msgstr "Visitors are never asked anything; Google returns a score from 0 to 1. Recommended."

msgid "v2 · \"Ben robot değilim\""
msgstr "v2 · \"I'm not a robot\""

msgid "Formda kutucuk görünür; şüpheli ziyaretçiye resim sorulur."
msgstr "A checkbox appears on the form; suspicious visitors get an image challenge."

msgid "Site anahtarı"
msgstr "Site key"

msgid "Gizli anahtar"
msgstr "Secret key"

msgid "Kayıtlı (%s). Değiştirmek için yazın."
msgstr "Saved (%s). Type to replace it."

msgid "Gizli anahtarı yapıştırın"
msgstr "Paste the secret key"

msgid "Bir kez girilir, şifreli saklanır ve bir daha gösterilmez."
msgstr "Entered once, stored encrypted and never shown again."

msgid "Anahtarlardan biri wp-config.php sabitinden geliyor (FLXRC_SITE_KEY / FLXRC_SECRET_KEY); paneldeki değer kullanılmaz."
msgstr "One of the keys comes from a wp-config.php constant (FLXRC_SITE_KEY / FLXRC_SECRET_KEY); the value in this panel is not used."

msgid "Test et ve kaydet"
msgstr "Test and save"

msgid "Google'dan gerçek bir doğrulama alır; geçerse anahtarlar kaydedilir ve koruma açılır."
msgstr "Runs a real check with Google; if it passes, the keys are saved and protection turns on."

msgid "Son test: %1$s · %2$s"
msgstr "Last test: %1$s · %2$s"

msgid "Korunan formlar"
msgstr "Protected forms"

msgid "Son 30 gün: geçen / engellenen"
msgstr "Last 30 days: passed / blocked"

msgid "kurulu değil"
msgstr "not installed"

msgid "Flux Forms'ta formun kendi reCAPTCHA seçeneği açıksa kapatın; iki doğrulama aynı sayfada çakışır."
msgstr "If a form has its own reCAPTCHA option turned on in Flux Forms, turn it off; two checks on one page conflict."

msgid "Bot eşiği (v3)"
msgstr "Bot threshold (v3)"

msgid "Puanı bunun altında kalan gönderim engellenir. 0,5 çoğu site için uygun; gerçek kişiler takılıyorsa düşürün."
msgstr "Submissions scoring below this are blocked. 0.5 suits most sites; lower it if real people get stuck."

msgid "Kutucuk görünümü (v2)"
msgstr "Checkbox theme (v2)"

msgid "Otomatik (sitenin koyu moduna uyar)"
msgstr "Automatic (follows the site's dark mode)"

msgid "Açık tema"
msgstr "Light"

msgid "Koyu tema"
msgstr "Dark"

msgid "Kutucuk boyutu (v2)"
msgstr "Checkbox size (v2)"

msgid "Normal"
msgstr "Normal"

msgid "Küçük"
msgstr "Compact"

msgid "Google adresi"
msgstr "Google host"

msgid "google.com'un engellendiği ağlarda recaptcha.net kullanın."
msgstr "Use recaptcha.net on networks where google.com is blocked."

msgid "Giriş yapmış kullanıcılara sorma"
msgstr "Skip signed-in users"

msgid "Yorum, ödeme, bağış ve formlarda üyelere doğrulama yapılmaz. Giriş ve kayıt formları her zaman korunur."
msgstr "Members are not checked on comments, checkout, donations and forms. Login and registration forms are always protected."

msgid "Google'a ulaşılamazsa gönderimi geçir"
msgstr "Let submissions through if Google is unreachable"

msgid "Önerilen. Kapalıysa Google kesintisinde hiçbir korunan form gönderilemez (yönetici girişi dahil)."
msgstr "Recommended. When off, no protected form can be sent during a Google outage (admin login included)."

msgid "v3 rozetini gizle"
msgstr "Hide the v3 badge"

msgid "Sağ alttaki reCAPTCHA rozeti gizlenir; Google'ın istediği bilgi metni korunan formların altına eklenir."
msgstr "The reCAPTCHA badge in the bottom corner is hidden; the notice Google requires is added under protected forms."

msgid "Doğrulama yapılmayan IP adresleri"
msgstr "IP addresses that skip the check"

msgid "Satır başına bir IP ya da aralık (CIDR). Ofis, test ve izleme servisleri için. Şu anki IP adresiniz: %s"
msgstr "One IP or range (CIDR) per line. For your office, tests and monitoring services. Your current IP address: %s"

msgid "Giriş ekranına kilitlenirseniz wp-config.php dosyasına define( 'FLXRC_DISABLE', true ); satırını ekleyin; koruma tamamen kapanır."
msgstr "If you get locked out of the login screen, add define( 'FLXRC_DISABLE', true ); to wp-config.php; protection turns off completely."

msgid "Ayarları kaydet"
msgstr "Save settings"

msgid "Kaydedildi."
msgstr "Saved."

msgid "Kaydedildi. Anahtarlar değiştiği için koruma test edilene kadar kapalı."
msgstr "Saved. The keys changed, so protection stays off until they are tested."

msgid "Site anahtarı ve gizli anahtar gerekli."
msgstr "The site key and the secret key are required."

msgid "Bu anahtarlar v2 (kutucuk) anahtarı. Türü v2 seçin ya da Google konsolunda v3 anahtarı oluşturun."
msgstr "These are v2 (checkbox) keys. Choose v2, or create v3 keys in the Google console."

msgid "Bu anahtarlar v3 anahtarı. Türü v3 seçin ya da Google konsolunda v2 anahtarı oluşturun."
msgstr "These are v3 keys. Choose v3, or create v2 keys in the Google console."

msgid "Bu formu göndermek için tarayıcınızda JavaScript açık olmalı."
msgstr "JavaScript must be enabled in your browser to send this form."

msgid "Bu form reCAPTCHA ile korunur; Google %1$s ve %2$s geçerlidir."
msgstr "This form is protected by reCAPTCHA and the Google %1$s and %2$s apply."

msgid "Gizlilik Politikası"
msgstr "Privacy Policy"

msgid "Hizmet Şartları"
msgstr "Terms of Service"

msgid "Lütfen \"Ben robot değilim\" kutusunu işaretleyin."
msgstr "Please tick the \"I'm not a robot\" box."

msgid "Güvenlik doğrulaması yüklenemedi. Sayfayı yenileyip tekrar deneyin."
msgstr "The security check could not load. Refresh the page and try again."

msgid "Güvenlik doğrulaması geçilemedi. Sayfayı yenileyip tekrar deneyin."
msgstr "The security check failed. Refresh the page and try again."

msgid "Google'a ulaşılamadı: %s"
msgstr "Could not reach Google: %s"

msgid "Google beklenmeyen bir yanıt döndü."
msgstr "Google returned an unexpected response."

msgid "Gizli anahtar geçersiz. Google reCAPTCHA konsolundaki \"Gizli anahtar\"ı kopyalayın."
msgstr "The secret key is invalid. Copy the \"Secret key\" from the Google reCAPTCHA console."

msgid "Site anahtarı ile gizli anahtar aynı kayda ait değil ya da reCAPTCHA türü (v2/v3) yanlış seçildi."
msgstr "The site key and the secret key do not belong to the same entry, or the wrong reCAPTCHA type (v2/v3) is selected."

msgid "Doğrulanamadı (%s)."
msgstr "Could not verify (%s)."

msgid "Anahtarlar çalışıyor. Puan: %1$s, alan adı: %2$s"
msgstr "The keys work. Score: %1$s, domain: %2$s"

msgid "Anahtarlar çalışıyor. Alan adı: %s"
msgstr "The keys work. Domain: %s"

msgid "Giriş"
msgstr "Login"

msgid "wp-login.php ve Flux Speed özel giriş adresi (örn. /fluxadmin)"
msgstr "wp-login.php and the Flux Speed custom login address (e.g. /fluxadmin)"

msgid "Kayıt"
msgstr "Registration"

msgid "WordPress kayıt formu"
msgstr "WordPress registration form"

msgid "WordPress kayıt formu (sitede kayıt şu an kapalı)"
msgstr "WordPress registration form (registration is currently closed on this site)"

msgid "Şifre sıfırlama"
msgstr "Password reset"

msgid "Şifremi unuttum formu: WordPress ve WooCommerce Hesabım"
msgstr "Lost password form: WordPress and WooCommerce My Account"

msgid "Yorumlar"
msgstr "Comments"

msgid "Yazı ve sayfa yorum formu"
msgstr "Post and page comment form"

msgid "Hesap girişi"
msgstr "Account login"

msgid "WooCommerce Hesabım giriş formu"
msgstr "WooCommerce My Account login form"

msgid "Hesap kaydı"
msgstr "Account registration"

msgid "WooCommerce Hesabım kayıt formu"
msgstr "WooCommerce My Account registration form"

msgid "Ödeme"
msgstr "Checkout"

msgid "Ödeme sayfası (klasik ve blok): mağaza siparişleri, Flux Donate ve Flux Commerce ödemeleri"
msgstr "Checkout page (classic and block): store orders, Flux Donate and Flux Commerce payments"

msgid "Bağış formu"
msgstr "Donation form"

msgid "Flux Donate \"Bağış seçenekleri\" formu (sepete ekleme)"
msgstr "Flux Donate \"Donation options\" form (add to cart)"

msgid "Formlar"
msgstr "Forms"

msgid "Flux Forms gönderimleri (iletişim, başvuru, form ile giriş/kayıt)"
msgstr "Flux Forms submissions (contact, applications, login/registration forms)"

msgid "Diğer eklentiler"
msgstr "Other plugins"

msgid "Hata"
msgstr "Error"

msgid "Yorum gönderilemedi"
msgstr "Comment not sent"

msgid "Koruma wp-config.php'deki FLXRC_DISABLE sabitiyle kapalı. Sorun çözüldüyse satırı silin."
msgstr "Protection is turned off by the FLXRC_DISABLE constant in wp-config.php. Remove the line once the issue is fixed."

msgid "Google reCAPTCHA anahtarları girilmemiş; formlar korunmuyor."
msgstr "Google reCAPTCHA keys are not set; forms are not protected."

msgid "Anahtarlar test edilmemiş; test geçene kadar koruma kapalı."
msgstr "The keys have not been tested; protection stays off until the test passes."

msgid "Koruma açık (%s)."
msgstr "Protection is on (%s)."

msgid "v3 görünmez"
msgstr "v3 invisible"

msgid "v2 kutucuk"
msgstr "v2 checkbox"

msgid "reCAPTCHA anahtarları"
msgstr "reCAPTCHA keys"

msgid "Hiçbir form seçilmemiş."
msgstr "No form is selected."

msgid "Korunmuyor: %s"
msgstr "Not protected: %s"

msgid "Google doğrulaması"
msgstr "Google verification"

msgid "%1$s: %2$s. Anahtarları yeniden test edin; Google erişilemiyorsa Ayarlar > Google adresi: recaptcha.net."
msgstr "%1$s: %2$s. Test the keys again; if Google is unreachable, set Settings > Google host to recaptcha.net."

msgid "Test et"
msgstr "Test"
