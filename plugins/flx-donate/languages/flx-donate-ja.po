msgstr "このテキストに従って、私は犠牲の代理人 (vekâlet) を捧げます。"

msgid "Share%s"
msgstr "%sを共有"

msgid "Apply to all"
msgstr "すべてに適用"

msgid "e.g. Ali Yılmaz"
msgstr "e.g.アリ・ユルマズ"

