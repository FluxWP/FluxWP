msgstr "تدفق SEO: وصف الصفحة الرئيسية"

msgid "Only the default language is active; the site is single-language."
msgstr "اللغة الافتراضية فقط هي النشطة؛ الموقع أحادي اللغة."

msgid "WordPress language packs"
msgstr "حزم لغات ووردبريس"

msgid "Not installed: %s. Pick it once in Settings › General › Site Language and save (the pack downloads), then switch back."
msgstr "غير مثبت:%s. اخترها مرة واحدة في الإعدادات > عام > لغة الموقع واحفظها (يتم تنزيل الحزمة)، ثم قم بالتبديل مرة أخرى."

msgid "All active languages have WordPress translations."
msgstr "تحتوي جميع اللغات النشطة على ترجمات WordPress."

msgid "General settings"
msgstr "الإعدادات العامة"

msgid "Page translations: %s"
msgstr "ترجمات الصفحة:%s"

msgid "%1$d / %2$d pages translated. %3$s"
msgstr "صفحات%1$d/%2$dمترجمة.%3$s"

msgid "Untranslated ones are shown in Turkish (canonical address is Turkish)."
msgstr "يتم عرض الرسائل غير المترجمة باللغة التركية (العنوان الأساسي هو التركي)."

msgid "Untranslated ones are hidden in this language."
msgstr "يتم إخفاء تلك غير المترجمة في هذه اللغة."

msgid "Pages"
msgstr "الصفحات"

msgid "Visitor country"
msgstr "بلد الزائر"

msgid "No visitor has been checked for a language suggestion yet."
msgstr "لم يتم التحقق من أي زائر للحصول على اقتراح لغة حتى الآن."

msgid "The server sends no country information; the browser time zone is used (Türkiye time = Turkish). If Cloudflare is enabled, the country code is used automatically."
msgstr "لا يرسل الخادم أي معلومات عن البلد؛ يتم استخدام المنطقة الزمنية للمتصفح (توقيت تركيا = اللغة التركية). إذا تم تمكين Cloudflare، فسيتم استخدام رمز البلد تلقائيًا."

msgid "Country information comes from the %s header."
msgstr "تأتي معلومات البلد من رأس%s."

msgid "Permalinks"
msgstr "الروابط الدائمة"

msgid "Plain (?p=) links are in use; choose the \"Post name\" structure for language addresses."
msgstr "الروابط العادية (?p=) قيد الاستخدام؛ اختر بنية \"اسم المشاركة\" لعناوين اللغة."

msgid "Name (%s)"
msgstr "الاسم (%s)"

msgid "Description (%s)"
msgstr "الوصف (%s)"

msgid "If left empty, the Turkish name and description are shown."
msgstr "إذا تركت فارغة، يظهر الاسم والوصف التركي."

msgid "[['Makes the site multilingual: language addresses like /en/, translation per page, post, project and event, language-specific visual, hreflang and canonical, English recommendation for those coming from outside Turkey, language selector; Language support for Flux AI & MCP and Flux AI tools.', 'tr']]"
msgstr "[['يجعل الموقع متعدد اللغات: عناوين لغة مثل /en/، ترجمة لكل صفحة، منشور، مشروع وحدث، مرئيات خاصة باللغة، hreflang وcanonical، توصية باللغة الإنجليزية لأولئك القادمين من خارج تركيا، محدد اللغة؛ دعم اللغة لأدوات Flux AI وMCP وFlux AI.', 'tr']]"
