msgstr "غير قابل للكتابة — لا يمكن إنشاء مجلد الوظيفة الإضافية أو استخراجه إليه."

msgid "Blocked by WP_HTTP_BLOCK_EXTERNAL — outgoing requests are disabled on this site."
msgstr "تم حظرها بواسطة WP_HTTP_BLOCK_EXTERNAL — تم تعطيل الطلبات الصادرة على هذا الموقع."

msgid "DISABLE_WP_CRON is on — background retries only run if a server cron task calls wp-cron.php."
msgstr "DISABLE_WP_CRON قيد التشغيل - يتم تشغيل عمليات إعادة المحاولة في الخلفية فقط إذا كانت مهمة cron الخاصة بالخادم تستدعي wp-cron.php."

msgid "Page that needed it"
msgstr "الصفحة التي تحتاج إليها"

msgid "Plugin version"
msgstr "إصدار البرنامج المساعد"

msgid "Add-on folder"
msgstr "مجلد الوظائف الإضافية"

