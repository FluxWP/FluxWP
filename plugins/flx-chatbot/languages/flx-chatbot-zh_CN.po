msgstr "价格、库存和链接;产品在窗口中显示为卡片。"

msgid "Product cards"
msgstr "产品卡"

msgid "Image, price, \"View\" and \"Add to cart\"."
msgstr "图片、价格、“查看”和“添加到购物车”。"

msgid "Flux Wiki pages"
msgstr "Flux 维基页面"

msgid "Order status"
msgstr "订单状态"

