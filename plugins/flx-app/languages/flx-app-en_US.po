msgstr "Your session expired. Try again from the app."

msgid "%s hesabınıza erişmek istiyor"
msgstr "%s wants to access your account"

msgid "Değiştir"
msgstr "Change"

msgid "Uygulama sizin yetkilerinizle çalışır: rolünüzün gördüğü menü ve işlemler."
msgstr "The app works with your permissions: the menus and actions your role can see."

msgid "Erişimi istediğiniz zaman Kullanıcılar › Uygulama erişimi sayfasından kaldırabilirsiniz."
msgstr "You can revoke access at any time under Users › App access."

msgid "Onaydan sonra %s adresine dönülecek."
msgstr "After approval you will return to %s."

msgid "Reddet"
msgstr "Deny"

msgid "İzin ver"
msgstr "Allow"

msgid "Siteye dön"
msgstr "Back to site"

msgid "Bağlantının süresi doldu. Uygulamadan yeniden açın."
msgstr "This link has expired. Open it again from the app."

msgid "%1$s, %2$s uygulamasına giriş kodunuz. 10 dakika geçerli. Bu kodu kimseyle paylaşmayın."
msgstr "%1$s is your sign-in code for the %2$s app. Valid for 10 minutes. Do not share this code with anyone."

msgid "%s giriş kodu"
msgstr "%s sign-in code"

msgid "Uygulamaya giriş kodunuz:"
msgstr "Your app sign-in code:"

msgid "Kod 10 dakika geçerli. Siz istemediyseniz bu e-postayı yok sayın."
msgstr "The code is valid for 10 minutes. If you did not request it, ignore this email."

msgid "E-posta"
msgstr "Email"

msgid "Kodla giriş kapalı."
msgstr "Sign in with code is turned off."

msgid "Geçerli bir e-posta ya da telefon yazın."
msgstr "Enter a valid email or phone number."

msgid "Çok fazla deneme. Biraz sonra tekrar deneyin."
msgstr "Too many attempts. Try again in a little while."

msgid "Kod yanlış ya da süresi dolmuş."
msgstr "The code is wrong or has expired."

msgid "Giriş gerekli."
msgstr "Sign-in required."

msgid "Diğer"
msgstr "Other"

msgid "Panel oturumu ayarlardan kapalı."
msgstr "Admin sessions are turned off in settings."

msgid "Çok fazla istek. Biraz bekleyin."
msgstr "Too many requests. Please wait a moment."

msgid "Geçersiz panel yolu."
msgstr "Invalid admin path."

msgid "Flux App"
msgstr "Flux App"

msgid "Belirteç tablosu"
msgstr "Token table"

msgid "Hazır."
msgstr "Ready."

msgid "Tablo yok. Eklentiyi kapatıp açın."
msgstr "Table missing. Deactivate and reactivate the plugin."

msgid "HTTPS"
msgstr "HTTPS"

msgid "Site adresi https; uygulama girişi güvenli."
msgstr "The site address is https; app sign-in is secure."

msgid "Site adresi https değil; OAuth belirteçleri şifresiz gider. Canlıda https kullanın."
msgstr "The site address is not https; OAuth tokens travel unencrypted. Use https in production."

msgid "Etkin erişimler"
msgstr "Active access"

msgid "Uygulama oturumu: %1$s · API anahtarı: %2$s"
msgstr "App sessions: %1$s · API keys: %2$s"

msgid "Belirteç geçersiz ya da süresi dolmuş."
msgstr "The token is invalid or expired."
