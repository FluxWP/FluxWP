msgstr "Depois de salvar, envie o formulário uma vez para criar a linha de cabeçalho e confirmar a primeira sincronização."

msgid "Save Binding"
msgstr "Salvar vinculação"

msgid "Please choose a spreadsheet first."
msgstr "Escolha uma planilha primeiro."

msgid "Pick a style first — “None” leaves the sheet unstyled."
msgstr "Escolha um estilo primeiro — “Nenhum” deixa a planilha sem estilo."

