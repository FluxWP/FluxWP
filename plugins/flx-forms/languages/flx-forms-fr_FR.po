msgstr "\\nVos e-mails sont envoyés dans les spams\\n"

msgid "\\nWordPress sent the test email, but delivery has not been confirmed yet.\\n"
msgstr "\\nWordPress a envoyé l'e-mail de test, mais la livraison n'a pas encore été confirmée.\\n"

