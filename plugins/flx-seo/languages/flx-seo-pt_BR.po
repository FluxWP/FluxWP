msgstr "Auditoria do local"

msgid "AI (MCP)"
msgstr "IA (MCP)"

msgid "llms.txt follows recommendations"
msgstr "llms.txt segue recomendações"

msgid "Accessibility tree is well-formed"
msgstr "A árvore de acessibilidade está bem formada"

msgid "Forms are WebMCP tools"
msgstr "Formulários são ferramentas WebMCP"

msgid "Low layout shift (CLS)"
msgstr "Baixa mudança de layout (CLS)"

