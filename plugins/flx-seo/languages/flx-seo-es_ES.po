msgid "session.upload_progress.enabled is on. WordPress does not use it; turning it off shrinks the attack surface. Set \"session.upload_progress.enabled = Off\" in php.ini or the hosting panel."
msgstr "session.upload_progress.enabled está activado. WordPress no lo usa; apagarlo reduce la superficie de ataque. Configure \"session.upload_progress.enabled = Off\" en php.ini o en el panel de alojamiento."

msgid "PHP version is missing a security patch"
msgstr "A la versión PHP le falta un parche de seguridad"

msgid "The server's PHP is unpatched against a known hole or no longer supported. Upgrade PHP to the current patch release from the hosting panel."
msgstr "El PHP del servidor no está parcheado contra un agujero conocido o ya no es compatible. Actualice PHP a la versión de parche actual desde el panel de alojamiento."

msgid "session.upload_progress is on"
msgstr "session.upload_progress está activado"

msgid "WordPress does not use this PHP feature; it is the exploit path for holes such as PHP2Shell. Set session.upload_progress.enabled = Off in php.ini or the hosting panel."
msgstr "WordPress no utiliza esta característica de PHP; es la ruta de explotación para agujeros como PHP2Shell. Establezca session.upload_progress.enabled = Desactivado en php.ini o en el panel de alojamiento."

