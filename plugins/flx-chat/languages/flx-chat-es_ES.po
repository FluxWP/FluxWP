msgstr "{n} donaciones pagadas · {m}"

msgid "No contact details."
msgstr "Sin datos de contacto."

msgid "No referral."
msgstr "Sin referencia."

msgid "Has the payment reached the account? When you confirm, the certificate is made and sent to the donor."
msgstr "¿Ha llegado el pago a la cuenta? Al confirmar, se crea el certificado y se envía al donante."
