msgstr "الأسبوع المقبل"

msgid "In 2 weeks"
msgstr "بعد أسبوعين"

msgid "This Friday"
msgstr "يوم الجمعة هذا"

msgid "No date"
msgstr "بلا تاريخ"

msgid "Clear"
msgstr "مسح"

msgid "Cancel"
msgstr "إلغاء"

msgid "Apply"
msgstr "تطبيق"

msgid "Month"
msgstr "الشهر"

msgid "Time"
msgstr "الوقت"

