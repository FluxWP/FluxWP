msgstr "Tema"

msgid "Term meta"
msgstr "Termo meta"

msgid "Data will be moved to the new names. Did you take a backup?"
msgstr "Os dados serão movidos para os novos nomes. Você fez um backup?"

msgid "Post meta"
msgstr "Postar meta"

msgid "Posts and pages"
msgstr "Postagens e páginas"

msgid "Upload folders"
msgstr "Carregar pastas"

msgid "Working…"
msgstr "Trabalhando..."

msgid "Upload these new packages first (do not activate them):"
msgstr "Faça upload desses novos pacotes primeiro (não os ative):"

