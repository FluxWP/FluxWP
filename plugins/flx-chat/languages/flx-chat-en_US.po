msgstr "Certificates resent"

msgid "Asistanın iptal ettiği bağış"
msgstr "Donations cancelled by the assistant"

msgid "Yeniden gönderilen ödeme linki"
msgstr "Payment links resent"

msgid "Token: {i} giriş / {o} çıkış · {c} istek · {m} mesaj gönderildi"
msgstr "Tokens: {i} input / {o} output · {c} requests · {m} messages sent"

