msgstr "\"%s\" renk tokenı bir rengi hedeflemiyor."

msgid "Token \"%s\" appears more than once in the palette."
msgstr "\"%s\" tokenı palette birden fazla kez geçiyor."

msgid "Swatch value aliases a token that does not exist: \"%s\"."
msgstr "Renk değeri olmayan bir tokena işaret ediyor: \"%s\"."

