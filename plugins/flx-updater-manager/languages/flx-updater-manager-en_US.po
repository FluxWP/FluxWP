msgstr "Clear log"

msgid "API kotası (saatlik)"
msgstr "API quota (hourly)"

msgid "Kullanılan %1$s · yenilenme %2$s"
msgstr "Used %1$s · resets %2$s"

msgid "Paket önbelleği"
msgstr "Package cache"

msgid "boş"
msgstr "empty"

msgid "Her %d dakikada bir GitHub'dan yenilenir; webhook gelirse hemen."
msgstr "Refreshed from GitHub every %d minutes; at once when the webhook fires."

msgid "Sürüm"
msgstr "Version"

msgid "Bellek sınırı"
msgstr "Memory limit"

msgid "sınırsız"
msgstr "unlimited"

msgid "Süre sınırı"
