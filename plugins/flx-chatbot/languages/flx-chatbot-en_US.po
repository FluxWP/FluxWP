msgstr "Main color"

msgid "Tema rengi"
msgstr "Theme color"

msgid "Temayı izle"
msgstr "Follow theme"

msgid "Boşsa sitenin tema rengi kullanılır."
msgstr "When empty, the site's theme color is used."

msgid "Yazı rengi (başlık ve düğmeler)"
msgstr "Text color (header and buttons)"

msgid "Otomatik"
msgstr "Automatic"

msgid "Boşsa ana renge göre okunaklı renk seçilir."
msgstr "When empty, a readable color is picked from the main color."

msgid "Açık / koyu"
msgstr "Light / dark"

msgid "Otomatik (cihaza ve siteye uyar)"
msgstr "Automatic (follows device and site)"

msgid "Hep açık"
msgstr "Always light"

msgid "Hep koyu"
msgstr "Always dark"

