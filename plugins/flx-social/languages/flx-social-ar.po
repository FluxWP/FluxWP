msgstr "إصدار واجهة برمجة التطبيقات (YYYYMM)"

msgid "linkedin.com/developers › App (linked to the organization page) › Products: \"Sign In with LinkedIn using OpenID Connect\" and \"Share on LinkedIn\" (personal); for company pages \"Community Management API\" (needs approval). Auth › Authorized redirect URL below."
msgstr "LinkedIn.com/developers › التطبيق (مرتبط بصفحة المؤسسة) › المنتجات: \"تسجيل الدخول باستخدام LinkedIn باستخدام OpenID Connect\" و\"المشاركة على LinkedIn\" (شخصي)؛ لصفحات الشركة \"Community Management API\" (يحتاج إلى موافقة). المصادقة › عنوان URL لإعادة التوجيه المعتمد أدناه."

msgid "LinkedIn profile / page"
msgstr "الملف الشخصي/الصفحة على LinkedIn"

msgid "developers.tiktok.com › App › add Login Kit + Content Posting API, Redirect URI below. Without the audit \"Draft\" mode is recommended: the video lands in the TikTok app and is published from there. For photo posts verify the site domain in TikTok (URL properties)."
msgstr "Developers.tiktok.com ›التطبيق› أضف مجموعة أدوات تسجيل الدخول + واجهة برمجة تطبيقات نشر المحتوى، وأعد توجيه URI أدناه. بدون التدقيق، يوصى باستخدام وضع \"المسودة\": يصل الفيديو إلى تطبيق TikTok ويتم نشره من هناك. بالنسبة لمنشورات الصور، قم بالتحقق من نطاق الموقع في TikTok (خصائص عنوان URL)."

msgid "TikTok account"
msgstr "حساب تيك توك"

msgid "developers.pinterest.com › App › Redirect URI below. Trial access works only in the sandbox; apply for Standard access."
msgstr "Developers.pinterest.com ›التطبيق› إعادة توجيه URI أدناه. يعمل الوصول التجريبي فقط في وضع الحماية؛ التقدم بطلب للحصول على الوصول القياسي."

msgid "Pinterest account"
msgstr "حساب بينتيريست"

msgid "The Evolution connection comes from Flux Mail (or Flux Chat); no key is entered here. Shares go to Status and groups."
msgstr "يأتي اتصال Evolution من Flux Mail (أو Flux Chat)؛ لم يتم إدخال أي مفتاح هنا. تذهب المشاركات إلى الحالة والمجموعات."

msgid "WhatsApp Status / group"
msgstr "حالة واتس اب / مجموعة"

msgid "Unknown app."
msgstr "تطبيق غير معروف."

msgid "Login required."
msgstr "تسجيل الدخول مطلوب."

msgid "You do not have social media permission."
msgstr "ليس لديك إذن وسائل التواصل الاجتماعي."

msgid "You do not have permission for this action."
msgstr "ليس لديك إذن بهذا الإجراء."

msgid "Record not found."
msgstr "لم يتم العثور على السجل."

msgid "You cannot change this post."
msgstr "لا يمكنك تغيير هذه المشاركة."

msgid "You cannot delete this post."
msgstr "لا يمكنك حذف هذه المشاركة."

msgid "Could not delete on some networks; the post stays in the list."
msgstr "تعذر الحذف على بعض الشبكات؛ يبقى المنشور في القائمة."

msgid "%s (copy)"
msgstr "%s(نسخة)"

msgid "You do not have permission to upload files."
msgstr "ليس لديك الإذن بتحميل الملفات."

msgid "No file received."
msgstr "لم يتم استلام أي ملف."

msgid "Account removed."
msgstr "تمت إزالة الحساب."

msgid "(deleted account)"
msgstr "(حساب محذوف)"

msgid "Post not found."
msgstr "لم يتم العثور على آخر."

msgid "Unknown action."
msgstr "عمل غير معروف."

msgid "%s: the connection expired, reconnect it under Accounts."
msgstr "%s: انتهت صلاحية الاتصال، أعد توصيله ضمن \"الحسابات\"."

msgid "Text can be at most %1$d characters (currently %2$d)."
msgstr "يمكن أن يتكون النص من أحرف %1$d على الأكثر (حاليًا %2$d)."

msgid "This network does not accept GIFs; use an image or video."
msgstr "هذه الشبكة لا تقبل ملفات GIF؛ استخدام صورة أو فيديو."

msgid "At most %d images."
msgstr "على الأكثر صور %d."

msgid "At most %d videos."
msgstr "على معظم مقاطع الفيديو %d."

msgid "Images and video cannot be used together in one post."
msgstr "لا يمكن استخدام الصور والفيديو معًا في مشاركة واحدة."

msgid "Media files must be reachable at a public https address."
msgstr "يجب أن تكون ملفات الوسائط قابلة للوصول على عنوان https عام."

msgid "This network does not connect via OAuth."
msgstr "هذه الشبكة لا تتصل عبر OAuth."

msgid "The connection expired, please reconnect."
msgstr "انتهت صلاحية الاتصال، يرجى إعادة الاتصال."

msgid "This network does not allow editing a published post."
msgstr "هذه الشبكة لا تسمح بتحرير منشور منشور."

msgid "This network does not allow deleting posts via the API; delete it in the app."
msgstr "لا تسمح هذه الشبكة بحذف المشاركات عبر واجهة برمجة التطبيقات؛ حذفه في التطبيق."

msgid "First comment is not supported on this network."
msgstr "التعليق الأول غير مدعوم على هذه الشبكة."

msgid "First enter this network's keys under Settings › Apps."
msgstr "أدخل أولاً مفاتيح هذه الشبكة ضمن الإعدادات > التطبيقات."

msgid "Choose a video for YouTube."
msgstr "اختر فيديو ليوتيوب."

msgid "YouTube title can be at most 100 characters."
msgstr "يمكن أن يصل عنوان YouTube إلى 100 حرف على الأكثر."

msgid "YouTube does not accept < and > in the title and description."
msgstr "لا يقبل YouTube استخدام< and >في العنوان والوصف."

msgid "This Google account has no YouTube channel."
msgstr "لا يحتوي حساب Google هذا على قناة على YouTube."

msgid "Video file not found on the server."
msgstr "لم يتم العثور على ملف الفيديو على الخادم."

msgid "Could not read the video file."
msgstr "لا يمكن قراءة ملف الفيديو."

msgid "Video not found on YouTube."
msgstr "لم يتم العثور على الفيديو على موقع يوتيوب."

msgid "An event/offer post needs a title and a start date."
msgstr "يحتاج منشور الحدث/العرض إلى عنوان وتاريخ بدء."

msgid "Could not get business accounts (requires Google's Business Profile API access approval)"
msgstr "تعذر الحصول على حسابات الأعمال (يتطلب موافقة الوصول إلى Business Profile API من Google)"

msgid "No managed business location found on this Google account."
msgstr "لم يتم العثور على موقع نشاط تجاري مُدار في حساب Google هذا."

msgid "LinkedIn could not process the video."
msgstr "لم يتمكن LinkedIn من معالجة الفيديو."

msgid "LinkedIn video processing took too long."
msgstr "استغرقت معالجة فيديو LinkedIn وقتًا طويلاً."

msgid "No Facebook page you manage was found. Make sure you selected the pages during login."
msgstr "لم يتم العثور على صفحة الفيسبوك التي تديرها. تأكد من تحديد الصفحات أثناء تسجيل الدخول."

msgid "A story has a single image or video."
msgstr "تحتوي القصة على صورة واحدة أو مقطع فيديو واحد."

msgid "Instagram accepts at most 30 hashtags."
msgstr "يقبل Instagram 30 علامة تصنيف على الأكثر."

msgid "Instagram feed image aspect ratio must be between 4:5 and 1.91:1 (except stories)."
msgstr "يجب أن تكون نسبة العرض إلى الارتفاع لصورة خلاصة Instagram بين 4:5 و1.91:1 (باستثناء القصص)."

msgid "First enter the keys under Settings › Apps › Instagram login."
msgstr "أدخل المفاتيح أولاً ضمن الإعدادات › التطبيقات › تسجيل الدخول إلى Instagram."

msgid "Instagram could not process a carousel item (format/size not suitable)."
msgstr "تعذر على Instagram معالجة عنصر دائري (التنسيق/الحجم غير مناسب)."

msgid "Instagram could not process the media. Video: MP4 (H.264/AAC), 3–90 s (Reels 15 min), up to 1 GB; image: JPEG, up to 8 MB."
msgstr "تعذر على Instagram معالجة الوسائط. الفيديو: MP4 (H.264/AAC)، 3–90 ثانية (بكرات 15 دقيقة)، حتى 1 جيجابايت؛ الصورة: JPEG، يصل حجمها إلى 8 ميجابايت."

msgid "Instagram video processing did not finish in 30 minutes."
msgstr "لم تنتهي معالجة فيديو Instagram خلال 30 دقيقة."

msgid "Pinterest title can be at most 100 characters."
msgstr "يمكن أن يصل عنوان Pinterest إلى 100 حرف على الأكثر."

msgid "Pinterest could not process the video."
msgstr "تعذر على Pinterest معالجة الفيديو."

msgid "Pinterest video processing took too long."
msgstr "استغرقت معالجة فيديو Pinterest وقتًا طويلاً."

msgid "Because the TikTok app has not been audited yet, only \"Only me\" visibility can be used."
msgstr "نظرًا لأن تطبيق TikTok لم يتم تدقيقه بعد، فيمكن استخدام رؤية \"أنا فقط\" فقط."

msgid "Draft sent to the TikTok app; publish it from the notification in the app."
msgstr "تم إرسال المسودة إلى تطبيق TikTok؛ نشره من الإخطار في التطبيق."

msgid "TikTok processing took too long; check in the TikTok app."
msgstr "استغرقت معالجة TikTok وقتًا طويلاً؛ تحقق في تطبيق TikTok."

msgid "No WhatsApp connection. Set up an Evolution connection in Flux Mail or Flux Chat."
msgstr "لا يوجد اتصال واتس اب. قم بإعداد اتصال Evolution في Flux Mail أو Flux Chat."

msgid "WhatsApp Status"
msgstr "حالة واتس اب"

msgid "Free (no cost, low write limit, no metrics)"
msgstr "مجانًا (بدون تكلفة، حد كتابة منخفض، بدون مقاييس)"

msgid "Basic (paid monthly)"
msgstr "الأساسية (المدفوعة شهريا)"

msgid "Pro (paid monthly)"
msgstr "برو (المدفوعة شهريا)"

msgid "Pay-as-you-go"
msgstr "الدفع عند الاستخدام"

msgid "X: a video or GIF is shared on its own."
msgstr "X: تتم مشاركة مقطع فيديو أو صورة GIF بمفردها."

msgid "The monthly limit of %d posts set for X has been reached."
msgstr "تم الوصول إلى الحد الشهري لمشاركات %d المحددة لـ X."

msgid "First enter the API Key and API Key Secret under Settings › Apps › X."
msgstr "أدخل أولاً مفتاح API ومفتاح API السري ضمن الإعدادات > التطبيقات > X."

msgid "Connection refused."
msgstr "تم رفض الاتصال."

msgid "Could not read the media file."
msgstr "لا يمكن قراءة ملف الوسائط."

msgid "video could not be processed"
msgstr "لا يمكن معالجة الفيديو"

msgid "Nothing this month"
msgstr "لا شيء هذا الشهر"

msgid "Delete this post?"
msgstr "هل تريد حذف هذه المشاركة؟"

msgid "Search posts"
msgstr "بحث في المشاركات"

msgid "Account enabled"
msgstr "تم تفعيل الحساب"

msgid "Open the panel to connect an account."
msgstr "افتح اللوحة لتوصيل الحساب."

msgid "Account disabled"
msgstr "تم تعطيل الحساب"

msgid "No accounts"
msgstr "لا حسابات"

msgid "Note"
msgstr "ملاحظة"

msgid "Review"
msgstr "مراجعة"

msgid "Approved"
msgstr "تمت الموافقة عليه"

msgid "Open in panel"
msgstr "فتح في اللوحة"

msgid "Deleted"
msgstr "تم الحذف"

msgid "New posts are composed in the media composer."
msgstr "وتتألف المشاركات الجديدة في الملحن وسائل الإعلام."

msgid "Scheduled and published posts show up here."
msgstr "تظهر هنا المشاركات المجدولة والمنشورة."

msgid "Social media management within the site: account linking (keys from panel), content per account, scheduling, network edit/delete, calendar, dashboard, Flux AI writing assistance and MCP tools. Facebook, Instagram, YouTube, X, LinkedIn, TikTok, Pinterest, Google Business, WhatsApp."
msgstr "إدارة الوسائط الاجتماعية داخل الموقع: ربط الحساب (مفاتيح من اللوحة)، والمحتوى لكل حساب، والجدولة، وتحرير/حذف الشبكة، والتقويم، ولوحة المعلومات، ومساعدة الكتابة Flux AI وأدوات MCP. Facebook، Instagram، YouTube، X، LinkedIn، TikTok، Pinterest، Google Business، WhatsApp."
