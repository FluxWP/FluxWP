msgstr "(antigo: respostas a contatos com números ocultos (@lid) podem falhar, atualize para 2.3 ou posterior)"

msgid "The webhook is not pointed at this site. Press \"Set up webhook\"."
msgstr "O webhook não está apontado para este site. Pressione \"Configurar webhook\"."

msgid "Webhook set up ✓ Incoming messages will now arrive here."
msgstr "Configuração do Webhook ✓ As mensagens recebidas agora chegarão aqui."

msgid "Importing recent chats, this may take a while…"
msgstr "Importando bate-papos recentes, isso pode demorar um pouco..."

msgid "Messages stored in Evolution: %s"
msgstr "Mensagens armazenadas no Evolution:%s"

msgid "Evolution does not store messages, so older messages cannot be loaded. On the Evolution server set DATABASE_SAVE_DATA_NEW_MESSAGE and DATABASE_SAVE_DATA_HISTORIC to true; for older conversations, keep \"Sync full history\" on in the instance settings when you reconnect the line with QR."
msgstr "O Evolution não armazena mensagens, portanto mensagens mais antigas não podem ser carregadas. No servidor Evolution, configure DATABASE_SAVE_DATA_NEW_MESSAGE e DATABASE_SAVE_DATA_HISTORIC como true; para conversas mais antigas, mantenha \"Sincronizar histórico completo\" ativado nas configurações da instância ao reconectar a linha com QR."

msgid "%1$s chats, %2$s messages imported ✓"
msgstr "Bate-papos%1$s, mensagens%2$simportadas ✓"

msgid "Scan this code via WhatsApp › Linked devices › Link a device."
msgstr "Leia este código via WhatsApp › Dispositivos vinculados › Vincule um dispositivo."

