msgid_plural "%dactive type has its hidden WooCommerce product.%dactive types have their hidden WooCommerce products."
msgstr[0] " El tipo activo%dtiene su producto WooCommerce oculto.%dlos tipos activos tienen sus productos WooCommerce ocultos."
msgstr[1] " El tipo activo%dtiene su producto WooCommerce oculto.%dlos tipos activos tienen sus productos WooCommerce ocultos."

msgid "%1$dtask is more than 15 minutes late:%2$s.%1$dtasks are more than 15 minutes late:%2$s."
msgid_plural "%1$dtask is more than 15 minutes late:%2$s.%1$dtasks are more than 15 minutes late:%2$s."
msgstr[0] " La tarea%1$dtiene más de 15 minutos de retraso:%2$s. Las tareas%1$dtienen más de 15 minutos de retraso:%2$s."
msgstr[1] " La tarea%1$dtiene más de 15 minutos de retraso:%2$s. Las tareas%1$dtienen más de 15 minutos de retraso:%2$s."

