msgstr "\\nمسح السجل\\n"

msgid "\\nClear all logs?\\n"
msgstr "\\nهل تريد مسح كافة السجلات؟\\n"

msgid "\\nNo sync activity yet.\\n"
msgstr "\\nلا يوجد أي نشاط مزامنة حتى الآن.\\n"

