msgstr "اختيار اللغة"

msgid "Flux Language Switcher"
msgstr "تدفق لغة الجلاد"

msgid "Site title"
msgstr "عنوان الموقع"

msgid "Tagline"
msgstr "سطر الوصف"

msgid "Flux SEO: site name"
msgstr "تدفق كبار المسئولين الاقتصاديين: اسم الموقع"

msgid "Flux SEO: alternate name"
msgstr "تدفق كبار المسئولين الاقتصاديين: اسم بديل"

