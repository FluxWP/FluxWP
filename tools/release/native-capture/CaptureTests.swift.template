import XCTest

final class CaptureTests: XCTestCase {
    let app = XCUIApplication(bundleIdentifier: __BUNDLE_ID__)
    func element(_ id: String) -> XCUIElement {
        app.descendants(matching: .any).matching(identifier: id).firstMatch
    }
    func tap(_ id: String) {
        let target = element(id)
        XCTAssertTrue(target.waitForExistence(timeout: 60), "Missing app control: \(id)")
        target.tap()
    }
    func tab(_ choices: [String]) {
        let target = app.descendants(matching: .any).matching(NSPredicate(format: "label IN %@", choices)).firstMatch
        XCTAssertTrue(target.waitForExistence(timeout: 15), "Missing navigation tab: \(choices)")
        target.tap()
    }
    func shot(_ name: String) {
        sleep(2)
        let attachment = XCTAttachment(screenshot: XCUIScreen.main.screenshot())
        attachment.name = __DEVICE_PREFIX__ + name + ".png"
        attachment.lifetime = .keepAlways
        add(attachment)
    }
    func testStoreScreens() {
        continueAfterFailure = false
        let locale = __LOCALE__
        app.launchArguments = ["-AppleLanguages", __LANGUAGES__, "-AppleLocale", locale]
        app.launch()
        if element("welcome-skip").waitForExistence(timeout: 5) {
            tap("welcome-skip")
        }
        XCTAssertTrue(element("demo").waitForExistence(timeout: 60))
        XCTAssertTrue(element("connection-terms").waitForExistence(timeout: 15), "Connection must display policy links")
        XCTAssertFalse(element("usage-consent").exists, "Detailed usage choice belongs in Settings")
        shot("01-connect")
        tap("demo")
        XCTAssertTrue(element("open-drawer").waitForExistence(timeout: 60))
        if locale == "en_US" {
            let menu = app.descendants(matching: .any).matching(NSPredicate(format: "label == %@", "Menu")).firstMatch
            XCTAssertTrue(menu.waitForExistence(timeout: 15), "English tab labels must be localized")
            XCTAssertFalse(app.descendants(matching: .any).matching(NSPredicate(format: "label == %@", "Menü")).firstMatch.exists, "English captures must not retain the Turkish default Menu label")
        }
        shot("02-dashboard")
        tab(__MESSAGES__)
        XCTAssertTrue(element("screen-inbox").waitForExistence(timeout: 30))
        shot("03-messages")
        tap("chat-301")
        shot("04-chat")
        tab(__MORE__)
        tab(["Flux AI"])
        XCTAssertTrue(element("screen-ai").waitForExistence(timeout: 30), "Flux AI must open its native screen")
        tap("ai-chats")
        tap("ai-chat-9")
        shot("05-ai")
        tab(__CONTACTS__)
        shot("06-contacts")
        tab(__POSTS__)
        shot("07-posts")
        tap("site-switcher")
        shot("09-accounts")
        app.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.15)).tap()
        tap("open-drawer")
        shot("08-menu")
        tab(["Settings", "Ayarlar"])
        let consent = element("usage-consent")
        XCTAssertTrue(consent.waitForExistence(timeout: 15), "Usage choice must remain available in Settings")
        XCTAssertEqual(consent.value as? String, "0", "Demo entry must not enable optional usage sharing")
    }
}
