msgid "Invalid path."
msgstr "Geçersiz yol."

msgid "Invalid name."
msgstr "Geçersiz ad."

msgid "The parent folder does not exist."
msgstr "Üst klasör yok."

msgid "This is not a folder."
msgstr "Bu bir klasör değil."

msgid "The folder could not be read (permissions)."
msgstr "Klasör okunamadı (izinler)."

msgid "This is not a file."
msgstr "Bu bir dosya değil."

msgid "The file could not be read (permissions)."
msgstr "Dosya okunamadı (izinler)."

msgid "The file is larger than %s and cannot be opened in the editor. Download it instead."
msgstr "Dosya %s'den büyük, editörde açılamaz. Bunun yerine indirin."

msgid "This is a binary file and cannot be opened in the editor."
msgstr "Bu ikili bir dosya, editörde açılamaz."

msgid "File changes are disabled on this site (DISALLOW_FILE_MODS)."
msgstr "Bu sitede dosya değişikliği kapalı (DISALLOW_FILE_MODS)."

msgid "This folder is managed by Flux Files."
msgstr "Bu klasörü Flux Files yönetir."

msgid "Editing code files is disabled on this site (DISALLOW_FILE_EDIT)."
msgstr "Bu sitede kod dosyası düzenleme kapalı (DISALLOW_FILE_EDIT)."

msgid "AI cannot change protected or WordPress core files."
msgstr "AI korumalı ya da WordPress çekirdek dosyalarını değiştiremez."

msgid "AI is not allowed to write code files. Enable it in Flux Files › Settings."
msgstr "AI'nın kod dosyası yazmasına izin verilmiyor. Flux Files › Ayarlar'dan açabilirsiniz."

msgid "A folder with this name already exists."
msgstr "Bu adda bir klasör zaten var."

msgid "A file with this name already exists."
msgstr "Bu adda bir dosya zaten var."

msgid "The file changed on the server since you opened it. Reload it or save a copy."
msgstr "Siz açtıktan sonra dosya sunucuda değişti. Yeniden yükleyin ya da bir kopya kaydedin."

msgid "The file is not writable (permissions)."
msgstr "Dosyaya yazılamıyor (izinler)."

msgid "The file could not be written (permissions or disk space)."
msgstr "Dosya yazılamadı (izinler ya da disk alanı)."

msgid "A file or folder with this name already exists."
msgstr "Bu adda bir dosya ya da klasör zaten var."

msgid "The folder could not be created (permissions)."
msgstr "Klasör oluşturulamadı (izinler)."

