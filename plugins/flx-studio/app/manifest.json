{
  "id": "studio",
  "plugin": "flx-studio",
  "min_app": "1.0.0",
  "title": "Studio",
  "icon": "image",
  "menu": "flx-studio",
  "entry": "gallery",
  "tabs": ["gallery"],
  "fallback": { "web": "admin.php?page=flx-studio" },
  "routes": {
    "admin.php?page=flx-studio": { "screen": "gallery" }
  },
  "sources": {
    "items": {
      "graphql": { "op": "FlxStudioItems", "data": "flxStudioItems" },
      "paging": { "mode": "cursor", "size": 40, "items": "nodes", "next": "pageInfo.endCursor", "has_next": "pageInfo.hasNextPage" },
      "key": "id",
      "cache": { "stale": 30 }
    },
    "item": {
      "graphql": { "op": "FlxStudioItem", "variables": { "id": "{{params.id|int}}" }, "data": "flxStudioItem" },
      "cache": { "stale": 30 }
    }
  },
  "screens": {
    "gallery": {
      "type": "list",
      "title": "Gallery",
      "source": "items",
      "layout": "grid",
      "search": { "param": "search", "placeholder": "Search the gallery" },
      "filters": [
        {
          "param": "kind",
          "label": "Type",
          "type": "segmented",
          "options": [
            { "value": "", "label": "All" },
            { "value": "IMAGE", "label": "Images" },
            { "value": "VIDEO", "label": "Videos" }
          ]
        },
        { "param": "favorite", "label": "Starred", "type": "toggle" }
      ],
      "item": {
        "title": "{{title|default:prompt}}",
        "subtitle": "{{model}}",
        "image": "{{thumb|default:url}}",
        "badges": [
          { "text": "Starred", "tone": "accent", "when": { "path": "favorite", "op": "truthy" } },
          { "text": "Failed", "tone": "danger", "when": { "path": "state", "op": "eq", "value": "FAILED" } },
          { "text": "In progress", "tone": "warn", "when": { "path": "state", "op": "in", "value": ["QUEUED", "RUNNING"] } }
        ]
      },
      "onPress": { "target": "screen:studio/item", "params": { "id": "{{databaseId}}" } },
      "actions": { "header": ["open_panel"] },
      "empty": { "title": "The gallery is empty", "body": "Generated images and videos are listed here. Create new ones in the panel." }
    },
    "item": {
      "type": "detail",
      "title": "Image",
      "source": "item",
      "header": {
        "title": "{{title|default:prompt}}",
        "subtitle": "{{model}}",
        "avatar": { "image": "{{thumb|default:url}}" }
      },
      "sections": [
        {
          "type": "fields",
          "fields": [
            { "label": "Prompt", "value": "{{prompt}}", "copy": true, "when": { "path": "prompt", "op": "filled" } },
            { "label": "Size", "value": "{{width}} × {{height}}", "when": { "path": "width", "op": "truthy" } },
            { "label": "Owner", "value": "{{ownerName}}" },
            { "label": "Error", "value": "{{error}}", "when": { "path": "error", "op": "filled" } }
          ]
        },
        { "type": "actions", "items": ["open_file", "favorite", "unfavorite", "open_panel"] }
      ],
      "actions": { "header": ["favorite", "unfavorite"] }
    }
  },
  "actions": {
    "favorite": {
      "label": "Star",
      "icon": "star",
      "when": { "path": "favorite", "op": "falsy" },
      "request": { "graphql": { "op": "FlxStudioItemUpdate", "variables": { "input": { "id": "{{databaseId}}", "favorite": true } }, "data": "flxStudioItemUpdate" } },
      "after": { "toast": "Starred", "invalidate": ["items", "item"] }
    },
    "unfavorite": {
      "label": "Remove star",
      "icon": "star",
      "when": { "path": "favorite", "op": "truthy" },
      "request": { "graphql": { "op": "FlxStudioItemUpdate", "variables": { "input": { "id": "{{databaseId}}", "favorite": false } }, "data": "flxStudioItemUpdate" } },
      "after": { "toast": "Star removed", "invalidate": ["items", "item"] }
    },
    "open_file": {
      "label": "Open file",
      "icon": "download",
      "when": { "path": "url", "op": "filled" },
      "open": "{{url}}"
    },
    "open_panel": {
      "label": "Open in panel",
      "icon": "globe",
      "web": "admin.php?page=flx-studio"
    }
  }
}
