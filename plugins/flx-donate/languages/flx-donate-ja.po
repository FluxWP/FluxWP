msgstr "印刷された証明書の住所"

msgid "Name, full address, district / city, phone"
msgstr "名前、完全な住所、地区/都市、電話番号"

msgid "By card, stop any time."
msgstr "カードでいつでも停止できます。"

msgid "Your donation was added to the cart."
msgstr "あなたの寄付がカートに追加されました。"

msgid "Go to cart"
msgstr "カートに移動"

msgid "Your donation"
msgstr "あなたの寄付"

msgid "from%s"
msgstr "%sから "

