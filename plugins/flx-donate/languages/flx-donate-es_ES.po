msgid_plural "%1$spaid gift ·%2$s%1$spaid gifts ·%2$s"
msgstr[0] "%1$sregalo pagado ·%2$s%1$sregalos pagados ·%2$s"
msgstr[1] "%1$sregalo pagado ·%2$s%1$sregalos pagados ·%2$s"

